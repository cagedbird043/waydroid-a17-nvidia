# Same-process HALs: loaded into app/SurfaceFlinger processes through the sphal namespace (libvulkan, the EGL loader,
# the gralloc mapper).
/(vendor|system/vendor)/lib(64)?/hw/vulkan\.nvidia\.so                    u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/lib(64)?/libvulkan_nouveau\.so                   u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/lib(64)?/libnv_bionic_native\.so                 u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/lib(64)?/libdrm\.so\.2                           u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/lib(64)?/libgallium_dri_nvrm\.so                 u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/lib(64)?/egl/lib(EGL|GLESv1_CM|GLESv2)_nvrm\.so  u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/lib(64)?/libgbm_mesa_wrapper\.so                 u:object_r:same_process_hal_file:s0
# Codec2 NVDEC service (same domain as AOSP's Codec2/OMX vendor services)
/(odm|vendor/odm)/bin/hw/android\.hardware\.media\.c2@1\.2-service-nvprolapse u:object_r:mediacodec_exec:s0
