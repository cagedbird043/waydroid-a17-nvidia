# nvidia-prolapse vendor modules (Android.mk next to this file). The driver binaries are prebuilts from the release
# native bundle (packaging/native/collect.py: prebuilts/native = its payload/ + BUILD-RECORD.json) and the ANGLE job
# (prebuilts/angle); vendor-image/build-vendor.sh (stage product) copies both in and checks the bundle's sha256s.
# Everything lands on the standard vendor paths the sphal/vendor linker namespaces search: no /vendor_extra.

# Vulkan: our HAL (hw/vulkan.<ro.hardware.vulkan>) -> NVK -> Rust RM; libdrm.so.2 is the soname NVK/nvrm NEED
PRODUCT_PACKAGES += \
    nvprolapse_vulkan.nvidia \
    nvprolapse_libvulkan_nouveau \
    nvprolapse_libnv_bionic_native \
    nvprolapse_libdrm.so.2

# GLES: ANGLE (default) and our gallium driver nvrm (ro.hardware.egl=nvrm), both in /vendor/<lib>/egl
PRODUCT_PACKAGES += \
    nvprolapse_libEGL_angle \
    nvprolapse_libGLESv1_CM_angle \
    nvprolapse_libGLESv2_angle \
    nvprolapse_libEGL_nvrm \
    nvprolapse_libGLESv1_CM_nvrm \
    nvprolapse_libGLESv2_nvrm \
    nvprolapse_libgallium_dri_nvrm

# gralloc: minigbm gbm_mesa core built in-tree with vendor-image/patches/external/minigbm; our wrapper replaces
# Mesa's libgbm_mesa_wrapper (allocation through NVK)
PRODUCT_PACKAGES += \
    nvprolapse_libgbm_mesa_wrapper

# Codec2 NVDEC decoder service on /odm (= vendor.img /odm on Waydroid; the binary opens /odm/etc paths)
PRODUCT_PACKAGES += \
    android.hardware.media.c2@1.2-service-nvprolapse
# media_codecs_c2.xml describes the HOST GPU's decoders (nvc2-xmlgen from nv_video_query_caps()), so no image can
# carry the right one: the image holds a placeholder without codecs and the install binds the host-generated file
# over /odm/etc/media_codecs_c2.xml. The service refuses to start while the file and the live caps differ, so a
# missing bind fails loudly instead of silently dropping hardware decode.
PRODUCT_COPY_FILES += \
    vendor/nvidia-prolapse/prebuilts/media/odm/etc/seccomp_policy/android.hardware.media.c2@1.2-nvprolapse.policy:$(TARGET_COPY_OUT_ODM)/etc/seccomp_policy/android.hardware.media.c2@1.2-nvprolapse.policy \
    vendor/nvidia-prolapse/media_codecs_c2.placeholder.xml:$(TARGET_COPY_OUT_ODM)/etc/media_codecs_c2.xml

# Shipped defaults (waydroid/nvidia_native.py mode_properties for nvidia-prolapse, native GL off). The host still
# writes /vendor/waydroid.prop, which init loads last (Waydroid base-patches-33 system/core 0015), so the LXC
# generator's per-install choice (nvidia_native_gl = on -> ro.hardware.egl=nvrm) overrides these.
PRODUCT_VENDOR_PROPERTIES += \
    ro.hardware.vulkan=nvidia \
    ro.hardware.egl=angle \
    ro.zygote.disable_gl_preload=true \
    debug.stagefright.ccodec=4 \
    debug.stagefright.omx_default_rank.sw-audio=4 \
    debug.stagefright.omx_default_rank.sw-other=256

# Display resize: this image's composer HAL (vendor-image/patches/hardware/interfaces) survives a primary display
# reconnect while frames are in flight, so hwcomposer.waydroid lets the Android display follow the window with one
# (patches/hardware/waydroid 0018). Without the property hwcomposer never sends a reconnect.
PRODUCT_VENDOR_PROPERTIES += \
    ro.vendor.composer.safe_primary_reconnect=true

# Identity: ro.vendor.nvidia_prolapse.version and .build_record (sha256 of the native bundle's BUILD-RECORD.json).
# waydroid/nvidia_native.py recognises this image by them and refuses an install whose package bundle differs.
# Generated by the product stage; a missing file fails the build here.
include vendor/nvidia-prolapse/identity.mk
