# shellcheck shell=bash
# AUR Maintainer: Shadichy <shadichy@blisslabs.org>

_pkg=kernelsu
pkgname=${_pkg}-dkms
pkgver=3.3.1+33+g4e752f94
pkgrel=1
_commit=4e752f941797dfe203788d618e026abf5a1088b5
_ksu_git_count=2713
# Public certificate accepted by the module; replace for your own signing key.
_ksu_expected_size=0x02ec
_ksu_expected_hash=d77ee93d9af4c1dbf8b89cf50fd9953db3a61b9142e009a9effeeedb5693eb4f
pkgdesc="A Kernel based root solution for Android. DKMS module for Container-based solutions such as Waydroid."
arch=('any')
url="https://github.com/supechicken/KernelSU"
license=('GPL-2.0-only')
depends=('dkms')
optdepends=('modloader')
makedepends=('git' 'rust' 'cargo')
options=('!strip' '!emptydirs')


_bundle=KernelSU-4e752f94.bundle
_release=a17-20261111-1
noextract=("$_bundle")
source=(
    "https://github.com/cagedbird043/waydroid-a17-nvidia/releases/download/$_release/$_bundle"
    'Makefile'
    '0001-Patch-Kbuild-for-dkms.patch'
    'dkms.conf'
    '00-kernelsu.conf'
    'load-kernelsu.in'
)
sha256sums=(
    '012f19894b81ae606f17bcec0673e16ce3d810bdf1c881abc888cfdd8c81632a'
    'a836794d044068ee44f0e60b4f45f4f58e810a23e79cb800b4cba1dd9004e369'
    'a45b6d9b38cc0fa06ca3984999ddd6940f4b4e2a84a4fccbf7801784903ef762'
    '0bb3096d98e5ac4539d9b074ff4331874713100972326a410a1068d262e19eba'
    '05feaafbbac794a68c7eeea8c0a4c5616fc9f6ef7e4b7540baf3f5d43fad5fb0'
    'f01d10fbcfba1b83134746ccfdc7ef4ceb61fa43593b94f039eac3469637429c'
)

prepare() {
    git init "$srcdir/$_pkg"
    git -C "$srcdir/$_pkg" fetch "$srcdir/$_bundle" HEAD 'refs/tags/*:refs/tags/*'
    git -C "$srcdir/$_pkg" checkout --force --detach "$_commit"
    cd "$srcdir/$_pkg"
    [[ $(git rev-parse HEAD) == "$_commit" ]]
    [[ $(git rev-parse --is-shallow-repository) == false ]]
    [[ $(git rev-list --count HEAD) == "$_ksu_git_count" ]]
    # Do not let an enclosing workspace repository redirect git apply.
    GIT_CEILING_DIRECTORIES="$srcdir" git apply "$srcdir/0001-Patch-Kbuild-for-dkms.patch"
}

build() {
    cd "$srcdir/$_pkg/userspace/ksuinit"
    cargo build --locked --jobs 4 --release --target-dir .
}

package() {
    local dest="$pkgdir/usr/src/kernelsu-${pkgver}"
    mkdir -p "$dest"
    cp -rpRLt "$dest" "$srcdir/$_pkg/kernel/."

    sed "s|@PKGVER@|${pkgver}|g;\
        s|@KSU_GIT_VERSION@|${_ksu_git_count} KSU_EXPECTED_SIZE=${_ksu_expected_size} KSU_EXPECTED_HASH=${_ksu_expected_hash}|g;" \
        "$srcdir/dkms.conf" >"$dest/dkms.conf"
    install -Dm644 "$srcdir/Makefile" "$dest/Makefile"
    install -Dm644 "$srcdir/00-kernelsu.conf" "$pkgdir/etc/modprobe.d/00-kernelsu.conf"
    install -Dm755 "$srcdir/$_pkg/userspace/ksuinit/release/ksuinit" "$pkgdir/usr/bin/kernelsu-loader"
    install -Dm755 "$srcdir/load-kernelsu.in" "$pkgdir/usr/bin/load-kernelsu"
}
