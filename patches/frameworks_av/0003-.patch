(cherry picked from commit 970850883ffbea2de9629f0e2a2db4cc3f73336c)
---
 media/libmediaplayerservice/StagefrightMetadataRetriever.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/media/libmediaplayerservice/StagefrightMetadataRetriever.cpp b/media/libmediaplayerservice/StagefrightMetadataRetriever.cpp
index 30d24f15fe..5127209717 100644
--- a/media/libmediaplayerservice/StagefrightMetadataRetriever.cpp
+++ b/media/libmediaplayerservice/StagefrightMetadataRetriever.cpp
@@ -624,7 +624,7 @@ void StagefrightMetadataRetriever::parseMetaData() {
 
     float captureFps;
     if (meta->findFloat(kKeyCaptureFramerate, &captureFps)) {
-        sprintf(tmp, "%f", captureFps);
+        snprintf(tmp, sizeof(tmp), "%f", captureFps);
         mMetaData.add(METADATA_KEY_CAPTURE_FRAMERATE, String8(tmp));
     }
 
