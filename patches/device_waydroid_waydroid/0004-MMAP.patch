Subject: [PATCH 4/4] =?utf-8?q?=E9=9F=B3=E9=A2=91=EF=BC=9A=E5=8E=BB?=
 =?utf-8?q?=E6=8E=89=20MMAP=20=E7=AB=AF=E5=8F=A3=EF=BC=8C=E5=AA=92?=
 =?utf-8?q?=E4=BD=93=E9=9F=B3=E9=87=8F=E9=BB=98=E8=AE=A4=E6=9C=80=E5=A4=A7?=
MIME-Version: 1.0
Content-Type: text/plain; charset=utf-8
Content-Transfer-Encoding: 8bit

- HAL 的 MMAP 流是 Cuttlefish 的占位实现，声音被丢弃；Chrome 网页音频等 AAudio 流会选中它，结果没声。去掉声明后 AAudio 退回普通路径，经 PulseAudio 出声
- system 镜像的 ro.config.media_vol_default=16 超过 15 档被 AudioService 丢弃，退回 1/3（5 档，约 -32 dB）；vendor 改为 15，音量交给主机控制
---
 configs/primary_audio_policy_configuration.xml | 14 +-------------
 device.mk                                      |  5 +++++
 2 files changed, 6 insertions(+), 13 deletions(-)

diff --git a/configs/primary_audio_policy_configuration.xml b/configs/primary_audio_policy_configuration.xml
index be7aef0..77f7d9a 100644
--- a/configs/primary_audio_policy_configuration.xml
+++ b/configs/primary_audio_policy_configuration.xml
@@ -29,21 +29,11 @@
                      samplingRates="8000 11025 16000 32000 44100 48000"
                      channelMasks="AUDIO_CHANNEL_OUT_MONO AUDIO_CHANNEL_OUT_STEREO"/>
         </mixPort>
-        <mixPort name="mmap_no_irq_out" role="source" flags="AUDIO_OUTPUT_FLAG_DIRECT AUDIO_OUTPUT_FLAG_MMAP_NOIRQ">
-             <profile name="" format="AUDIO_FORMAT_PCM_16_BIT"
-                      samplingRates="44100 48000"
-                      channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
-        </mixPort>
         <mixPort name="primary input" role="sink">
             <profile name="" format="AUDIO_FORMAT_PCM_16_BIT"
                      samplingRates="8000 11025 16000 32000 44100 48000"
                      channelMasks="AUDIO_CHANNEL_IN_MONO AUDIO_CHANNEL_IN_STEREO"/>
         </mixPort>
-        <mixPort name="mmap_no_irq_in" role="sink" flags="AUDIO_INPUT_FLAG_MMAP_NOIRQ">
-            <profile name="" format="AUDIO_FORMAT_PCM_16_BIT"
-                             samplingRates="44100 48000"
-                             channelMasks="AUDIO_CHANNEL_IN_STEREO"/>
-        </mixPort>
         <mixPort name="telephony_tx" role="source">
             <profile name="" format="AUDIO_FORMAT_PCM_16_BIT"
                      samplingRates="8000 11025 16000 32000 44100 48000"
@@ -68,11 +58,9 @@
     </devicePorts>
     <routes>
         <route type="mix" sink="Speaker"
-               sources="primary output,mmap_no_irq_out"/>
+               sources="primary output"/>
         <route type="mix" sink="primary input"
                sources="Built-In Mic"/>
-        <route type="mix" sink="mmap_no_irq_in"
-               sources="Built-In Mic"/>
 
         <route type="mix" sink="telephony_rx"
                sources="Telephony Rx"/>
diff --git a/device.mk b/device.mk
index 494bc3d..e61e5ea 100644
--- a/device.mk
+++ b/device.mk
@@ -57,6 +57,11 @@ PRODUCT_COPY_FILES += \
     $(LOCAL_PATH)/configs/audio_policy_configuration.xml:$(TARGET_COPY_OUT_VENDOR)/etc/audio_policy_configuration.xml \
     $(LOCAL_PATH)/configs/primary_audio_policy_configuration.xml:$(TARGET_COPY_OUT_VENDOR)/etc/primary_audio_policy_configuration.xml
 
+# Media volume starts at full scale: the host has the volume keys, so Android passes audio through.
+# The system image sets 16, above the 15 steps, and AudioService then falls back to a third.
+PRODUCT_PROPERTY_OVERRIDES += \
+    ro.config.media_vol_default=15
+
 # Bluetooth HAL
 PRODUCT_PACKAGES += \
     android.hardware.bluetooth@1.1-service.sim
-- 
