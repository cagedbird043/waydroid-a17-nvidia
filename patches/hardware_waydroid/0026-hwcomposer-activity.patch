---
 hwcomposer/WaydroidWindow.cpp      |  1 +
 hwcomposer/modes/waydroid_mode.cpp | 33 +++++++++++++++++++++---------
 hwcomposer/wayland-hwc.h           |  4 ++++
 3 files changed, 28 insertions(+), 10 deletions(-)

diff --git a/hwcomposer/WaydroidWindow.cpp b/hwcomposer/WaydroidWindow.cpp
index 71b8818..042e249 100644
--- a/hwcomposer/WaydroidWindow.cpp
+++ b/hwcomposer/WaydroidWindow.cpp
@@ -184,6 +184,7 @@ Return<void> WaydroidWindow::taskCreated(uint32_t taskID, const hidl_string& pac
     auto &task = mDisplay->tasks[tid];
     task.appID = packageName;
     task.component = componentName;
+    task.guests.clear();
     task.from_layer = false;
     ALOGI("taskCreated %s %s/%s", tid.c_str(), packageName.c_str(), componentName.c_str());
     return Void();
diff --git a/hwcomposer/modes/waydroid_mode.cpp b/hwcomposer/modes/waydroid_mode.cpp
index b0f1fed..4efe974 100644
--- a/hwcomposer/modes/waydroid_mode.cpp
+++ b/hwcomposer/modes/waydroid_mode.cpp
@@ -175,11 +175,14 @@ std::string component_class(const std::string &component, const std::string &pkg
  * which A17 no longer creates: the buffer is posted on ViewRootImpl's BLAST
  * child ("VRI-<pkg>/<activity>") or a SurfaceView ("SurfaceView[<pkg>/<activity>]"),
  * neither of which names its task. Recover the task from the WMS task events.
+ * An activity of another package started into a task (Settings search, share
+ * sheets, permission screens) is in no event: a package with no task on screen
+ * goes to the focused task and stays its guest.
  * Popups an app opens without its component in the title (is_app_popup_title)
  * are drawn by the app in front, so they go to the focused task.
  * on_screen holds the tasks this frame has a "Task=<id>" layer of.
  * Called with display->windowsMutex held. */
-void resolve_task(const struct display &disp, const std::set<std::string> &on_screen,
+void resolve_task(struct display &disp, const std::set<std::string> &on_screen,
                   layer_info &info) {
     std::string title = info.aid;
     const bool vri = title.rfind("VRI-", 0) == 0;
@@ -194,13 +197,14 @@ void resolve_task(const struct display &disp, const std::set<std::string> &on_sc
         title = title.substr(open, close == std::string::npos ? std::string::npos : close - open);
     }
 
-    const std::pair<const std::string, task_info> *best = nullptr;
+    std::pair<const std::string, task_info> *best = nullptr;
     std::string pkg, activity;
     if (split_component_title(title, pkg, activity)) {
         int best_score = -1;
-        for (const auto &entry : disp.tasks) {
+        for (auto &entry : disp.tasks) {
             const auto &task = entry.second;
-            if (task.appID != pkg)
+            const bool own = task.appID == pkg;
+            if (!own && !task.guests.contains(pkg))
                 continue;
             /* WMS also reports the recent tasks a previous boot left behind.
              * Those draw nothing: a frame of the package comes from a task on
@@ -209,8 +213,9 @@ void resolve_task(const struct display &disp, const std::set<std::string> &on_sc
             if (!task.focused && !task.closing && !on_screen.count(entry.first)
                     && !disp.windows.contains(entry.first))
                 continue;
-            int score = (!task.closing ? 4 : 0)
-                    + (component_class(task.component, pkg) == activity ? 2 : 0)
+            int score = (own ? 8 : 0)
+                    + (!task.closing ? 4 : 0)
+                    + (own && component_class(task.component, pkg) == activity ? 2 : 0)
                     + (task.focused ? 1 : 0);
             if (score > best_score
                     || (score == best_score && std::stoul(entry.first) > std::stoul(best->first))) {
@@ -218,21 +223,29 @@ void resolve_task(const struct display &disp, const std::set<std::string> &on_sc
                 best_score = score;
             }
         }
+        if (!best) {
+            for (auto &entry : disp.tasks) {
+                if (entry.second.focused && !entry.second.closing && !entry.second.appID.empty()) {
+                    best = &entry;
+                    best->second.guests.insert(pkg);
+                    break;
+                }
+            }
+        }
     } else if (is_app_popup_title(title)) {
-        for (const auto &entry : disp.tasks) {
+        for (auto &entry : disp.tasks) {
             if (entry.second.focused && !entry.second.closing && !entry.second.appID.empty()) {
                 best = &entry;
                 break;
             }
         }
-        if (best)
-            pkg = best->second.appID;
     }
     if (!best)
         return;
     info.type = LayerSplitType::TID;
     info.tid = best->first;
-    info.aid = pkg;
+    /* The window is named after the task's own package, also for a guest's frame. */
+    info.aid = best->second.appID;
     info.component = activity;
 }
 
diff --git a/hwcomposer/wayland-hwc.h b/hwcomposer/wayland-hwc.h
index ecb105e..fb338d2 100644
--- a/hwcomposer/wayland-hwc.h
+++ b/hwcomposer/wayland-hwc.h
@@ -670,6 +670,10 @@ struct task_info {
     std::string appID;
     std::string component;
     bool focused = false;
+    /* Packages other than appID whose activities run in this task (Settings
+     * search, share sheets, permission and sign-in screens): learned when a
+     * frame of a package with no task of its own came while this task had focus. */
+    std::set<std::string> guests;
     /* Two-phase close: the host closed the card, Android was asked to remove
      * the task, and until the authoritative taskRemoved arrives this task's
      * layers must not recreate a window (teardown frames, task-ID reuse). */
