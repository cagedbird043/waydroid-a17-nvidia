 hwcomposer/gralloc_handler.cpp | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/hwcomposer/gralloc_handler.cpp b/hwcomposer/gralloc_handler.cpp
index e443571..220e79f 100644
--- a/hwcomposer/gralloc_handler.cpp
+++ b/hwcomposer/gralloc_handler.cpp
@@ -431,18 +431,18 @@ std::unique_ptr<buffer> create_buffer_cros(wl_conn *conn, const buffer_metadata&
     for (unsigned i = 0; i < n; i++)
         planes[i] = { cros_handle->fds[i], cros_handle->offsets[i], cros_handle->strides[i] };
     if (n == 1)
-        ALOGI("attach dmabuf: %ux%u fmt 0x%x stride %u mod 0x%llx usage 0x%x",
+        ALOGI("attach dmabuf: %ux%u fmt 0x%x stride %u mod 0x%llx usage 0x%llx",
               metadata.width, metadata.height, cros_handle->format,
               cros_handle->strides[0],
               (unsigned long long)cros_handle->format_modifier,
-              cros_handle->usage);
+              (unsigned long long)cros_handle->usage);
     else
         ALOGI("attach dmabuf: %ux%u fmt 0x%x planes %u (offset/stride %u/%u, %u/%u, %u/%u) "
-              "mod 0x%llx usage 0x%x",
+              "mod 0x%llx usage 0x%llx",
               metadata.width, metadata.height, cros_handle->format, n,
               planes[0].offset, planes[0].stride, planes[1].offset, planes[1].stride,
               n > 2 ? planes[2].offset : 0, n > 2 ? planes[2].stride : 0,
-              (unsigned long long)cros_handle->format_modifier, cros_handle->usage);
+              (unsigned long long)cros_handle->format_modifier, (unsigned long long)cros_handle->usage);
     return create_dmabuf_wl_buffer(conn, metadata, planes, n, cros_handle->format, cros_handle->format_modifier, handle);
 }
 std::unique_ptr<buffer> create_buffer_android(wl_conn *conn, const buffer_metadata& metadata, buffer_handle_t handle) {
