+bool ime_bridge::set_clip(const std::string &text) {
+    if (text.size() > kMaxClip)
+        return false;
+    std::scoped_lock lock(display->windowsMutex);
+    if (client_fd < 0)
+        return false;
+    std::string msg;
+    put_u32(msg, kMsgClip);
+    put_string(msg, text);
+    send(msg);
