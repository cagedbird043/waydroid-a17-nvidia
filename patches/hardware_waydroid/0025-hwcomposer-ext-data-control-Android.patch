diff --git a/hwcomposer/WaydroidClipboard.cpp b/hwcomposer/WaydroidClipboard.cpp
index 39cd803..79e35c9 100644
--- a/hwcomposer/WaydroidClipboard.cpp
+++ b/hwcomposer/WaydroidClipboard.cpp
@@ -16,17 +16,33 @@
 
 /* Thank you @emersion:
  * https://emersion.fr/blog/2020/wayland-clipboard-drag-and-drop/
- */
+ *
+ * Two ways to the host clipboard. ext-data-control (the clipboard managers'
+ * protocol) on the control connection is used whenever the compositor offers
+ * it: it reports every selection change and takes a new selection without
+ * keyboard focus or an input serial. Without it the clipboard rides on
+ * wl_data_device of whichever connection has keyboard focus, which only sees
+ * the selection on focus enter and needs a recent serial to set it.
+ *
+ * Transfers never block the Wayland event thread: the host selection is read
+ * and our text is written on short-lived threads. */
 
 #include "WaydroidClipboard.h"
 
+#include <fcntl.h>
 #include <log/log.h>
 #include <unistd.h>
 #include <algorithm>
+#include <cerrno>
+#include <cstring>
+#include <mutex>
+#include <thread>
 #include <vector>
 
 #include <wayland-client.h>
 
+#include "ext-data-control-v1-client-protocol.h"
+
 bool clipboard_debug_enabled() {
     static const bool enabled =
         property_get_bool("persist.waydroid.clipboard_debug", false);
@@ -41,15 +57,220 @@ static const std::vector<std::string> MIME_TYPES = {
     "STRING",
 };
 
-static void data_source_handle_send(void *data, struct wl_data_source *, const char *mime_type, int fd) {
-    // An application wants to paste the clipboard contents
-    const char *text = (const char *)data;
+static bool is_text_mime(const char *mime_type) {
+    return std::find(MIME_TYPES.begin(), MIME_TYPES.end(), mime_type) != MIME_TYPES.end();
+}
+
+/* The preferred text type among those offered; empty when there is none. */
+template <typename List>
+static std::string pick_text_mime(const List &offered) {
+    for (const auto &want : MIME_TYPES)
+        if (std::find(offered.begin(), offered.end(), want) != offered.end())
+            return want;
+    return "";
+}
+
+/* Hands our text to a host application that pastes it. */
+static void serve_text(const char *mime_type, int fd, std::string text) {
     CLIPLOG("clipboard: host asked for our selection as %s", mime_type);
-    if (std::find(MIME_TYPES.begin(), MIME_TYPES.end(), mime_type) != MIME_TYPES.end())
-        write(fd, text, strlen((char *)text));
-    else
+    if (!is_text_mime(mime_type)) {
         ALOGE("Destination client requested unsupported MIME type: %s", mime_type);
-    close(fd);
+        close(fd);
+        return;
+    }
+    std::thread([fd, text = std::move(text)] {
+        size_t off = 0;
+        while (off < text.size()) {
+            ssize_t n = write(fd, text.data() + off, text.size() - off);
+            if (n < 0 && errno == EINTR)
+                continue;
+            if (n <= 0)
+                break;
+            off += n;
+        }
+        close(fd);
+    }).detach();
+}
+
+/* Reads a host selection the compositor is about to send into fd. A read
+ * that ends after a newer selection arrived is dropped. */
+static void read_host_selection(struct display *display, int fd, const std::string &mime_type) {
+    uint64_t generation;
+    {
+        std::scoped_lock lock(display->clipboard_mutex);
+        generation = ++display->clipboard_generation;
+    }
+    std::thread([display, fd, generation, mime_type] {
+        std::string received;
+        char buf[4096];
+        while (true) {
+            ssize_t n = read(fd, buf, sizeof(buf));
+            if (n < 0 && errno == EINTR)
+                continue;
+            if (n <= 0)
+                break;
+            received.append(buf, n);
+        }
+        close(fd);
+
+        {
+            std::scoped_lock lock(display->clipboard_mutex);
+            if (generation != display->clipboard_generation) {
+                CLIPLOG("clipboard: dropping a stale read of %zu bytes", received.size());
+                return;
+            }
+            /* Nothing transferred means the source went away before writing;
+             * an empty host clipboard is not worth losing what we had. */
+            if (received.empty()) {
+                CLIPLOG("clipboard: host selection transferred 0 bytes as %s, keeping the "
+                        "previous %zu bytes", mime_type.c_str(), display->clipboard.size());
+                return;
+            }
+            /* Our own selection coming back, or a host copy of the same text. */
+            if (received == display->clipboard)
+                return;
+            display->clipboard = received;
+            CLIPLOG("clipboard: read %zu bytes of host selection as %s",
+                    display->clipboard.size(), mime_type.c_str());
+        }
+        /* Android only pulls the host text when an app reads the clipboard and
+         * then does not tell anyone it changed; pushing it in through the
+         * input method makes the framework notify apps. */
+        if (display->ime && display->ime->set_clip(received))
+            CLIPLOG("clipboard: pushed %zu bytes to Android", received.size());
+    }).detach();
+}
+
+/* A pipe for one transfer: returns the write end for the compositor and keeps
+ * the read end in *read_fd. */
+static int transfer_pipe(int *read_fd) {
+    int fds[2];
+    if (pipe2(fds, O_CLOEXEC) != 0) {
+        ALOGE("clipboard: pipe failed: %s", strerror(errno));
+        return -1;
+    }
+    *read_fd = fds[0];
+    return fds[1];
+}
+
+/* ---- ext-data-control ---- */
+
+struct control_offer {
+    std::vector<std::string> mime_types;
+};
+
+static void control_offer_handle_offer(void *data, struct ext_data_control_offer_v1 *,
+                                       const char *mime_type) {
+    static_cast<control_offer *>(data)->mime_types.push_back(mime_type);
+}
+
+static const struct ext_data_control_offer_v1_listener control_offer_listener = {
+    .offer = control_offer_handle_offer,
+};
+
+static void control_offer_destroy(struct ext_data_control_offer_v1 *offer) {
+    delete static_cast<control_offer *>(ext_data_control_offer_v1_get_user_data(offer));
+    ext_data_control_offer_v1_destroy(offer);
+}
+
+static void control_device_handle_data_offer(void *, struct ext_data_control_device_v1 *,
+                                             struct ext_data_control_offer_v1 *offer) {
+    ext_data_control_offer_v1_add_listener(offer, &control_offer_listener, new control_offer);
+}
+
+static void control_device_handle_selection(void *data, struct ext_data_control_device_v1 *,
+                                            struct ext_data_control_offer_v1 *offer) {
+    struct wl_conn *conn = static_cast<struct wl_conn *>(data);
+    if (!offer) {
+        CLIPLOG("clipboard: host selection cleared");
+        return;
+    }
+    const std::string mime_type =
+            pick_text_mime(static_cast<control_offer *>(ext_data_control_offer_v1_get_user_data(offer))
+                                   ->mime_types);
+    if (mime_type.empty()) {
+        CLIPLOG("clipboard: host selection has no text");
+        control_offer_destroy(offer);
+        return;
+    }
+    int read_fd;
+    int write_fd = transfer_pipe(&read_fd);
+    if (write_fd < 0) {
+        control_offer_destroy(offer);
+        return;
+    }
+    ext_data_control_offer_v1_receive(offer, mime_type.c_str(), write_fd);
+    close(write_fd);
+    control_offer_destroy(offer);
+    wl_display_flush(conn->display);
+    read_host_selection(conn->dpy, read_fd, mime_type);
+}
+
+static void control_device_handle_finished(void *data, struct ext_data_control_device_v1 *device) {
+    struct wl_conn *conn = static_cast<struct wl_conn *>(data);
+    ALOGW("clipboard: the compositor ended data control; following keyboard focus instead");
+    std::scoped_lock lock(conn->dpy->windowsMutex);
+    if (conn->data_control_device == device)
+        conn->data_control_device = nullptr;
+    ext_data_control_device_v1_destroy(device);
+}
+
+static void control_device_handle_primary_selection(void *, struct ext_data_control_device_v1 *,
+                                                    struct ext_data_control_offer_v1 *offer) {
+    if (offer)
+        control_offer_destroy(offer);
+}
+
+static const struct ext_data_control_device_v1_listener control_device_listener = {
+    .data_offer = control_device_handle_data_offer,
+    .selection = control_device_handle_selection,
+    .finished = control_device_handle_finished,
+    .primary_selection = control_device_handle_primary_selection,
+};
+
+static void control_source_handle_send(void *data, struct ext_data_control_source_v1 *,
+                                       const char *mime_type, int fd) {
+    serve_text(mime_type, fd, *static_cast<std::string *>(data));
+}
+
+static void control_source_handle_cancelled(void *data, struct ext_data_control_source_v1 *source) {
+    CLIPLOG("clipboard: our selection was replaced on the host");
+    delete static_cast<std::string *>(data);
+    ext_data_control_source_v1_destroy(source);
+}
+
+static const struct ext_data_control_source_v1_listener control_source_listener = {
+    .send = control_source_handle_send,
+    .cancelled = control_source_handle_cancelled,
+};
+
+void clipboard_attach(struct wl_conn *conn) {
+    std::scoped_lock lock(conn->dpy->windowsMutex);
+    if (!conn->is_ctl || conn->data_control_device)
+        return;
+    if (!conn->data_control_manager || !conn->seat) {
+        ALOGW("clipboard: the compositor has no ext_data_control_manager_v1; the clipboard "
+              "follows keyboard focus");
+        return;
+    }
+    conn->data_control_device =
+            ext_data_control_manager_v1_get_data_device(conn->data_control_manager, conn->seat);
+    ext_data_control_device_v1_add_listener(conn->data_control_device, &control_device_listener, conn);
+    wl_display_flush(conn->display);
+    ALOGI("clipboard: using ext-data-control");
+}
+
+void clipboard_detach(struct wl_conn *conn) {
+    std::scoped_lock lock(conn->dpy->windowsMutex);
+    if (conn->data_control_device)
+        ext_data_control_device_v1_destroy(conn->data_control_device);
+    conn->data_control_device = nullptr;
+}
+
+/* ---- wl_data_device, following keyboard focus ---- */
+
+static void data_source_handle_send(void *data, struct wl_data_source *, const char *mime_type, int fd) {
+    serve_text(mime_type, fd, *static_cast<std::string *>(data));
 }
 
