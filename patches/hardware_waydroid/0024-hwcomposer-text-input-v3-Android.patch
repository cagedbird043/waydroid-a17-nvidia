+// Input method that hands Android editors to the host input method; the
+// composer's side is hwcomposer/ime-bridge.h.
+android_app {
+    name: "WaydroidHostIme",
+    srcs: ["src/**/*.java"],
+    resource_dirs: ["res"],
+    sdk_version: "current",
+    vendor: true,
+    optimize: {
+        enabled: false,
+    },
+    required: ["waydroid-hostime-enable"],
+}
+
+sh_binary {
+    name: "waydroid-hostime-enable",
+    src: "waydroid-hostime-enable.sh",
+    vendor: true,
+    required: ["waydroid-hostime.rc"],
+}
+
+prebuilt_etc {
+    name: "waydroid-hostime.rc",
+    src: "waydroid-hostime.rc",
+    sub_dir: "init",
+    vendor: true,
+}
