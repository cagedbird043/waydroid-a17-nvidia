+int task_control::package_uid(const std::string &package) {
+    /* "package:<name> uid:<uid>" for every installed package whose name
+     * contains the filter; pick the exact one. */
+    std::string out;
+    if (!run_tool("cmd", {"package", "list", "packages", "-U", package}, &out, /*quiet=*/true))
+        return -1;
+    const std::string want = "package:" + package + " uid:";
+    size_t pos = 0;
+    while (pos < out.size()) {
+        size_t end = out.find('\n', pos);
+        if (end == std::string::npos)
+            end = out.size();
+        const std::string line = out.substr(pos, end - pos);
+        if (line.rfind(want, 0) == 0)
+            return atoi(line.c_str() + want.size());
+        pos = end + 1;
+    }
+    return -1;
+}
