+
+#include "ime-bridge.h"
+
+#include <poll.h>
+#include <sys/eventfd.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+#include <algorithm>
+#include <cerrno>
+#include <cmath>
+#include <cstddef>
+#include <cstring>
+#include <mutex>
+#include <vector>
+
+#include <log/log.h>
+#include <wayland-client.h>
+
+#include "text-input-unstable-v3-client-protocol.h"
+#include "wayland-hwc.h"
+
+namespace {
+
+constexpr char kSocketName[] = "waydroid-hostime";
+constexpr char kImePackage[] = "id.waydro.hostime";
+
+constexpr uint32_t kMsgFocus = 1;
+constexpr uint32_t kMsgCursor = 2;
+constexpr uint32_t kMsgDone = 10;
+
+/* Far above any real message; a peer sending more is not the app. */
+constexpr uint32_t kMaxMessage = 64 * 1024;
+
+void put_u32(std::string &out, uint32_t v) {
+    const char b[4] = {char(v >> 24), char(v >> 16), char(v >> 8), char(v)};
+    out.append(b, 4);
+}
+
+void put_string(std::string &out, const std::optional<std::string> &s) {
+    if (!s) {
+        put_u32(out, uint32_t(-1));
+        return;
+    }
+    put_u32(out, s->size());
+    out += *s;
+}
+
+uint32_t get_u32(const uint8_t *p) {
+    return uint32_t(p[0]) << 24 | uint32_t(p[1]) << 16 | uint32_t(p[2]) << 8 | p[3];
+}
+
+void text_input_enter(void *data, struct zwp_text_input_v3 *, struct wl_surface *surface) {
+    static_cast<ime_bridge *>(data)->enter(surface);
+}
+
+void text_input_leave(void *data, struct zwp_text_input_v3 *, struct wl_surface *surface) {
+    static_cast<ime_bridge *>(data)->leave(surface);
+}
+
+void text_input_preedit(void *data, struct zwp_text_input_v3 *, const char *text,
+                        int32_t begin, int32_t end) {
+    static_cast<ime_bridge *>(data)->preedit_string(text, begin, end);
+}
+
+void text_input_commit(void *data, struct zwp_text_input_v3 *, const char *text) {
+    static_cast<ime_bridge *>(data)->commit_string(text);
+}
+
+void text_input_delete(void *data, struct zwp_text_input_v3 *, uint32_t before, uint32_t after) {
+    static_cast<ime_bridge *>(data)->delete_surrounding_text(before, after);
+}
+
+void text_input_done(void *data, struct zwp_text_input_v3 *, uint32_t) {
+    /* A serial behind our commits still carries text to apply; the spec only
+     * asks not to take it as the current state, and we keep none. */
+    static_cast<ime_bridge *>(data)->done();
+}
+
+const struct zwp_text_input_v3_listener text_input_listener = {
+    text_input_enter,
+    text_input_leave,
+    text_input_preedit,
+    text_input_commit,
+    text_input_delete,
+    text_input_done,
+};
+
+}  // namespace
+
+ime_bridge::ime_bridge(struct display *display) : display(display) {
+    listen_fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+    wake_fd = eventfd(0, EFD_CLOEXEC);
+    struct sockaddr_un addr = {};
+    addr.sun_family = AF_UNIX;
+    /* Abstract: sun_path[0] stays 0. */
+    memcpy(addr.sun_path + 1, kSocketName, sizeof(kSocketName) - 1);
+    const socklen_t len = offsetof(struct sockaddr_un, sun_path) + 1 + sizeof(kSocketName) - 1;
+    if (listen_fd < 0 || wake_fd < 0 || bind(listen_fd, (struct sockaddr *)&addr, len) != 0
+            || listen(listen_fd, 2) != 0) {
+        ALOGE("hostime: cannot listen on @%s: %s; host input method disabled", kSocketName,
+              strerror(errno));
+        return;
+    }
+    thread = std::thread(&ime_bridge::serve, this);
+}
+
+ime_bridge::~ime_bridge() {
+    if (thread.joinable()) {
+        uint64_t one = 1;
+        (void)!write(wake_fd, &one, sizeof(one));
+        thread.join();
+    }
+    if (client_fd >= 0)
+        close(client_fd);
+    if (listen_fd >= 0)
+        close(listen_fd);
+    if (wake_fd >= 0)
+        close(wake_fd);
+}
+
+void ime_bridge::attach(struct wl_conn *c, struct zwp_text_input_v3 *ti) {
+    std::scoped_lock lock(display->windowsMutex);
+    conn = c;
+    text_input = ti;
+    entered = nullptr;
+    enabled = false;
+    zwp_text_input_v3_add_listener(text_input, &text_input_listener, this);
+}
+
+void ime_bridge::detach(struct wl_conn *c) {
+    std::scoped_lock lock(display->windowsMutex);
+    if (conn != c)
+        return;
+    if (text_input)
+        zwp_text_input_v3_destroy(text_input);
+    text_input = nullptr;
+    conn = nullptr;
+    entered = nullptr;
+    enabled = false;
+}
+
+void ime_bridge::enter(struct wl_surface *surface) {
+    std::scoped_lock lock(display->windowsMutex);
+    entered = surface;
+    /* Text input starts disabled on every enter. */
+    enabled = false;
+    update();
+}
+
+void ime_bridge::leave(struct wl_surface *surface) {
+    std::scoped_lock lock(display->windowsMutex);
+    if (entered != surface)
+        return;
+    entered = nullptr;
+    enabled = false;
+}
+
+void ime_bridge::preedit_string(const char *text, int32_t begin, int32_t end) {
+    std::scoped_lock lock(display->windowsMutex);
+    pending_preedit = text ? text : "";
+    pending_preedit_begin = begin;
+    pending_preedit_end = end;
+}
+
+void ime_bridge::commit_string(const char *text) {
+    std::scoped_lock lock(display->windowsMutex);
+    pending_commit = text ? text : "";
+}
+
+void ime_bridge::delete_surrounding_text(uint32_t before, uint32_t after) {
+    std::scoped_lock lock(display->windowsMutex);
+    pending_delete_before = before;
+    pending_delete_after = after;
+}
+
+void ime_bridge::done() {
+    std::scoped_lock lock(display->windowsMutex);
+    std::string msg;
+    put_u32(msg, kMsgDone);
+    put_u32(msg, pending_delete_before);
+    put_u32(msg, pending_delete_after);
+    put_string(msg, pending_commit);
+    /* No preedit_string before done means the preedit is now empty. */
+    put_string(msg, pending_preedit ? pending_preedit : std::optional<std::string>(""));
+    put_u32(msg, pending_preedit ? pending_preedit_begin : 0);
+    put_u32(msg, pending_preedit ? pending_preedit_end : 0);
+    send(msg);
+    pending_preedit.reset();
+    pending_commit.reset();
+    pending_delete_before = pending_delete_after = 0;
+}
+
+/* Brings the text-input object in line with what the two sides say: enabled
+ * while a surface of ours has the keyboard and an Android editor has focus. */
+void ime_bridge::update() {
+    if (!text_input || !conn)
+        return;
+    const bool want = entered && editor_active;
+    if (!want) {
+        if (enabled) {
+            zwp_text_input_v3_disable(text_input);
+            zwp_text_input_v3_commit(text_input);
+            enabled = false;
+            wl_display_flush(conn->display);
+        }
+        return;
+    }
+    bool changed = false;
+    if (!enabled) {
+        zwp_text_input_v3_enable(text_input);
+        zwp_text_input_v3_set_content_type(text_input, content_hint, content_purpose);
+        enabled = true;
+        cursor_sent = false;
+        changed = true;
+    }
+    if (cursor && !cursor_sent) {
+        /* Android display pixels to the entered surface's local space. */
+        const struct layerFrame origin = surface_display_origin(conn, entered);
+        const double scale = display->scale > 0 ? display->scale : 1.0;
+        const int32_t x = floor((cursor->left - origin.x) / scale);
+        const int32_t y = floor((cursor->top - origin.y) / scale);
+        const int32_t w = std::max(1, (int32_t)ceil((cursor->right - cursor->left) / scale));
+        const int32_t h = std::max(1, (int32_t)ceil((cursor->bottom - cursor->top) / scale));
+        zwp_text_input_v3_set_cursor_rectangle(text_input, x, y, w, h);
+        cursor_sent = true;
+        changed = true;
+    }
+    if (changed) {
+        zwp_text_input_v3_commit(text_input);
+        wl_display_flush(conn->display);
+    }
+}
+
+void ime_bridge::send(const std::string &payload) {
+    if (client_fd < 0)
+        return;
+    std::string frame;
+    put_u32(frame, payload.size());
+    frame += payload;
+    size_t off = 0;
+    while (off < frame.size()) {
+        ssize_t n = ::send(client_fd, frame.data() + off, frame.size() - off, MSG_NOSIGNAL);
+        if (n < 0 && errno == EINTR)
+            continue;
+        if (n <= 0) {
+            ALOGW("hostime: write to the app failed: %s", strerror(errno));
+            return;
+        }
+        off += n;
+    }
+}
+
+void ime_bridge::drop_client() {
+    if (client_fd >= 0)
+        close(client_fd);
+    client_fd = -1;
+    editor_active = false;
+    cursor.reset();
+    update();
+}
+
+/* Only the app's uid may take the socket: whatever is typed goes to it. */
+bool ime_bridge::accept_client(int fd) {
+    struct ucred cred = {};
+    socklen_t len = sizeof(cred);
+    if (getsockopt(fd, SOL_SOCKET, SO_PEERCRED, &cred, &len) != 0)
+        return false;
+    if (ime_uid < 0 || (int)cred.uid != ime_uid) {
+        /* Not cached yet, or the app was reinstalled under a new uid. */
+        ime_uid = display->task_ctl->package_uid(kImePackage);
+    }
+    if (ime_uid < 0 || (int)cred.uid != ime_uid) {
+        ALOGW("hostime: refusing pid %d uid %u (%s runs as %d)", cred.pid, cred.uid,
+              kImePackage, ime_uid);
+        return false;
+    }
+    ALOGI("hostime: %s connected (pid %d)", kImePackage, cred.pid);
+    return true;
+}
+
+void ime_bridge::handle_message(uint32_t type, const uint8_t *data, size_t size) {
+    if (type == kMsgFocus && size >= 12) {
+        editor_active = get_u32(data) != 0;
+        const uint32_t hint = get_u32(data + 4);
+        const uint32_t purpose = get_u32(data + 8);
+        /* A new editor type needs a fresh enable to reach the input method. */
+        if (enabled && (hint != content_hint || purpose != content_purpose) && text_input) {
+            zwp_text_input_v3_disable(text_input);
+            zwp_text_input_v3_commit(text_input);
+            enabled = false;
+        }
+        content_hint = hint;
+        content_purpose = purpose;
+        if (!editor_active)
+            cursor.reset();
+        update();
+    } else if (type == kMsgCursor && size >= 16) {
+        const hwc_rect_t r = {(int32_t)get_u32(data), (int32_t)get_u32(data + 4),
+                              (int32_t)get_u32(data + 8), (int32_t)get_u32(data + 12)};
+        if (!cursor || memcmp(&*cursor, &r, sizeof(r)) != 0) {
+            cursor = r;
+            cursor_sent = false;
+            update();
+        }
+    }
+}
+
+void ime_bridge::serve() {
+    std::vector<uint8_t> buf;
+    while (true) {
+        int fd;
+        {
+            std::scoped_lock lock(display->windowsMutex);
+            fd = client_fd;
+        }
+        struct pollfd fds[3] = {
+            {wake_fd, POLLIN, 0},
+            {listen_fd, POLLIN, 0},
+            {fd, POLLIN, 0},
+        };
+        if (poll(fds, fd >= 0 ? 3 : 2, -1) < 0) {
+            if (errno == EINTR)
+                continue;
+            ALOGE("hostime: poll failed: %s", strerror(errno));
+            return;
+        }
+        if (fds[0].revents)
+            return;
+
+        if (fds[1].revents & POLLIN) {
+            int c = accept4(listen_fd, nullptr, nullptr, SOCK_CLOEXEC);
+            /* package_uid forks a shell command: no lock across it. */
+            if (c >= 0 && !accept_client(c)) {
+                close(c);
+                c = -1;
+            }
+            if (c >= 0) {
+                std::scoped_lock lock(display->windowsMutex);
+                /* The app restarted: its new connection replaces the old one. */
+                drop_client();
+                client_fd = c;
+                buf.clear();
+            }
+            continue;
+        }
+
+        if (fd >= 0 && fds[2].revents) {
+            uint8_t chunk[4096];
+            ssize_t n = recv(fd, chunk, sizeof(chunk), 0);
+            if (n < 0 && errno == EINTR)
+                continue;
+            std::scoped_lock lock(display->windowsMutex);
+            if (fd != client_fd)
+                continue;
+            if (n <= 0) {
+                ALOGI("hostime: the app disconnected");
+                drop_client();
+                continue;
+            }
+            buf.insert(buf.end(), chunk, chunk + n);
+            size_t off = 0;
+            while (buf.size() - off >= 4) {
+                const uint32_t len = get_u32(buf.data() + off);
+                if (len < 4 || len > kMaxMessage) {
+                    ALOGW("hostime: malformed message (length %u), dropping the app", len);
+                    drop_client();
+                    buf.clear();
+                    off = 0;
+                    break;
+                }
+                if (buf.size() - off - 4 < len)
+                    break;
+                const uint8_t *msg = buf.data() + off + 4;
+                handle_message(get_u32(msg), msg + 4, len - 4);
+                off += 4 + len;
+            }
+            buf.erase(buf.begin(), buf.begin() + off);
+        }
+    }
+}
