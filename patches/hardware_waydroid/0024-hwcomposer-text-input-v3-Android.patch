+struct display;
+struct wl_conn;
+struct wl_surface;
+struct zwp_text_input_v3;
+
+/* The host input method (fcitx5, ibus, whatever the compositor runs) typing
+ * into Android.
+ *
+ * The composer is a Wayland client, so it holds a zwp_text_input_v3 on the
+ * control connection: the compositor routes keys through the host input method
+ * while text input is enabled and hands back preedit and commit strings, and
+ * keys the input method does not take still arrive on wl_keyboard as before.
+ * Android's side is the vendor input method app (id.waydro.hostime), which
+ * has no input view of its own: it puts the strings into the focused editor
+ * and reports where that editor's cursor is, so the host draws its candidate
+ * window next to it.
+ *
+ * The app connects to the abstract unix socket "waydroid-hostime"; only the
+ * uid the package runs as is accepted, since the socket carries everything
+ * typed. Messages are a big-endian uint32 length followed by that many bytes:
+ * a uint32 type, then the fields, int32 big-endian, strings as an int32 byte
+ * length (-1 for none) and UTF-8.
+ *
+ *   app -> composer
+ *     1 FOCUS   active, content hint, content purpose (zwp_text_input_v3 values)
+ *     2 CURSOR  left, top, right, bottom of the cursor, Android display pixels
+ *   composer -> app
+ *     10 DONE   delete before, delete after (UTF-8 bytes), commit string,
+ *               preedit string, preedit cursor begin, end (bytes; -1 hidden)
+ *
+ * All state is guarded by display->windowsMutex, which the reconnect path
+ * already holds when it detaches a connection. */
+class ime_bridge {
+  public:
+    explicit ime_bridge(struct display *display);
+    ~ime_bridge();
+
+    /* The control connection bound a text-input object, or is going away. */
+    void attach(struct wl_conn *conn, struct zwp_text_input_v3 *text_input);
+    void detach(struct wl_conn *conn);
+
+    /* zwp_text_input_v3 events, on the control connection's wayland thread. */
+    void enter(struct wl_surface *surface);
+    void leave(struct wl_surface *surface);
+    void preedit_string(const char *text, int32_t cursor_begin, int32_t cursor_end);
+    void commit_string(const char *text);
+    void delete_surrounding_text(uint32_t before, uint32_t after);
+    void done();
+
+  private:
+    void serve();
+    bool accept_client(int fd);
+    void handle_message(uint32_t type, const uint8_t *data, size_t size);
+    void drop_client();
+    void update();
+    void send(const std::string &payload);
+
+    struct display *display;
+    int listen_fd = -1;
+    int wake_fd = -1;
+    std::thread thread;
+
+    int client_fd = -1;
+    int ime_uid = -1;
+
+    struct wl_conn *conn = nullptr;
+    struct zwp_text_input_v3 *text_input = nullptr;
+    struct wl_surface *entered = nullptr;
+    bool enabled = false;
+
+    bool editor_active = false;
+    uint32_t content_hint = 0;
+    uint32_t content_purpose = 0;
+    std::optional<hwc_rect_t> cursor;
+    bool cursor_sent = false;
+
+    /* Events since the last done. */
+    std::optional<std::string> pending_preedit;
+    int32_t pending_preedit_begin = 0;
+    int32_t pending_preedit_end = 0;
+    std::optional<std::string> pending_commit;
+    uint32_t pending_delete_before = 0;
+    uint32_t pending_delete_after = 0;
+};
