@@ -0,0 +1,370 @@
+package id.waydro.hostime;
+
+import android.graphics.Matrix;
+import android.graphics.RectF;
+import android.inputmethodservice.InputMethodService;
+import android.net.LocalSocket;
+import android.net.LocalSocketAddress;
+import android.os.Handler;
+import android.os.Looper;
+import android.text.InputType;
+import android.util.Log;
+import android.view.inputmethod.CursorAnchorInfo;
+import android.view.inputmethod.EditorInfo;
+import android.view.inputmethod.InputConnection;
+
+import java.io.ByteArrayOutputStream;
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.io.IOException;
+import java.io.OutputStream;
+import java.nio.charset.StandardCharsets;
+
+/**
+ * Hands the focused editor to the host input method through the composer
+ * (hardware/waydroid/hwcomposer/ime-bridge.h, which documents the protocol).
+ * It draws nothing: the host shows the preedit and candidates, this puts the
+ * resulting text into the editor and tells the host where the cursor is.
+ * Keys reach the editor as with no input method at all.
+ */
+public class HostIme extends InputMethodService {
+    private static final String TAG = "HostIme";
+    private static final String SOCKET = "waydroid-hostime";
+
+    private static final int MSG_FOCUS = 1;
+    private static final int MSG_CURSOR = 2;
+    private static final int MSG_DONE = 10;
+
+    /* zwp_text_input_v3 content hints and purposes. */
+    private static final int HINT_COMPLETION = 0x1;
+    private static final int HINT_SPELLCHECK = 0x2;
+    private static final int HINT_AUTO_CAPITALIZATION = 0x4;
+    private static final int HINT_HIDDEN_TEXT = 0x40;
+    private static final int HINT_SENSITIVE_DATA = 0x80;
+    private static final int HINT_MULTILINE = 0x200;
+    private static final int PURPOSE_NORMAL = 0;
+    private static final int PURPOSE_DIGITS = 2;
+    private static final int PURPOSE_NUMBER = 3;
+    private static final int PURPOSE_PHONE = 4;
+    private static final int PURPOSE_URL = 5;
+    private static final int PURPOSE_EMAIL = 6;
+    private static final int PURPOSE_NAME = 7;
+    private static final int PURPOSE_PASSWORD = 8;
+    private static final int PURPOSE_PIN = 9;
+    private static final int PURPOSE_DATE = 10;
+    private static final int PURPOSE_TIME = 11;
+    private static final int PURPOSE_DATETIME = 12;
+
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private final Object lock = new Object();
+    private Thread reader;
+    private volatile boolean stopped;
+    /* Guarded by lock. */
+    private LocalSocket socket;
+    private OutputStream out;
+
+    /* Main thread. The last state sent, resent after a reconnect. */
+    private boolean editorActive;
+    private int hint;
+    private int purpose;
+    private final RectF lastCursor = new RectF();
+    private boolean haveCursor;
+    private boolean composing;
+
+    @Override
+    public void onCreate() {
+        super.onCreate();
+        reader = new Thread(this::readLoop, "HostIme reader");
+        reader.start();
+    }
+
+    @Override
+    public void onDestroy() {
+        stopped = true;
+        closeSocket();
+        reader.interrupt();
+        super.onDestroy();
+    }
+
+    @Override
+    public boolean onEvaluateInputViewShown() {
+        return false;
+    }
+
+    @Override
+    public boolean onEvaluateFullscreenMode() {
+        return false;
+    }
+
+    @Override
+    public void onStartInput(EditorInfo info, boolean restarting) {
+        super.onStartInput(info, restarting);
+        composing = false;
+        haveCursor = false;
+        int cls = info.inputType & InputType.TYPE_MASK_CLASS;
+        editorActive = cls != InputType.TYPE_NULL;
+        hint = 0;
+        purpose = PURPOSE_NORMAL;
+        if (editorActive)
+            describe(info.inputType);
+        sendFocus();
+        InputConnection ic = getCurrentInputConnection();
+        if (editorActive && ic != null) {
+            ic.requestCursorUpdates(InputConnection.CURSOR_UPDATE_IMMEDIATE
+                    | InputConnection.CURSOR_UPDATE_MONITOR);
+        }
+    }
+
+    @Override
+    public void onFinishInput() {
+        super.onFinishInput();
+        composing = false;
+        haveCursor = false;
+        if (editorActive) {
+            editorActive = false;
+            sendFocus();
+        }
+    }
+
+    @Override
+    public void onUpdateCursorAnchorInfo(CursorAnchorInfo info) {
+        float left = info.getInsertionMarkerHorizontal();
+        float top = info.getInsertionMarkerTop();
+        float bottom = info.getInsertionMarkerBottom();
+        if (Float.isNaN(left) || Float.isNaN(top) || Float.isNaN(bottom)) {
+            /* No insertion marker (a selection): use the composing text's
+             * first character, else keep the last position. */
+            int start = info.getComposingTextStart();
+            RectF r = start >= 0 ? info.getCharacterBounds(start) : null;
+            if (r == null)
+                return;
+            left = r.left;
+            top = r.top;
+            bottom = r.bottom;
+        }
+        RectF rect = new RectF(left, top, left + 1, bottom);
+        Matrix m = info.getMatrix();
+        if (m != null)
+            m.mapRect(rect);
+        if (haveCursor && rect.equals(lastCursor))
+            return;
+        lastCursor.set(rect);
+        haveCursor = true;
+        sendCursor();
+    }
+
+    private void describe(int type) {
+        int cls = type & InputType.TYPE_MASK_CLASS;
+        int variation = type & InputType.TYPE_MASK_VARIATION;
+        switch (cls) {
+            case InputType.TYPE_CLASS_NUMBER:
+                purpose = variation == InputType.TYPE_NUMBER_VARIATION_PASSWORD ? PURPOSE_PIN
+                        : (type & (InputType.TYPE_NUMBER_FLAG_DECIMAL
+                                | InputType.TYPE_NUMBER_FLAG_SIGNED)) != 0 ? PURPOSE_NUMBER
+                        : PURPOSE_DIGITS;
+                if (purpose == PURPOSE_PIN)
+                    hint |= HINT_HIDDEN_TEXT | HINT_SENSITIVE_DATA;
+                return;
+            case InputType.TYPE_CLASS_PHONE:
+                purpose = PURPOSE_PHONE;
+                return;
+            case InputType.TYPE_CLASS_DATETIME:
+                purpose = variation == InputType.TYPE_DATETIME_VARIATION_DATE ? PURPOSE_DATE
+                        : variation == InputType.TYPE_DATETIME_VARIATION_TIME ? PURPOSE_TIME
+                        : PURPOSE_DATETIME;
+                return;
+            default:
+                break;
+        }
+        switch (variation) {
+            case InputType.TYPE_TEXT_VARIATION_PASSWORD:
+            case InputType.TYPE_TEXT_VARIATION_VISIBLE_PASSWORD:
+            case InputType.TYPE_TEXT_VARIATION_WEB_PASSWORD:
+                purpose = PURPOSE_PASSWORD;
+                hint |= HINT_HIDDEN_TEXT | HINT_SENSITIVE_DATA;
+                break;
+            case InputType.TYPE_TEXT_VARIATION_URI:
+                purpose = PURPOSE_URL;
+                break;
+            case InputType.TYPE_TEXT_VARIATION_EMAIL_ADDRESS:
+            case InputType.TYPE_TEXT_VARIATION_WEB_EMAIL_ADDRESS:
+                purpose = PURPOSE_EMAIL;
+                break;
+            case InputType.TYPE_TEXT_VARIATION_PERSON_NAME:
+                purpose = PURPOSE_NAME;
+                break;
+            default:
+                break;
+        }
+        if ((type & InputType.TYPE_TEXT_FLAG_MULTI_LINE) != 0)
+            hint |= HINT_MULTILINE;
+        if ((type & (InputType.TYPE_TEXT_FLAG_CAP_CHARACTERS | InputType.TYPE_TEXT_FLAG_CAP_WORDS
+                | InputType.TYPE_TEXT_FLAG_CAP_SENTENCES)) != 0)
+            hint |= HINT_AUTO_CAPITALIZATION;
+        if ((type & InputType.TYPE_TEXT_FLAG_AUTO_CORRECT) != 0)
+            hint |= HINT_SPELLCHECK;
+        if ((type & InputType.TYPE_TEXT_FLAG_AUTO_COMPLETE) != 0)
+            hint |= HINT_COMPLETION;
+    }
+
+    private void sendFocus() {
+        send(MSG_FOCUS, new int[] {editorActive ? 1 : 0, hint, purpose});
+    }
+
+    private void sendCursor() {
+        send(MSG_CURSOR, new int[] {Math.round(lastCursor.left), Math.round(lastCursor.top),
+                Math.round(lastCursor.right), Math.round(lastCursor.bottom)});
+    }
+
+    private void send(int type, int[] fields) {
+        synchronized (lock) {
+            if (out == null)
+                return;
+            try {
+                ByteArrayOutputStream body = new ByteArrayOutputStream();
+                DataOutputStream d = new DataOutputStream(body);
+                d.writeInt(type);
+                for (int f : fields)
+                    d.writeInt(f);
+                DataOutputStream o = new DataOutputStream(out);
+                o.writeInt(body.size());
+                body.writeTo(o);
+                o.flush();
+            } catch (IOException e) {
+                Log.w(TAG, "send failed: " + e);
+                closeSocketLocked();
+            }
+        }
+    }
+
+    private void closeSocket() {
+        synchronized (lock) {
+            closeSocketLocked();
+        }
+    }
+
+    private void closeSocketLocked() {
+        try {
+            if (socket != null)
+                socket.close();
+        } catch (IOException ignored) {
+        }
+        socket = null;
+        out = null;
+    }
+
+    /* Connects to the composer, retrying while it is not there, and applies
+     * what it sends on the main thread. */
+    private void readLoop() {
+        while (!stopped) {
+            LocalSocket s = new LocalSocket();
+            DataInputStream in;
+            try {
+                s.connect(new LocalSocketAddress(SOCKET, LocalSocketAddress.Namespace.ABSTRACT));
+                in = new DataInputStream(s.getInputStream());
+                synchronized (lock) {
+                    socket = s;
+                    out = s.getOutputStream();
+                }
+            } catch (IOException e) {
+                try {
+                    s.close();
+                } catch (IOException ignored) {
+                }
+                try {
+                    Thread.sleep(1000);
+                } catch (InterruptedException ie) {
+                    return;
+                }
+                continue;
+            }
+            Log.i(TAG, "connected to the composer");
+            main.post(() -> {
+                sendFocus();
+                if (haveCursor)
+                    sendCursor();
+            });
+            try {
+                while (true) {
+                    int len = in.readInt();
+                    if (len < 4 || len > 64 * 1024)
+                        throw new IOException("bad message length " + len);
+                    byte[] buf = new byte[len];
+                    in.readFully(buf);
+                    DataInputStream m = new DataInputStream(new java.io.ByteArrayInputStream(buf));
+                    if (m.readInt() != MSG_DONE)
+                        continue;
+                    final int before = m.readInt();
+                    final int after = m.readInt();
+                    final String commit = readString(m);
+                    final String preedit = readString(m);
+                    m.readInt();
+                    m.readInt();
+                    main.post(() -> apply(before, after, commit, preedit));
+                }
+            } catch (IOException e) {
+                Log.i(TAG, "composer connection closed: " + e);
+            }
+            closeSocket();
+        }
+    }
+
+    private static String readString(DataInputStream m) throws IOException {
+        int n = m.readInt();
+        if (n < 0)
+            return null;
+        byte[] b = new byte[n];
+        m.readFully(b);
+        return new String(b, StandardCharsets.UTF_8);
+    }
+
+    /* The order zwp_text_input_v3.done prescribes: drop the preedit, delete
+     * around the cursor, insert the commit, set the new preedit. */
+    private void apply(int before, int after, String commit, String preedit) {
+        InputConnection ic = getCurrentInputConnection();
+        if (ic == null)
+            return;
+        ic.beginBatchEdit();
+        if (before > 0 || after > 0) {
+            if (composing) {
+                ic.setComposingText("", 1);
+                composing = false;
+            }
+            ic.deleteSurroundingText(
+                    chars(ic.getTextBeforeCursor(before, 0), before, true),
+                    chars(ic.getTextAfterCursor(after, 0), after, false));
+        }
+        if (commit != null) {
+            /* Replaces the composing region, if any. */
+            ic.commitText(commit, 1);
+            composing = false;
+        }
+        if (preedit != null && !preedit.isEmpty()) {
+            ic.setComposingText(preedit, 1);
+            composing = true;
+        } else if (composing) {
+            ic.setComposingText("", 1);
+            composing = false;
+        }
+        ic.endBatchEdit();
+    }
+
+    /* The number of UTF-16 units covering `bytes` UTF-8 bytes, counted away
+     * from the cursor. */
+    private static int chars(CharSequence text, int bytes, boolean beforeCursor) {
+        if (text == null || bytes <= 0)
+            return 0;
+        String s = text.toString();
+        int units = 0;
+        int counted = 0;
+        int i = beforeCursor ? s.length() : 0;
+        while (counted < bytes && (beforeCursor ? i > 0 : i < s.length())) {
+            int cp = beforeCursor ? s.codePointBefore(i) : s.codePointAt(i);
+            int n = Character.charCount(cp);
+            i += beforeCursor ? -n : n;
+            units += n;
+            counted += new String(Character.toChars(cp)).getBytes(StandardCharsets.UTF_8).length;
+        }
+        return units;
+    }
+}
diff --git a/hostime/waydroid-hostime-enable.sh b/hostime/waydroid-hostime-enable.sh
new file mode 100755
index 0000000..d7eca84
--- /dev/null
+++ b/hostime/waydroid-hostime-enable.sh
@@ -0,0 +1,11 @@
+#!/system/bin/sh
+# Enables the host input method bridge and makes it the default unless the
+# user picked another input method than the stock keyboard. Runs as shell:
+# InputMethodManagerService takes "ime" commands only from shell or root.
+ime=id.waydro.hostime/.HostIme
+cmd input_method ime enable "$ime" > /dev/null
+case "$(settings get secure default_input_method)" in
+    "" | null | com.android.inputmethod.latin/*)
+        cmd input_method ime set "$ime" > /dev/null
+        ;;
+esac
