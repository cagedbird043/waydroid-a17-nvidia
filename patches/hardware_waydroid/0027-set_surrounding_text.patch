+    /* zwp_text_input_v3.set_surrounding_text takes less than 4000 bytes; at
+     * most 3 bytes per UTF-16 unit, so these always fit with no selection. */
+    private static final int SURROUNDING_BEFORE = 1000;
+    private static final int SURROUNDING_AFTER = 300;
+    private static final int SURROUNDING_MAX_BYTES = 3999;
 
     private final Handler main = new Handler(Looper.getMainLooper());
     private final Object lock = new Object();
@@ -73,6 +81,13 @@ public class HostIme extends InputMethodService {
     private final RectF lastCursor = new RectF();
     private boolean haveCursor;
     private boolean composing;
+    /* The surrounding text last sent; null when none was (no editor, a
+     * password, composing text in the editor). */
+    private byte[] lastSurrounding;
+    private int lastSurroundingCursor;
+    private int lastSurroundingAnchor;
+    /* apply() changed the editor: the next text change is the input method's. */
+    private boolean imeEdit;
 
     @Override
     public void onCreate() {
@@ -104,6 +119,8 @@ public class HostIme extends InputMethodService {
         super.onStartInput(info, restarting);
