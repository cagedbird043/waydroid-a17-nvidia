+/* Role factories inherit their wrapper's queue without changing the shared
+ * global proxy. Async task-stream creation never uses these wrappers. */
+template <typename T>
+static T *creation_queue_wrapper(struct wl_conn *conn, T *factory)
+{
+    T *wrapper = static_cast<T *>(wl_proxy_create_wrapper(factory));
+    if (!wrapper) {
+        ALOGE("window::create: cannot allocate proxy wrapper");
+        abort();
+    }
+    wl_proxy_set_queue(reinterpret_cast<struct wl_proxy *>(wrapper), conn->create_queue);
+    return wrapper;
+}
+
+static bool hand_to_default_queue(struct window *window)
+{
+    auto *conn = window->conn;
+    while (wl_display_prepare_read_queue(conn->display, conn->create_queue) != 0) {
+        if (wl_display_dispatch_queue_pending(conn->display, conn->create_queue) < 0)
+            return false;
+    }
+    void *proxies[] = {window->xdg_surface, window->xdg_toplevel,
+                       window->decoration, window->shell_surface};
+    for (void *proxy : proxies)
+        if (proxy)
+            wl_proxy_set_queue(static_cast<struct wl_proxy *>(proxy), nullptr);
+    window->creating = false;
+    wl_display_cancel_read(conn->display);
+    return true;
+}
+
+/* Default-queue continuation: the creator no longer waits for this thread.
+ * Copy commands under windowsMutex, then release it before system_server can
+ * wait on SurfaceFlinger. Normal input still asserts focus before injection. */
+static void creation_done(void *data, struct wl_callback *callback, uint32_t)
+{
+    auto *conn = static_cast<struct wl_conn *>(data);
+    auto *display = conn->dpy;
+    bool focus, resize, close;
+    int task = -1;
+    hwc_rect_t bounds{};
+    close_action action;
+    {
+        std::scoped_lock lock(display->windowsMutex);
+        auto pending = conn->creation_continuations.find(callback);
+        /* The window destructor may have cancelled an already-entered
+         * callback while it was waiting for this lock. */
+        if (pending == conn->creation_continuations.end())
+            return;
+        auto *window = pending->second;
+        conn->creation_continuations.erase(pending);
+        window->creation_done = nullptr;
+        wl_callback_destroy(callback);
+        focus = window->creation_focus_pending && window->activated;
+        resize = window->creation_resize_pending;
+        close = window->creation_close_pending;
+        if (window->taskID != "0" && window->taskID != "none")
+            task = stoi(window->taskID);
+        bounds = window->target;
+        if (close)
+            action = close_window_locked(window);
+    }
+    if (close) {
+        perform_close(display, action);
+        return;
+    }
+    if (task >= 0 && resize)
+        display->task_ctl->resize(task, bounds);
+    if (task >= 0 && focus) {
+        force_screen_wakeup(display);
+        display->task_ctl->focus(task);
+    }
+}
+
+static const struct wl_callback_listener creation_done_listener = {creation_done};
+static void resume_created_window(struct window *window)
+{
+    if (!window->creation_focus_pending && !window->creation_resize_pending && !window->creation_close_pending)
+        return;
+    auto *conn = window->conn;
+    window->creation_done = wl_display_sync(conn->display);
+    conn->creation_continuations.emplace(window->creation_done, window);
+    wl_callback_add_listener(window->creation_done, &creation_done_listener, conn);
+    wl_display_flush(conn->display);
+}
