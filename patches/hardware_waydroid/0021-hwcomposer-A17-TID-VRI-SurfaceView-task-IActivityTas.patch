+namespace {
+
+/* SystemUI and shell windows drawn through ViewRootImpl. They belong to no app
+ * task, so they must not fall back to the focused task's card. */
+bool is_system_window_title(const std::string &title) {
+    static const char *const prefixes[] = {
+        "StatusBar", "NotificationShade", "NavigationBar", "Taskbar", "ScreenDecorOverlay",
+        "InputMethod", "ShellDropTarget", "VolumeDialog", "Wallpaper",
+    };
+    for (const char *prefix : prefixes)
+        if (title.rfind(prefix, 0) == 0)
+            return true;
+    return false;
+}
+
+/* "<pkg>/<activity>" as WM titles an activity window; false for anything else. */
+bool split_component_title(const std::string &title, std::string &pkg, std::string &activity) {
+    const auto slash = title.find('/');
+    if (slash == std::string::npos || slash == 0 || slash + 1 == title.size())
+        return false;
+    pkg = title.substr(0, slash);
+    if (pkg.find('.') == std::string::npos || pkg.find(' ') != std::string::npos)
+        return false;
+    activity = title.substr(slash + 1);
+    return true;
+}
+
+/* Activity class of a WMS component ("pkg/.Cls" or "pkg/pkg.Cls"), fully qualified. */
+std::string component_class(const std::string &component, const std::string &pkg) {
+    const auto slash = component.find('/');
+    std::string cls = slash == std::string::npos ? component : component.substr(slash + 1);
+    return !cls.empty() && cls[0] == '.' ? pkg + cls : cls;
+}
+
+/* The platform patch prefixes "TID:<id>#" to the WindowStateAnimator surface,
+ * which A17 no longer creates: the buffer is posted on ViewRootImpl's BLAST
+ * child ("VRI-<pkg>/<activity>") or a SurfaceView ("SurfaceView[<pkg>/<activity>]"),
+ * neither of which names its task. Recover the task from the WMS task events.
+ * Windows titled without a package (PopupWindow:<hash>, dialogs, toasts) are
+ * drawn by the app in front, so they go to the focused task.
+ * Called with display->windowsMutex held. */
+void resolve_task(const struct display &disp, layer_info &info) {
+    std::string title = info.aid;
+    const bool vri = title.rfind("VRI-", 0) == 0;
+    if (vri) {
+        title.erase(0, 4);
+        info.aid = title;
+    }
+    const auto surface_view = title.find("SurfaceView[");
+    if (surface_view != std::string::npos) {
+        const auto open = surface_view + 12;
+        const auto close = title.find(']', open);
+        title = title.substr(open, close == std::string::npos ? std::string::npos : close - open);
+    }
+
+    const std::pair<const std::string, task_info> *best = nullptr;
+    std::string pkg, activity;
+    if (split_component_title(title, pkg, activity)) {
+        int best_score = -1;
+        for (const auto &entry : disp.tasks) {
+            const auto &task = entry.second;
+            if (task.appID != pkg)
+                continue;
+            int score = (!task.closing ? 4 : 0)
+                    + (component_class(task.component, pkg) == activity ? 2 : 0)
+                    + (task.focused ? 1 : 0);
+            if (score > best_score
+                    || (score == best_score && std::stoul(entry.first) > std::stoul(best->first))) {
+                best = &entry;
+                best_score = score;
+            }
+        }
+    } else if (vri && !is_system_window_title(title)) {
+        for (const auto &entry : disp.tasks) {
+            if (entry.second.focused && !entry.second.closing && !entry.second.appID.empty()) {
+                best = &entry;
+                break;
+            }
+        }
+        if (best)
+            pkg = best->second.appID;
+    }
+    if (!best)
+        return;
+    info.type = LayerSplitType::TID;
+    info.tid = best->first;
+    info.aid = pkg;
+    info.component = activity;
+}
+
+}  // namespace
+
 void split_layer_names_helper::setup(waydroid_hwc_composer_device_1 *pdev, const hwc_layer_1 *layers, size_t count_of_layers) {
     layer_infos.reserve(count_of_layers);
     for (size_t l = 0; l < count_of_layers; l++) {
@@ -150,6 +242,14 @@ void split_layer_names_helper::setup(waydroid_hwc_composer_device_1 *pdev, const
         }();
         layer_infos.push_back(split_layer_name(name));
     }
+
+    auto *disp = pdev->display;
+    std::scoped_lock lock(disp->windowsMutex);
+    if (!disp->task_events_seen)
+        return;
+    for (auto &info : layer_infos)
+        if (info.type == LayerSplitType::RawName)
+            resolve_task(*disp, info);
 }
 
