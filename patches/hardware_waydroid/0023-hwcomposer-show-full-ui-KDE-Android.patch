 hwcomposer/modes/multi-window.cpp  | 14 ++++++
 hwcomposer/modes/waydroid_mode.cpp | 21 +++++---
 hwcomposer/wayland-hwc.cpp         | 78 ++++++++++++++++++++++++++----
 hwcomposer/wayland-hwc.h           |  8 +++
 5 files changed, 121 insertions(+), 16 deletions(-)

