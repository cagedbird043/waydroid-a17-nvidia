+        /* While the desktop is open an app the host launches belongs in it:
+         * the system service switched to that app's card, so switch back and
+         * bring the desktop up instead. Closing the desktop drops its window
+         * before naming an app, so that switch is left alone. */
+        if (pdev->multi_windows && pdev->display->freeform
+                && active_apps != "none" && active_apps != "Waydroid") {
+            std::scoped_lock lock(pdev->display->windowsMutex);
+            auto desktop = pdev->display->windows.find("Waydroid");
+            if (desktop != pdev->display->windows.end()) {
+                ALOGI("desktop open: %s stays in it", active_apps.c_str());
+                property_set("waydroid.active_apps", "Waydroid");
+                request_window_activation(desktop->second.get());
+                active_apps = "Waydroid";
+            }
+        }
+
         /*
          * In prop "persist.waydroid.multi_windows" we detect HWC let SF render layers
          * And just show the target client layer (single windows mode) or
