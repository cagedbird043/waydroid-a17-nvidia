diff --git a/hwcomposer/WaydroidClipboard.cpp b/hwcomposer/WaydroidClipboard.cpp
index 34623c4..39cd803 100644
--- a/hwcomposer/WaydroidClipboard.cpp
+++ b/hwcomposer/WaydroidClipboard.cpp
@@ -27,6 +27,12 @@
 
 #include <wayland-client.h>
 
+bool clipboard_debug_enabled() {
+    static const bool enabled =
+        property_get_bool("persist.waydroid.clipboard_debug", false);
+    return enabled;
+}
+
 static const std::vector<std::string> MIME_TYPES = {
     "text/plain;charset=utf-8",
     "UTF8_STRING",
@@ -38,6 +44,7 @@ static const std::vector<std::string> MIME_TYPES = {
 static void data_source_handle_send(void *data, struct wl_data_source *, const char *mime_type, int fd) {
     // An application wants to paste the clipboard contents
     const char *text = (const char *)data;
+    CLIPLOG("clipboard: host asked for our selection as %s", mime_type);
     if (std::find(MIME_TYPES.begin(), MIME_TYPES.end(), mime_type) != MIME_TYPES.end())
         write(fd, text, strlen((char *)text));
     else
@@ -47,6 +54,8 @@ static void data_source_handle_send(void *data, struct wl_data_source *, const c
 
 static void data_source_handle_cancelled(void *data, struct wl_data_source *source) {
     // An application has replaced the clipboard contents
+    CLIPLOG("clipboard: our selection was cancelled — replaced by another client, "
+            "or the serial we quoted predates the current selection's");
     wl_data_source_destroy(source);
     free(data);
 }
@@ -78,23 +87,38 @@ static void read_selection(struct wl_conn *conn, struct wl_data_offer *offer, co
      */
     wl_display_roundtrip(conn->display);
 
-    // Read the clipboard contents
-    std::string contents;
+    // Read the clipboard contents into a scratch buffer, NOT straight into
+    // display->clipboard: this read can fail, and a failed read must not be
+    // allowed to destroy the contents we already have.
+    std::string received;
     while (true) {
         char buf[1024];
         ssize_t n = read(fds[0], buf, sizeof(buf));
         if (n <= 0)
             break;
-        contents.append(buf, n);
+        received.append(buf, n);
     }
 
-    // Keep what we have if the host handed us nothing, so a failed handshake
-    // doesn't wipe a clip an Android app just set.
-    if (!contents.empty())
-        display->clipboard = contents;
-
     close(fds[0]);
     wl_data_offer_destroy(offer);
+
+    /* An offer that advertised a text mime type but then transferred nothing
+     * means the handshake was torn down before the source could write. The
+     * common cause is losing keyboard focus while this blocking read is in
+     * flight (the roundtrip above dispatches the wl_keyboard.leave, and the
+     * compositor invalidates our offer with it) — and because the selection is
+     * re-delivered on every focus enter, a focus flicker is enough to hit it.
+     * Committing the empty result there leaves the guest with a clipboard that
+     * is empty forever: keep what we had instead. */
+    if (received.empty()) {
+        CLIPLOG("clipboard: host selection transferred 0 bytes as %s, keeping the "
+                "previous %zu bytes", mime_type.c_str(), display->clipboard.size());
+        return;
+    }
+
+    display->clipboard = std::move(received);
+    CLIPLOG("clipboard: read %zu bytes of host selection as %s",
+            display->clipboard.size(), mime_type.c_str());
 }
 
 static void data_device_handle_selection(void *data, struct wl_data_device *, struct wl_data_offer *offer) {
@@ -204,13 +228,14 @@ Return<void> WaydroidClipboard::sendClipboardData(const hidl_string& in) {
     wl_data_source_add_listener(source, &data_source_listener, strdup(in.c_str()));
     for (auto mime_type : MIME_TYPES)
         wl_data_source_offer(source, mime_type.c_str());
-    wl_data_device_set_selection(conn->data_device, source, conn->keyboard_enter_serial);
+    wl_data_device_set_selection(conn->data_device, source, conn->last_input_serial);
     wl_display_flush(conn->display);
 
     return Void();
 }
 
 Return<void> WaydroidClipboard::getClipboardData(getClipboardData_cb out_cb) {
+    CLIPLOG("clipboard: guest read %zu bytes", mDisplay->clipboard.size());
     out_cb(mDisplay->clipboard);
     return Void();
 }
diff --git a/hwcomposer/gralloc_handler.cpp b/hwcomposer/gralloc_handler.cpp
index 4fd087b..83e11a0 100644
--- a/hwcomposer/gralloc_handler.cpp
+++ b/hwcomposer/gralloc_handler.cpp
@@ -25,6 +25,7 @@
 
 #include "gralloc_handler.h"
 
+#include <algorithm>
 #include <cstdint>
 #include <memory>
 
@@ -168,6 +169,32 @@ namespace {
         return fmt;
     }
 }
+namespace {
+bool compositor_supports(wl_conn *conn, uint32_t drm_format, uint64_t modifier) {
+    if (modifier == DRM_FORMAT_MOD_INVALID)
+        return false;
+    auto it = conn->modifiers.find(drm_format);
+    if (it == conn->modifiers.end())
+        return false;
+    const auto &mods = it->second;
+    return std::find(mods.begin(), mods.end(), modifier) != mods.end();
+}
+
+/* Alpha-carrying fourcc -> layout-identical alpha-ignoring fourcc. Used for
+ * HWC_BLENDING_NONE layers: their buffers' alpha channel is undefined and the
+ * compositor must not blend it (SurfaceFlinger doesn't). */
+uint32_t drm_format_strip_alpha(uint32_t format) {
+    switch (format) {
+        case DRM_FORMAT_ABGR8888:       return DRM_FORMAT_XBGR8888;
+        case DRM_FORMAT_ARGB8888:       return DRM_FORMAT_XRGB8888;
+        case DRM_FORMAT_ABGR2101010:    return DRM_FORMAT_XBGR2101010;
+        case DRM_FORMAT_ARGB2101010:    return DRM_FORMAT_XRGB2101010;
+        case DRM_FORMAT_ABGR16161616F:  return DRM_FORMAT_XBGR16161616F;
+        default:                        return format;
+    }
+}
+}
+
 std::unique_ptr<buffer> create_dmabuf_wl_buffer(wl_conn *conn, const buffer_metadata& metadata,
                                                                 int prime_fd, int drm_format, int byte_stride,
                                                                 int offset, uint64_t modifier, buffer_handle_t handle)
@@ -185,6 +212,15 @@ std::unique_ptr<buffer> create_dmabuf_wl_buffer(wl_conn *conn, const buffer_meta
     }
     assert(drm_format >= 0);
 
+    if (metadata.opaque) {
+        uint32_t stripped = drm_format_strip_alpha((uint32_t)drm_format);
+        /* only if the compositor advertises the X-variant with this modifier */
+        if (stripped != (uint32_t)drm_format
+            && compositor_supports(conn, stripped, modifier)) {
+            drm_format = (int)stripped;
+        }
+    }
+
     zwp_linux_buffer_params_v1 *params = zwp_linux_dmabuf_v1_create_params(conn->dmabuf);
     zwp_linux_buffer_params_v1_add(params, prime_fd, 0, offset, byte_stride, modifier >> 32, modifier & 0xffffffff);
     zwp_linux_buffer_params_v1_add_listener(params, &params_listener, nullptr);
@@ -464,7 +500,39 @@ gralloc_handler::update_shm_buffer_func gralloc_handler::select_update_shm_buffe
     }
 }
 
+namespace {
+bool displayable_buffer_cros(wl_conn *conn, buffer_handle_t handle) {
+    auto *cros_handle = reinterpret_cast<const cros_gralloc_handle *>(handle);
+    return compositor_supports(conn, cros_handle->format,
+                               cros_handle->format_modifier);
+}
+
+bool displayable_buffer_gbm(wl_conn *conn, buffer_handle_t handle) {
+    auto *drm_handle = reinterpret_cast<const gralloc_handle_t *>(handle);
+    int drm_format = ConvertHalFormatToDrm(conn, drm_handle->format);
+    if (drm_format < 0)
+        return false;
+    return compositor_supports(conn, (uint32_t)drm_format, drm_handle->modifier);
+}
+
+/* android_wlegl / wl_shm transports have no dmabuf format negotiation */
+bool displayable_buffer_always(wl_conn *, buffer_handle_t) {
+    return true;
+}
+}
+
+gralloc_handler::displayable_buffer_func gralloc_handler::select_displayable_buffer_impl(wl_conn *conn, GrallocType gralloc_type) {
+    if (gralloc_type == GrallocType::GRALLOC_GBM && conn->dmabuf) {
+        return displayable_buffer_gbm;
+    } else if (gralloc_type == GrallocType::GRALLOC_CROS && conn->dmabuf) {
+        return displayable_buffer_cros;
+    } else {
+        return displayable_buffer_always;
+    }
+}
+
 gralloc_handler::gralloc_handler(display *display)
     : get_buffer_metadata_impl(select_get_buffer_metadata_impl(display->gtype))
     , create_buffer_impl(select_create_buffer_impl(display->ctl.get(), display->gtype))
-    , update_shm_buffer_impl(select_update_shm_buffer_impl(display->gtype)) { }
+    , update_shm_buffer_impl(select_update_shm_buffer_impl(display->gtype))
+    , displayable_buffer_impl(select_displayable_buffer_impl(display->ctl.get(), display->gtype)) { }
