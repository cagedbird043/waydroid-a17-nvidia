+#include <hardware/hwcomposer.h>
+
+#include <condition_variable>
+#include <cstdint>
+#include <map>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+/* Drives ActivityTaskManager and WindowManager through the platform's own
+ * shell commands ("cmd activity ...", "cmd window ...").
+ *
+ * The task service in the system image reaches ActivityTaskManager with
+ * hand-numbered binder transactions, which go stale whenever the platform
+ * AIDL gains a method (on Android 17 its setFocusedTask lands on removeTask).
+ * The composer cannot make those calls itself either: vendor libbinder
+ * stamps its own interface-token header and refuses system-stability
+ * binders. The shell commands run the same ActivityTaskManager methods and
+ * follow the platform across releases.
+ *
+ * focus/remove/clear_recents run synchronously on the caller's thread (a
+ * fork+exec of /system/bin/cmd, ~15 ms): an activation must reorder Android's
+ * tasks before the click that caused it is injected. The rest run on a worker
+ * thread, because their callers hold windowsMutex or sit inside hwc_set. */
+class task_control {
+  public:
+    task_control();
+    ~task_control();
+
+    bool focus(uint32_t task_id);
+    bool remove(uint32_t task_id);
+    bool clear_recents();
+
+    /* Asynchronous; a newer request for the same task replaces a queued one,
+     * so an interactive host resize sends only the sizes the worker gets to. */
+    void resize(uint32_t task_id, const hwc_rect_t &bounds);
+
+    /* Asynchronous; retried until system_server answers, since the composer
+     * starts long before it. freeform puts every task launched on the
+     * default display into a freeform window of its own. */
+    void set_display_freeform(bool freeform);
+
+    /* Asynchronous. A task launched while WMShell's desk is inactive comes up
+     * fullscreen even on a freeform display; this moves it into the desk,
+     * which also activates the desk for the launches after it. */
+    void move_to_desk(uint32_t task_id);
+
+  private:
+    void worker();
+    int desk_id();
+    int fresh_desk_id();
+
+    std::mutex mutex;
+    std::condition_variable cond;
+    std::map<uint32_t, hwc_rect_t> pending_resizes;
+    std::vector<uint32_t> pending_desk_moves;
+    int pending_display_mode = -1;
+    /* Worker thread only: the desks restored from the last session are gone. */
+    bool desks_reset = false;
+    bool quit = false;
+    std::thread thread;
+};
