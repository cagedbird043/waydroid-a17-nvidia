+/* Height added to the host output for the freeform display, in host logical
+ * pixels: the status bar, the taskbar and a task's caption take ~260 Android
+ * pixels at the default density, and a card maximized on the host must still
+ * fit below the first and above the second. */
+static constexpr int kFreeformHeadroom = 200;
+
+void
+freeform_display_size(struct display *display)
+{
+    if (!display->freeform || display->full_width <= 0 || display->full_height <= 0
+            || display->scale <= 0)
+        return;
+    const int width = floor(display->full_width / display->scale);
+    const int height = floor(display->full_height / display->scale) + kFreeformHeadroom;
+    if (display->width == width && display->height == height)
+        return;
+    ALOGI("freeform: Android display %dx%d -> %dx%d", display->width, display->height,
+          width, height);
+    display->width = width;
+    display->height = height;
+    publish_display_size(display);
+    display_resize_arm(display, floor(width * display->scale), floor(height * display->scale));
+    display->want_frame.store(true);
+}
+
+bool
+window::is_freeform_card() const
+{
+    return conn->dpy->freeform && conn->is_ctl && taskID != "0" && taskID != "none";
+}
+
+static int32_t
+rect_width(const hwc_rect_t &r)
+{
+    return r.right - r.left;
+}
+
+static int32_t
+rect_height(const hwc_rect_t &r)
+{
+    return r.bottom - r.top;
+}
+
+static bool
+rects_intersect(const hwc_rect_t &a, const hwc_rect_t &b)
+{
+    return a.left < b.right && b.left < a.right && a.top < b.bottom && b.top < a.bottom;
+}
+
+static bool
+rects_equal(const hwc_rect_t &a, const hwc_rect_t &b)
+{
+    return a.left == b.left && a.top == b.top && a.right == b.right && a.bottom == b.bottom;
+}
+
+/* Gives the card's toplevel the given host logical size. */
+static void
+freeform_set_window_size(struct window *window, int32_t width, int32_t height)
+{
+    if (window->bg_buffer && window->viewport)
+        wp_viewport_set_destination(window->viewport, width, height);
+    if (window->xdg_surface)
+        xdg_surface_set_window_geometry(window->xdg_surface, 0, 0, width, height);
+}
+
+static void
+freeform_set_content(struct window *window, const hwc_rect_t &content)
+{
+    if (rects_equal(window->content, content))
+        return;
+    struct display *display = window->conn->dpy;
+    window->content = content;
+
+    int32_t width = std::max(1, (int32_t)ceil(rect_width(content) / display->scale));
+    int32_t height = std::max(1, (int32_t)ceil(rect_height(content) / display->scale));
+    /* The task took the size the host configured, up to rounding: keep the
+     * host's exact size so the compositor sees no size change. Otherwise the
+     * task was clamped or resized from the Android side, and the card follows
+     * it. */
+    if (window->host_width > 0 && abs(width - window->host_width) <= 1
+            && abs(height - window->host_height) <= 1) {
+        width = window->host_width;
+        height = window->host_height;
+    } else {
+        window->host_width = window->host_height = 0;
+    }
+    freeform_set_window_size(window, width, height);
+    /* Only a task nobody has sized yet takes its bounds from the frames: a
+     * resize in flight passes through sizes that must not claim space. */
+    if (rect_width(window->target) <= 0)
+        window->target = { content.left, content.top - display->caption_height, content.right,
+                           content.bottom };
+    /* Input on the toplevel itself (not a layer) is surface-local too. */
+    window->conn->layers[window->surface] = { .x = content.left, .y = content.top };
+    ALOGI("freeform: card %s#%s shows [%d,%d %dx%d] as %dx%d", window->appID.c_str(),
+          window->taskID.c_str(), content.left, content.top, rect_width(content),
+          rect_height(content), width, height);
+}
+
+/* Task bounds (caption included) of the given size at a spot no other card
+ * covers, preferring where the task already is. Android pixels. */
+static hwc_rect_t
+freeform_bounds(struct window *window, int32_t width, int32_t height)
+{
+    struct display *display = window->conn->dpy;
+    const int32_t caption = display->caption_height;
+    const int32_t disp_w = floor(display->width * display->scale);
+    const int32_t disp_h = floor(display->height * display->scale);
+    const hwc_rect_t usable = { 0, display->reserved_top, disp_w, disp_h - display->reserved_bottom };
+    width = std::clamp(width, 1, std::max(1, rect_width(usable)));
+    height = std::clamp(height, 1, std::max(1, rect_height(usable)));
+
+    std::vector<hwc_rect_t> taken;
+    for (const auto &[key, other] : display->windows) {
+        (void)key;
+        if (other.get() != window && other->is_freeform_card() && rect_width(other->target) > 0)
+            taken.push_back(other->target);
+    }
+    auto fits = [&](int32_t x, int32_t y) {
+        const hwc_rect_t b = { x, y, x + width, y + height };
+        if (b.left < usable.left || b.top < usable.top || b.right > usable.right
+                || b.bottom > usable.bottom)
+            return false;
+        for (const auto &t : taken)
+            if (rects_intersect(b, t))
+                return false;
+        return true;
+    };
+
+    int32_t x = usable.left, y = usable.top;
+    if (rect_width(window->target) > 0) {
+        x = window->target.left;
+        y = window->target.top;
+    }
+    if (!fits(x, y)) {
+        constexpr int32_t kStep = 32;
+        bool found = false;
+        for (int32_t cy = usable.top; !found && cy + height <= usable.bottom; cy += kStep)
+            for (int32_t cx = usable.left; !found && cx + width <= usable.right; cx += kStep)
+                if (fits(cx, cy)) {
+                    x = cx;
+                    y = cy;
+                    found = true;
+                }
+        /* Nowhere free: stay put, inside the usable area. Overlapping tasks
+         * still work, the focused one gets the input where they overlap. */
+        if (!found) {
+            x = std::clamp(x, usable.left, std::max(usable.left, usable.right - width));
+            y = std::clamp(y, usable.top, std::max(usable.top, usable.bottom - height));
+        }
+    }
+    return { x, y, x + width, y + height };
+}
+
+static void
+freeform_place_card(struct window *window)
+{
+    if (window->placed || rect_width(window->content) <= 0)
+        return;
+    window->placed = true;
+    struct display *display = window->conn->dpy;
+    const hwc_rect_t &c = window->content;
+    const hwc_rect_t b = freeform_bounds(window, rect_width(c), rect_height(c) + display->caption_height);
+    if (b.left == c.left && b.top == c.top - display->caption_height
+            && rect_width(b) == rect_width(c)
+            && rect_height(b) == rect_height(c) + display->caption_height)
+        return;
+    ALOGI("freeform: placing task %s at [%d,%d %dx%d]", window->taskID.c_str(), b.left, b.top,
+          rect_width(b), rect_height(b));
+    window->target = b;
+    display->task_ctl->resize(stoi(window->taskID), b);
+}
+
+/* Frames a new content area must hold still before a card takes it. */
+static constexpr int kFreeformStableFrames = 3;
+
+void
+freeform_observe_content(struct window *window, const hwc_rect_t &content, bool fullscreen)
+{
+    struct display *display = window->conn->dpy;
+    if (fullscreen) {
+        /* Shown at display size it would cover the host; it gets a card
+         * size once it is a freeform window in the desk. */
+        if (!window->desk_requested) {
+            window->desk_requested = true;
+            display->task_ctl->move_to_desk(stoi(window->taskID));
+        }
+        window->pending_content_frames = 0;
+        return;
+    }
+    if (rects_equal(content, window->content)) {
+        window->pending_content_frames = 0;
+        return;
+    }
+    if (window->pending_content_frames > 0 && rects_equal(content, window->pending_content)) {
+        window->pending_content_frames++;
+    } else {
+        window->pending_content = content;
+        window->pending_content_frames = 1;
+    }
+    if (window->pending_content_frames < kFreeformStableFrames) {
+        /* The animation may end on this very frame and the task go idle:
+         * keep frames coming until the area is adopted. */
+        display->want_frame.store(true);
+        return;
+    }
+    window->pending_content_frames = 0;
+    freeform_set_content(window, content);
+    freeform_place_card(window);
+}
+
+void
+freeform_request_size(struct window *window, int32_t width, int32_t height)
+{
+    if (width <= 0 || height <= 0)
+        return;
+    if (width == rect_width(window->content) && height == rect_height(window->content))
+        return;
+    if (width == window->requested_width && height == window->requested_height)
+        return;
+    window->requested_width = width;
+    window->requested_height = height;
+    window->placed = true;
+    struct display *display = window->conn->dpy;
+    const hwc_rect_t b = freeform_bounds(window, width, height + display->caption_height);
+    ALOGI("freeform: host sized task %s to %dx%d -> bounds [%d,%d %dx%d]",
+          window->taskID.c_str(), width, height, b.left, b.top, rect_width(b), rect_height(b));
+    window->target = b;
+    display->task_ctl->resize(stoi(window->taskID), b);
+}
