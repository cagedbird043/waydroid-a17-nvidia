+/* What WMShell laid out, read off this frame: a freeform task's caption
+ * ("Caption of Task=<id>") sits on top of its bounds and the app's windows fill
+ * the rest, so the content area runs from the caption's bottom edge to the
+ * lowest of the task's layers. Without a caption (a task not in the desk) it
+ * is just the extent of the task's layers. Also takes the bands of the status
+ * bar and the taskbar, which tasks must stay clear of. */
+void multi_window_mode::observe_freeform(waydroid_hwc_composer_device_1 *pdev,
+                                         hwc_display_contents_1_t *contents) {
+    auto *display = pdev->display;
+    static const std::string kCaption = "Caption of Task=";
+    const int32_t disp_h = floor(display->height * display->scale);
+    std::map<std::string, hwc_rect_t> captions, extents;
+    for (size_t i = 0; i < contents->numHwLayers; ++i) {
+        const hwc_layer_1 &layer = contents->hwLayers[i];
+        if (layer.compositionType == HWC_FRAMEBUFFER_TARGET)
+            continue;
+        const auto &info = layer_infos[i];
+        const hwc_rect_t &f = layer.displayFrame;
+        /* Popups (menus, the text toolbar) are drawn within the task but sized
+         * by their own content; only the activity's windows give its area. */
+        if (info.type == LayerSplitType::TID && !info.component.empty()) {
+            auto [it, fresh] = extents.emplace(info.tid, f);
+            if (!fresh) {
+                it->second.left = std::min(it->second.left, f.left);
+                it->second.top = std::min(it->second.top, f.top);
+                it->second.right = std::max(it->second.right, f.right);
+                it->second.bottom = std::max(it->second.bottom, f.bottom);
+            }
+        } else if (info.type == LayerSplitType::RawName) {
+            std::string name = info.aid;
+            if (name.rfind("VRI-", 0) == 0)
+                name.erase(0, 4);
+            if (name.rfind(kCaption, 0) == 0) {
+                captions[name.substr(kCaption.size())] = f;
+                display->caption_height = f.bottom - f.top;
+            } else if (name == "StatusBar") {
+                display->reserved_top = f.bottom;
+            } else if (name == "Taskbar" && f.bottom >= disp_h - 1) {
+                display->reserved_bottom = disp_h - f.top;
+            }
+        }
+    }
+    for (const auto &[tid, extent] : extents) {
+        auto cap = captions.find(tid);
+        if (cap == captions.end()) {
+            task_content[tid] = { extent, false };
+            continue;
+        }
+        const hwc_rect_t &c = cap->second;
+        /* A fullscreen task carries only a handle, far narrower than it. */
+        if ((c.right - c.left) * 2 < extent.right - extent.left)
+            task_content[tid] = { extent, true };
+        else if (extent.bottom > c.bottom)
+            task_content[tid] = { { c.left, c.bottom, c.right, extent.bottom }, false };
+    }
+}
