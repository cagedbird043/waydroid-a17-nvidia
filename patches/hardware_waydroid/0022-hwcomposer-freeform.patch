+
+/* WindowConfiguration.WINDOWING_MODE_* */
+constexpr int kWindowingModeFullscreen = 1;
+constexpr int kWindowingModeFreeform = 5;
+
+/* How long set_display_freeform keeps retrying while system_server is not up. */
+constexpr int kDisplayModeAttempts = 180;
+
+/* Runs /system/bin/<tool> with the given arguments and waits for it. Its
+ * output is collected into *out, or dropped when out is null ("Setting focus
+ * to task N"). Returns false when the tool could not run or exited non-zero. */
+bool run_tool(const char *tool, std::vector<std::string> args, std::string *out = nullptr,
+              bool quiet = false) {
+    args.insert(args.begin(), tool);
+    std::vector<char *> argv;
+    for (auto &arg : args)
+        argv.push_back(arg.data());
+    argv.push_back(nullptr);
+
+    std::string line;
+    for (size_t i = 0; i < args.size(); i++)
+        line += (i > 0 ? " " : "") + args[i];
+
+    int pipe_fds[2] = {-1, -1};
+    if (out && pipe2(pipe_fds, O_CLOEXEC) != 0) {
+        ALOGE("%s: pipe failed: %s", line.c_str(), strerror(errno));
+        return false;
+    }
+    posix_spawn_file_actions_t actions;
+    posix_spawn_file_actions_init(&actions);
+    posix_spawn_file_actions_addopen(&actions, STDIN_FILENO, "/dev/null", O_RDONLY, 0);
+    if (out)
+        posix_spawn_file_actions_adddup2(&actions, pipe_fds[1], STDOUT_FILENO);
+    else
+        posix_spawn_file_actions_addopen(&actions, STDOUT_FILENO, "/dev/null", O_WRONLY, 0);
+    posix_spawn_file_actions_addopen(&actions, STDERR_FILENO, "/dev/null", O_WRONLY, 0);
+    const std::string path = std::string("/system/bin/") + tool;
+    pid_t pid;
+    int err = posix_spawn(&pid, path.c_str(), &actions, nullptr, argv.data(), environ);
+    posix_spawn_file_actions_destroy(&actions);
+    if (out)
+        close(pipe_fds[1]);
+    if (err != 0) {
+        ALOGE("%s: spawn failed: %s", line.c_str(), strerror(err));
+        if (out)
+            close(pipe_fds[0]);
+        return false;
+    }
+
+    if (out) {
+        out->clear();
+        char buf[4096];
+        ssize_t n;
+        while ((n = read(pipe_fds[0], buf, sizeof(buf))) != 0) {
+            if (n < 0) {
+                if (errno == EINTR)
+                    continue;
+                break;
+            }
+            out->append(buf, n);
+        }
+        close(pipe_fds[0]);
+    }
+
+    int status;
+    while (waitpid(pid, &status, 0) < 0) {
+        if (errno != EINTR) {
+            ALOGE("%s: waitpid failed: %s", line.c_str(), strerror(errno));
+            return false;
+        }
+    }
+    if (!WIFEXITED(status) || WEXITSTATUS(status) != 0) {
+        if (!quiet)
+            ALOGE("%s: failed (status 0x%x)", line.c_str(), status);
+        return false;
+    }
+    return true;
+}
+
+bool run_cmd(std::vector<std::string> args, bool quiet = false) {
+    return run_tool("cmd", std::move(args), nullptr, quiet);
+}
+
+}  // namespace
+
+task_control::task_control() : thread(&task_control::worker, this) {}
+
+task_control::~task_control() {
+    {
+        std::scoped_lock lock(mutex);
+        quit = true;
+    }
+    cond.notify_one();
+    thread.join();
+}
+
+bool task_control::focus(uint32_t task_id) {
+    return run_cmd({"activity", "task", "focus", std::to_string(task_id)});
+}
+
+bool task_control::remove(uint32_t task_id) {
+    return run_cmd({"activity", "stack", "remove", std::to_string(task_id)});
+}
+
+bool task_control::clear_recents() {
+    return run_cmd({"activity", "clear-recent-apps"});
+}
+
+void task_control::resize(uint32_t task_id, const hwc_rect_t &bounds) {
+    {
+        std::scoped_lock lock(mutex);
+        pending_resizes[task_id] = bounds;
+    }
+    cond.notify_one();
+}
+
+void task_control::set_display_freeform(bool freeform) {
+    {
+        std::scoped_lock lock(mutex);
+        pending_display_mode = freeform ? kWindowingModeFreeform : kWindowingModeFullscreen;
+    }
+    cond.notify_one();
+}
+
+void task_control::move_to_desk(uint32_t task_id) {
+    {
+        std::scoped_lock lock(mutex);
+        if (std::find(pending_desk_moves.begin(), pending_desk_moves.end(), task_id)
+                == pending_desk_moves.end())
+            pending_desk_moves.push_back(task_id);
+    }
+    cond.notify_one();
+}
+
+/* WMShell's desktop-mode shell command (DesktopModeShellCommandHandler). */
+static bool desktopmode(std::vector<std::string> args) {
+    args.insert(args.begin(), {"activity", "service", "SystemUIService", "WMShell", "desktopmode"});
+    return run_tool("dumpsys", std::move(args));
+}
+
+/* The id of WMShell's desk on the default display: the root task named
+ * "Desk" ("Task{... #6 name=Desk ..."). WMShell's own getActiveDeskId is not
+ * implemented on this platform. Worker thread only. */
+int task_control::desk_id() {
+    std::string out;
+    if (!run_tool("dumpsys", {"activity", "activities"}, &out))
+        return -1;
+    static const std::string kName = " name=Desk ";
+    const size_t name = out.find(kName);
+    if (name == std::string::npos)
+        return -1;
+    const size_t hash = out.rfind('#', name);
+    if (hash == std::string::npos)
+        return -1;
+    return atoi(out.c_str() + hash + 1);
+}
+
+/* The desk Android restored at boot still holds the previous session's
+ * windows, and activating it would bring every one of them back as a card
+ * nobody opened. Start the session from a fresh, empty desk instead.
+ * Worker thread only. */
+int task_control::fresh_desk_id() {
+    if (!desks_reset) {
+        desks_reset = true;
+        ALOGI("WMShell: replacing the desks restored from the last session");
+        desktopmode({"removeAllDesks"});
+        desktopmode({"createDesk", "0"});
+    }
+    int desk = desk_id();
+    if (desk < 0) {
+        desktopmode({"createDesk", "0"});
+        desk = desk_id();
+    }
+    return desk;
+}
+
+void task_control::worker() {
+    int display_mode_attempts = 0;
+    std::unique_lock<std::mutex> lock(mutex);
+    while (!quit) {
+        if (pending_resizes.empty() && pending_desk_moves.empty() && pending_display_mode < 0) {
+            cond.wait(lock);
+            continue;
+        }
+
+        if (pending_display_mode >= 0) {
+            const int mode = pending_display_mode;
+            lock.unlock();
+            const bool ok = run_cmd({"window", "set-display-windowing-mode", std::to_string(mode)},
+                                    /*quiet=*/true);
+            lock.lock();
+            if (ok) {
+                ALOGI("default display windowing mode: %s",
+                      mode == kWindowingModeFreeform ? "freeform" : "fullscreen");
+                if (pending_display_mode == mode)
+                    pending_display_mode = -1;
+                display_mode_attempts = 0;
+            } else if (++display_mode_attempts >= kDisplayModeAttempts) {
+                ALOGE("could not set the default display windowing mode to %d", mode);
+                pending_display_mode = -1;
+                display_mode_attempts = 0;
+            } else {
+                /* system_server is not up yet; nothing else can run before it. */
+                cond.wait_for(lock, std::chrono::seconds(1));
+            }
+            continue;
+        }
+
+        /* Into the desk first: a resize of a fullscreen task is refused. */
+        if (!pending_desk_moves.empty()) {
+            const uint32_t task_id = pending_desk_moves.front();
+            pending_desk_moves.erase(pending_desk_moves.begin());
+            lock.unlock();
+            const int desk = fresh_desk_id();
+            if (desk < 0) {
+                ALOGE("task %u: no WMShell desk to move it into", task_id);
+            } else {
+                ALOGI("task %u: fullscreen, moving it into desk %d", task_id, desk);
+                desktopmode({"moveTaskToDesk", std::to_string(task_id), std::to_string(desk)});
+            }
+            lock.lock();
+            continue;
+        }
+
+        auto it = pending_resizes.begin();
+        const uint32_t task_id = it->first;
+        const hwc_rect_t b = it->second;
+        pending_resizes.erase(it);
+        lock.unlock();
+        run_cmd({"activity", "task", "resize", std::to_string(task_id), std::to_string(b.left),
+                 std::to_string(b.top), std::to_string(b.right), std::to_string(b.bottom)});
+        lock.lock();
+    }
+}
