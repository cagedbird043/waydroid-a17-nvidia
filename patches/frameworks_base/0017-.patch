 services/core/java/com/android/server/wm/AppTaskImpl.java | 6 +++++-
 services/core/java/com/android/server/wm/Task.java        | 3 +++
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/services/core/java/com/android/server/wm/AppTaskImpl.java b/services/core/java/com/android/server/wm/AppTaskImpl.java
index faaf6912b..68cb9697e 100644
--- a/services/core/java/com/android/server/wm/AppTaskImpl.java
+++ b/services/core/java/com/android/server/wm/AppTaskImpl.java
@@ -146,6 +146,8 @@ class AppTaskImpl extends IAppTask.Stub {
         checkCallerOrSystemOrRoot();
 
         synchronized (mService.mGlobalLock) {
+            final int callingPid = Binder.getCallingPid();
+            final int callingUid = Binder.getCallingUid();
             final long origId = Binder.clearCallingIdentity();
             try {
                 Task task = mService.mRootWindowContainer.anyTaskForId(mTaskId,
@@ -154,8 +156,10 @@ class AppTaskImpl extends IAppTask.Stub {
                     Slog.w(TAG, "Unable to find task ID " + mTaskId);
                     return null;
                 }
+                final boolean getTasksAllowed = mService.isGetTasksAllowed(
+                        "getTaskInfo", callingPid, callingUid);
                 return mService.getRecentTasks().createRecentTaskInfo(task,
-                        false /* stripExtras */, true /* getTasksAllowed */);
+                        false /* stripExtras */, getTasksAllowed);
             } finally {
                 Binder.restoreCallingIdentity(origId);
             }
diff --git a/services/core/java/com/android/server/wm/Task.java b/services/core/java/com/android/server/wm/Task.java
index 726c52c00..23c7366cb 100644
--- a/services/core/java/com/android/server/wm/Task.java
+++ b/services/core/java/com/android/server/wm/Task.java
@@ -3624,6 +3624,9 @@ class Task extends TaskFragment {
             info.topActivityInfo.applicationInfo.taskAffinity = "";
             info.topActivityInfo.applicationInfo.name = "";
             info.topActivityInfo.applicationInfo.packageName = "";
+            info.pictureInPictureParams = null;
+            info.mTopActivityLocusId = null;
+            info.taskDescription = new ActivityManager.TaskDescription();
         }
 
         if (task.effectiveUid != baseActivityUid) {
