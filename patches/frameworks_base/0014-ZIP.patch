MIME-Version: 1.0
Content-Type: text/plain; charset=utf-8
Content-Transfer-Encoding: 8bit

zipEntry->name.length() + 1 was assigned to uint16_t, and that
overflows the max Zip entry length of 65535. The fix just uses
the size_t type.

Bug: 505748392
Test: atest libandroidfw_tests
Flag: EXEMPT BUGFIX
Change-Id: I1772a0c2bebde3d045730cba40ede9dc073cc69f

(cherry picked from commit 55ddf2e8ed824b552f8312e1d8dc3ebbd9faf92b)
---
 libs/androidfw/Android.bp                    |  1 +
 libs/androidfw/ZipFileRO.cpp                 |  4 +-
 libs/androidfw/include/androidfw/ZipFileRO.h |  2 +
 libs/androidfw/tests/ZipFileRO_test.cpp      | 55 ++++++++++++++++++++
 4 files changed, 60 insertions(+), 2 deletions(-)
 create mode 100644 libs/androidfw/tests/ZipFileRO_test.cpp

diff --git a/libs/androidfw/Android.bp b/libs/androidfw/Android.bp
index 664ca38cc..32c0d0f5d 100644
--- a/libs/androidfw/Android.bp
+++ b/libs/androidfw/Android.bp
@@ -249,6 +249,7 @@ cc_test {
         "tests/StringPool_test.cpp",
         "tests/Theme_test.cpp",
         "tests/TypeWrappers_test.cpp",
+        "tests/ZipFileRO_test.cpp",
         "tests/ZipUtils_test.cpp",
     ],
     static_libs: [
diff --git a/libs/androidfw/ZipFileRO.cpp b/libs/androidfw/ZipFileRO.cpp
index 10651cdaf..9ed61c68d 100644
--- a/libs/androidfw/ZipFileRO.cpp
+++ b/libs/androidfw/ZipFileRO.cpp
@@ -217,10 +217,10 @@ int ZipFileRO::getEntryFileName(ZipEntryRO entry, char* buffer, size_t bufLen)
     const
 {
     const _ZipEntryRO* zipEntry = reinterpret_cast<_ZipEntryRO*>(entry);
-    const uint16_t requiredSize = zipEntry->name.length() + 1;
+    const size_t requiredSize = zipEntry->name.length() + 1;
 
     if (bufLen < requiredSize) {
-        ALOGW("Buffer too short, requires %d bytes for entry name", requiredSize);
+        ALOGW("Buffer too short, requires %zu bytes for entry name", requiredSize);
         return requiredSize;
     }
 
diff --git a/libs/androidfw/include/androidfw/ZipFileRO.h b/libs/androidfw/include/androidfw/ZipFileRO.h
index 0f3f19c91..181cdd97a 100644
--- a/libs/androidfw/include/androidfw/ZipFileRO.h
+++ b/libs/androidfw/include/androidfw/ZipFileRO.h
@@ -196,6 +196,8 @@ private:
     ZipFileRO(const ZipFileRO& src);
     ZipFileRO& operator=(const ZipFileRO& src);
 
+    friend class ZipFileROTest_GetEntryFileName_MaxLengthOverflow_Test;
+
     ZipFileRO(ZipArchiveHandle handle, char* fileName) : mHandle(handle),
         mFileName(fileName)
     {
diff --git a/libs/androidfw/tests/ZipFileRO_test.cpp b/libs/androidfw/tests/ZipFileRO_test.cpp
new file mode 100644
index 000000000..f77c2ad50
--- /dev/null
+++ b/libs/androidfw/tests/ZipFileRO_test.cpp
@@ -0,0 +1,55 @@
+/*
