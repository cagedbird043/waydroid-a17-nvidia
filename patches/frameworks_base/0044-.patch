Content-Type: text/plain; charset=utf-8
Content-Transfer-Encoding: 8bit

"Avoid showing Volume Panel when the device is locked" gates the
panel on DeviceEntryInteractor.isDeviceEntered, which is a constant
false when the scene container is disabled. As a result setVisible(true)
always bailed out and the expanded volume panel never opened.

Use isDeviceEntered only when SceneContainerFlag is enabled and fall
back to !KeyguardInteractor.isKeyguardShowing otherwise.

Change-Id: I8a42e00fa0da25c54e78aa7b757cffb73841e141
Signed-off-by: Pranav Vashi <neobuddy89@gmail.com>

(cherry picked from commit 1df617a1093e41562fd1f43f27de0cfb4af817e5)
---
 .../VolumePanelGlobalStateInteractor.kt         | 17 +++++++++++++++--
 .../VolumePanelGlobalStateInteractorKosmos.kt   |  2 ++
 2 files changed, 17 insertions(+), 2 deletions(-)

diff --git a/packages/SystemUI/src/com/android/systemui/volume/panel/domain/interactor/VolumePanelGlobalStateInteractor.kt b/packages/SystemUI/src/com/android/systemui/volume/panel/domain/interactor/VolumePanelGlobalStateInteractor.kt
index 04089db1e..d45a9afef 100644
--- a/packages/SystemUI/src/com/android/systemui/volume/panel/domain/interactor/VolumePanelGlobalStateInteractor.kt
+++ b/packages/SystemUI/src/com/android/systemui/volume/panel/domain/interactor/VolumePanelGlobalStateInteractor.kt
@@ -19,7 +19,9 @@ package com.android.systemui.volume.panel.domain.interactor
 import com.android.systemui.dagger.SysUISingleton
 import com.android.systemui.dagger.qualifiers.Application
 import com.android.systemui.deviceentry.domain.interactor.DeviceEntryInteractor
+import com.android.systemui.keyguard.domain.interactor.KeyguardInteractor
 import com.android.systemui.plugins.ActivityStarter
+import com.android.systemui.scene.shared.flag.SceneContainerFlag
 import com.android.systemui.volume.panel.data.repository.VolumePanelGlobalStateRepository
 import com.android.systemui.volume.panel.shared.model.VolumePanelGlobalState
 import javax.inject.Inject
@@ -28,6 +30,7 @@ import kotlinx.coroutines.CoroutineScope
 import kotlinx.coroutines.flow.SharingStarted
 import kotlinx.coroutines.flow.StateFlow
 import kotlinx.coroutines.flow.launchIn
+import kotlinx.coroutines.flow.map
 import kotlinx.coroutines.flow.mapLatest
 import kotlinx.coroutines.flow.onEach
 import kotlinx.coroutines.flow.stateIn
@@ -39,10 +42,20 @@ class VolumePanelGlobalStateInteractor
 constructor(
     @param:Application private val coroutineScope: CoroutineScope,
     private val deviceEntryInteractor: DeviceEntryInteractor,
+    private val keyguardInteractor: KeyguardInteractor,
     private val repository: VolumePanelGlobalStateRepository,
     private val activityStarter: ActivityStarter,
 ) {
 
+    private val isDeviceEntered: StateFlow<Boolean> =
+        if (SceneContainerFlag.isEnabled) {
+            deviceEntryInteractor.isDeviceEntered
+        } else {
+            keyguardInteractor.isKeyguardShowing
+                .map { !it }
+                .stateIn(coroutineScope, SharingStarted.Eagerly, false)
+        }
+
     val globalState: StateFlow<VolumePanelGlobalState> =
         repository.globalState
             .mapLatest { state ->
@@ -54,7 +67,7 @@ constructor(
             .stateIn(coroutineScope, SharingStarted.Eagerly, VolumePanelGlobalState(false))
 
     init {
-        deviceEntryInteractor.isDeviceEntered
+        isDeviceEntered
             .onEach { isDeviceEntered ->
                 if (!isDeviceEntered) {
                     setVisible(false)
@@ -64,7 +77,7 @@ constructor(
     }
 
     fun setVisible(isVisible: Boolean) {
-        if (isVisible && !deviceEntryInteractor.isDeviceEntered.value) {
+        if (isVisible && !isDeviceEntered.value) {
             return
         }
         repository.updateVolumePanelState { it.copy(isVisible = isVisible) }
diff --git a/packages/SystemUI/tests/utils/src/com/android/systemui/volume/panel/domain/interactor/VolumePanelGlobalStateInteractorKosmos.kt b/packages/SystemUI/tests/utils/src/com/android/systemui/volume/panel/domain/interactor/VolumePanelGlobalStateInteractorKosmos.kt
index 672f76075..a503b5482 100644
--- a/packages/SystemUI/tests/utils/src/com/android/systemui/volume/panel/domain/interactor/VolumePanelGlobalStateInteractorKosmos.kt
+++ b/packages/SystemUI/tests/utils/src/com/android/systemui/volume/panel/domain/interactor/VolumePanelGlobalStateInteractorKosmos.kt
@@ -17,6 +17,7 @@
 package com.android.systemui.volume.panel.domain.interactor
 
 import com.android.systemui.deviceentry.domain.interactor.deviceEntryInteractor
+import com.android.systemui.keyguard.domain.interactor.keyguardInteractor
 import com.android.systemui.kosmos.Kosmos
 import com.android.systemui.kosmos.applicationCoroutineScope
 import com.android.systemui.plugins.activityStarter
@@ -27,6 +28,7 @@ val Kosmos.volumePanelGlobalStateInteractor: VolumePanelGlobalStateInteractor by
         coroutineScope = applicationCoroutineScope,
         activityStarter = activityStarter,
         deviceEntryInteractor = deviceEntryInteractor,
+        keyguardInteractor = keyguardInteractor,
         repository = volumePanelGlobalStateRepository,
     )
 }
