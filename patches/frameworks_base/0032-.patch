+++ b/services/tests/servicestests/src/com/android/server/locales/LocaleManagerServiceTest.java
@@ -410,14 +410,43 @@ public class LocaleManagerServiceTest {
         }
     }
 
-    @Test(expected = IllegalArgumentException.class)
-    public void testGetOverrideLocaleConfig_pathTraversal_fails() throws Exception {
-        String traversalPackageName = "../../10/locale_configs/com.victim";
+    @Test
+    public void testGetOverrideLocaleConfig_packageNotFound_returnsNull() throws Exception {
+        String unknownPackage = "com.unknown.package";
         doThrow(new PackageManager.NameNotFoundException("Mock"))
-                .when(mMockPackageManager).getPackageUidAsUser(eq(traversalPackageName), any(),
+                .when(mMockPackageManager).getPackageUidAsUser(eq(unknownPackage), any(),
                         anyInt());
 
-        mLocaleManagerService.getOverrideLocaleConfig(traversalPackageName, DEFAULT_USER_ID);
+        assertNull(mLocaleManagerService.getOverrideLocaleConfig(
+                unknownPackage, DEFAULT_USER_ID));
+    }
+
+    @Test
