ATV 的 A17 版本把 usage 加宽为 int64_t，句柄变成 36 个 int，预编译的 vulkan.nvidia
拒绝导入（numInts 34 + 2 fds != 35），surfaceflinger 因此无法创建纹理而中止。
句柄中的 usage 只用于判断低位的 SW 读写掩码。
---
 cros_gralloc/cros_gralloc_handle.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/cros_gralloc/cros_gralloc_handle.h b/cros_gralloc/cros_gralloc_handle.h
index 167972e..d009521 100644
--- a/cros_gralloc/cros_gralloc_handle.h
+++ b/cros_gralloc/cros_gralloc_handle.h
@@ -36,7 +36,7 @@ struct cros_gralloc_handle : public native_handle_t {
 	uint32_t magic;
 	uint32_t pixel_stride;
 	int32_t droid_format;
-	int64_t usage; /* Android usage. */
+	int32_t usage; /* Android usage; 32 bits keeps the 35-int handle layout the nvidia-prolapse HAL pins. */
 	uint32_t num_planes;
 	uint64_t reserved_region_size;
 	uint64_t total_size; /* Total allocation size */
