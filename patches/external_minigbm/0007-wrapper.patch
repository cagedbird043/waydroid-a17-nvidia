可选扩展仅从动态 wrapper 查询，保留 ATV 内嵌实现的编译路径；普通载体也使用格式字节步长，确保未导出布局扩展时 P010 不会按半宽分配。

(cherry picked from commit 2e89bdc6c8edf50f478258b1fdf11e531366b261)
---
 gbm_mesa_driver/gbm_mesa_internals.cpp | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/gbm_mesa_driver/gbm_mesa_internals.cpp b/gbm_mesa_driver/gbm_mesa_internals.cpp
index 23d3479..814e9a5 100644
--- a/gbm_mesa_driver/gbm_mesa_internals.cpp
+++ b/gbm_mesa_driver/gbm_mesa_internals.cpp
@@ -57,8 +57,8 @@ extern "C" {
 // PRIx64
 #include <inttypes.h>
 
-#ifndef EMBEDDED_GBM_WRAPPER
 #define GBM_WRAPPER_NAME "libgbm_mesa_wrapper.so"
+#ifndef EMBEDDED_GBM_WRAPPER
 #define GBM_GET_OPS_SYMBOL "get_gbm_ops"
 #else
 extern "C" {
@@ -236,6 +236,7 @@ static std::shared_ptr<GbmMesaDriver> gbm_mesa_get_or_init_driver(struct driver
 			return nullptr;
 		}
 
+#ifndef EMBEDDED_GBM_WRAPPER
 		auto get_map_flags_ops = (const struct gbm_map_flags_ops *(*)(void))dlsym(
 		    gbm_mesa_drv->dl_handle, GBM_GET_MAP_FLAGS_OPS_SYMBOL);
 		if (get_map_flags_ops) {
@@ -274,6 +275,7 @@ static std::shared_ptr<GbmMesaDriver> gbm_mesa_get_or_init_driver(struct driver
 			}
 			gbm_mesa_drv->alloc_flags_ops = af;
 		}
+#endif
 
 		gbm_mesa_drv->gbm_dev =
 		    gbm_mesa_drv->wrapper->dev_create(gbm_mesa_drv->gbm_node_fd.Get());
@@ -417,7 +419,7 @@ int gbm_mesa_bo_create2(struct bo *bo, uint32_t width, uint32_t height, uint32_t
 
 	if (alloc_args.drm_format == 0) {
 		/* Always use linear for spoofed format allocations. */
-		uint32_t spoof_stride = alloc_args.width;
+		uint32_t spoof_stride = drv_stride_from_format(format, alloc_args.width, 0);
 		uint32_t spoof_height = alloc_args.height;
 		if (drv->layout_ops && (format == DRM_FORMAT_NV12 || format == DRM_FORMAT_P010)) {
 			/* GPU copy pitch is in bytes, including two-byte P010 samples. */
-- 
