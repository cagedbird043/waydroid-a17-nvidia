---
 gbm_mesa_driver/gbm_mesa_internals.cpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/gbm_mesa_driver/gbm_mesa_internals.cpp b/gbm_mesa_driver/gbm_mesa_internals.cpp
index 814e9a5..93b1e1a 100644
--- a/gbm_mesa_driver/gbm_mesa_internals.cpp
+++ b/gbm_mesa_driver/gbm_mesa_internals.cpp
@@ -377,6 +377,15 @@ int gbm_mesa_bo_create2(struct bo *bo, uint32_t width, uint32_t height, uint32_t
 	const bool sw_access = unmask64(&use_flags, BO_USE_SW_MASK);
 	const bool gpu_render = (use_flags & (BO_USE_RENDERING | BO_USE_FRONT_RENDERING)) != 0;
 
+	/* BGR888 lives in an R8 carrier, which the GPU cannot use as a colour target. Answering a
+	 * render probe with "supported" sends the A17 Vulkan loader into its R8G8B8 swapchain path
+	 * (vkGetPhysicalDeviceSurfaceFormatsKHR), which crashes Vulkan 1.0 instances. */
+	if (format == DRM_FORMAT_BGR888 && gpu_render) {
+		if (!test_only)
+			drv_loge("BGR888 cannot be a GPU render target");
+		return -EINVAL;
+	}
+
 	struct alloc_args alloc_args = {
 		.gbm = drv->gbm_dev,
 		.width = width,
