From 0fb126dcb257b6c585e15eff1e7a642ccd77d04c Mon Sep 17 00:00:00 2001
From: nvidia-prolapse <nvidia-prolapse@localhost>
Date: Sun, 18 Oct 2026 01:20:49 +0300
Subject: [PATCH 6/8] gbm_mesa: CPU-cached memory for buffers the CPU reads
 often
MIME-Version: 1.0
Content-Type: text/plain; charset=utf-8
Content-Transfer-Encoding: 8bit

Applies to https://github.com/waydroid/android_external_minigbm e5a7769 ("Fix YVU420
format"), after 0001..0006.

struct alloc_args tells the wrapper the layout (force_linear, needs_map_stride) and
scanout, not how the CPU uses a LINEAR buffer, so a wrapper places every CPU buffer the
same way: the first host-visible, coherent memory type. That is VRAM behind the BAR on
NVK (DEVICE_LOCAL|HOST_VISIBLE|HOST_COHERENT, CPU reads ~22 MB/s) and uncached system
memory on NVIDIA's own Vulkan driver (~90 MB/s); a cached system-memory type reads at
~10 GB/s (RTX 5090, a 4096x1224 R8 LINEAR buffer). A Codec2 client without a Surface
(CCodec ByteBuffer mode) copies every decoder output block out on the CPU: 1920x816
H.264 ran at 31 fps and 1920x1080 at 25 fps, with 94 % of the app's cycles in
libstagefright CopyRow_ERMS reading the block.

New optional wrapper ABI (gbm_mesa_wrapper_alloc_flags.h): get_gbm_alloc_flags_ops()->
alloc(args, flags), with GBM_ALLOC_FLAG_CPU_READ_OFTEN for BO_USE_SW_READ_OFTEN buffers
that are not scanned out, the rule amdgpu.c uses for GTT placement (USWC unless
BO_USE_SW_READ_OFTEN, always USWC for scanout). A wrapper without the symbol is called
through gbm_ops.alloc as before.

ATV 在分配前会消耗用量标志，故 CPU_READ_OFTEN 判定读取原始 use_flags_copy，避免缓存请求失效；保留 test_only 无分配探测及 scanout 失败重试，并让重试使用相同扩展分配入口。

(cherry picked from commit cb42bbcf11b529ec7cdf89f14a350cba18735871)
---
 gbm_mesa_driver/gbm_mesa_internals.cpp        | 30 ++++++++++++++-
 .../gbm_mesa_wrapper_alloc_flags.h            | 37 +++++++++++++++++++
 2 files changed, 65 insertions(+), 2 deletions(-)
 create mode 100644 gbm_mesa_driver/gbm_mesa_wrapper_alloc_flags.h

diff --git a/gbm_mesa_driver/gbm_mesa_internals.cpp b/gbm_mesa_driver/gbm_mesa_internals.cpp
index d578936..23d3479 100644
--- a/gbm_mesa_driver/gbm_mesa_internals.cpp
+++ b/gbm_mesa_driver/gbm_mesa_internals.cpp
@@ -23,6 +23,7 @@ extern "C" {
 #include "gbm_mesa_wrapper.h"
 #include "gbm_mesa_wrapper_map_flags.h"
 #include "gbm_mesa_wrapper_layout.h"
+#include "gbm_mesa_wrapper_alloc_flags.h"
 
 #include "UniqueFd.h"
 #include "drv_priv.h"
@@ -115,6 +116,8 @@ struct GbmMesaDriver {
 	const struct gbm_map_flags_ops *map_flags_ops = nullptr;
 	/* optional: the driver's memory requirement of a NV12/P010 layout (gbm_mesa_wrapper_layout.h) */
 	const struct gbm_layout_ops *layout_ops = nullptr;
+	/* optional: allocation with usage-derived placement hints (gbm_mesa_wrapper_alloc_flags.h) */
+	const struct gbm_alloc_flags_ops *alloc_flags_ops = nullptr;
 	struct gbm_device *gbm_dev = nullptr;
 	void *dl_handle = nullptr;
 
@@ -259,6 +262,19 @@ static std::shared_ptr<GbmMesaDriver> gbm_mesa_get_or_init_driver(struct driver
 			gbm_mesa_drv->layout_ops = lo;
 		}
 
+		auto get_alloc_flags_ops = (const struct gbm_alloc_flags_ops *(*)(void))dlsym(
+		    gbm_mesa_drv->dl_handle, GBM_GET_ALLOC_FLAGS_OPS_SYMBOL);
+		if (get_alloc_flags_ops) {
+			auto af = get_alloc_flags_ops();
+			if (!af || af->version != GBM_ALLOC_FLAGS_OPS_VERSION || !af->alloc) {
+				drv_loge("'%s' exports '%s' but its ops are unusable (version %u, want %u)",
+					 GBM_WRAPPER_NAME, GBM_GET_ALLOC_FLAGS_OPS_SYMBOL,
+					 af ? af->version : 0u, GBM_ALLOC_FLAGS_OPS_VERSION);
+				return nullptr;
+			}
+			gbm_mesa_drv->alloc_flags_ops = af;
+		}
+
 		gbm_mesa_drv->gbm_dev =
 		    gbm_mesa_drv->wrapper->dev_create(gbm_mesa_drv->gbm_node_fd.Get());
 		if (!gbm_mesa_drv->gbm_dev) {
@@ -462,12 +478,22 @@ int gbm_mesa_bo_create2(struct bo *bo, uint32_t width, uint32_t height, uint32_t
 	if (test_only)
 		return 0;
 
-	err = wr->alloc(&alloc_args);
+	/* Use the original flags: ATV consumed SW/scanout bits during validation. */
+	const uint32_t alloc_flags =
+	    ((use_flags_copy & BO_USE_SW_READ_OFTEN) && !(use_flags_copy & BO_USE_SCANOUT))
+		? GBM_ALLOC_FLAG_CPU_READ_OFTEN
+		: 0;
+	auto do_alloc = [&]() {
+		return drv->alloc_flags_ops ? drv->alloc_flags_ops->alloc(&alloc_args, alloc_flags)
+					    : wr->alloc(&alloc_args);
+	};
+
+	err = do_alloc();
 
 	if (err && !scanout_strong) {
 		drv_loge("Failed to allocate for scanout, trying non-scanout");
 		alloc_args.use_scanout = false;
-		err = wr->alloc(&alloc_args);
+		err = do_alloc();
 	}
 
 	if (err) {
diff --git a/gbm_mesa_driver/gbm_mesa_wrapper_alloc_flags.h b/gbm_mesa_driver/gbm_mesa_wrapper_alloc_flags.h
new file mode 100644
index 0000000..a7f37a6
--- /dev/null
+++ b/gbm_mesa_driver/gbm_mesa_wrapper_alloc_flags.h
@@ -0,0 +1,37 @@
+/*
+ * Optional extension of the gbm_mesa wrapper ABI (gbm_mesa_wrapper.h): allocate
+ * with placement hints derived from the buffer's usage.
+ *
+ * struct alloc_args carries the layout (force_linear, needs_map_stride) and
+ * scanout, but not how the CPU uses a LINEAR buffer. A buffer the CPU reads
+ * often (BO_USE_SW_READ_OFTEN, e.g. hardware decoder output that a Codec2
+ * client copies out on the CPU) is unusable in write-combined or uncached
+ * memory: uncached CPU reads run at a small fraction of cached ones. minigbm's
+ * amdgpu backend makes the same distinction (amdgpu.c amdgpu_create_bo: GTT
+ * buffers are USWC unless BO_USE_SW_READ_OFTEN, and always USWC for scanout).
+ * A wrapper that exports GBM_GET_ALLOC_FLAGS_OPS_SYMBOL gets these hints with
+ * every allocation; a wrapper without the symbol keeps gbm_ops.alloc unchanged.
+ */
+
+#pragma once
+
+#include <stdint.h>
+
+struct alloc_args;
+
+#define GBM_ALLOC_FLAGS_OPS_VERSION 1u
+#define GBM_GET_ALLOC_FLAGS_OPS_SYMBOL "get_gbm_alloc_flags_ops"
+
+/*
+ * The CPU reads the buffer often and it is not scanned out: a LINEAR buffer
+ * goes to CPU-cached memory.
+ */
+#define GBM_ALLOC_FLAG_CPU_READ_OFTEN (1u << 0)
+
+struct gbm_alloc_flags_ops {
+	/* GBM_ALLOC_FLAGS_OPS_VERSION of the wrapper; the glue refuses another */
+	uint32_t version;
+
+	/* as gbm_ops.alloc, with flags a subset of the GBM_ALLOC_FLAG_* bits */
+	int (*alloc)(struct alloc_args *args, uint32_t flags);
+};
