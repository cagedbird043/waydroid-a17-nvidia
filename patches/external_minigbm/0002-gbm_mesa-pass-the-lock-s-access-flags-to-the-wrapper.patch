From b45a5c962895722ccfcc923e677c10dd2b5bb497 Mon Sep 17 00:00:00 2001
From: nvidia-prolapse <nvidia-prolapse@localhost>
Date: Fri, 16 Oct 2026 19:55:46 +0300
Subject: [PATCH 2/8] gbm_mesa: pass the lock's access flags to the wrapper
MIME-Version: 1.0
Content-Type: text/plain; charset=utf-8
Content-Transfer-Encoding: 8bit

Applies to https://github.com/waydroid/android_external_minigbm
16844babfbd83d7c206ca22256257cbf26ca7de1 ("gralloc: Handle PixelFormat::R_8"),
after 0001-gbm_mesa-CPU-usage-does-not-force-LINEAR-on-render-targets.patch.

gbm_mesa_bo_map() drops map_flags: gbm_ops.map/unmap have no access flags.
A wrapper that serves CPU locks of tiled buffers through a linear copy (GPU
copy in at map, GPU copy back at unmap, as minigbm's amdgpu backend does with
BO_MAP_READ/BO_MAP_WRITE) then has to copy back after every lock, so a
read-only lock writes the buffer and can overwrite GPU writes that landed
while it was held.

- New optional wrapper ABI (gbm_mesa_wrapper_map_flags.h): a wrapper that
  exports get_gbm_map_flags_ops() gets map(…, map_flags, …) and
  unmap(…, map_flags) with BO_MAP_READ/BO_MAP_WRITE. A wrapper without the
  symbol keeps the old gbm_ops.map/unmap path unchanged; one that exports it
  with another version fails driver init loudly.
- Nested locks: cros_gralloc_buffer::lock reuses the first lock's mapping;
  when the nested lock asks for access the mapping lacks, the mapping's flags
  are widened (drv_bo_widen_map_flags) so the backend's unmap sees every
  access the mapping was used for (e.g. a write lock taken while a read lock
  is held still gets its data copied back).

适配 ATV 的解映射状态检查：保留无效内部状态返回 EINVAL 的行为，在检查通过后调用带读写标志的 wrapper 扩展。

(cherry picked from commit f2f78353a0320abb6afe4e5fe06d81749ec7a31a)
---
 cros_gralloc/cros_gralloc_buffer.cc          |  2 +
 drv.c                                        | 18 +++++++++
 drv.h                                        |  2 +
 gbm_mesa_driver/gbm_mesa_internals.cpp       | 30 +++++++++++++-
 gbm_mesa_driver/gbm_mesa_wrapper_map_flags.h | 41 ++++++++++++++++++++
 5 files changed, 91 insertions(+), 2 deletions(-)
 create mode 100644 gbm_mesa_driver/gbm_mesa_wrapper_map_flags.h

diff --git a/cros_gralloc/cros_gralloc_buffer.cc b/cros_gralloc/cros_gralloc_buffer.cc
index c738830..033657e 100644
--- a/cros_gralloc/cros_gralloc_buffer.cc
+++ b/cros_gralloc/cros_gralloc_buffer.cc
@@ -359,6 +359,8 @@ int32_t cros_gralloc_buffer::lock(const struct rectangle *rect, uint32_t map_fla
 
 	if (map_flags) {
 		if (lock_data_[0]) {
+			if (map_flags & ~lock_data_[0]->vma->map_flags)
+				drv_bo_widen_map_flags(bo_, lock_data_[0], map_flags);
 			drv_bo_invalidate(bo_, lock_data_[0]);
 			vaddr = lock_data_[0]->vma->addr;
 		} else {
diff --git a/drv.c b/drv.c
index 990ec89..5268eec 100644
--- a/drv.c
+++ b/drv.c
@@ -690,6 +690,24 @@ int drv_bo_flush_or_unmap(struct bo *bo, struct mapping *mapping)
 	return ret;
 }
 
+/*
+ * A nested lock of a mapped buffer reuses the mapping (cros_gralloc_buffer::lock); when it
+ * asks for access the mapping lacks (a write lock while a read lock is held), the mapping's
+ * flags grow, so that the backend's unmap sees every access the mapping was used for.
+ */
+void drv_bo_widen_map_flags(struct bo *bo, struct mapping *mapping, uint32_t map_flags)
+{
+	struct driver *drv = bo->drv;
+
+	assert(mapping);
+	assert(mapping->vma);
+	assert(mapping->refcount > 0);
+
+	pthread_mutex_lock(&drv->mappings_lock);
+	mapping->vma->map_flags |= map_flags & BO_MAP_READ_WRITE;
+	pthread_mutex_unlock(&drv->mappings_lock);
+}
+
 uint32_t drv_bo_get_width(struct bo *bo)
 {
 	return bo->meta.width;
diff --git a/drv.h b/drv.h
index 0752883..ca8970e 100644
--- a/drv.h
+++ b/drv.h
@@ -215,6 +215,8 @@ int drv_bo_flush(struct bo *bo, struct mapping *mapping);
 
 int drv_bo_flush_or_unmap(struct bo *bo, struct mapping *mapping);
 
+void drv_bo_widen_map_flags(struct bo *bo, struct mapping *mapping, uint32_t map_flags);
+
 uint32_t drv_bo_get_width(struct bo *bo);
 
 uint32_t drv_bo_get_height(struct bo *bo);
diff --git a/gbm_mesa_driver/gbm_mesa_internals.cpp b/gbm_mesa_driver/gbm_mesa_internals.cpp
index 34916b2..46bf1f4 100644
--- a/gbm_mesa_driver/gbm_mesa_internals.cpp
+++ b/gbm_mesa_driver/gbm_mesa_internals.cpp
@@ -21,6 +21,7 @@ extern "C" {
 }
 
 #include "gbm_mesa_wrapper.h"
+#include "gbm_mesa_wrapper_map_flags.h"
 
 #include "UniqueFd.h"
 #include "drv_priv.h"
@@ -103,6 +104,8 @@ struct GbmMesaDriver {
 	}
 
 	struct gbm_ops *wrapper = nullptr;
+	/* optional: map/unmap with the lock's access flags (gbm_mesa_wrapper_map_flags.h) */
+	const struct gbm_map_flags_ops *map_flags_ops = nullptr;
 	struct gbm_device *gbm_dev = nullptr;
 	void *dl_handle = nullptr;
 
@@ -221,6 +224,19 @@ static std::shared_ptr<GbmMesaDriver> gbm_mesa_get_or_init_driver(struct driver
 			return nullptr;
 		}
 
+		auto get_map_flags_ops = (const struct gbm_map_flags_ops *(*)(void))dlsym(
+		    gbm_mesa_drv->dl_handle, GBM_GET_MAP_FLAGS_OPS_SYMBOL);
+		if (get_map_flags_ops) {
+			auto mf = get_map_flags_ops();
+			if (!mf || mf->version != GBM_MAP_FLAGS_OPS_VERSION || !mf->map || !mf->unmap) {
+				drv_loge("'%s' exports '%s' but its ops are unusable (version %u, want %u)",
+					 GBM_WRAPPER_NAME, GBM_GET_MAP_FLAGS_OPS_SYMBOL,
+					 mf ? mf->version : 0u, GBM_MAP_FLAGS_OPS_VERSION);
+				return nullptr;
+			}
+			gbm_mesa_drv->map_flags_ops = mf;
+		}
+
 		gbm_mesa_drv->gbm_dev =
 		    gbm_mesa_drv->wrapper->dev_create(gbm_mesa_drv->gbm_node_fd.Get());
 		if (!gbm_mesa_drv->gbm_dev) {
@@ -532,7 +548,13 @@ void *gbm_mesa_bo_map(struct bo *bo, struct vma *vma, uint32_t map_flags)
 		s_height = 1;
 	}
 
-	wr->map(priv->gbm_bo, s_width, s_height, &buf, &vma->priv);
+	static_assert(GBM_MAP_FLAG_READ == BO_MAP_READ && GBM_MAP_FLAG_WRITE == BO_MAP_WRITE,
+		      "gbm_mesa_wrapper_map_flags.h flags must equal BO_MAP_*");
+	if (drv->map_flags_ops)
+		drv->map_flags_ops->map(priv->gbm_bo, s_width, s_height,
+					map_flags & BO_MAP_READ_WRITE, &buf, &vma->priv);
+	else
+		wr->map(priv->gbm_bo, s_width, s_height, &buf, &vma->priv);
 
 	return buf;
 }
@@ -552,7 +574,11 @@ int gbm_mesa_bo_unmap(struct bo *bo, struct vma *vma)
 		drv_loge("Buffer internal state is invalid");
 		return -EINVAL;
 	}
-	wr->unmap(priv->gbm_bo, vma->priv);
+	if (drv->map_flags_ops)
+		drv->map_flags_ops->unmap(priv->gbm_bo, vma->priv,
+					  vma->map_flags & BO_MAP_READ_WRITE);
+	else
+		wr->unmap(priv->gbm_bo, vma->priv);
 	vma->priv = nullptr;
 	return 0;
 }
diff --git a/gbm_mesa_driver/gbm_mesa_wrapper_map_flags.h b/gbm_mesa_driver/gbm_mesa_wrapper_map_flags.h
new file mode 100644
index 0000000..800143e
--- /dev/null
+++ b/gbm_mesa_driver/gbm_mesa_wrapper_map_flags.h
@@ -0,0 +1,41 @@
+/*
+ * Optional extension of the gbm_mesa wrapper ABI (gbm_mesa_wrapper.h): map and
+ * unmap with the lock's CPU access flags.
+ *
+ * gbm_ops.map/unmap carry no access flags, so a wrapper that maps a tiled
+ * buffer through a linear copy (a GPU copy in, a GPU copy back) must write the
+ * copy back after every lock, including read-only locks, and a read-only lock
+ * then writes the buffer. A wrapper that exports GBM_GET_MAP_FLAGS_OPS_SYMBOL
+ * gets the flags minigbm derives from the lock usage (BO_MAP_READ/BO_MAP_WRITE,
+ * cros_gralloc_convert_map_usage). A wrapper without the symbol keeps the
+ * plain gbm_ops.map/unmap ABI unchanged.
+ *
+ * The unmap flags are those of the whole mapping: a nested lock of the same
+ * buffer that adds access (e.g. a write lock while a read lock is held) widens
+ * the mapping's flags, so unmap may carry more flags than map did.
+ */
+
+#pragma once
+
+#include <stdint.h>
+
+struct gbm_bo;
+
+#define GBM_MAP_FLAGS_OPS_VERSION 1u
+#define GBM_GET_MAP_FLAGS_OPS_SYMBOL "get_gbm_map_flags_ops"
+
+/* equal to minigbm's BO_MAP_READ / BO_MAP_WRITE (drv.h) */
+#define GBM_MAP_FLAG_READ (1u << 0)
+#define GBM_MAP_FLAG_WRITE (1u << 1)
+
+struct gbm_map_flags_ops {
+	/* GBM_MAP_FLAGS_OPS_VERSION of the wrapper; the glue refuses another */
+	uint32_t version;
+
+	/* as gbm_ops.map, with map_flags != 0 and a subset of READ|WRITE */
+	void (*map)(struct gbm_bo *bo, int w, int h, uint32_t map_flags, void **addr,
+		    void **map_data);
+
+	/* as gbm_ops.unmap; map_flags = the mapping's flags (>= the map's) */
+	void (*unmap)(struct gbm_bo *bo, void *map_data, uint32_t map_flags);
+};
