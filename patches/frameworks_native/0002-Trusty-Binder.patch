+        std::function<void(sp<RpcSession>&&, RpcSession::PreJoinSetupResult&&)>&& joinFn,
+        std::function<void(sp<RpcSession>&&, RpcSession::PreJoinSetupResult&&)>&& incomingSetupFn) {
