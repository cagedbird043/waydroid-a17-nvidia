+-        sprintf(sfile_name, "%s/%s_%s.out", DBG_TMP_FOLDER,DBG_PSFILE, szjob_id);
++        snprintf(sfile_name, sizeof(sfile_name), "%s/%s_%s.out", DBG_TMP_FOLDER,DBG_PSFILE, szjob_id);
+         g_fp_outdbgps= fopen(sfile_name, "w");
