++                if (copy_len >= sizeof(finalstr)) {
++                    copy_len = sizeof(finalstr) - 1;
++                }
++                strncpy(finalstr, &newstring[1], copy_len);
++                finalstr[copy_len] = '\0'; // Guarantee null termination
++                ppd_values[12] = 1;
