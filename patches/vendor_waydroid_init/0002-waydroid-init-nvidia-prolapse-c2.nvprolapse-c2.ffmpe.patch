ATV 的 c2.ffmpeg 视频 rank 为 0，排在 NVDEC 服务 c2.nvprolapse（0x10）之前；它的 DRM hwaccel
在 NVIDIA 栈上初始化时调用 eventfd，被 ffmpeg 服务的 seccomp 终止，播放器报解码失败。
---
 waydroid-init/main.cpp | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/waydroid-init/main.cpp b/waydroid-init/main.cpp
index 5a7caff..b65ffea 100644
--- a/waydroid-init/main.cpp
+++ b/waydroid-init/main.cpp
@@ -94,7 +94,14 @@ int main(int argc, char **argv) {
         settings.updateSetting("ro.hardware.gralloc", "default");
     } else {
         // Configure c2.ffmpeg
-        if (gpuUtils.driverInfo.driverName == "vmwgfx") {
+        if (gpuUtils.nvidiaProlapse) {
+            // Video decode belongs to the vendor's NVDEC service c2.nvprolapse.* (rank 0x10); c2.ffmpeg's
+            // DRM hwaccel cannot run on the NVIDIA stack, so it stays the software fallback behind NVDEC.
+            settings.updateSetting("media.sf.hwaccel", "0");
+            settings.updateSetting("debug.ffmpeg-codec2.hwaccel.drm", "0");
+            settings.updateSetting("debug.ffmpeg-codec2.pixel_format", "RGBX_8888");
+            settings.updateSetting("debug.ffmpeg-codec2.rank.video", "32");
+        } else if (gpuUtils.driverInfo.driverName == "vmwgfx") {
             settings.updateSetting("media.sf.hwaccel", "0");
             settings.updateSetting("debug.ffmpeg-codec2.hwaccel.drm", "0");
             settings.updateSetting("debug.ffmpeg-codec2.pixel_format", "RGB_565");
