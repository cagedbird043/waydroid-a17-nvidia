++/* The compute-only family's channel has no copy engine: a transfer that only
++ * the copy engine implements fails with a named reason instead of emitting
++ * copy-engine methods into a channel without that object.
++ */
++static bool
++nvk_cmd_has_copy_engine(struct nvk_cmd_buffer *cmd, const char *what)
++{
++   if (nvk_queue_engines_from_queue_flags(nvk_cmd_buffer_queue_flags(cmd)) &
++       NVKMD_ENGINE_COPY)
++      return true;
++
++   vk_command_buffer_set_error(&cmd->vk,
++      vk_errorf(cmd, VK_ERROR_UNKNOWN,
++                "%s on the compute-only queue family: D32_SFLOAT_S8_UINT with "
++                "stencil inside 64-bit elements (pre-Blackwell) has no "
++                "compute copy view and the queue has no copy engine",
++                what));
++   return false;
++}
