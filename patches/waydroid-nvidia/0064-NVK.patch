++static nir_shader *
++nvk_meta_build_blocks_to_buffer_shader(uint32_t block_B, bool to_image)
++{
++   nir_builder builder =
++      nir_builder_init_simple_shader(MESA_SHADER_COMPUTE, NULL,
++                                     "nvk-meta-compressed-layer-to-buffer");
++   nir_builder *b = &builder;
++   b->shader->info.workgroup_size[0] = 16;
++   b->shader->info.workgroup_size[1] = 16;
++   b->shader->info.workgroup_size[2] = 1;
++
++   const enum pipe_format view_pfmt = block_B == 8 ? PIPE_FORMAT_R32G32_UINT
++                                                   : PIPE_FORMAT_R32G32B32A32_UINT;
++   const struct glsl_type *res_type = to_image ?
++      glsl_image_type(GLSL_SAMPLER_DIM_2D, false, GLSL_TYPE_UINT) :
++      glsl_texture_type(GLSL_SAMPLER_DIM_2D, false, GLSL_TYPE_UINT);
++   nir_variable *res_var =
++      nir_variable_create(b->shader, nir_var_uniform, res_type, "blocks");
++   res_var->data.descriptor_set = 0;
++   res_var->data.binding = 0;
++   nir_deref_instr *res = nir_build_deref_var(b, res_var);
++
++   nir_def *id = nir_trim_vector(b, nir_load_global_invocation_id(b, 32), 2);
++   nir_def *extent = nir_load_push_constant(b, 2, 32,
++      nir_imm_int(b, offsetof(struct nvk_meta_blocks_to_buffer_push, extent_el)));
++   nir_def *inside = nir_iand(b, nir_ult(b, nir_channel(b, id, 0),
++                                         nir_channel(b, extent, 0)),
++                                 nir_ult(b, nir_channel(b, id, 1),
++                                         nir_channel(b, extent, 1)));
++   nir_push_if(b, inside);
++   {
++      nir_def *offset = nir_load_push_constant(b, 2, 32,
++         nir_imm_int(b, offsetof(struct nvk_meta_blocks_to_buffer_push, offset_el)));
++      nir_def *coord = nir_iadd(b, id, offset);
++
++      nir_def *buf_addr = nir_load_push_constant(b, 1, 64,
++         nir_imm_int(b, offsetof(struct nvk_meta_blocks_to_buffer_push, buf_addr)));
++      nir_def *row_stride = nir_load_push_constant(b, 1, 32,
++         nir_imm_int(b, offsetof(struct nvk_meta_blocks_to_buffer_push, row_stride_B)));
++      nir_def *byte_off =
++         nir_iadd(b, nir_imul(b, nir_channel(b, id, 1), row_stride),
++                     nir_imul_imm(b, nir_channel(b, id, 0), block_B));
++      nir_def *addr = nir_iadd(b, buf_addr, nir_u2u64(b, byte_off));
++
++      if (to_image) {
++         nir_def *block = nir_load_global(b, block_B / 4, 32, addr,
++                                          .align_mul = 4);
++         nir_def *zero = nir_imm_int(b, 0);
++         nir_def *val = nir_pad_vector_imm_int(b, block, 0, 4);
++         nir_image_deref_store(b, &res->def,
++                               nir_vec4(b, nir_channel(b, coord, 0),
++                                        nir_channel(b, coord, 1), zero, zero),
++                               zero, val, zero,
++                               .image_dim = GLSL_SAMPLER_DIM_2D,
++                               .image_array = false, .format = view_pfmt,
++                               .access = ACCESS_NON_READABLE,
++                               .src_type = nir_type_uint32);
++      } else {
++         nir_def *texel = nir_txf(b, coord, .texture_deref = res);
++         nir_store_global(b, nir_trim_vector(b, texel, block_B / 4), addr,
++                          .align_mul = 4);
++      }
++   }
++   nir_pop_if(b, NULL);
++
++   return b->shader;
++}
++
++static VkResult
++nvk_meta_get_blocks_to_buffer_pipeline(struct nvk_device *dev,
++                                       uint32_t block_B, bool to_image,
++                                       VkPipelineLayout *layout_out,
++                                       VkPipeline *pipeline_out)
++{
++   struct nvk_meta_blocks_to_buffer_key key;
++   memset(&key, 0, sizeof(key));
++   key.key_type = NVK_META_OBJECT_KEY_COMPRESSED_TO_BUFFER;
++   key.block_B = block_B;
++   key.to_image = to_image;
++
++   /* One layout per direction: the descriptor type differs */
++   const struct {
++      enum vk_meta_object_key_type key_type;
++      bool to_image;
++   } layout_key = { key.key_type, to_image };
++
++   const VkDescriptorSetLayoutBinding binding = {
++      .binding = 0,
++      .descriptorType = to_image ? VK_DESCRIPTOR_TYPE_STORAGE_IMAGE
++                                 : VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE,
++      .descriptorCount = 1,
++      .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT,
++   };
++   const VkDescriptorSetLayoutCreateInfo set_layout = {
++      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
++      .flags = VK_DESCRIPTOR_SET_LAYOUT_CREATE_PUSH_DESCRIPTOR_BIT_KHR,
++      .bindingCount = 1,
++      .pBindings = &binding,
++   };
++   const VkPushConstantRange push_range = {
++      .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT,
++      .offset = 0,
++      .size = sizeof(struct nvk_meta_blocks_to_buffer_push),
++   };
++   VkResult result = vk_meta_get_pipeline_layout(&dev->vk, &dev->meta,
++                                                 &set_layout, &push_range,
++                                                 &layout_key,
++                                                 sizeof(layout_key),
++                                                 layout_out);
++   if (result != VK_SUCCESS)
++      return result;
++
++   VkPipeline cached = vk_meta_lookup_pipeline(&dev->meta, &key, sizeof(key));
++   if (cached != VK_NULL_HANDLE) {
++      *pipeline_out = cached;
++      return VK_SUCCESS;
++   }
++
++   const VkPipelineShaderStageNirCreateInfoMESA nir_info = {
++      .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_NIR_CREATE_INFO_MESA,
++      .nir = nvk_meta_build_blocks_to_buffer_shader(block_B, to_image),
++   };
++   const VkComputePipelineCreateInfo info = {
++      .sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO,
++      .stage = {
++         .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
++         .pNext = &nir_info,
++         .stage = VK_SHADER_STAGE_COMPUTE_BIT,
++         .pName = "main",
++      },
++      .layout = *layout_out,
++   };
++   result = vk_meta_create_compute_pipeline(&dev->vk, &dev->meta, &info,
++                                            &key, sizeof(key), pipeline_out);
++   ralloc_free(nir_info.nir);
++   return result;
++}
