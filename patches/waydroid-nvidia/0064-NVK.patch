+--- a/src/nouveau/vulkan/nvk_cmd_meta.c
++++ b/src/nouveau/vulkan/nvk_cmd_meta.c
+@@ -4,14 +4,21 @@
+  */
+ #include "nvk_buffer.h"
+ #include "nvk_cmd_buffer.h"
++#include "nvk_queue.h"
