+@@ -350,20 +357,149 @@
+    return e.width * e.height * e.depth;
+ }
+ 
++/* Image copies on a queue without a copy engine (the compute-only family)
++ * run as compute meta for every format, as the proprietary driver serves
++ * every transfer command on its compute queue with compute work on that
++ * queue's own channel (libnvidia-eglcore.so 615.78.08: a compute
++ * inline-to-memory parameter block and an inline-QMD kernel launch per
++ * command).  Depth/stencil aspects and YCbCr planes are copied through
++ * unsigned-integer views of the same element size (as panvk_meta.h does) and
++ * compressed formats through views of their block size.  The one layout
++ * that has no such view is pre-Blackwell D32_SFLOAT_S8_UINT, whose stencil
++ * shares 64-bit elements with depth: vk_meta needs each aspect's bits to fill
++ * whole components.
++ */
++static bool
++nvk_meta_image_copy_compute_only_supported(struct nvk_image *img)
++{
++   return img->vk.format != VK_FORMAT_D32_SFLOAT_S8_UINT || img->separate_zs;
++}
++
++static bool
++nvk_meta_image_copy_compute_ok(struct nvk_cmd_buffer *cmd,
++                               struct nvk_image *img)
++{
++   if (nvk_meta_image_copy_compute_supported(img))
++      return true;
++
++   /* Queues with a copy engine keep it for these formats */
++   if (nvk_queue_engines_from_queue_flags(nvk_cmd_buffer_queue_flags(cmd)) &
++       NVKMD_ENGINE_COPY)
++      return false;
++
++   return nvk_meta_image_copy_compute_only_supported(img);
++}
++
++/* D24 depth has no compute copy view on the compute-only family: its
++ * images use a Z24 GOB layout no colour view format selects on Blackwell,
++ * and the ZS GOB before (nvk_image.c does not advertise
++ * VK_FORMAT_FEATURE_2_DEPTH_COPY_ON_COMPUTE_QUEUE_BIT_KHR for it).
++ */
++static bool
++nvk_meta_zs_regions_copyable(struct nvk_cmd_buffer *cmd,
++                             const struct nvk_image *img,
++                             uint32_t region_count,
++                             const VkBufferImageCopy2 *regions,
++                             const char *what)
++{
++   if (nvk_queue_engines_from_queue_flags(nvk_cmd_buffer_queue_flags(cmd)) &
++       NVKMD_ENGINE_COPY)
++      return true;
++
++   const struct nvk_physical_device *pdev =
++      nvk_device_physical(nvk_cmd_buffer_device(cmd));
++   const bool z24 = img->vk.format == VK_FORMAT_X8_D24_UNORM_PACK32 ||
++                    img->vk.format == VK_FORMAT_D24_UNORM_S8_UINT;
++   for (uint32_t r = 0; r < region_count; r++) {
++      const VkImageAspectFlags aspects = regions[r].imageSubresource.aspectMask;
++      if ((aspects & (VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT)) &&
++          (pdev->info.cls_eng3d < BLACKWELL_A ||
++           (z24 && (aspects & VK_IMAGE_ASPECT_DEPTH_BIT)))) {
++         vk_command_buffer_set_error(&cmd->vk,
++            vk_errorf(cmd, VK_ERROR_UNKNOWN,
++                      "%s on the compute-only queue family: %s %s aspect has "
++                      "no compute copy view (format does not advertise the "
++                      "copy-on-compute-queue feature) and the queue has no "
++                      "copy engine", what, vk_Format_to_str(img->vk.format),
++                      (aspects & VK_IMAGE_ASPECT_DEPTH_BIT) ? "depth" : "stencil"));
++         return false;
++      }
++   }
++   return true;
++}
++
++static void
++nvk_meta_copy_depth_stencil_properties(struct nvk_image *img,
++                                       struct vk_meta_copy_image_properties *props)
++{
++   switch (img->vk.format) {
++   case VK_FORMAT_D16_UNORM:
++      props->depth.view_format = VK_FORMAT_R16_UINT;
++      props->depth.component_mask = BITFIELD_MASK(1);
++      break;
++   case VK_FORMAT_X8_D24_UNORM_PACK32:
++      /* Z24X8: depth in the low three bytes */
++      props->depth.view_format = VK_FORMAT_R8G8B8A8_UINT;
++      props->depth.component_mask = BITFIELD_MASK(3);
++      break;
++   case VK_FORMAT_D32_SFLOAT:
++      props->depth.view_format = VK_FORMAT_R32_UINT;
++      props->depth.component_mask = BITFIELD_MASK(1);
++      break;
++   case VK_FORMAT_S8_UINT:
++      props->stencil.view_format = VK_FORMAT_R8_UINT;
