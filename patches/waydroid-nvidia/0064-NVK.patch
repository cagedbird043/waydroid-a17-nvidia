++/* A sampled view that reinterprets a compressed image as blocks covers one
++ * level (nil_image_level_as_uncompressed()), and the texture header derives
++ * the stride between array layers from the view's own single level, not from
++ * the image's mip chain: layers past the first read the wrong bytes when the
++ * image has more than one level.  Storage views carry the array stride
++ * explicitly and are unaffected.  So compute copies out of such an image
++ * (on the compute-only family, which has no copy engine) read through one
++ * single-layer view per layer, whose address the descriptor places with the
++ * image's real array stride.
++ */
++static bool
++nvk_meta_compressed_layers_need_split(const struct nvk_image *img)
++{
++   return vk_format_is_compressed(img->vk.format) &&
++          img->vk.image_type != VK_IMAGE_TYPE_3D &&
++          img->vk.array_layers > 1 && img->vk.mip_levels > 1;
++}
