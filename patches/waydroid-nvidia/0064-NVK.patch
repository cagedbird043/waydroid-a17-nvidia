++#define NVK_META_OBJECT_KEY_COMPRESSED_TO_BUFFER (VK_META_OBJECT_KEY_DRIVER_OFFSET + 0x101)
++
++struct nvk_meta_blocks_to_buffer_key {
++   enum vk_meta_object_key_type key_type;
++   uint32_t block_B;
++   /* false: image layer -> buffer, true: buffer -> image layer */
++   bool to_image;
++};
++
++struct nvk_meta_blocks_to_buffer_push {
++   uint64_t buf_addr;
++   uint32_t row_stride_B;
++   uint32_t pad;
++   int32_t offset_el[2];
++   uint32_t extent_el[2];
++};
