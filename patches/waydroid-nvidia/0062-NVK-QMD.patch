diff --git a/nvidia-prolapse/driver-source/native/mesa/nak-qmd-cwd-membar.patch b/nvidia-prolapse/driver-source/native/mesa/nak-qmd-cwd-membar.patch
new file mode 100644
index 0000000..04e5d92
--- /dev/null
+++ b/nvidia-prolapse/driver-source/native/mesa/nak-qmd-cwd-membar.patch
@@ -0,0 +1,52 @@
+nak: CWD_MEMBAR_TYPE = L1_MEMBAR in Blackwell B QMDs
+
+NVIDIA's driver (libnvidia-eglcore.so 615.78.08) launches every Blackwell B (cec0) QMD with
+CWD_MEMBAR_TYPE = L1_MEMBAR (QMDV05_00 MW(625:624) = 3, in its QMD template); NAK left it L1_NONE.
+
+diff --git a/src/nouveau/compiler/nak/qmd.rs b/src/nouveau/compiler/nak/qmd.rs
+index d91d6a32841f..6b54e7153b94 100644
+--- a/src/nouveau/compiler/nak/qmd.rs
++++ b/src/nouveau/compiler/nak/qmd.rs
+@@ -7,7 +7,9 @@ use std::cmp::min;
+ 
+ use compiler::bindings::*;
+ use nak_bindings::*;
+-use nvidia_headers::classes::{cla0c0, clc0c0, clc3c0, clc6c0, clcbc0, clcdc0};
++use nvidia_headers::classes::{
++    cla0c0, clc0c0, clc3c0, clc6c0, clcbc0, clcdc0, clcec0,
++};
+ 
+ use bitview::*;
+ use paste::paste;
+@@ -621,6 +623,17 @@ mod qmd_5_0 {
+         qmd_impl_set_smem_size_bounded_gb!(clcdc0, QMDV05_00);
+         qmd_impl_set_slm_size!(clcdc0, QMDV05_00, SHIFTED4);
+     }
++
++    impl Qmd5_0 {
++        /// L1 membar when each CTA completes, so the grid's stores are
++        /// visible in L2 once the CWD retires it.  NVIDIA's own driver
++        /// (libnvidia-eglcore.so 615.78.08) has CWD_MEMBAR_TYPE = L1_MEMBAR
++        /// in every Blackwell B (cec0) QMD it launches, Vulkan and GL.
++        pub fn set_cwd_membar_l1(&mut self) {
++            let mut bv = QMDBitView::new(&mut self.qmd);
++            set_enum!(bv, clcdc0, QMDV05_00, CWD_MEMBAR_TYPE, L1_MEMBAR);
++        }
++    }
+ }
+ use qmd_5_0::Qmd5_0;
+ 
+@@ -707,7 +720,12 @@ pub extern "C" fn nak_fill_qmd(
+         if dev.cls_compute >= clcdc0::BLACKWELL_COMPUTE_A {
+             let qmd_out = qmd_out as *mut Qmd5_0;
+             assert!(qmd_size == size_of_val(&*qmd_out));
+-            qmd_out.write(fill_qmd(dev, info, qmd_info));
++            let mut qmd: Qmd5_0 = fill_qmd(dev, info, qmd_info);
++            // Known for Blackwell B only; Blackwell A keeps L1_NONE.
++            if dev.cls_compute >= clcec0::BLACKWELL_COMPUTE_B {
++                qmd.set_cwd_membar_l1();
++            }
++            qmd_out.write(qmd);
+         } else if dev.cls_compute >= clcbc0::HOPPER_COMPUTE_A {
+             let qmd_out = qmd_out as *mut Qmd4_0;
+             assert!(qmd_size == size_of_val(&*qmd_out));
diff --git a/nvidia-prolapse/driver-source/native/mesa/nvk-pixel-shader-barrier.patch b/nvidia-prolapse/driver-source/native/mesa/nvk-pixel-shader-barrier.patch
new file mode 100644
index 0000000..d761f76
--- /dev/null
+++ b/nvidia-prolapse/driver-source/native/mesa/nvk-pixel-shader-barrier.patch
@@ -0,0 +1,256 @@
+nvk: order colour-attachment output -> fragment reads with PIXEL_SHADER_BARRIER on Blackwell B
+
+NVIDIA's driver (libnvidia-eglcore.so 615.78.08: barrier record E 0xc63a00, finalise E 0xc63f50,
+drain E 0xc65ae0) drains a dependency whose only source stage is COLOR_ATTACHMENT_OUTPUT and whose
+destinations are fragment-stage reads (FRAGMENT_SHADER / LATE_FRAGMENT_TESTS / COLOR_ATTACHMENT_OUTPUT /
+BOTTOM_OF_PIPE stages; uniform, input-attachment, sampled, storage or colour reads) with one
+PIXEL_SHADER_BARRIER, followed by the undocumented method 0x0f74 for texture / shader-data reads,
+instead of WAIT_FOR_IDLE. NVK's texture-data invalidate is kept next to 0x0f74. Every other
+dependency, and every class without a known rule, keeps WAIT_FOR_IDLE.
+
+diff --git a/src/nouveau/vulkan/nvk_cmd_buffer.c b/src/nouveau/vulkan/nvk_cmd_buffer.c
+index d9509d5bf67a..07738ae55e00 100644
+--- a/src/nouveau/vulkan/nvk_cmd_buffer.c
++++ b/src/nouveau/vulkan/nvk_cmd_buffer.c
+@@ -23,6 +23,7 @@
+ #include "clb097.h"
+ #include "clb197.h"
+ #include "clcb97.h"
++#include "clce97.h"
+ #include "nv_push_cl906f.h"
+ #include "nv_push_cla16f.h"
+ #include "nv_push_cl9097.h"
+@@ -32,6 +33,7 @@
+ #include "nv_push_clb06f.h"
+ #include "nv_push_clb1c0.h"
+ #include "nv_push_clc597.h"
++#include "nv_push_clc797.h"
+ #include "nv_push_clc86f.h"
+ 
+ static uint8_t
+@@ -550,6 +552,156 @@ nvk_barrier_invalidates(VkPipelineStageFlags2 stages,
+    return barriers;
+ }
+ 
++/* How the 3D class drains colour-attachment work before a fragment-stage
++ * read.  NVIDIA's own driver (libnvidia-eglcore.so 615.78.08, the Vulkan
++ * barrier record built at E 0xc63a00, finalised at E 0xc63f50 and drained
++ * at E 0xc65ae0) orders such a dependency with one PIXEL_SHADER_BARRIER
++ * instead of WAIT_FOR_IDLE and every other dependency with WAIT_FOR_IDLE.
++ * That rule is only known for the classes listed here; every other class
++ * keeps WAIT_FOR_IDLE.
++ */
++static bool
++nvk_class_has_pixel_shader_barrier_drain(const struct nvk_physical_device *pdev)
++{
++   switch (pdev->info.cls_eng3d) {
++   case BLACKWELL_B:
++      return true;
++   default:
++      return false;
++   }
++}
++
++struct nvk_pixel_dep {
++   VkPipelineStageFlags2 src_stages;
++   VkPipelineStageFlags2 dst_stages;
++   /* Every destination access is one a pixel-shader barrier orders */
++   bool dst_pixel_reads;
++   /* A destination reads through the texture / shader-data path */
++   bool dst_tex_reads;
++};
++
++#define NVK_PIXEL_DST_STAGES (VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT | \
++                              VK_PIPELINE_STAGE_2_LATE_FRAGMENT_TESTS_BIT | \
++                              VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT | \
++                              VK_PIPELINE_STAGE_2_BOTTOM_OF_PIPE_BIT)
++
++/* Accesses the destination stages above can perform, as the stock driver's
++ * per-stage access table has them.
++ */
++static VkAccessFlags2
++nvk_pixel_dst_stage_accesses(VkPipelineStageFlags2 stages)
++{
++   VkAccessFlags2 access = 0;
++
++   if (stages & VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT) {
++      access |= VK_ACCESS_2_UNIFORM_READ_BIT |
++                VK_ACCESS_2_INPUT_ATTACHMENT_READ_BIT |
++                VK_ACCESS_2_SHADER_READ_BIT |
++                VK_ACCESS_2_SHADER_WRITE_BIT |
++                VK_ACCESS_2_COLOR_ATTACHMENT_READ_BIT |
++                VK_ACCESS_2_DEPTH_STENCIL_ATTACHMENT_READ_BIT |
++                VK_ACCESS_2_ACCELERATION_STRUCTURE_READ_BIT_KHR |
++                VK_ACCESS_2_SHADER_SAMPLED_READ_BIT |
++                VK_ACCESS_2_SHADER_STORAGE_READ_BIT |
++                VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT |
++                VK_ACCESS_2_SHADER_BINDING_TABLE_READ_BIT_KHR |
++                VK_ACCESS_2_DESCRIPTOR_BUFFER_READ_BIT_EXT |
++                VK_ACCESS_2_SAMPLER_HEAP_READ_BIT_EXT |
++                VK_ACCESS_2_RESOURCE_HEAP_READ_BIT_EXT;
++   }
++   if (stages & VK_PIPELINE_STAGE_2_LATE_FRAGMENT_TESTS_BIT) {
++      access |= VK_ACCESS_2_DEPTH_STENCIL_ATTACHMENT_READ_BIT |
++                VK_ACCESS_2_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
++   }
++   if (stages & VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT) {
++      access |= VK_ACCESS_2_COLOR_ATTACHMENT_READ_BIT |
++                VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT |
++                VK_ACCESS_2_COLOR_ATTACHMENT_READ_NONCOHERENT_BIT_EXT;
++   }
++
++   return access;
++}
++
++static void
++nvk_pixel_dep_add(struct nvk_pixel_dep *dep,
++                  VkPipelineStageFlags2 src_stages,
++                  VkPipelineStageFlags2 dst_stages,
++                  VkAccessFlags2 dst_access)
++{
++   dep->src_stages |= src_stages;
++   dep->dst_stages |= dst_stages;
++
++   /* The generic accesses widen the way the stock driver widens them:
++    * SHADER_READ also covers sampled, storage, binding-table and tile reads,
++    * SHADER_WRITE storage and tile writes, MEMORY_READ / MEMORY_WRITE every
++    * read / write.
++    */
++   VkAccessFlags2 access = dst_access;
++   if (dst_access & VK_ACCESS_2_SHADER_READ_BIT)
++      access |= VK_ACCESS_2_SHADER_SAMPLED_READ_BIT |
++                VK_ACCESS_2_SHADER_STORAGE_READ_BIT |
++                VK_ACCESS_2_SHADER_BINDING_TABLE_READ_BIT_KHR |
++                VK_ACCESS_2_SHADER_TILE_ATTACHMENT_READ_BIT_QCOM;
++   if (dst_access & VK_ACCESS_2_SHADER_WRITE_BIT)
++      access |= VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT |
++                VK_ACCESS_2_SHADER_TILE_ATTACHMENT_WRITE_BIT_QCOM;
++   if (dst_access & VK_ACCESS_2_MEMORY_READ_BIT)
++      access |= VK_ACCESS_2_UNIFORM_READ_BIT |
++                VK_ACCESS_2_INPUT_ATTACHMENT_READ_BIT |
++                VK_ACCESS_2_SHADER_READ_BIT |
++                VK_ACCESS_2_COLOR_ATTACHMENT_READ_BIT |
++                VK_ACCESS_2_DEPTH_STENCIL_ATTACHMENT_READ_BIT |
++                VK_ACCESS_2_ACCELERATION_STRUCTURE_READ_BIT_KHR |
++                VK_ACCESS_2_SHADER_SAMPLED_READ_BIT |
++                VK_ACCESS_2_SHADER_STORAGE_READ_BIT |
++                VK_ACCESS_2_SHADER_BINDING_TABLE_READ_BIT_KHR |
++                VK_ACCESS_2_DESCRIPTOR_BUFFER_READ_BIT_EXT |
++                VK_ACCESS_2_COLOR_ATTACHMENT_READ_NONCOHERENT_BIT_EXT |
++                VK_ACCESS_2_SAMPLER_HEAP_READ_BIT_EXT |
++                VK_ACCESS_2_RESOURCE_HEAP_READ_BIT_EXT;
++   if (dst_access & VK_ACCESS_2_MEMORY_WRITE_BIT)
++      access |= VK_ACCESS_2_SHADER_WRITE_BIT |
++                VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT |
++                VK_ACCESS_2_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT |
++                VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT;
++
++   access &= nvk_pixel_dst_stage_accesses(dst_stages);
++
++   const VkAccessFlags2 pixel_reads =
++      VK_ACCESS_2_UNIFORM_READ_BIT |
++      VK_ACCESS_2_INPUT_ATTACHMENT_READ_BIT |
++      VK_ACCESS_2_SHADER_READ_BIT |
++      VK_ACCESS_2_COLOR_ATTACHMENT_READ_BIT |
++      VK_ACCESS_2_COLOR_ATTACHMENT_READ_NONCOHERENT_BIT_EXT |
++      VK_ACCESS_2_SHADER_SAMPLED_READ_BIT |
++      VK_ACCESS_2_SHADER_STORAGE_READ_BIT;
++   if (access & ~pixel_reads)
++      dep->dst_pixel_reads = false;
++
++   if (access & (VK_ACCESS_2_INPUT_ATTACHMENT_READ_BIT |
++                 VK_ACCESS_2_SHADER_READ_BIT |
++                 VK_ACCESS_2_SHADER_SAMPLED_READ_BIT |
++                 VK_ACCESS_2_SHADER_STORAGE_READ_BIT))
++      dep->dst_tex_reads = true;
++}
++
++/* The source is colour-attachment output and nothing else (stock: the
++ * source stages minus COLOR_ATTACHMENT_OUTPUT are empty, TOP_OF_PIPE
++ * included), the destination stages are fragment shading, late fragment
++ * tests, colour-attachment output or bottom of pipe, and every destination
++ * access is a read those stages order behind a pixel-shader barrier.  The
++ * stock driver handles VK_DEPENDENCY_BY_REGION_BIT with an undocumented
++ * method instead; a by-region dependency is weaker than the full one, so the
++ * full form below covers it.
++ */
++static bool
++nvk_pixel_dep_is_pixel_ordered(const struct nvk_pixel_dep *dep)
++{
++   return dep->src_stages == VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT &&
++          !(dep->dst_stages & ~NVK_PIXEL_DST_STAGES) &&
++          dep->dst_pixel_reads;
++}
++
+ void
+ nvk_cmd_flush_wait_dep(struct nvk_cmd_buffer *cmd,
+                        const VkDependencyInfo *dep,
+@@ -562,6 +714,7 @@ nvk_cmd_flush_wait_dep(struct nvk_cmd_buffer *cmd,
+       nvk_queue_engines_from_queue_flags(queue_flags);
+ 
+    enum nvk_barrier barriers = 0;
++   struct nvk_pixel_dep pixel_dep = { .dst_pixel_reads = true };
+ 
+    /* For asymmetric, we don't know what the access flags will be yet.
+     * Handle this by setting access to everything.
+@@ -576,18 +729,24 @@ nvk_cmd_flush_wait_dep(struct nvk_cmd_buffer *cmd,
+       barriers |= nvk_barrier_flushes_waits(bar->srcStageMask,
+                                             VK_ACCESS_2_MEMORY_READ_BIT |
+                                             VK_ACCESS_2_MEMORY_WRITE_BIT);
++      /* The destination is not known yet */
++      pixel_dep.dst_pixel_reads = false;
+    }
+ 
+    for (uint32_t i = 0; i < dep->memoryBarrierCount; i++) {
+       const VkMemoryBarrier2 *bar = &dep->pMemoryBarriers[i];
+       barriers |= nvk_barrier_flushes_waits(bar->srcStageMask,
+                                             bar->srcAccessMask);
++      nvk_pixel_dep_add(&pixel_dep, bar->srcStageMask, bar->dstStageMask,
++                        bar->dstAccessMask);
+    }
+ 
+    for (uint32_t i = 0; i < dep->bufferMemoryBarrierCount; i++) {
+       const VkBufferMemoryBarrier2 *bar = &dep->pBufferMemoryBarriers[i];
+       barriers |= nvk_barrier_flushes_waits(bar->srcStageMask,
+                                             bar->srcAccessMask);
++      nvk_pixel_dep_add(&pixel_dep, bar->srcStageMask, bar->dstStageMask,
++                        bar->dstAccessMask);
+ 
+       if (bar->srcQueueFamilyIndex == VK_QUEUE_FAMILY_FOREIGN_EXT)
+          barriers |= NVK_BARRIER_HOST_WFI_INVALIDATE_SYSMEM;
+@@ -597,6 +756,8 @@ nvk_cmd_flush_wait_dep(struct nvk_cmd_buffer *cmd,
+       const VkImageMemoryBarrier2 *bar = &dep->pImageMemoryBarriers[i];
+       barriers |= nvk_barrier_flushes_waits(bar->srcStageMask,
+                                             bar->srcAccessMask);
++      nvk_pixel_dep_add(&pixel_dep, bar->srcStageMask, bar->dstStageMask,
++                        bar->dstAccessMask);
+ 
+       if (bar->srcQueueFamilyIndex == VK_QUEUE_FAMILY_FOREIGN_EXT)
+          barriers |= NVK_BARRIER_HOST_WFI_INVALIDATE_SYSMEM;
+@@ -631,6 +792,26 @@ nvk_cmd_flush_wait_dep(struct nvk_cmd_buffer *cmd,
+        */
+       switch (nvk_cmd_buffer_last_subchannel(cmd)) {
+       case SUBC_NV9097: {
++         if (nvk_class_has_pixel_shader_barrier_drain(pdev) &&
++             nvk_pixel_dep_is_pixel_ordered(&pixel_dep)) {
++            struct nv_push *p = nvk_cmd_buffer_push(cmd, 4);
++            P_IMMD(p, NVC797, PIXEL_SHADER_BARRIER, {
++               .sysmembar_enable = SYSMEMBAR_ENABLE_FALSE,
++               .barrier_location = BARRIER_LOCATION_BLOCK_BEFORE_PS,
++            });
++            /* The stock driver follows the barrier with the class's
++             * undocumented method 0x0f74 when a destination reads through
++             * the texture / shader-data path (libnvidia-eglcore.so
++             * 615.78.08 E 0xc64090, word 0x800003dd), in place of its
++             * texture-data invalidate.  Its effect is not documented, so
++             * the INVALIDATE_TEXTURE_DATA_CACHE_NO_WFI that
++             * nvk_cmd_invalidate_deps() emits for these reads stays as
++             * well.
++             */
++            if (pixel_dep.dst_tex_reads)
++               __push_immd(p, SUBC_NV9097, 0x0f74, 0);
++            break;
++         }
+          struct nv_push *p = nvk_cmd_buffer_push(cmd, 2);
+          P_IMMD(p, NV9097, WAIT_FOR_IDLE, 0);
+          break;
diff --git a/nvidia-prolapse/driver-source/native/mesa/tests/README.md b/nvidia-prolapse/driver-source/native/mesa/tests/README.md
index 4c2422a..220d220 100644
--- a/nvidia-prolapse/driver-source/native/mesa/tests/README.md
+++ b/nvidia-prolapse/driver-source/native/mesa/tests/README.md
@@ -604,6 +604,43 @@ draw is RED in every round. Variants (`./gl-texpool-rebind ROUNDS ITERS [variant
 PASS, 0 wrong pixels of 4,194,304 per round (none/zero 6 rounds, wrap/ctx2/free 4 rounds); in `wrap` batch 2..8
 took 32.4 ms to submit (the ring-slot wait for batch 1). 0 Xid.
 
+## vk-barrier-order.c (pipeline-barrier ordering: colour -> sampled, compute -> compute, compute -> fragment)
+
+    T=build/barrier-order/test; mkdir -p $T; S=nvidia-prolapse/driver-source/native/mesa/tests
+    for x in QUAD:vert:quad FILL:frag:fill SAMPLE:frag:sample SSBO:frag:ssbo PRODUCE:comp:produce CONSUME:comp:consume; do
+      IFS=: read D ST NM <<< "$x"
+      glslangValidator -V -S $ST -D$D $S/vk-barrier-order.glsl --vn vk_barrier_order_$NM -o $T/vk-barrier-order.$NM.h
+    done
+    cc -std=c11 -Wall -Wextra -Werror -I$T $S/vk-barrier-order.c -lvulkan -o $T/vk-barrier-order
+    E="VK_DRIVER_FILES=$PWD/build/nvk-host/native-rm-icd.json VK_LOADER_LAYERS_DISABLE=~implicit~"
+    for spin in 0 300 2000 20000; do env $E $T/vk-barrier-order 40 $spin; done
+    env $E $T/vk-barrier-order 5 2000 unordered                            # negative control: must FAIL
+    VK_DRIVER_FILES=/usr/share/vulkan/icd.d/nvidia_icd.json $T/vk-barrier-order 10 2000   # stock reference
+    NVK_DEBUG=push_dump env $E $T/vk-barrier-order 1 2000 2>&1 | grep -c PIXEL_SHADER_BARRIER   # 12 on Blackwell B
+
+Per round, with a producer that spins SPIN iterations before writing: colour (draw into C, barrier
+COLOR_ATTACHMENT_OUTPUT/WRITE -> FRAGMENT_SHADER/SAMPLED_READ as image barrier, memory barrier in GENERAL, and
+image barrier with BY_REGION, then a draw sampling C), compute (dispatch writes A, CS storage barrier, dispatch
+reads A), cs-gfx (dispatch writes A, barrier to FRAGMENT_SHADER/STORAGE_READ, draw reads A per pixel). 12 rounds per
+command buffer, every result compared exactly. PASS = 0 mismatches. `unordered` replaces the three barriers by
+TOP -> BOTTOM without accesses: colour and compute then fail on both drivers (stale previous-round values);
+cs-gfx passes even unordered on this host (the compute -> 3D switch orders it), so it only guards the
+CS -> FS case against corruption, not ordering. On Blackwell B the colour barrier is PIXEL_SHADER_BARRIER
+(words 0x80000378, 0x800003dd = method 0x0f74, then INVALIDATE_TEXTURE_DATA_CACHE_NO_WFI) instead of
+WAIT_FOR_IDLE, as NVIDIA's driver emits it (libnvidia-eglcore.so 615.78.08 E 0xc65e10 / E 0xc64090).
+10-24 (RTX 5090): 480 rounds per case at spin 0 / 300 / 2000 / 20000, all PASS; stock PASS; unordered FAIL on
+both (colour 60/60 and compute 57-60/60 bad rounds). 0 Xid.
+
+## nak-qmd-membar.c (CWD_MEMBAR_TYPE in the QMDs of the built NVK)
+
+    M=build/mesa-rm-source; B=build/nvk-host; S=nvidia-prolapse/driver-source/native/mesa/tests
+    cc -std=gnu11 -DHAVE_FUNC_ATTRIBUTE_PACKED -DHAVE_ENDIAN_H -DUTIL_ARCH_LITTLE_ENDIAN=1 -DUTIL_ARCH_BIG_ENDIAN=0 \
+       -I$M/src/nouveau/compiler -I$M/src/nouveau/headers -I$M/src/compiler -I$M/src/compiler/nir -I$B/src/compiler/nir \
+       -I$M/include -I$M/src -I$B/src/compiler -I$B/src $S/nak-qmd-membar.c -ldl -o build/nak-qmd-membar
+    build/nak-qmd-membar $B/src/nouveau/vulkan/libvulkan_nouveau.so
+
+PASS = CWD_MEMBAR_TYPE 3 (dword 19 = 0x00030000) for cec0 and 0 for cdc0. 10-24: PASS.
+
 ## vk-zcull-depth.c (depth-tested rendering with ZCULL active on the RM backend)
 
