index 77f9fb1..a0e02f7 100644
--- a/packaging/native/release_gate.py
+++ b/packaging/native/release_gate.py
@@ -190,10 +190,68 @@ def needed(path, leaf_ok=False, remedy=REMEDY_BUNDLE):
     return names
 
 
+EROFS_MAGIC = 0xE0F5E1E2
+
+
+def _is_erofs(image):
+    with open(image, 'rb') as f:
+        f.seek(1024)
+        return int.from_bytes(f.read(4), 'little') == EROFS_MAGIC
+
+
+def _dump_raw(image, source, dest):
+    """One file out of an ext4 (debugfs) or EROFS (dump.erofs) image; Android 15+ system images are EROFS."""
+    if _is_erofs(image):
+        with open(dest, 'wb') as out:
+            subprocess.run(['dump.erofs', f'--path={source}', '--cat', str(image)], stdout=out,
+                           stderr=subprocess.DEVNULL, check=False)
+    else:
+        subprocess.run(['debugfs', '-R', f'dump {source} {dest}', str(image)], capture_output=True, check=True)
+    return dest.is_file() and dest.stat().st_size > 0
+
+
+_APEX_PAYLOADS = {}
+
+
+def _apex_payload(image, apex, scratch):
+    """apex_payload.img of the packed /system/apex/<apex>.apex (or .capex) in `image`, extracted once into
+    scratch. Android 14+ images ship the runtime and other APEXes packed instead of flattened."""
+    key = (str(image), apex)
+    if key in _APEX_PAYLOADS:
+        return _APEX_PAYLOADS[key]
+    import zipfile
+    payload = None
+    for suffix in ('.apex', '.capex'):
+        packed = scratch / f'{apex}{suffix}'
+        if not _dump_raw(image, f'/system/apex/{apex}{suffix}', packed):
+            packed.unlink(missing_ok=True)
+            continue
+        with zipfile.ZipFile(packed) as z:
+            if suffix == '.capex':
+                inner = scratch / f'{apex}.apex'
+                inner.write_bytes(z.read('original_apex'))
+                packed.unlink()
+                packed = inner
+        with zipfile.ZipFile(packed) as z:
+            payload = scratch / f'{apex}.payload.img'
+            payload.write_bytes(z.read('apex_payload.img'))
+        packed.unlink()
+        break
+    _APEX_PAYLOADS[key] = payload
+    return payload
+
+
 def _dump(image, source, dest):
     dest.unlink(missing_ok=True)
-    subprocess.run(['debugfs', '-R', f'dump {source} {dest}', str(image)], capture_output=True, check=True)
-    return dest.is_file() and dest.stat().st_size > 0
+    if _dump_raw(image, source, dest):
+        return True
+    m = re.match(r'^/system/apex/([^/]+)(/.+)$', source)
+    if not m:
+        return False
+    scratch = Path(os.environ.get('TMPDIR', '/tmp')) / f'gate-apex-payloads-{os.getpid()}'
+    scratch.mkdir(exist_ok=True)
+    payload = _apex_payload(image, m.group(1), scratch)
+    return bool(payload) and _dump_raw(payload, m.group(2), dest)
 
 
