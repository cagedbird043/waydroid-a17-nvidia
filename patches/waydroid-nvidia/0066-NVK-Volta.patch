++   const uint32_t q = tpcs / pipes;
++   uint64_t t = MIN2((uint64_t)q * w_max + 0x80, 0xffffffffull);
++   const uint64_t prod = (uint64_t)((uint32_t)t >> 8) * pipes;
++   const uint32_t r11 = MIN2(prod, 0xffffffffull);
