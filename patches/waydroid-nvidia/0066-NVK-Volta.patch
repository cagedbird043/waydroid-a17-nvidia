++/* SET_SCG_CONTROL of the proprietary driver's compute-context initialiser
++ * (615.78.08 E 0x56f326..E 0x56f4b6, one word per subdevice): with
++ * tpcs = SHADER_PIPE_SUB_COUNT and pipes = SHADER_PIPE_COUNT, and its default
