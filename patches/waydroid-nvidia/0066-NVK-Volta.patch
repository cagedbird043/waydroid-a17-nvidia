++/// RELEASE0 of a Volta/Turing (QMD V02_02) dispatch: a one-word semaphore
++/// reduction ADD of `payload` (unsigned 32-bit) to `addr` when the grid
++/// completes.  The proprietary driver gives every dispatch QMD this release
++/// to a per-command-buffer launch counter, payload 1
++/// (libnvidia-eglcore.so.615.78.08 ELF 0xaee500, called for each dispatch
++/// at ELF 0xbdffd6; its V02 arm sets SEMAPHORE_RELEASE_ENABLE0, the address,
++/// payload 1, REDUCTION_ENABLE and STRUCTURE_SIZE ONE_WORD with RED_ADD /
++/// UNSIGNED_32).  Other QMD layouts are not handled here.
++#[no_mangle]
++pub extern "C" fn nak_qmd_set_release0_add(
++    dev: &nv_device_info,
++    qmd: *mut ::std::os::raw::c_void,
++    qmd_size: usize,
++    addr: u64,
++    payload: u32,
++) {
++    assert!(
++        dev.cls_compute >= clc3c0::VOLTA_COMPUTE_A
++            && dev.cls_compute < clc6c0::AMPERE_COMPUTE_A,
++        "QMD RELEASE0 is only set in the QMD V02_02 layout (Volta, Turing)"
++    );
++    assert!(!qmd.is_null());
++    assert!(qmd_size == size_of::<Qmd2_2>());
++    let words =
++        unsafe { std::slice::from_raw_parts_mut(qmd as *mut u32, qmd_size / 4) };
++    use nvidia_headers::classes::clc3c0::qmd as q;
++    let mut bv = QMDBitView::new(words);
++    set_enum!(bv, q, QMDV02_02, SEMAPHORE_RELEASE_ENABLE0, TRUE);
++    set_field!(bv, q, QMDV02_02, RELEASE0_ADDRESS_LOWER, addr as u32);
