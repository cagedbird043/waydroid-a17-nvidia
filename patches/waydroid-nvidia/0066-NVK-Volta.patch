@@ -0,0 +1,217 @@
+nak/nvk: dispatch QMD occupancy (Ampere B to Hopper) and launch queue by queue family
+
+NVIDIA's driver (libnvidia-eglcore.so.615.78.08) writes the QMD occupancy
+limits on every dispatch for the AMPERE_COMPUTE_B, Ada and Hopper QMD layouts
+too (setters ELF 0xaa1700 / 0xaa17e0; values threshold shared memory 0,
+registers 0x40, warps 0x10, maxima 0xff), and per recording queue family
+CTA_LAUNCH_QUEUE (0 graphics / 1 compute, from AMPERE_COMPUTE_B on) and
+QMD_GROUP_ID (0x1f graphics / 0x20 compute, from Turing on) at ELF 0xc5aed0.
+A compute-only channel has no 3D class: the indirect dispatch sizes the MME
+data FIFO through the compute class there (clc7c0.h..clcbc0.h 0x0574).
+
+--- a/src/nouveau/compiler/nak.h
++++ b/src/nouveau/compiler/nak.h
+@@ -334,6 +334,11 @@
+ struct nak_qmd_cbuf_desc_layout
+ nak_get_qmd_cbuf_desc_layout(const struct nv_device_info *dev, uint8_t idx);
+ 
++/* CTA_LAUNCH_QUEUE / QMD_GROUP_ID by the recording queue family. */
++void nak_qmd_set_launch_queue(const struct nv_device_info *dev,
++                              void *qmd, size_t qmd_size,
++                              bool compute_family);
++
+ /* QMD dependency fields (Blackwell B compute only; other classes abort). */
+ void nak_qmd_set_empty_grid(const struct nv_device_info *dev,
+                             void *qmd, size_t qmd_size);
