++          * No subchannel switch happens there, so stall the command
++          * streamer explicitly as on Blackwell below.
++          */
++         assert(nvk_cmd_buffer_compute_cls(cmd) >= AMPERE_COMPUTE_B);
++         if (nvk_cmd_buffer_compute_cls(cmd) >= HOPPER_COMPUTE_A)
++            __push_immd(p, nvk_cmd_buffer_host_subc(cmd), NVC86F_WFI, 0);
++         else
++            __push_immd(p, nvk_cmd_buffer_host_subc(cmd), NV906F_SET_REFERENCE, 0);
++         P_IMMD(p, NVC7C0, SET_MME_DATA_FIFO_CONFIG, FIFO_SIZE_SIZE_4KB);
+       } else {
+          /* The line in the other side of the if causes an implicit wfi
+           * due to the subc switch which we apparently rely on for
diff --git a/nvidia-prolapse/driver-source/native/mesa/nv_rm.h b/nvidia-prolapse/driver-source/native/mesa/nv_rm.h
