+ use nvidia_headers::classes::{
+-    cla0c0, clc0c0, clc3c0, clc6c0, clcbc0, clcdc0, clcec0,
++    cla0c0, clc0c0, clc3c0, clc5c0, clc6c0, clc7c0, clcbc0, clcdc0, clcec0,
+ };
+ 
+ use bitview::*;
+@@ -512,6 +512,7 @@
+ mod qmd_3_0 {
+     use crate::qmd::*;
+     use nvidia_headers::classes::clc6c0::qmd as clc6c0;
++    use nvidia_headers::classes::clc7c0::qmd as clc7c0;
+ 
+     #[repr(transparent)]
+     pub struct Qmd3_0 {
+@@ -539,6 +540,26 @@
+         qmd_impl_set_smem_size_bounded!(clc6c0, QMDV03_00);
+         qmd_impl_set_slm_size!(clc6c0, QMDV03_00, NONE);
+     }
++
++    impl Qmd3_0 {
++        /// Occupancy limits of the grid in the AMPERE_COMPUTE_B+ QMD V03_00
++        /// layout (clc7c0qmd.h / clc9c0qmd.h; the AMPERE_COMPUTE_A layout in
++        /// clc6c0qmd.h has no such fields).  NVIDIA's driver
++        /// (libnvidia-eglcore.so.615.78.08, setters at ELF 0xaa1700 /
++        /// 0xaa17e0, their 0xc7c0 / 0xc9c0 arms) writes these values on every
++        /// dispatch; with them left 0 a grid that fills the GPU and graphics
++        /// work of another subcontext in the same channel group time-slice
++        /// instead of running together.
++        pub fn set_occupancy(&mut self) {
++            let mut bv = QMDBitView::new(&mut self.qmd);
++            set_field!(bv, clc7c0, QMDV03_00, OCCUPANCY_THRESHOLD_SHARED_MEM, 0_u32);
