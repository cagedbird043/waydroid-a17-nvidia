             gptimer_max: u32::MAX,
             general_bits: 1, // tileformat 1, GOB_2 (stock and V0)
@@ -116,10 +131,20 @@ impl HevcDecoder {
             epoch: 0,
             epoch_max_poc: None,
             bit_depth,
+            chroma_444,
             gen: NvdecGen::of(decoder_class),
