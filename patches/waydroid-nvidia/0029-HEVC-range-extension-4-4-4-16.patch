--- a/nvidia-prolapse/driver-source/native/src/video/hevc/codec.rs
+++ b/nvidia-prolapse/driver-source/native/src/video/hevc/codec.rs
@@ -38,6 +38,8 @@ pub struct HevcDecoder {
     epoch_max_poc: Option<i32>,
     /// Session bit depth (8 = Main, 10 = Main 10); surfaces are sized for it.
