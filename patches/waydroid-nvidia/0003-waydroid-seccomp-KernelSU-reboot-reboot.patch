 .../0002-seccomp-allow-kernelsu-supercall.patch    | 14 ++++++++++++++
 1 file changed, 14 insertions(+)
 create mode 100644 waydroid/0002-seccomp-allow-kernelsu-supercall.patch

diff --git a/waydroid/0002-seccomp-allow-kernelsu-supercall.patch b/waydroid/0002-seccomp-allow-kernelsu-supercall.patch
new file mode 100644
index 0000000..a00e0f1
--- /dev/null
+++ b/waydroid/0002-seccomp-allow-kernelsu-supercall.patch
@@ -0,0 +1,14 @@
+KernelSU (host kernelsu-dkms) hands its driver fd out through reboot(0xDEADBEEF, 0xCAFEBABE, 0, &fd);
+the container's blacklist kills every reboot(2). Keep killing all other reboot calls.
+
+--- a/data/configs/waydroid.seccomp
++++ b/data/configs/waydroid.seccomp
+@@ -6,7 +6,7 @@
+ _sysctl
+ kexec_file_load
+ kexec_load
+-reboot
++reboot kill [0,3735928559,SCMP_CMP_NE]
+ open_by_handle_at errno 38
+ adjtimex errno 0
+ clock_adjtime errno 0
