+        let mut r: i8 = -1;
+        for i in 0..NUM_REF_FRAMES {
+            let hint = shifted[i];
+            if !used[i] && hint >= cur && (r < 0 || hint < earliest) {
+                r = i as i8;
+                earliest = hint;
+            }
+        }
