+            let hint = shifted[i];
+            if r < 0 || hint < earliest {
+                r = i as i8;
+                earliest = hint;
+            }
+        }
+        for k in idx.iter_mut() {
+            if *k == 0xff {
+                *k = r as u8;
+            }
+        }
