+-/// RELEASE0 of a Volta/Turing (QMD V02_02) dispatch: a one-word semaphore
+-/// reduction ADD of `payload` (unsigned 32-bit) to `addr` when the grid
+-/// completes.  The proprietary driver gives every dispatch QMD this release
+-/// to a per-command-buffer launch counter, payload 1
+-/// (libnvidia-eglcore.so.615.78.08 ELF 0xaee500, called for each dispatch
+-/// at ELF 0xbdffd6; its V02 arm sets SEMAPHORE_RELEASE_ENABLE0, the address,
+-/// payload 1, REDUCTION_ENABLE and STRUCTURE_SIZE ONE_WORD with RED_ADD /
+-/// UNSIGNED_32).  Other QMD layouts are not handled here.
++/// RELEASE0 of a dispatch: a one-word semaphore reduction ADD of `payload`
++/// (unsigned 32-bit) to `addr` when the grid completes.  The proprietary
++/// driver gives every dispatch QMD this release to a per-command-buffer
++/// launch counter, payload 1 (libnvidia-eglcore.so.615.78.08 ELF 0xaee500,
++/// called for each dispatch at ELF 0xbdffd6 and for each internal kernel
++/// launch).  It has one arm per QMD layout: V02 sets
++/// SEMAPHORE_RELEASE_ENABLE0 (ELF 0xaee51e), V03 RELEASE0_ENABLE |
++/// REDUCTION_ENABLE | STRUCTURE_SIZE ONE_WORD (ELF 0xaee555 `or
++/// $0x44800000`), V04 and V05 RELEASE_ENABLE(0) | STRUCTURE_SIZE(0)
++/// ONE_WORD | REDUCTION_ENABLE(0) (ELF 0xaee5b5 / ELF 0xaee578 `or $0x13`),
++/// each with the address, payload 1 and the reduction op and format cleared
++/// to RED_ADD / UNSIGNED (32-bit); the membar type stays as the QMD has it.
+ #[no_mangle]
+ pub extern "C" fn nak_qmd_set_release0_add(
+     dev: &nv_device_info,
+@@ -1231,22 +1235,83 @@
+     payload: u32,
+ ) {
+     assert!(
+-        dev.cls_compute >= clc3c0::VOLTA_COMPUTE_A
+-            && dev.cls_compute < clc6c0::AMPERE_COMPUTE_A,
+-        "QMD RELEASE0 is only set in the QMD V02_02 layout (Volta, Turing)"
++        dev.cls_compute >= clc3c0::VOLTA_COMPUTE_A,
++        "QMD RELEASE0 needs a Volta or later QMD layout"
+     );
+     assert!(!qmd.is_null());
+-    assert!(qmd_size == size_of::<Qmd2_2>());
+     let words =
+         unsafe { std::slice::from_raw_parts_mut(qmd as *mut u32, qmd_size / 4) };
+-    use nvidia_headers::classes::clc3c0::qmd as q;
++    let lo = addr as u32;
++    let hi = (addr >> 32) as u32;
+     let mut bv = QMDBitView::new(words);
+-    set_enum!(bv, q, QMDV02_02, SEMAPHORE_RELEASE_ENABLE0, TRUE);
+-    set_field!(bv, q, QMDV02_02, RELEASE0_ADDRESS_LOWER, addr as u32);
+-    set_field!(bv, q, QMDV02_02, RELEASE0_ADDRESS_UPPER, (addr >> 32) as u32);
+-    set_enum!(bv, q, QMDV02_02, RELEASE0_REDUCTION_OP, RED_ADD);
+-    set_enum!(bv, q, QMDV02_02, RELEASE0_REDUCTION_FORMAT, UNSIGNED_32);
+-    set_enum!(bv, q, QMDV02_02, RELEASE0_REDUCTION_ENABLE, TRUE);
+-    set_enum!(bv, q, QMDV02_02, RELEASE0_STRUCTURE_SIZE, ONE_WORD);
+-    set_field!(bv, q, QMDV02_02, RELEASE0_PAYLOAD, payload);
++    if dev.cls_compute >= clcdc0::BLACKWELL_COMPUTE_A {
++        assert!(qmd_size == size_of::<Qmd5_0>());
++        use nvidia_headers::classes::clcdc0::qmd as q;
++        set_array!(bv, q, QMDV05_00, RELEASE_ENABLE, 0, q::QMDV05_00_RELEASE_ENABLE_TRUE);
++        set_array!(bv, q, QMDV05_00, RELEASE_STRUCTURE_SIZE, 0,
++                   q::QMDV05_00_RELEASE_STRUCTURE_SIZE_SEMAPHORE_ONE_WORD);
++        set_array!(bv, q, QMDV05_00, RELEASE_REDUCTION_ENABLE, 0,
++                   q::QMDV05_00_RELEASE_REDUCTION_ENABLE_TRUE);
++        set_array!(bv, q, QMDV05_00, RELEASE_REDUCTION_OP, 0,
++                   q::QMDV05_00_RELEASE_REDUCTION_OP_RED_ADD);
++        set_array!(bv, q, QMDV05_00, RELEASE_REDUCTION_FORMAT, 0,
++                   q::QMDV05_00_RELEASE_REDUCTION_FORMAT_UNSIGNED);
++        set_array!(bv, q, QMDV05_00, RELEASE_PAYLOAD64B, 0,
++                   q::QMDV05_00_RELEASE_PAYLOAD64B_FALSE);
++        set_field!(bv, q, QMDV05_00, RELEASE_SEMAPHORE0_ADDR_LOWER, lo);
++        set_field!(bv, q, QMDV05_00, RELEASE_SEMAPHORE0_ADDR_UPPER, hi);
++        set_field!(bv, q, QMDV05_00, RELEASE_SEMAPHORE0_PAYLOAD_LOWER, payload);
++    } else if dev.cls_compute >= clcbc0::HOPPER_COMPUTE_A {
++        assert!(qmd_size == size_of::<Qmd4_0>());
++        use nvidia_headers::classes::clcbc0::qmd as q;
++        set_array!(bv, q, QMDV04_00, RELEASE_ENABLE, 0, q::QMDV04_00_RELEASE_ENABLE_TRUE);
++        set_array!(bv, q, QMDV04_00, RELEASE_STRUCTURE_SIZE, 0,
++                   q::QMDV04_00_RELEASE_STRUCTURE_SIZE_SEMAPHORE_ONE_WORD);
++        set_array!(bv, q, QMDV04_00, RELEASE_REDUCTION_ENABLE, 0,
++                   q::QMDV04_00_RELEASE_REDUCTION_ENABLE_TRUE);
++        set_array!(bv, q, QMDV04_00, RELEASE_REDUCTION_OP, 0,
++                   q::QMDV04_00_RELEASE_REDUCTION_OP_RED_ADD);
++        set_array!(bv, q, QMDV04_00, RELEASE_REDUCTION_FORMAT, 0,
++                   q::QMDV04_00_RELEASE_REDUCTION_FORMAT_UNSIGNED);
++        set_array!(bv, q, QMDV04_00, RELEASE_PAYLOAD64B, 0,
++                   q::QMDV04_00_RELEASE_PAYLOAD64B_FALSE);
++        set_field!(bv, q, QMDV04_00, RELEASE_SEMAPHORE0_ADDR_LOWER, lo);
++        set_field!(bv, q, QMDV04_00, RELEASE_SEMAPHORE0_ADDR_UPPER, hi);
++        set_field!(bv, q, QMDV04_00, RELEASE_SEMAPHORE0_PAYLOAD_LOWER, payload);
++    } else if dev.cls_compute >= clc7c0::AMPERE_COMPUTE_B {
++        assert!(qmd_size == size_of::<Qmd3_0>());
++        use nvidia_headers::classes::clc7c0::qmd as q;
++        set_enum!(bv, q, QMDV03_00, RELEASE0_ENABLE, TRUE);
++        set_enum!(bv, q, QMDV03_00, RELEASE0_STRUCTURE_SIZE, SEMAPHORE_ONE_WORD);
++        set_enum!(bv, q, QMDV03_00, RELEASE0_REDUCTION_ENABLE, TRUE);
++        set_enum!(bv, q, QMDV03_00, RELEASE0_REDUCTION_OP, RED_ADD);
++        set_enum!(bv, q, QMDV03_00, RELEASE0_REDUCTION_FORMAT, UNSIGNED);
++        set_enum!(bv, q, QMDV03_00, RELEASE0_PAYLOAD64B, FALSE);
++        set_field!(bv, q, QMDV03_00, RELEASE0_ADDRESS_LOWER, lo);
++        set_field!(bv, q, QMDV03_00, RELEASE0_ADDRESS_UPPER, hi);
++        set_field!(bv, q, QMDV03_00, RELEASE0_PAYLOAD_LOWER, payload);
++    } else if dev.cls_compute >= clc6c0::AMPERE_COMPUTE_A {
++        assert!(qmd_size == size_of::<Qmd3_0>());
++        use nvidia_headers::classes::clc6c0::qmd as q;
++        set_enum!(bv, q, QMDV03_00, RELEASE0_ENABLE, TRUE);
++        set_enum!(bv, q, QMDV03_00, RELEASE0_STRUCTURE_SIZE, SEMAPHORE_ONE_WORD);
++        set_enum!(bv, q, QMDV03_00, RELEASE0_REDUCTION_ENABLE, TRUE);
++        set_enum!(bv, q, QMDV03_00, RELEASE0_REDUCTION_OP, RED_ADD);
++        set_enum!(bv, q, QMDV03_00, RELEASE0_REDUCTION_FORMAT, UNSIGNED_32);
++        set_enum!(bv, q, QMDV03_00, RELEASE0_PAYLOAD64B, FALSE);
++        set_field!(bv, q, QMDV03_00, RELEASE0_ADDRESS_LOWER, lo);
++        set_field!(bv, q, QMDV03_00, RELEASE0_ADDRESS_UPPER, hi);
++        set_field!(bv, q, QMDV03_00, RELEASE0_PAYLOAD_LOWER, payload);
++    } else {
++        assert!(qmd_size == size_of::<Qmd2_2>());
++        use nvidia_headers::classes::clc3c0::qmd as q;
++        set_enum!(bv, q, QMDV02_02, SEMAPHORE_RELEASE_ENABLE0, TRUE);
++        set_field!(bv, q, QMDV02_02, RELEASE0_ADDRESS_LOWER, lo);
++        set_field!(bv, q, QMDV02_02, RELEASE0_ADDRESS_UPPER, hi);
++        set_enum!(bv, q, QMDV02_02, RELEASE0_REDUCTION_OP, RED_ADD);
++        set_enum!(bv, q, QMDV02_02, RELEASE0_REDUCTION_FORMAT, UNSIGNED_32);
++        set_enum!(bv, q, QMDV02_02, RELEASE0_REDUCTION_ENABLE, TRUE);
++        set_enum!(bv, q, QMDV02_02, RELEASE0_STRUCTURE_SIZE, ONE_WORD);
++        set_field!(bv, q, QMDV02_02, RELEASE0_PAYLOAD, payload);
++    }
+ }
+--- a/src/nouveau/vulkan/nvk_cmd_buffer.c
++++ b/src/nouveau/vulkan/nvk_cmd_buffer.c
+@@ -68,6 +68,8 @@
+    util_dynarray_fini(&cmd->pushes);
+    util_dynarray_fini(&cmd->copy_memory_indirect_temps);
+    util_dynarray_fini(&cmd->sked.qmds);
++   if (cmd->cntr.scratch != 0)
++      nvk_cmd_pool_free_counter_scratch(pool, cmd->cntr.scratch);
+    vk_command_buffer_finish(&cmd->vk);
+    vk_free(&pool->vk.alloc, cmd);
+ }
+@@ -142,6 +144,12 @@
+    cmd->sked.wfi_drain = false;
+    cmd->sked.render_override = false;
+    util_dynarray_clear(&cmd->sked.qmds);
++   cmd->cntr.started = false;
++   cmd->cntr.launches = 0;
++   cmd->cntr.pending = 0;
++   cmd->cntr.other_work = false;
++   cmd->cntr.mark = NULL;
++   cmd->cntr.waited = false;
+ 
+    util_dynarray_clear(&cmd->pushes);
+    util_dynarray_clear(&cmd->copy_memory_indirect_temps);
+@@ -426,9 +434,149 @@
+    if (queue_flags & VK_QUEUE_GRAPHICS_BIT)
+       nvk_cmd_buffer_begin_graphics(cmd, pBeginInfo);
+ 
++   cmd->cntr.mark = cmd->push.end;
++
++   return VK_SUCCESS;
++}
++
++/* The launch counter of the copy kernels that vkCmdCopyMemoryIndirectKHR
++ * records on a queue without a copy engine, as the proprietary driver
++ * counts its kernel launches (libnvidia-eglcore.so 615.78.08): word 2 of a
++ * 0x100-byte scratch block of GPU-only device memory (ELF 0xc5b52a /
++ * ELF 0xc5a490), reset at the command buffer's first launch with a host
++ * semaphore release of 0 and an acquire of 0 (ELF 0xc5b300), increased by
++ * the RELEASE0 of each launch's QMD (ELF 0xaee500).  A barrier after such
++ * launches waits for the counter to reach the number of launches (host
++ * ACQ_CIRC_GEQ) and issues a compute NO_OPERATION, without idling the
++ * compute engine (ELF 0xc5a530), then invalidates the destination's caches;
++ * the end of the command buffer waits for the counter
++ * once more (ELF 0xc5c980 -> ELF 0xc5c500 -> ELF 0xc5a530).  A secondary
++ * command buffer has a counter of its own; the primary that executes it
++ * does not count its launches.  Volta/Turing count every dispatch on
++ * cmd->sked's counter, which this reuses there.
++ */
++VkResult
++nvk_cmd_counted_launch(struct nvk_cmd_buffer *cmd, uint64_t *addr_out)
++{
++   if (cmd->cntr.scratch == 0) {
++      VkResult result =
++         nvk_cmd_pool_alloc_counter_scratch(nvk_cmd_buffer_pool(cmd),
++                                            &cmd->cntr.scratch);
++      if (unlikely(result != VK_SUCCESS))
++         return result;
++   }
++   const uint64_t addr = cmd->cntr.scratch + 8;
++   if (!cmd->cntr.started) {
++      const uint8_t host = nvk_cmd_buffer_host_subc(cmd);
++      struct nv_push *p = nvk_cmd_buffer_push(cmd, 12);
++      __push_mthd(p, host, NVC86F_SEM_ADDR_LO);
++      P_NVC86F_SEM_ADDR_LO(p, (uint32_t)addr >> 2);
++      P_NVC86F_SEM_ADDR_HI(p, addr >> 32);
++      P_NVC86F_SEM_PAYLOAD_LO(p, 0);
++      P_NVC86F_SEM_PAYLOAD_HI(p, 0);
++      P_NVC86F_SEM_EXECUTE(p, {
++         .operation = OPERATION_RELEASE,
++         .payload_size = PAYLOAD_SIZE_32BIT,
++      });
++      __push_mthd(p, host, NVC86F_SEM_ADDR_LO);
++      P_NVC86F_SEM_ADDR_LO(p, (uint32_t)addr >> 2);
++      P_NVC86F_SEM_ADDR_HI(p, addr >> 32);
++      P_NVC86F_SEM_PAYLOAD_LO(p, 0);
++      P_NVC86F_SEM_PAYLOAD_HI(p, 0);
++      P_NVC86F_SEM_EXECUTE(p, {
++         .operation = OPERATION_ACQUIRE,
++         .payload_size = PAYLOAD_SIZE_32BIT,
++      });
++      cmd->cntr.started = true;
++   }
++   cmd->cntr.launches++;
++   *addr_out = addr;
+    return VK_SUCCESS;
+ }
+ 
++void
++nvk_cmd_counted_launches_begin(struct nvk_cmd_buffer *cmd)
++{
++   if (cmd->push.end != cmd->cntr.mark)
++      cmd->cntr.other_work = true;
++}
++
++void
++nvk_cmd_counted_launches_end(struct nvk_cmd_buffer *cmd, uint32_t count)
++{
++   cmd->cntr.pending += count;
++   cmd->cntr.mark = cmd->push.end;
++}
++
++/* The counter and its expected value, or false when the launches since the
++ * last wait cannot be waited for on it.
++ */
++static bool
++nvk_cmd_counter_target(struct nvk_cmd_buffer *cmd,
++                       uint64_t *addr, uint32_t *count)
++{
++   const struct nvk_physical_device *pdev =
++      nvk_device_physical(nvk_cmd_buffer_device(cmd));
++   if (nvk_cmd_sked_qmds_tracked(pdev)) {
++      if (cmd->sked.counter_addr == 0 || cmd->sked.wfi_drain)
++         return false;
++      *addr = cmd->sked.counter_addr;
++      *count = cmd->sked.launches;
++      return true;
++   }
++   if (!cmd->cntr.started)
++      return false;
++   *addr = cmd->cntr.scratch + 8;
++   *count = cmd->cntr.launches;
++   return true;
++}
++
++static void
++nvk_cmd_counter_wait(struct nvk_cmd_buffer *cmd, uint64_t addr, uint32_t count)
++{
++   struct nv_push *p = nvk_cmd_buffer_push(cmd, 8);
++   __push_mthd(p, nvk_cmd_buffer_host_subc(cmd), NVC86F_SEM_ADDR_LO);
++   P_NVC86F_SEM_ADDR_LO(p, (uint32_t)addr >> 2);
++   P_NVC86F_SEM_ADDR_HI(p, addr >> 32);
++   P_NVC86F_SEM_PAYLOAD_LO(p, count);
++   P_NVC86F_SEM_PAYLOAD_HI(p, 0);
++   P_NVC86F_SEM_EXECUTE(p, {
++      .operation = OPERATION_ACQ_CIRC_GEQ,
++      .payload_size = PAYLOAD_SIZE_32BIT,
++   });
++   P_IMMD(p, NVA0C0, NO_OPERATION, 0);
++}
++
++/* Barrier after counted launches only (nothing else recorded since the
++ * last wait): the counter wait replaces the compute idle and the
++ * shader-data flush; the destination's cache invalidates follow from
++ * nvk_cmd_invalidate_deps() (texture data and global data for a transfer
++ * read, the same two invalidates the proprietary driver issues there).
++ */
++static bool
++nvk_cmd_counter_barrier(struct nvk_cmd_buffer *cmd)
++{
++   uint64_t addr;
++   uint32_t count;
++   if (cmd->cntr.pending == 0 || cmd->cntr.other_work ||
++       cmd->push.end != cmd->cntr.mark ||
++       !nvk_cmd_counter_target(cmd, &addr, &count))
++      return false;
++
++   nvk_cmd_counter_wait(cmd, addr, count);
++   return true;
++}
++
++static void
++nvk_cmd_counter_end(struct nvk_cmd_buffer *cmd)
++{
++   const struct nvk_physical_device *pdev =
++      nvk_device_physical(nvk_cmd_buffer_device(cmd));
++   if (nvk_cmd_sked_qmds_tracked(pdev) || !cmd->cntr.started)
++      return;
++   nvk_cmd_counter_wait(cmd, cmd->cntr.scratch + 8, cmd->cntr.launches);
++}
++
+ static void
+ flush_mem_list(struct nvk_cmd_buffer *cmd, struct list_head *mem_list)
+ {
+@@ -442,6 +590,7 @@
+    VK_FROM_HANDLE(nvk_cmd_buffer, cmd, commandBuffer);
+ 
+    nvk_cmd_cs_join_close(cmd);
++   nvk_cmd_counter_end(cmd);
+    nvk_cmd_sked_end(cmd);
+    nvk_cmd_buffer_flush_push(cmd, false);
+ 
+@@ -544,8 +693,12 @@
+    if (access & VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT)
+       barriers |= NVK_BARRIER_FLUSH_SHADER_DATA;
+ 
++   /* Indirect memory copies are shader writes on a queue without a copy
++    * engine (nvk_CmdCopyMemoryIndirectKHR), like the compute meta copies.
