diff --git a/nvidia-prolapse/driver-source/native/shaders/lcg-spin.comp b/nvidia-prolapse/driver-source/native/shaders/lcg-spin.comp
new file mode 100644
index 0000000..5f2cacf
--- /dev/null
+++ b/nvidia-prolapse/driver-source/native/shaders/lcg-spin.comp
@@ -0,0 +1,13 @@
+#version 450
+// Busy kernel for the shared-TSG concurrency test: each invocation runs
+// `iters` steps of a 32-bit LCG from `seed + index` and stores the result.
+layout(local_size_x = 64) in;
+layout(set = 0, binding = 0, std430) writeonly buffer Output { uint words[]; } output_data;
+layout(push_constant) uniform Params { uint iters; uint seed; } params;
+void main() {
+    uint index = gl_GlobalInvocationID.x;
+    uint x = params.seed + index;
+    for (uint k = 0u; k < params.iters; k++)
+        x = x * 1664525u + 1013904223u;
+    output_data.words[index] = x;
+}
