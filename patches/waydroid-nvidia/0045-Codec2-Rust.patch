index 0000000..dd0854b
--- /dev/null
+++ b/nvidia-prolapse/media/test/superframe_input.h
@@ -0,0 +1,64 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NVC2_SUPERFRAME_INPUT_H
+#define NVC2_SUPERFRAME_INPUT_H
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+#include <media/NdkMediaExtractor.h>
+
+// Optional host-produced fixture: replace exactly two original VP9 samples by
+// one superframe, retaining the first sample PTS. Reject a mismatched fixture.
+class SuperframeInput {
+public:
+    bool load(const char *path) {
+        FILE *f = fopen(path, "rb");
+        if (!f) return false;
+        if (fseek(f, 0, SEEK_END) || ftell(f) <= 0 || ftell(f) > 2 * 1024 * 1024) { fclose(f); return false; }
+        mData.resize(static_cast<size_t>(ftell(f)));
+        rewind(f);
+        bool ok = fread(mData.data(), 1, mData.size(), f) == mData.size();
+        fclose(f);
+        if (!ok) return false;
+        const uint8_t marker = mData.back();
+        const unsigned bytes = ((marker >> 3) & 3) + 1;
+        const size_t index = 2 + 2 * bytes;
+        if ((marker & 0xe7) != 0xc1 || mData.size() <= index || mData[mData.size() - index] != marker) return false;
+        for (unsigned i = 0; i < 2; ++i)
+            for (unsigned b = 0; b < bytes; ++b)
+                mSize[i] |= size_t(mData[mData.size() - index + 1 + i * bytes + b]) << (8 * b);
+        if (!mSize[0] || !mSize[1] || mSize[0] + mSize[1] != mData.size() - index) return false;
+        mEnabled = true;
+        return true;
+    }
+    // Returns -2 for a bad/mismatched fixture, -1 at EOS.
+    ssize_t read(AMediaExtractor *ex, uint8_t *out, size_t capacity, int64_t *pts) {
+        if (!out || !capacity) return -2;
+        *pts = AMediaExtractor_getSampleTime(ex);
+        ssize_t n = AMediaExtractor_readSampleData(ex, out, capacity);
+        if (n >= 0 && static_cast<size_t>(n) > capacity) return -2;
+        if (!mEnabled || mSubmitted || n < 0) {
+            if (n >= 0) AMediaExtractor_advance(ex);
+            return n;
+        }
+        mPts = *pts;
+        if (mData.size() > capacity || size_t(n) != mSize[0] || memcmp(out, mData.data(), mSize[0])) return -2;
+        if (!AMediaExtractor_advance(ex)) return -2;
+        n = AMediaExtractor_readSampleData(ex, out, capacity);
+        if (n < 0 || size_t(n) != mSize[1] || memcmp(out, mData.data() + mSize[0], mSize[1])) return -2;
+        AMediaExtractor_advance(ex);
+        memcpy(out, mData.data(), mData.size());
+        mSubmitted = true;
+        return static_cast<ssize_t>(mData.size());
+    }
+    void output(int64_t pts) { if (mEnabled && mSubmitted && pts == mPts) ++mOutputs; }
+    bool valid(size_t total) const { return !mEnabled || (mSubmitted && mOutputs == 2 && total == 60); }
+    bool enabled() const { return mEnabled; }
+    size_t outputs() const { return mOutputs; }
+private:
+    std::vector<uint8_t> mData;
+    size_t mSize[2]{}, mOutputs = 0;
+    bool mEnabled = false, mSubmitted = false;
+    int64_t mPts = 0;
+};
+#endif
diff --git a/nvidia-prolapse/media/test/test_vp9_superframe.py b/nvidia-prolapse/media/test/test_vp9_superframe.py
new file mode 100755
index 0000000..1599aed
--- /dev/null
+++ b/nvidia-prolapse/media/test/test_vp9_superframe.py
@@ -0,0 +1,41 @@
+#!/usr/bin/env python3
+"""Byte-level regression tests for the VP9 superframe fixture tool."""
+import importlib.util
+import pathlib
+import struct
+import unittest
+
+spec = importlib.util.spec_from_file_location("fixture", pathlib.Path(__file__).with_name("vp9-superframe.py"))
+fixture = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(fixture)
+
+
+class SuperframeTests(unittest.TestCase):
+    def test_two_frames_and_size_widths(self):
+        for length, width in [(1, 1), (255, 1), (256, 2), (65536, 3)]:
+            frames = [b"a" * length, b"bc"]
+            data = fixture.superframe(frames)
+            marker = 0xc1 | ((width - 1) << 3)
+            expected = bytes([marker]) + length.to_bytes(width, "little") + (2).to_bytes(width, "little") + bytes([marker])
+            self.assertEqual(data, b"".join(frames) + expected)
+
+    def test_frame_count_bounds(self):
+        for frames in [[], [b""], [b"x"] * 9]:
+            with self.assertRaises(ValueError):
+                fixture.superframe(frames)
+        self.assertEqual(fixture.superframe([b"x"] * 8)[-1], 0xc7)
+
+    def test_ivf_packet_bounds(self):
+        header = bytearray(32)
+        header[:4] = b"DKIF"
+        header[8:12] = b"VP90"
+        struct.pack_into("<H", header, 6, 32)
+        data = bytes(header) + struct.pack("<IQ", 1, 0) + b"a" + struct.pack("<IQ", 2, 1) + b"bc"
+        self.assertEqual(fixture.parse_ivf(data)[1], [(0, b"a"), (1, b"bc")])
+        for bad in [b"", data[:-1], data + b"x"]:
+            with self.assertRaises(ValueError):
+                fixture.parse_ivf(bad)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/nvidia-prolapse/media/test/vp9-superframe.py b/nvidia-prolapse/media/test/vp9-superframe.py
new file mode 100755
index 0000000..9b0f14d
--- /dev/null
+++ b/nvidia-prolapse/media/test/vp9-superframe.py
@@ -0,0 +1,83 @@
+#!/usr/bin/env python3
+"""Build a two-display-frame VP9 superframe for MediaCodec multi-output tests.
+
+Usage: python3 vp9-superframe.py INPUT.{mp4,ivf} OUTPUT_PREFIX
+Use a 60-frame VP9 stream encoded with -auto-alt-ref 0. Feed the original MP4 to
+c2_smoke ... superframe PREFIX.bin or c2_surface_smoke ... PREFIX.bin. The clients
+replace its first two extractor samples by this one input and verify two outputs
+at the first input PTS, 60 total pictures and no error.
+"""
+import argparse
+import json
+import pathlib
+import struct
+import subprocess
+
+
+def superframe(frames):
+    if not 1 <= len(frames) <= 8 or any(not f for f in frames):
+        raise ValueError("one to eight nonempty VP9 frames required")
+    width = max(1, (max(map(len, frames)).bit_length() + 7) // 8)
+    if width > 4:
+        raise ValueError("VP9 superframe size field exceeds four bytes")
+    marker = 0xC0 | ((width - 1) << 3) | (len(frames) - 1)
+    return b"".join(frames) + bytes([marker]) + b"".join(
+        len(f).to_bytes(width, "little") for f in frames
+    ) + bytes([marker])
+
+
+def parse_ivf(data):
+    if len(data) < 32 or data[:4] != b"DKIF" or data[8:12] != b"VP90":
+        raise ValueError("expected VP9 IVF")
+    header_size = struct.unpack_from("<H", data, 6)[0]
+    if header_size != 32:
+        raise ValueError("expected 32-byte IVF header")
+    packets = []
+    pos = header_size
+    while pos < len(data):
+        if pos + 12 > len(data):
+            raise ValueError("truncated IVF packet header")
+        size, pts = struct.unpack_from("<IQ", data, pos)
+        pos += 12
+        if not size or pos + size > len(data):
+            raise ValueError("truncated/empty IVF packet")
+        packets.append((pts, data[pos:pos + size]))
+        pos += size
+    if len(packets) < 2:
+        raise ValueError("need two consecutive display frames")
+    return data[:32], packets
+
+
+def make(source, prefix):
+    data = source.read_bytes()
+    if data[:4] != b"DKIF":
+        data = subprocess.run(["ffmpeg", "-v", "error", "-i", str(source), "-map", "0:v:0",
+                               "-c:v", "copy", "-f", "ivf", "pipe:1"], check=True,
+                              stdout=subprocess.PIPE).stdout
+    header, packets = parse_ivf(data)
+    # show_frame is bit 1 in VP9's first byte after the frame marker/profile bits
+    # only for profile 0; require profile 0 and no show_existing for this fixture.
+    for _, frame in packets[:2]:
+        bits = [(frame[0] >> b) & 1 for b in range(7, -1, -1)]
+        if bits[:4] != [1, 0, 0, 0] or bits[4] or not bits[6]:
+            raise ValueError("fixture must start with two profile-0 show_frame frames (no alt-ref)")
+    merged = superframe([f for _, f in packets[:2]])
+    pathlib.Path(str(prefix) + ".bin").write_bytes(merged)
+    out_header = bytearray(header)
+    struct.pack_into("<I", out_header, 24, len(packets) - 1)
+    output = bytes(out_header) + struct.pack("<IQ", len(merged), packets[0][0]) + merged
+    output += b"".join(struct.pack("<IQ", len(f), pts) + f for pts, f in packets[2:])
+    pathlib.Path(str(prefix) + ".ivf").write_bytes(output)
+    manifest = {"inputs": len(packets) - 1, "outputs": len(packets), "merged_input": 0,
+                "merged_outputs": 2, "same_timestamp": True,
+                "member_sizes": [len(f) for _, f in packets[:2]], "marker": merged[-1]}
+    pathlib.Path(str(prefix) + ".json").write_text(json.dumps(manifest, indent=2) + "\n")
+    print(json.dumps(manifest))
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("source", type=pathlib.Path)
+    parser.add_argument("prefix", type=pathlib.Path)
+    args = parser.parse_args()
+    make(args.source, args.prefix)
