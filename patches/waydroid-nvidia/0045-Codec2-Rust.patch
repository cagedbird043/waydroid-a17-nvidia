+#!/usr/bin/env python3
+"""Real-GPU VP9 superframe fixture/driver verification; no guest interaction."""
+import os
+import pathlib
+import subprocess
+import sys
+
+root = pathlib.Path(__file__).resolve().parents[1]
+out = root / "out/host/superframe"
+out.mkdir(parents=True, exist_ok=True)
+
+
+def run(args, **kwargs):
+    print("+", " ".join(map(str, args)), flush=True)
+    subprocess.run(list(map(str, args)), check=True, cwd=root, **kwargs)
+
+
+run(["ffmpeg", "-v", "error", "-y", "-f", "lavfi", "-i", "testsrc2=size=640x360:rate=30",
+     "-frames:v", "60", "-c:v", "libvpx-vp9", "-threads", "4", "-deadline", "realtime",
+     "-cpu-used", "6", "-auto-alt-ref", "0", "-lag-in-frames", "0", "-g", "30", out / "vp9.mp4"])
+run(["ffmpeg", "-v", "error", "-y", "-i", out / "vp9.mp4", "-pix_fmt", "nv12", "-f", "rawvideo", out / "reference.nv12"])
+run([sys.executable, root / "test/vp9-superframe.py", out / "vp9.mp4", out / "pair"])
+for mode in ["nv12", "yv12"]:
+    for pool in [1, 8]:
+        for eos_on_last in [False, True]:
+            env = dict(os.environ, REAL_MODE=mode, REAL_SUPERFRAME="1")
+            env.pop("REAL_EOS_ON_LAST", None)
+            if eos_on_last:
+                env["REAL_EOS_ON_LAST"] = "1"
+            run([root / "out/host/real_codec_test", "vp9", out / "pair.ivf", out / "reference.nv12",
+                 "640", "360", str(pool)], env=env)
+print("superframe: PASS (8 real-GPU cases, shared index has 2 incomplete/final outputs, 60 pictures)")
