+    let owned = unsafe { OwnedFd::from_raw_fd(e.release_fence_fd) };
+    assert!(unsafe { libc::fcntl(owned.as_raw_fd(), libc::F_GETFD) } >= 0);
+    p.busy.remove(&e.cookie);
+    queue(&mut d, 1, 1, false);
