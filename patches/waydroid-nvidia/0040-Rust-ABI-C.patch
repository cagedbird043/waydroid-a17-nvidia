-// Macro to build an NvU32 from four bytes, listed from msb to lsb
-#define NvU32_BUILD(a, b, c, d) \
-    ((NvU32)( \
-     (((NvU32)(a) & 0xff) << 24) | \
-     (((NvU32)(b) & 0xff) << 16) | \
-     (((NvU32)(c) & 0xff) << 8)  | \
-     (((NvU32)(d) & 0xff))))
-
-// Macro to build an NvU64 from two DWORDS, listed from msb to lsb
-#define NvU64_BUILD(a, b) \
-    ((NvU64)( \
-     (((NvU64)(a) & ~0U) << 32) | \
-     (((NvU64)(b) & ~0U))))
