+    if p.data.is_null() || p.length<n as u64 || p.length>isize::MAX as u64
+        || (p.data as usize).checked_add(n).is_none() {return Err(bad());}
+    Ok(unsafe {std::slice::from_raw_parts(p.data,n)})
