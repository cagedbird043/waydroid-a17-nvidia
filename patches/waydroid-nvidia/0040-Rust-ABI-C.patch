-    for (size_t i = 0; i < r; i++) {
-        if (zeros >= 2 && rbsp[i] <= 3) { out[n++] = 3; zeros = 0; }   // emulation prevention
-        out[n++] = rbsp[i]; zeros = rbsp[i] ? 0 : zeros + 1;
-    }
-    return n;
-}
