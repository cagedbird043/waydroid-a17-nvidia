-#define NV_VASPACE_ALLOCATION_INDEX_GPU_MAX                                 0x05 //<! Increment this on adding index entries
-
-
-#define NV_VASPACE_BIG_PAGE_SIZE_64K                                (64 * 1024)
-#define NV_VASPACE_BIG_PAGE_SIZE_128K                               (128 * 1024)
