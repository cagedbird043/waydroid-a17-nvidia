-#ifndef NVDEC_1_0
-/*!
- * Find the Greatest Common Denominator of two NvU64s
- *
- * @param[in] a      first number
- * @param[in] b      second number
- *
- * @return  GCD of a and b *
- */
-static NV_FORCEINLINE NvU64 nvFindGcdU64(NvU64 a, NvU64 b)
-{
-    while (1)
-    {
-        NvU64 temp;
-
-        if (a == 0)
-            return b;
-        temp = a;
-        a = b % a;
-        b = temp;
-    }
