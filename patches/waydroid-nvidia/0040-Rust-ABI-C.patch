-static NV_FORCEINLINE NvU32
-nvPopCount32(const NvU32 x)
-{
-    NvU32 temp = x;
-    temp = temp - ((temp >> 1) & 0x55555555U);
-    temp = (temp & 0x33333333U) + ((temp >> 2) & 0x33333333U);
-    temp = (((temp + (temp >> 4)) & 0x0F0F0F0FU) * 0x01010101U) >> 24;
-    return temp;
