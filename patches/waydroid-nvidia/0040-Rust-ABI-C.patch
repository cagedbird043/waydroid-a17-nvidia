-        const int x0 = bx * 32, y0 = by * 32, w = W - x0 < 32 ? W - x0 : 32, h = H - y0 < 32 ? H - y0 : 32;
-        uint64_t sum = 0, ss = 0;
-        for (int r = 0; r < h; r++) {
-            if (bytes == 1) { const uint8_t *p = (const uint8_t *)y + (size_t)(y0 + r) * stride + x0; for (int c = 0; c < w; c++) { sum += p[c]; ss += (uint32_t)p[c] * p[c]; } }
