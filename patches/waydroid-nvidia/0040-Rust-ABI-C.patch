-{
-    NvU64 temp = x;
-    temp = temp - ((temp >> 1) & 0x5555555555555555ULL);
-    temp = (temp & 0x3333333333333333ULL) + ((temp >> 2) & 0x3333333333333333ULL);
-    temp = (temp + (temp >> 4)) & 0x0F0F0F0F0F0F0F0FULL;
