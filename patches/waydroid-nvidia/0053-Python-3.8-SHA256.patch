         self.assertEqual(self.status(self.RUNNING, media=off)['c2 service'], 'FAIL')
 
 
+class TombstoneStatusTest(SourceRootFixture):
+    def test_text_and_pb_tombstones_keep_reporting(self):
+        self.build(media={'enabled': False, 'reason': 'test'})
+        root = self.root.parent
+        output = io.StringIO()
+
+        def run(command, **kwargs):
+            text = ''
+            if command[:2] == ['systemctl', 'is-active']:
+                text = 'active'
+            elif 'lxc-info' in command:
+                text = 'RUNNING' if command[-1] == '-sH' else '1234'
+            elif 'lxc-attach' in command:
+                if 'tombstone_' in command[-1]:
+                    text = ('99 /data/tombstones/tombstone_old\n'
+                            '101 /data/tombstones/tombstone_01\n'
+                            '101 /data/tombstones/tombstone_01.pb\n'
+                            '102 /data/tombstones/tombstone_02.pb\n')
+                else:
+                    return mock.Mock(returncode=3, stdout='', stderr='no surfaceflinger')
+            elif command[:2] == ['journalctl', '-k'] and '--since' not in command:
+                text = 'kernel log available'
+            return mock.Mock(returncode=0, stdout=text, stderr='')
+
+        with mock.patch.object(sn, 'CFG', root / 'cfg'), \
+             mock.patch.object(sn, 'OVERRIDE', root / 'override'), \
+             mock.patch.object(sn, 'HOOK', root / 'hook'), \
+             mock.patch.object(nn, 'lxc_nodes', return_value=[]), \
+             mock.patch.object(sn, 'check'), \
+             mock.patch.object(sn, 'installed_module_version', return_value=V), \
+             mock.patch.object(sn, 'process_start', return_value=100), \
+             mock.patch.object(sn, 'media_status') as media, \
+             mock.patch.object(sn.subprocess, 'run', side_effect=run), \
+             contextlib.redirect_stdout(output):
+            sn.status(self.root)
+        media.assert_called_once()
+        report = output.getvalue()
+        self.assertIn('tombstones: 2 since container start: tombstone_01, tombstone_02', report)
+        self.assertNotIn('tombstone_old', report)
+        self.assertIn('kernel Xid: 0 since container start', report)
+
+
