 +DEFAULT = "~/Downloads:Download/Host"
@@ -79,8 +84,20 @@ diff --git a/tools/helpers/shared_folders.py b/tools/helpers/shared_folders.py
 +# vold's bind of /data/media that MediaProvider serves /sdcard from
 +FUSE_LOWER = "/mnt/pass_through/0/emulated"
 +BOOT_TIMEOUT = 300
++# set to stop what the last start() began
 +_stop = threading.Event()
 +
++# Files the host changes in a shared folder bypass MediaProvider; it learns of them by scanning
++# the changed paths: a scan of a missing path drops its records, one of a folder covers its tree.
++IN_CLOSE_WRITE, IN_MOVED_FROM, IN_MOVED_TO, IN_CREATE, IN_DELETE = 0x8, 0x40, 0x80, 0x100, 0x200
++IN_Q_OVERFLOW, IN_IGNORED, IN_ISDIR = 0x4000, 0x8000, 0x40000000
++IN_ONLYDIR, IN_DONT_FOLLOW = 0x01000000, 0x02000000
++WATCH_MASK = IN_CLOSE_WRITE | IN_MOVED_FROM | IN_MOVED_TO | IN_CREATE | IN_DELETE | IN_ONLYDIR | IN_DONT_FOLLOW
++MAX_WATCHES = 4096      # folders watched per share; deeper changes wait for MediaProvider's own scans
++SCAN_QUIET = 1.5        # seconds without changes before a batch is scanned
++SCAN_LATEST = 10        # ... unless the oldest change waits this long
++SCAN_TARGETS = 8        # paths per batch; more are merged into their parent folders
++
 +_libc = ctypes.CDLL(None, use_errno=True)
 +SYS_OPEN_TREE, SYS_MOVE_MOUNT = 428, 429      # same number on every architecture
 +OPEN_TREE_CLONE = 0x1
@@ -168,9 +185,11 @@ diff --git a/tools/helpers/shared_folders.py b/tools/helpers/shared_folders.py
 +
