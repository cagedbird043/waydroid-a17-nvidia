 +    """Drop mounts a crashed session left behind; share the folders once Android has booted."""
++    global _stop
++    _stop.set()
++    _stop = threading.Event()
 +    umount_all(args, session)
-+    _stop.clear()
-+    threading.Thread(target=_wait_and_mount, args=(args, session), daemon=True).start()
++    threading.Thread(target=_run, args=(args, session, _stop), daemon=True).start()
