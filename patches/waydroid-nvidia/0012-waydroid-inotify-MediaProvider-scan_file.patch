++class _Scanner:
++    """Watches the shared folders and has MediaProvider scan what changed in them."""
++
++    def __init__(self, args, shares):
++        self.args = args
++        self.roots = [fd for fd, _ in shares]
++        self.storage = ["/storage/emulated/0/" + "/".join(parts) for _, parts in shares]
++        self.watches = {}       # watch descriptor -> (share index, folder relative to the share)
++        self.count = [0] * len(shares)
++        self.env = None
++        self.fd = _check(_libc.inotify_init1(os.O_CLOEXEC | os.O_NONBLOCK))
++
++    def watch_tree(self, share, rel):
++        base = "/proc/self/fd/{}".format(self.roots[share])
++        # os.walk does not descend into symlinks, so the tree stays inside the share
++        for path, dirs, _ in os.walk(os.path.join(base, rel)):
++            if self.count[share] >= MAX_WATCHES:
++                logging.warning("shared_folders: {} has more than {} folders, the rest is not watched"
++                                .format(self.storage[share], MAX_WATCHES))
++                return
++            wd = _libc.inotify_add_watch(self.fd, path.encode(), WATCH_MASK)
++            if wd < 0:
++                dirs.clear()
++                continue
++            if wd not in self.watches:
++                self.count[share] += 1
++            self.watches[wd] = (share, os.path.relpath(path, base))
++
++    def read_events(self, pending):
++        try:
++            buf = os.read(self.fd, 65536)
++        except BlockingIOError:
++            return
++        offset = 0
++        while offset < len(buf):
++            wd, mask, _, length = struct.unpack_from("iIII", buf, offset)
++            name = buf[offset + 16:offset + 16 + length].split(b"\0", 1)[0].decode(errors="surrogateescape")
++            offset += 16 + length
++            if mask & IN_Q_OVERFLOW:
++                pending.update((share, "") for share in range(len(self.roots)))
++                continue
++            if mask & IN_IGNORED:
++                if wd in self.watches:
++                    self.count[self.watches.pop(wd)[0]] -= 1
++                continue
++            if wd not in self.watches:
++                continue
++            share, folder = self.watches[wd]
++            rel = os.path.normpath(os.path.join(folder, name))
++            if mask & IN_ISDIR and mask & (IN_CREATE | IN_MOVED_TO):
++                self.watch_tree(share, rel)
++            elif mask & IN_CREATE:
++                continue    # its IN_CLOSE_WRITE follows once the file is complete
++            pending.add((share, rel))
++
++    def scan(self, pending):
++        paths = []
++        for share in range(len(self.roots)):
++            rels = {rel for s, rel in pending if s == share}
++            while len(rels) > SCAN_TARGETS:
++                rels = {os.path.dirname(rel) for rel in rels}
++            for rel in sorted(rels):
++                if not any(other != rel and (other == "" or rel.startswith(other + "/")) for other in rels):
++                    paths.append(self.storage[share] if rel in ("", ".") else self.storage[share] + "/" + rel)
++        if self.env is None:
++            self.env = tools.helpers.lxc.android_env_attach_options(self.args)
++        script = "for p; do content call --uri content://media --method scan_file --arg \"$p\" >/dev/null; done"
++        subprocess.run(["lxc-attach", "-P", tools.config.defaults["lxc"], "-n", "waydroid", "--clear-env",
++                        *self.env, "--", "/system/bin/sh", "-c", script, "sh", *paths],
++                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
++
++    def run(self, stop_event):
++        try:
++            for share in range(len(self.roots)):
++                self.watch_tree(share, "")
++            pending, first = set(), 0
++            while not stop_event.is_set():
++                ready, _, _ = select.select([self.fd], [], [], SCAN_QUIET)
++                if ready:
++                    self.read_events(pending)
++                    if pending and not first:
++                        first = time.monotonic()
++                    if not pending or time.monotonic() - first < SCAN_LATEST:
++                        continue
++                if pending and not stop_event.is_set():
++                    self.scan(pending)
++                    pending, first = set(), 0
++        finally:
++            os.close(self.fd)
