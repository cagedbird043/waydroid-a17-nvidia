+#!/usr/bin/env python3
+"""Exercise the real xmlgen CLI and Rust text ABI without opening a GPU.
+
+Build native's host cdylib and xmlgen first, then run this unittest. NVC2_XMLGEN
+can select another host executable linked to the matching caps ABI.
+"""
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+NATIVE = Path(__file__).resolve().parents[2] / 'driver-source/native'
+CLI = Path(os.environ.get('NVC2_XMLGEN', NATIVE / 'target/debug/nvc2-xmlgen'))
+# Only device discovery/caps acquisition are substituted. XML/reason formatting,
+# owned text handles, CLI output/checking, and exit statuses use production code.
+STUB = r'''
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include "nv_c2_caps.h"
+static int mode(void) { return atoi(getenv("NVC2_TEST_MODE")); }
+int32_t nv_video_device_open(struct NvVideoDevice **out, struct NvVideoDeviceInfo *info) {
+    memset(info, 0, sizeof(*info));
+    info->abi_version = 2;
+    strcpy(info->name, "xmlgen-test");
+    info->nvdec_class = mode() == 0 ? 0 : 0xc3b0;
+    *out = (struct NvVideoDevice *)(uintptr_t)1;
+    return 0;
+}
+void nv_video_device_close(struct NvVideoDevice *dev) { (void)dev; }
+int32_t nv_c2_caps_query(struct NvVideoDevice *dev, struct NvC2Caps **out) {
+    (void)dev;
+    if (mode() == 0) abort(); /* class zero must never query */
+    *out = 0;
+    if (mode() == 2) return NV_C2_E_INTERNAL;
+    *out = (struct NvC2Caps *)(uintptr_t)1;
+    return 0;
+}
+int32_t nv_c2_caps_view(const struct NvC2Caps *caps, struct NvC2CapsView *out) {
+    (void)caps;
+    memset(out, 0, sizeof(*out));
+    out->abi_version = mode() == 3 ? 1 : NV_C2_CAPS_ABI_VERSION;
+    return 0;
+}
+void nv_c2_caps_destroy(struct NvC2Caps *caps) { (void)caps; }
+const char *nv_video_last_error(void) { return "injected unusable/query caps"; }
+'''
+
+
+class XmlgenNoDecoderTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        if not CLI.is_file():
+            raise RuntimeError('build the host nvc2-xmlgen first: ' + str(CLI))
+        cls.tmp = tempfile.TemporaryDirectory(prefix='nvc2-xmlgen-test-')
+        cls.root = Path(cls.tmp.name)
+        source = cls.root / 'device.c'
+        source.write_text(STUB)
+        cls.shim = cls.root / 'device.so'
+        subprocess.run(['cc', '-shared', '-fPIC', '-Wall', '-Wextra', '-Werror',
+                        '-I', str(NATIVE / 'video'), str(source), '-o', str(cls.shim)], check=True)
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.tmp.cleanup()
+
+    def run_cli(self, mode, *args):
+        env = dict(os.environ, NVC2_TEST_MODE=str(mode), LD_PRELOAD=str(self.shim))
+        return subprocess.run([str(CLI), *map(str, args)], env=env, capture_output=True)
+
+    def test_empty_classes_generate_and_check(self):
+        listings = []
+        for mode in (0, 1):
+            xml = self.root / ('codecs-{}.xml'.format(mode))
+            generated = self.run_cli(mode, '-o', xml)
+            self.assertEqual(generated.returncode, 3, generated.stderr)
+            self.assertNotIn(b'<MediaCodec ', xml.read_bytes())
+            self.assertEqual(self.run_cli(mode, '--check', xml).returncode, 3)
+            self.assertEqual(self.run_cli(1 - mode, '--check', xml).returncode, 1)
+            listings.append(xml.read_bytes())
+        self.assertIn(b'no NVDEC class this decoder supports; supported from Turing', listings[0])
+        self.assertIn(b'NVDEC class 0xc3b0: no supported decode codecs', listings[1])
+        self.assertNotEqual(*listings)
+
+    def test_errors_are_not_no_decoder(self):
+        for mode in (2, 3):
+            result = self.run_cli(mode)
+            self.assertEqual(result.returncode, 1, result.stderr)
+            self.assertEqual(result.stdout, b'')
+            self.assertNotIn(b'Android software decoders', result.stderr)
+
+
+if __name__ == '__main__':
+    unittest.main()
