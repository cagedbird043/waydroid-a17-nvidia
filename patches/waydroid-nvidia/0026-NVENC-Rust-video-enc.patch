+            let l0 = if is_b {
+                &self.slot_of[1..]
+            } else {
+                &self.slot_of[..]
+            };
+            for i in 0..4 {
+                b[0x128 + i] = if i < nl0 { i as u8 } else { 255 };
+                b[0x136 + i] = if i < nl0 { i as u8 } else { 255 };
+                b[0x12f + i] = if i < nl0 {
