+++ b/nvidia-prolapse/driver-source/native/src/video/enc/hevchdr.rs
@@ -0,0 +1,302 @@
+//! HEVC parameter sets (ITU-T H.265 7.3).
+use super::h264hdr::{escape, Bw};
+#[derive(Clone, Debug, Default)]
+pub struct HevcParams {
+    pub width: i32,
+    pub height: i32,
+    pub level_idc: i32,
+    pub log2_max_poc_lsb_minus4: i32,
+    pub max_dec_pic_buffering: i32,
+    pub num_reorder: i32,
+    pub sps_rps_negative: i32,
+    pub num_ref_idx_l0_default: i32,
+    pub pic_init_qp: i32,
+    pub vui: bool,
+    pub full_range: bool,
+    pub colour: [i32; 3],
+    pub bit_depth: i32,
+    pub chroma444: bool,
+    pub lossless: bool,
+    pub min_cb8: bool,
+    pub no_sdh: bool,
+    pub no_ts: bool,
+    pub no_cqd: bool,
+    pub no_sao: bool,
+    pub no_amp: bool,
+    pub sis: bool,
+}
+pub fn level_for(width: i32, height: i32) -> i32 {
+    let ps = width as i64 * height as i64;
+    let sr = ps * 60;
+    if ps <= 552960 && sr <= 33177600 {
+        93
+    } else if ps <= 2228224 && sr <= 133693440 {
+        123
+    } else if ps <= 8912896 && sr <= 534773760 {
+        153
+    } else {
+        183
+    }
+}
+fn level(p: &HevcParams) -> i32 {
+    if p.level_idc != 0 {
+        p.level_idc
+    } else {
+        level_for(p.width, p.height)
+    }
+}
+// Whole 32x32 CTBs: NVENC codes partial CTBs as whole; crop with the conformance window (T6.06).
+pub fn coded_width(p: &HevcParams) -> usize {
+    (p.width as usize + 31) & !31
+}
+pub fn coded_height(p: &HevcParams) -> usize {
+    (p.height as usize + 31) & !31
+}
+fn profile_tier_level(b: &mut Bw<192>, level: i32, ten: bool, rext: bool) {
+    b.put(0, 2);
+    b.put(0, 1);
+    b.put(
+        if rext {
+            4
+        } else if ten {
+            2
+        } else {
+            1
+        },
+        5,
+    );
+    b.put(
+        if rext {
+            0x08000000
+        } else if ten {
+            0x20000000
+        } else {
+            0x60000000
+        },
+        32,
+    );
+    b.put(1, 1);
+    b.put(0, 1);
+    b.put(0, 1);
+    b.put(1, 1);
+    if rext {
+        b.put(1, 1);
+        b.put(1, 1);
+        b.flag(!ten);
+        b.put(0, 1);
+        b.put(0, 1);
+        b.put(0, 1);
+        b.put(0, 1);
+        b.put(0, 1);
+        b.put(1, 1);
+        b.put(0, 32);
+        b.put(0, 2);
+    } else {
+        b.put(0, 32);
+        b.put(0, 11);
+    }
+    b.put(0, 1);
+    b.put(level as u32, 8);
+}
+fn emit(b: &Bw<192>, typ: u8, out: &mut Vec<u8>) {
+    out.extend_from_slice(&[0, 0, 0, 1, typ << 1, 1]);
+    escape(b.bytes(), out);
+}
+pub fn write_vps(p: &HevcParams, out: &mut Vec<u8>) {
+    let mut b = Bw::<192>::new();
+    b.put(0, 4);
+    b.put(1, 1);
+    b.put(1, 1);
+    b.put(0, 6);
+    b.put(0, 3);
+    b.put(1, 1);
+    b.put(0xffff, 16);
+    profile_tier_level(&mut b, level(p), p.bit_depth > 8, p.chroma444);
+    b.put(1, 1);
+    b.ue(p.max_dec_pic_buffering as u32 - 1);
+    b.ue(p.num_reorder as u32);
+    b.ue(0);
+    b.put(0, 6);
+    b.ue(0);
+    b.put(0, 1);
+    b.put(0, 1);
+    b.trailing();
+    emit(&b, 32, out);
+}
+pub fn write_sps(p: &HevcParams, out: &mut Vec<u8>) {
+    let mut b = Bw::<192>::new();
+    let cw = coded_width(p) as u32;
+    let ch = coded_height(p) as u32;
+    b.put(0, 4);
+    b.put(0, 3);
+    b.put(1, 1);
+    profile_tier_level(&mut b, level(p), p.bit_depth > 8, p.chroma444);
+    b.ue(0);
+    b.ue(if p.chroma444 { 3 } else { 1 });
+    if p.chroma444 {
+        b.put(0, 1);
+    }
+    b.ue(cw);
+    b.ue(ch);
+    let u = if p.chroma444 { 1 } else { 2 };
+    let cr = (cw - p.width as u32) / u;
+    let cb = (ch - p.height as u32) / u;
+    b.flag(cr != 0 || cb != 0);
+    if cr != 0 || cb != 0 {
+        b.ue(0);
+        b.ue(cr);
+        b.ue(0);
+        b.ue(cb);
+    }
+    let bd = if p.bit_depth > 8 {
+        p.bit_depth as u32 - 8
+    } else {
+        0
+    };
+    b.ue(bd);
+    b.ue(bd);
+    b.ue(p.log2_max_poc_lsb_minus4 as u32);
+    b.put(1, 1);
+    b.ue(p.max_dec_pic_buffering as u32 - 1);
+    b.ue(p.num_reorder as u32);
+    b.ue(0);
+    b.ue(if p.min_cb8 { 0 } else { 1 });
+    b.ue(if p.min_cb8 { 2 } else { 1 });
+    b.ue(0);
+    b.ue(3);
+    b.ue(3);
+    b.ue(3);
+    b.put(0, 1);
+    b.flag(!p.no_amp);
+    b.flag(!p.no_sao);
+    b.put(0, 1);
+    b.ue(1);
+    b.ue(p.sps_rps_negative as u32);
+    b.ue(0);
+    for _ in 0..p.sps_rps_negative {
+        b.ue(0);
+        b.put(0, 1);
+    }
+    b.put(0, 1);
+    b.put(0, 1);
+    b.flag(p.sis);
+    b.flag(p.vui);
+    if p.vui {
+        b.put(1, 1);
+        b.put(1, 8);
+        b.put(0, 1);
+        b.put(1, 1);
+        b.put(5, 3);
+        b.flag(p.full_range);
+        b.put(1, 1);
+        for c in p.colour {
+            b.put(if c != 0 { c } else { 1 } as u32, 8);
+        }
+        b.put(0, 1);
+        b.put(0, 1);
+        b.put(0, 1);
+        b.put(0, 1);
+        b.put(0, 1);
+        b.put(0, 1);
+        b.put(0, 1);
+    }
+    b.put(0, 1);
+    b.trailing();
+    emit(&b, 33, out);
+}
+pub fn write_pps(p: &HevcParams, out: &mut Vec<u8>) {
+    let mut b = Bw::<192>::new();
+    b.ue(0);
+    b.ue(0);
+    b.put(0, 1);
+    b.put(0, 1);
+    b.put(0, 3);
+    b.flag(!p.no_sdh);
+    b.put(1, 1);
+    b.ue(if p.num_ref_idx_l0_default != 0 {
+        p.num_ref_idx_l0_default
+    } else {
+        1
+    } as u32
+        - 1);
+    b.ue(0);
+    b.se(p.pic_init_qp - 26);
+    b.put(0, 1);
+    b.flag(!p.no_ts);
+    b.flag(!p.no_cqd);
+    if !p.no_cqd {
+        b.ue(0);
+    }
+    b.se(0);
+    b.se(0);
+    b.put(0, 1);
+    b.put(0, 1);
+    b.put(0, 1);
+    b.flag(p.lossless);
+    b.put(0, 1);
+    b.put(0, 1);
+    b.put(1, 1);
+    b.put(1, 1);
+    b.put(0, 1);
+    b.put(0, 1);
+    b.se(0);
+    b.se(0);
+    b.put(0, 1);
+    b.put(0, 1);
+    b.ue(0);
+    b.put(0, 1);
+    b.put(0, 1);
+    b.trailing();
+    emit(&b, 34, out);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    // Golden bytes generated by linking the original mickys C implementation.
+    #[test]
+    fn c_golden_bytes() {
+        let mut out = vec![0x5a];
+        let p = HevcParams {
+            width: 1919,
+            height: 1079,
+            level_idc: 0,
+            log2_max_poc_lsb_minus4: 4,
+            max_dec_pic_buffering: 3,
+            num_reorder: 1,
+            sps_rps_negative: 3,
+            num_ref_idx_l0_default: 1,
+            pic_init_qp: 0,
+            vui: true,
+            full_range: true,
+            colour: [9, 16, 9],
+            bit_depth: 10,
+            chroma444: true,
+            lossless: true,
+            min_cb8: true,
+            no_sdh: true,
+            no_ts: true,
+            no_cqd: true,
+            no_sao: true,
+            no_amp: true,
+            sis: true,
+            ..Default::default()
+        };
+        write_vps(&p, &mut out);
+        write_sps(&p, &mut out);
+        write_pps(&p, &mut out);
+        assert_eq!(out[0], 0x5a);
+        assert_eq!(
+            &out[1..],
+            &[
+                0x00, 0x00, 0x00, 0x01, 0x40, 0x01, 0x0c, 0x01, 0xff, 0xff, 0x04, 0x08, 0x00, 0x00,
+                0x03, 0x00, 0x9c, 0x08, 0x00, 0x00, 0x03, 0x00, 0x00, 0x7b, 0xb5, 0x02, 0x40, 0x00,
+                0x00, 0x00, 0x01, 0x42, 0x01, 0x01, 0x04, 0x08, 0x00, 0x00, 0x03, 0x00, 0x9c, 0x08,
+                0x00, 0x00, 0x03, 0x00, 0x00, 0x7b, 0x90, 0x00, 0x78, 0x10, 0x02, 0x20, 0xea, 0x29,
+                0xb2, 0xda, 0xdc, 0x84, 0x20, 0x22, 0x6a, 0x38, 0x0b, 0x70, 0x91, 0x00, 0x90, 0x08,
+                0x00, 0x00, 0x00, 0x01, 0x44, 0x01, 0xc0, 0xe0, 0xd4, 0x62, 0x66, 0x48
+            ]
+        );
+        out.truncate(1);
+    }
+}
diff --git a/nvidia-prolapse/driver-source/native/src/video/enc/layout.rs b/nvidia-prolapse/driver-source/native/src/video/enc/layout.rs
new file mode 100644
index 0000000..927b86a
--- /dev/null
+++ b/nvidia-prolapse/driver-source/native/src/video/enc/layout.rs
@@ -0,0 +1,237 @@
+//! NVIDIA GPU block-linear and NVENC input surfaces.
+//!
+//! GPU BL uses 64-byte x 8-row GOBs. NVENC's input layout on Ada
+//! (input_cfg block_height 2 / input_bl_mode 0, T2.05d) instead uses
+//! 64-byte x 16-row tiles, also written by NVDEC (M8).
+
+pub fn bl_offset(x: usize, y: usize, pitch: usize, block_height_log2: u32) -> usize {
+    let gob = ((x % 64) / 32) * 256
+        + ((y % 8) / 2) * 64
+        + ((x % 32) / 16) * 32
+        + (y % 2) * 16
+        + x % 16;
+    let block_rows = 8usize << block_height_log2;
+    let block = (y / block_rows) * (pitch / 64) + x / 64;
+    block * (512usize << block_height_log2)
+        + ((y / 8) % (1usize << block_height_log2)) * 512
+        + gob
+}
+
+pub fn bl_plane_size(pitch: usize, rows: usize, block_height_log2: u32) -> usize {
+    let block_rows = 8usize << block_height_log2;
+    pitch * rows.div_ceil(block_rows) * block_rows
+}
+
+pub fn bl_tile_plane(
+    dst: &mut [u8], src: &[u8], src_stride: usize, width: usize,
+    rows: usize, pitch: usize, bh: u32,
+) {
+    for y in 0..rows {
+        for x in (0..width).step_by(16) {
+            let n = (width - x).min(16);
+            let d = bl_offset(x, y, pitch, bh);
+            let s = y * src_stride + x;
+            dst[d..d + n].copy_from_slice(&src[s..s + n]);
+        }
+    }
+}
+
+pub fn in_offset(x: usize, y: usize, pitch: usize) -> usize {
+    let inside = x % 16 + (y % 4) * 16 + ((x / 16) % 2) * 64
+        + ((y / 4) % 2) * 128 + ((x / 32) % 2) * 256 + ((y / 8) % 2) * 512;
+    (y / 16) * pitch * 16 + (x / 64) * 1024 + inside
+}
+
+pub fn in_plane_size(pitch: usize, rows: usize) -> usize {
+    pitch * rows.div_ceil(16) * 16
+}
+
+fn tile_rows(dst: &mut [u8], src: &[u8], stride: usize, width: usize, rows: usize, pitch: usize) {
+    // Each 16-byte run is contiguous; neither row nor tile padding is written.
+    for y in 0..rows {
+        for x in (0..width).step_by(16) {
+            let n = (width - x).min(16);
+            let d = in_offset(x, y, pitch);
+            let s = y * stride + x;
+            dst[d..d + n].copy_from_slice(&src[s..s + n]);
+        }
+    }
+}
+
+pub fn in_tile_plane(
+    dst: &mut [u8], src: &[u8], src_stride: usize, width: usize, rows: usize, pitch: usize,
+) {
+    if rows == 0 || width == 0 { return; }
+    let split = rows.div_ceil(16).div_ceil(2) * 16;
+    if split >= rows {
+        tile_rows(dst, src, src_stride, width, rows, pitch);
+        return;
+    }
+    let (a, b) = dst.split_at_mut((split * pitch).min(dst.len()));
+    std::thread::scope(|scope| {
+        scope.spawn(|| tile_rows(a, src, src_stride, width, split, pitch));
+        tile_rows(b, &src[split * src_stride..], src_stride, width, rows - split, pitch);
+    });
+}
+
+fn untile_rows(dst: &mut [u8], stride: usize, src: &[u8], width: usize, rows: usize, pitch: usize) {
+    for y in 0..rows {
+        for x in (0..width).step_by(16) {
+            let n = (width - x).min(16);
+            let d = y * stride + x;
+            let s = in_offset(x, y, pitch);
+            dst[d..d + n].copy_from_slice(&src[s..s + n]);
+        }
+    }
+}
+
+pub fn in_untile_plane(
+    dst: &mut [u8], dst_stride: usize, src: &[u8], width: usize, rows: usize, pitch: usize,
+) {
+    if rows == 0 || width == 0 { return; }
+    let split = rows.div_ceil(16).div_ceil(2) * 16;
+    if split >= rows {
+        untile_rows(dst, dst_stride, src, width, rows, pitch);
+        return;
+    }
+    let (a, b) = dst.split_at_mut(split * dst_stride);
+    std::thread::scope(|scope| {
+        scope.spawn(|| untile_rows(a, dst_stride, src, width, split, pitch));
+        untile_rows(b, dst_stride, &src[split * pitch..], width, rows - split, pitch);
+    });
+}
+
+// BT.709 video-range fixed-point conversion. Chroma uses the 2x2 sum;
+// odd widths and heights repeat the last pixel/row, just as blocklinear.c.
+fn bgra_rows(s0: &[u8], s1: &[u8], y0: &mut [u8], y1: &mut [u8], uv: &mut [u8], width: usize) {
+    for x in 0..width {
+        let luma = |s: &[u8]| {
+            16 + ((47 * s[4 * x + 2] as i32 + 157 * s[4 * x + 1] as i32
+                + 16 * s[4 * x] as i32 + 128) >> 8)
+        };
+        y0[x] = luma(s0) as u8;
+        y1[x] = luma(s1) as u8;
+    }
+    for x in (0..width).step_by(2) {
+        let x1 = (x + 1).min(width - 1);
+        let sum = |c: usize| s0[4 * x + c] as i32 + s0[4 * x1 + c] as i32
+            + s1[4 * x + c] as i32 + s1[4 * x1 + c] as i32;
+        let (r, g, b) = (sum(2), sum(1), sum(0));
+        uv[x] = (128 + ((-26 * r - 87 * g + 112 * b + 512) >> 10)) as u8;
+        uv[x + 1] = (128 + ((112 * r - 102 * g - 10 * b + 512) >> 10)) as u8;
+    }
+}
+
+fn l10r_rows(s0: &[u8], s1: &[u8], y0: &mut [u8], y1: &mut [u8], uv: &mut [u8], width: usize) {
+    let pixel = |s: &[u8], x: usize| {
+        let a = u32::from_le_bytes(s[4 * x..4 * x + 4].try_into().unwrap());
+        [((a >> 20) & 1023) as i32, ((a >> 10) & 1023) as i32, (a & 1023) as i32]
+    };
+    for x in 0..width {
+        let luma = |s| {
+            let [r, g, b] = pixel(s, x);
+            ((64 + ((11931 * r + 40137 * g + 4052 * b + 32768) >> 16)) << 6) as u16
+        };
+        y0[2 * x..2 * x + 2].copy_from_slice(&luma(s0).to_le_bytes());
+        y1[2 * x..2 * x + 2].copy_from_slice(&luma(s1).to_le_bytes());
+    }
+    for x in (0..width).step_by(2) {
+        let x1 = (x + 1).min(width - 1);
+        let a = pixel(s0, x);
+        let b = pixel(s0, x1);
+        let c = pixel(s1, x);
+        let d = pixel(s1, x1);
+        let [r, g, bl] = std::array::from_fn(|i| a[i] + b[i] + c[i] + d[i]);
+        // VideoToolbox point-samples instead: T6.14 measures a 43 dB difference.
+        let u = ((512 + ((-6576 * r - 22124 * g + 28700 * bl + (1 << 17)) >> 18)) << 6) as u16;
+        let v = ((512 + ((28700 * r - 26069 * g - 2631 * bl + (1 << 17)) >> 18)) << 6) as u16;
+        uv[2 * x..2 * x + 2].copy_from_slice(&u.to_le_bytes());
+        uv[2 * x + 2..2 * x + 4].copy_from_slice(&v.to_le_bytes());
+    }
+}
+
+type ConvertRows = fn(&[u8], &[u8], &mut [u8], &mut [u8], &mut [u8], usize);
+
+fn convert_bands(
+    luma: &mut [u8], chroma: &mut [u8], src: &[u8], stride: usize,
+    width: usize, rows: usize, pitch: usize, bytes: usize, convert: ConvertRows,
+) {
+    let even_width = (width + 1) & !1;
+    let bw = (even_width * bytes).div_ceil(64) * 64;
+    // Reuse the C core's cache-sized 32 luma + 16 chroma row scratch buffer.
+    let mut buf = vec![0; bw * 48];
+    let (yb, uvb) = buf.split_at_mut(bw * 32);
+    for r0 in (0..rows).step_by(32) {
+        let count = (rows - r0).min(32);
+        for r in (0..count).step_by(2) {
+            let s0 = &src[(r0 + r) * stride..];
+            let s1 = &src[(r0 + (r + 1).min(count - 1)) * stride..];
+            let (before, after) = yb.split_at_mut((r + 1) * bw);
+            convert(s0, s1, &mut before[r * bw..], &mut after[..bw], &mut uvb[(r / 2) * bw..], width);
+        }
+        tile_rows(&mut luma[r0 * pitch..], yb, bw, width * bytes, count, pitch);
+        tile_rows(&mut chroma[(r0 / 2) * pitch..], uvb, bw, even_width * bytes, count.div_ceil(2), pitch);
+    }
+}
+
+fn convert_surface(
+    luma: &mut [u8], chroma: &mut [u8], src: &[u8], stride: usize,
+    width: usize, rows: usize, pitch: usize, bytes: usize, convert: ConvertRows,
+) {
+    if rows == 0 || width == 0 { return; }
+    // A super-band is two luma tile rows and one chroma tile row.
+    let split = rows.div_ceil(32).div_ceil(2) * 32;
+    if split >= rows {
+        convert_bands(luma, chroma, src, stride, width, rows, pitch, bytes, convert);
+        return;
+    }
+    let (ya, yb) = luma.split_at_mut((split * pitch).min(luma.len()));
+    let (uva, uvb) = chroma.split_at_mut((split / 2 * pitch).min(chroma.len()));
+    std::thread::scope(|scope| {
+        scope.spawn(|| convert_bands(ya, uva, src, stride, width, split, pitch, bytes, convert));
+        convert_bands(yb, uvb, &src[split * stride..], stride, width, rows - split, pitch, bytes, convert);
+    });
+}
+
+pub fn in_tile_bgra(
+    dst_luma: &mut [u8], dst_chroma: &mut [u8], src: &[u8], src_stride: usize,
+    width: usize, rows: usize, pitch: usize,
+) {
+    convert_surface(dst_luma, dst_chroma, src, src_stride, width, rows, pitch, 1, bgra_rows);
+}
+
+pub fn in_tile_l10r(
+    dst_luma: &mut [u8], dst_chroma: &mut [u8], src: &[u8], src_stride: usize,
+    width: usize, rows: usize, pitch: usize,
+) {
+    convert_surface(dst_luma, dst_chroma, src, src_stride, width, rows, pitch, 2, l10r_rows);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn known_offsets() {
+        assert_eq!(bl_offset(32, 0, 128, 2), 256);
+        assert_eq!(bl_offset(64, 0, 128, 2), 2048);
+        assert_eq!(bl_offset(0, 32, 128, 2), 4096);
+        assert_eq!(in_offset(16, 0, 128), 64);
+        assert_eq!(in_offset(0, 4, 128), 128);
+        assert_eq!(in_offset(0, 16, 128), 2048);
+    }
+
+    #[test]
+    fn tile_roundtrip_preserves_padding() {
+        let (width, rows, stride, pitch) = (73, 67, 89, 128);
+        let src: Vec<u8> = (0..rows * stride).map(|i| (i * 37) as u8).collect();
+        let mut tiled = vec![0xa5; in_plane_size(pitch, rows)];
+        let mut dst = vec![0xcd; rows * stride];
+        in_tile_plane(&mut tiled, &src, stride, width, rows, pitch);
+        in_untile_plane(&mut dst, stride, &tiled, width, rows, pitch);
+        for y in 0..rows {
+            assert_eq!(&dst[y * stride..y * stride + width], &src[y * stride..y * stride + width]);
+            assert!(dst[y * stride + width..(y + 1) * stride].iter().all(|&v| v == 0xcd));
+        }
+    }
+}
