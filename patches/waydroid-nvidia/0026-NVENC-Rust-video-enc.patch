+        put32(b, 0x16c, 4096);
+        put32(b, 0x18c, 4096);
+        put32(b, 0x178, 0x100 + area as u32);
+        put32(b, 0x174, 0x100 + 2 * area as u32);
+        put32(b, 0x180, 0x100 | (self.sb_cols as u32) << 16);
+        put32(b, 0x184, self.sb_rows as u32);
+        put32(
+            b,
+            0x31c,
+            0x80000000 | (self.wmb * self.hmb * 56).max(202500) as u32,
+        );
