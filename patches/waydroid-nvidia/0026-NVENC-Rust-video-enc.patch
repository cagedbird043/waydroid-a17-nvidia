+    pub fn headers(&self, out: &mut Vec<u8>) {
+        match self.cfg.codec {
+            ENC_AV1 => {}
+            ENC_HEVC => {
+                let p = self.hevc_params();
+                hevchdr::write_vps(&p, out);
+                hevchdr::write_sps(&p, out);
+                hevchdr::write_pps(&p, out);
+            }
+            _ => {
