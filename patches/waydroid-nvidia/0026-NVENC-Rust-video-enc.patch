--- /dev/null
+++ b/nvidia-prolapse/driver-source/native/src/bin/nv-venc-test.rs
@@ -0,0 +1,290 @@
+//! Host raw-input encode tool; base options/output match media/test/nvenc_test.c.
+//! Extra options exercise the complete EncConfig on the same C/Rust comparison harness.
+use nv_bionic_native::video::enc::{EncConfig, EncFrame, Encoder, ENC_AV1, ENC_HEVC};
+use std::{
+    collections::VecDeque,
+    fs::File,
+    io::{Read, Seek, SeekFrom, Write},
+};
+fn value(args: &[String], i: &mut usize) -> Result<i32, String> {
+    *i += 1;
+    args.get(*i)
+        .ok_or("missing option value")?
+        .parse()
+        .map_err(|_| "invalid integer".into())
+}
+fn hex<const N: usize>(s: &str) -> Result<[u8; N], String> {
+    if s.len() != 2 * N {
+        return Err("wrong metadata hex length".into());
+    }
+    let mut out = [0; N];
+    for (i, b) in out.iter_mut().enumerate() {
+        *b = u8::from_str_radix(&s[i * 2..i * 2 + 2], 16).map_err(|_| "invalid metadata hex")?;
+    }
+    Ok(out)
+}
+fn run() -> Result<i32, Box<dyn std::error::Error>> {
+    let a: Vec<String> = std::env::args().collect();
+    let mut c = EncConfig {
+        qp_i: 26,
+        qp_p: 28,
+        num_refs: 1,
+        fps: 30,
+        h264_profile: 100,
+        cabac: true,
+        ..Default::default()
+    };
+    let mut i = 1;
+    let mut pci = None;
+    while i < a.len() && a[i].starts_with('-') {
+        match a[i].as_str() {
+            "-hevc" => c.codec = ENC_HEVC,
+            "-av1" => {
+                c.codec = ENC_AV1;
+                c.qp_i = 90;
+                c.qp_p = 110;
+            }
+            "-cbr" => {
+                c.rc_mode = 2;
+                c.bitrate = value(&a, &mut i)? * 1000;
+            }
+            "-vbr" => {
+                c.rc_mode = 1;
+                c.bitrate = value(&a, &mut i)? * 1000;
+            }
+            "-qp" => {
+                c.qp_i = value(&a, &mut i)?;
+                c.qp_p = c.qp_i;
+            }
+            "-gop" => c.idr_period = value(&a, &mut i)?,
+            "-fps" => c.fps = value(&a, &mut i)?,
+            "-profile" => c.h264_profile = value(&a, &mut i)?,
+            "-level" => c.h264_level = value(&a, &mut i)?,
+            "-bf" => c.bframes = value(&a, &mut i)?,
+            "-refs" => c.num_refs = value(&a, &mut i)?,
+            "-depth" => c.depth = value(&a, &mut i)?,
+            "-slices" => c.slices = value(&a, &mut i)?,
+            "-aq" => c.aq = value(&a, &mut i)?,
+            "-engine" => c.engine = value(&a, &mut i)?,
+            "-vbv" => c.vbv_bits = value(&a, &mut i)? * 1000,
+            "-maxrate" => c.max_bitrate = value(&a, &mut i)? * 1000,
+            "-10" => c.bit_depth = 10,
+            "-444" => c.chroma444 = true,
+            "-quality" => c.quality = true,
+            "-two-pass" => c.two_pass = true,
+            "-lossless" => c.lossless = true,
+            "-no-cu8" => c.no_cu8 = true,
+            "-full-range" => c.full_range = true,
+            "-v" => c.verbose = true,
+            "-colour" => {
+                for v in &mut c.colour {
+                    *v = value(&a, &mut i)?;
+                }
+            }
+            "-mdcv" => {
+                i += 1;
+                c.mdcv = hex(a.get(i).ok_or("missing MDCV")?)?;
+                c.has_mdcv = true;
+            }
+            "-cll" => {
+                i += 1;
+                c.cll = hex(a.get(i).ok_or("missing CLL")?)?;
+                c.has_cll = true;
+            }
+            "-pci" => {
+                i += 1;
+                let p = a
+                    .get(i)
+                    .ok_or("missing PCI address")?
+                    .replace([':', '.'], " ");
+                let p: Vec<_> = p
+                    .split_whitespace()
+                    .map(|x| u32::from_str_radix(x, 16))
+                    .collect::<Result<_, _>>()?;
+                pci = Some(
+                    p.try_into()
+                        .map_err(|_| "PCI address must be domain:bus:device.function")?,
+                );
+            }
+            x => {
+                eprintln!("unknown option {x}");
+                return Ok(2);
+            }
+        }
+        i += 1;
+    }
+    if a.len() - i != 4 {
+        eprintln!("usage: nvenc_test [-hevc|-av1] [-cbr KBPS|-vbr KBPS] [-qp QP] [-gop N] [-fps F] [-profile 66|77|100] [-level IDC] W H in.nv12 out");
+        return Ok(2);
+    }
+    c.width = a[i].parse()?;
+    c.height = a[i + 1].parse()?;
+    let (w, h) = (c.width as usize, c.height as usize);
+    let samples = if c.chroma444 {
+        3 * w * h
+    } else {
+        w * h + w * h.div_ceil(2)
+    };
+    let frame_bytes = samples
+        * if c.bit_depth == 10 && !c.chroma444 {
+            2
+        } else {
+            1
+        };
+    let mut input = File::open(&a[i + 2])?;
+    let mut output = File::create(&a[i + 3])?;
+    let count = input.metadata()?.len() as usize / frame_bytes;
+    let mut buf = vec![0; frame_bytes];
+    let mut e = Encoder::open_on(&c, pci).map_err(|e| e.to_string())?;
+    let mut hdr = Vec::new();
+    e.headers(&mut hdr);
+    output.write_all(&hdr)?;
+    let mut stream = Vec::with_capacity(w * h * 2 + 4096);
+    let mut pending = VecDeque::with_capacity(e.cfg.depth as usize);
+    let (mut n, mut failed, mut total, mut ms) = (0, 0, hdr.len(), 0.0);
+    let mut order = Vec::with_capacity(count);
+    let mut pos = 0;
+    while pos < count {
+        let end = if c.idr_period > 0 {
+            (pos + c.idr_period as usize).min(count)
+        } else {
+            count
+        };
+        order.push((pos, false, false, true));
+        let mut anchor = pos;
+        while anchor + 1 < end {
+            let next = (anchor + e.cfg.bframes.max(0) as usize + 1).min(end - 1);
+            order.push((next, false, false, false));
+            for b in anchor + 1..next {
+                order.push((b, true, b + 1 == next, false));
+            }
+            anchor = next;
+        }
+        pos = end;
+    }
+    for (disp, b, show, force) in order {
+        if pending.len() == e.cfg.depth as usize {
+            let (t, s) = pending.pop_front().unwrap();
+            finish(
+                &mut e,
+                t,
+                s,
+                &mut stream,
+                &hdr,
+                &mut output,
+                &c,
+                &mut n,
+                &mut failed,
+                &mut total,
+                &mut ms,
+            )?;
+        }
+        input.seek(SeekFrom::Start((disp * frame_bytes) as u64))?;
+        input.read_exact(&mut buf)?;
+        if c.chroma444 {
+            e.load_yuv444(
+                &buf[..w * h],
+                w,
+                &buf[w * h..2 * w * h],
+                w,
+                &buf[2 * w * h..],
+                w,
+            )
+            .map_err(|e| e.to_string())?;
+        } else if c.bit_depth == 10 {
+            e.load_p010(&buf[..2 * w * h], 2 * w, &buf[2 * w * h..], 2 * w)
+                .map_err(|e| e.to_string())?;
+        } else {
+            e.load_nv12(&buf[..w * h], w, &buf[w * h..], w)
+                .map_err(|e| e.to_string())?;
+        }
+        pending.push_back((
+            e.submit_ex(force, b, disp as i32)
+                .map_err(|e| e.to_string())?,
+            show,
+        ));
+    }
+    while let Some((t, s)) = pending.pop_front() {
+        finish(
+            &mut e,
+            t,
+            s,
+            &mut stream,
+            &hdr,
+            &mut output,
+            &c,
+            &mut n,
+            &mut failed,
+            &mut total,
+            &mut ms,
+        )?;
+    }
+    println!(
+        "{n} frames ({failed} failed), {total} bytes, mean engine time {:.3} ms",
+        if n > failed {
+            ms / f64::from(n - failed)
+        } else {
+            0.0
+        }
+    );
+    Ok(i32::from(failed != 0))
+}
+#[allow(clippy::too_many_arguments)]
+fn finish(
+    e: &mut Encoder,
+    t: u32,
+    show: bool,
+    stream: &mut Vec<u8>,
+    hdr: &[u8],
+    output: &mut File,
+    c: &EncConfig,
+    n: &mut i32,
+    failed: &mut i32,
+    total: &mut usize,
+    ms: &mut f64,
+) -> Result<(), Box<dyn std::error::Error>> {
+    stream.clear();
+    let fr: EncFrame = match e.wait(t, stream) {
+        Ok(f) => f,
+        Err(err) => {
+            eprintln!("frame {} failed ({err})", *n);
+            *failed += 1;
+            *n += 1;
+            return Ok(());
+        }
+    };
+    if fr.idr && *n > 0 && !hdr.is_empty() {
+        output.write_all(hdr)?;
+        *total += hdr.len();
+    }
+    output.write_all(stream)?;
+    *total += fr.size;
+    *ms += fr.ms;
+    if c.verbose || *n < 3 {
+        println!(
+            "frame {}: {} {} bytes, {:.3} ms, avgQP {}",
+            *n,
+            if fr.idr { "IDR" } else { "P" },
+            fr.size,
+            fr.ms,
+            fr.avg_qp
+        );
+    }
+    *n += 1;
+    if show && c.codec == ENC_AV1 {
+        stream.clear();
+        e.av1_show_existing(stream);
+        output.write_all(stream)?;
+        *total += stream.len();
+    }
+    Ok(())
+}
+fn main() {
+    match run() {
+        Ok(c) => std::process::exit(c),
+        Err(e) => {
+            eprintln!("{e}");
+            std::process::exit(1);
+        }
+    }
+}
diff --git a/nvidia-prolapse/driver-source/native/src/video/enc/av1hdr.rs b/nvidia-prolapse/driver-source/native/src/video/enc/av1hdr.rs
new file mode 100644
index 0000000..d5c58fd
--- /dev/null
+++ b/nvidia-prolapse/driver-source/native/src/video/enc/av1hdr.rs
@@ -0,0 +1,488 @@
+//! AV1 OBUs for NVENC's supported tools; section numbers refer to the AV1 specification.
+use super::h264hdr::Bw;
+#[derive(Clone, Debug, Default)]
+pub struct Av1SeqParams {
+    pub width: i32,
+    pub height: i32,
+    pub bit_depth: i32,
+    pub full_range: bool,
+    pub colour: [i32; 3],
+    pub seq_level_idx: i32,
+    pub enable_cdef: bool,
+    pub enable_restoration: bool,
+    pub order_hint_bits: i32,
+}
+#[derive(Clone, Debug, Default)]
+pub struct Av1FrameParams {
+    pub frame_type: i32,
+    pub hidden: bool,
+    pub order_hint: i32,
+    pub refresh_frame_flags: i32,
+    pub ref_frame_idx: [i32; 7],
+    pub ref_order_hint: [i32; 7],
+    pub primary_ref_frame: i32,
+    pub error_resilient: bool,
+    pub disable_cdf_update: bool,
+    pub disable_frame_end_update_cdf: bool,
+    pub base_q_idx: i32,
+    pub dq_y_dc: i32,
+    pub dq_u_dc: i32,
+    pub dq_u_ac: i32,
+    pub delta_q_present: bool,
+    pub lf_level: [i32; 4],
+    pub lf_sharpness: i32,
+    pub lf_delta_enabled: bool,
+    pub cdef_damping: i32,
+    pub cdef_bits: i32,
+    pub cdef_y: [i32; 8],
+    pub cdef_uv: [i32; 8],
+    pub lr_type: [i32; 3],
+    pub lr_unit_shift: i32,
+    pub tx_mode_select: bool,
+    pub reference_select: bool,
+    pub reduced_tx_set: bool,
+    pub interp_filter: i32,
+    pub allow_high_precision_mv: bool,
+    pub is_motion_mode_switchable: bool,
+    pub tile_cols_log2: i32,
+    pub tile_rows_log2: i32,
+    pub context_update_tile_id: i32,
+    pub tile_size_bytes: i32,
+}
+fn leb128(mut v: usize, out: &mut Vec<u8>) {
+    loop {
+        let x = (v & 0x7f) as u8;
+        v >>= 7;
+        out.push(x | if v != 0 { 0x80 } else { 0 });
+        if v == 0 {
+            break;
+        }
+    }
+}
+fn obu(typ: u8, payload: &[u8], out: &mut Vec<u8>) {
+    out.push(typ << 3 | 2);
+    leb128(payload.len(), out);
+    out.extend_from_slice(payload);
+}
+pub fn level_for(width: i32, height: i32) -> i32 {
+    let ps = width as i64 * height as i64;
+    if ps <= 665856 {
+        4
+    } else if ps <= 1065024 {
+        5
+    } else if ps <= 2359296 {
+        9
+    } else if ps <= 8912896 {
+        13
+    } else {
+        17
+    }
+}
+pub fn write_temporal_delimiter(out: &mut Vec<u8>) {
+    out.extend_from_slice(&[0x12, 0]);
+}
+fn bits_for(v: i32) -> i32 {
+    let mut n = 1;
+    while (1i64 << n) <= v as i64 {
+        n += 1;
+    }
+    n
+}
+pub fn write_sequence_header(s: &Av1SeqParams, out: &mut Vec<u8>) {
+    let mut b = Bw::<64>::new();
+    b.put(0, 3);
+    b.put(0, 1);
+    b.put(0, 1);
+    b.put(0, 1);
+    b.put(0, 1);
+    b.put(0, 5);
+    b.put(0, 12);
+    let lvl = if s.seq_level_idx != 0 {
+        s.seq_level_idx
+    } else {
+        level_for(s.width, s.height)
+    };
+    b.put(lvl as u32, 5);
+    if lvl > 7 {
+        b.put(0, 1);
+    }
+    let wb = bits_for(s.width - 1);
+    let hb = bits_for(s.height - 1);
+    b.put(wb as u32 - 1, 4);
+    b.put(hb as u32 - 1, 4);
+    b.put(s.width as u32 - 1, wb);
+    b.put(s.height as u32 - 1, hb);
+    b.put(0, 1);
+    b.put(0, 1);
+    b.put(0, 1);
+    b.put(0, 1);
+    b.put(0, 1);
+    b.put(0, 1);
+    b.put(0, 1);
+    b.put(0, 1);
+    b.put(1, 1);
+    b.put(0, 1);
+    b.put(0, 1);
+    b.put(0, 1);
+    b.put(0, 1);
+    b.put(
+        if s.order_hint_bits != 0 {
+            s.order_hint_bits
+        } else {
+            7
+        } as u32
+            - 1,
+        3,
+    );
+    b.put(0, 1);
+    b.flag(s.enable_cdef);
+    b.flag(s.enable_restoration);
+    b.flag(s.bit_depth > 8);
+    b.put(0, 1);
+    b.put(1, 1);
+    for c in s.colour {
+        b.put(if c != 0 { c } else { 1 } as u32, 8);
+    }
+    b.flag(s.full_range);
+    b.put(0, 2);
+    b.put(0, 1);
+    b.put(0, 1);
+    b.trailing();
+    obu(1, b.bytes(), out);
+}
+fn tile_log2(blk: i32, target: i32) -> i32 {
+    let mut k = 0;
+    while (blk << k) < target {
+        k += 1;
+    }
+    k
+}
+fn delta_q(b: &mut Bw<512>, v: i32) {
+    b.flag(v != 0);
+    if v != 0 {
+        b.put(v as u32 & 127, 7);
+    }
+}
+pub fn write_frame(s: &Av1SeqParams, f: &Av1FrameParams, tiles: &[&[u8]], out: &mut Vec<u8>) {
+    let mut b = Bw::<512>::new();
+    let key = f.frame_type == 0;
+    let intra = key;
+    let ohb = if s.order_hint_bits != 0 {
+        s.order_hint_bits
+    } else {
+        7
+    };
+    b.put(0, 1);
+    b.put(f.frame_type as u32, 2);
+    b.flag(!f.hidden);
+    if f.hidden {
+        b.put(1, 1);
+    }
+    let er = key || f.error_resilient;
+    if !key {
+        b.flag(f.error_resilient);
+    }
+    b.flag(f.disable_cdf_update);
+    b.put(0, 1);
+    b.put(f.order_hint as u32 & ((1 << ohb) - 1), ohb);
+    if !(intra || er) {
+        b.put(f.primary_ref_frame as u32, 3);
+    }
+    if !key {
+        b.put(f.refresh_frame_flags as u32, 8);
+    }
+    if !intra && er && f.refresh_frame_flags != 0xff {
+        for _ in 0..8 {
+            b.put(0, ohb);
+        }
+    }
+    if key {
+        b.put(0, 1);
+    } else {
+        b.put(0, 1);
+        for v in f.ref_frame_idx {
+            b.put(v as u32, 3);
+        }
+        b.put(0, 1);
+        b.flag(f.allow_high_precision_mv);
+        b.flag(f.interp_filter == 4);
+        if f.interp_filter != 4 {
+            b.put(f.interp_filter as u32, 2);
+        }
+        b.flag(f.is_motion_mode_switchable);
+    }
+    if !f.disable_cdf_update {
+        b.flag(f.disable_frame_end_update_cdf);
+    }
+    // Uniform spacing tile_info (5.9.15), 64x64 superblocks.
+    let mi_cols = 2 * ((s.width + 7) >> 3);
+    let mi_rows = 2 * ((s.height + 7) >> 3);
+    let sb_cols = (mi_cols + 15) >> 4;
+    let sb_rows = (mi_rows + 15) >> 4;
+    let min_cols = tile_log2(64, sb_cols);
+    let max_cols = tile_log2(1, sb_cols.min(64));
+    let max_rows = tile_log2(1, sb_rows.min(64));
+    let min_tiles = min_cols.max(tile_log2((4096 * 2304) >> 12, sb_rows * sb_cols));
+    b.put(1, 1);
+    let mut cl = min_cols;
+    while cl < max_cols {
+        let inc = cl < f.tile_cols_log2;
+        b.flag(inc);
+        if !inc {
+            break;
+        }
+        cl += 1;
+    }
+    let mut rl = (min_tiles - cl).max(0);
+    while rl < max_rows {
+        let inc = rl < f.tile_rows_log2;
+        b.flag(inc);
+        if !inc {
+            break;
+        }
+        rl += 1;
+    }
+    if cl != 0 || rl != 0 {
+        b.put(f.context_update_tile_id as u32, cl + rl);
+        b.put(f.tile_size_bytes as u32 - 1, 2);
+    }
+    b.put(f.base_q_idx as u32, 8);
+    delta_q(&mut b, f.dq_y_dc);
+    delta_q(&mut b, f.dq_u_dc);
+    delta_q(&mut b, f.dq_u_ac);
+    b.put(0, 1);
+    b.put(0, 1);
+    if f.base_q_idx > 0 {
+        b.flag(f.delta_q_present);
+        if f.delta_q_present {
+            b.put(0, 2);
+            b.put(0, 1);
+        }
+    }
+    let lossless = f.base_q_idx == 0 && f.dq_y_dc == 0 && f.dq_u_dc == 0 && f.dq_u_ac == 0;
+    if !lossless {
+        b.put(f.lf_level[0] as u32, 6);
+        b.put(f.lf_level[1] as u32, 6);
+        if f.lf_level[0] != 0 || f.lf_level[1] != 0 {
+            b.put(f.lf_level[2] as u32, 6);
+            b.put(f.lf_level[3] as u32, 6);
+        }
+        b.put(f.lf_sharpness as u32, 3);
+        b.flag(f.lf_delta_enabled);
+        if f.lf_delta_enabled {
+            b.put(0, 1);
+        }
+        if s.enable_cdef {
+            b.put(f.cdef_damping as u32 - 3, 2);
+            b.put(f.cdef_bits as u32, 2);
+            for i in 0..(1 << f.cdef_bits) {
+                b.put(f.cdef_y[i] as u32 >> 2, 4);
+                b.put(f.cdef_y[i] as u32 & 3, 2);
+                b.put(f.cdef_uv[i] as u32 >> 2, 4);
+                b.put(f.cdef_uv[i] as u32 & 3, 2);
+            }
+        }
+        if s.enable_restoration {
+            for v in f.lr_type {
+                b.put(v as u32, 2);
+            }
+            if f.lr_type.iter().any(|&v| v != 0) {
+                b.flag(f.lr_unit_shift > 0);
+                if f.lr_unit_shift > 0 {
+                    b.flag(f.lr_unit_shift > 1);
+                }
+                if f.lr_type[1] != 0 || f.lr_type[2] != 0 {
+                    b.put(0, 1);
+                }
+            }
+        }
+        b.flag(f.tx_mode_select);
+    }
+    if !intra {
+        b.flag(f.reference_select);
+    }
+    if !intra && f.reference_select {
+        // skip_mode_params (5.9.22), including wrapped order hints.
+        let m = 1 << (ohb - 1);
+        let mask = (1 << ohb) - 1;
+        let rel = |a: i32, z: i32| ((a - z) & (m - 1)) - ((a - z) & m);
+        let mut fwd = None;
+        let mut bwd = None;
+        for &v in &f.ref_order_hint {
+            let h = v & mask;
+            let oh = f.order_hint & mask;
+            if rel(h, oh) < 0 {
+                if fwd.is_none_or(|v| rel(h, v) > 0) {
+                    fwd = Some(h);
+                }
+            } else if rel(h, oh) > 0 && bwd.is_none_or(|v| rel(h, v) < 0) {
+                bwd = Some(h);
+            }
+        }
+        let allowed = if let Some(fwd) = fwd {
+            bwd.is_some() || f.ref_order_hint.iter().any(|&h| rel(h & mask, fwd) < 0)
+        } else {
+            false
+        };
+        if allowed {
+            b.put(0, 1);
+        }
+    }
+    b.flag(f.reduced_tx_set);
+    if !intra {
+        for _ in 0..7 {
+            b.put(0, 1);
+        }
+    }
+    b.align();
+    if tiles.len() > 1 {
+        b.put(0, 1);
+        b.align();
+    }
+    // Emit directly into the caller's buffer, without a temporary copy of tile data.
+    let payload_len = b.bytes().len()
+        + tiles.iter().map(|t| t.len()).sum::<usize>()
+        + tiles.len().saturating_sub(1) * f.tile_size_bytes as usize;
+    out.push(6 << 3 | 2);
+    leb128(payload_len, out);
+    out.extend_from_slice(b.bytes());
+    for (i, tile) in tiles.iter().enumerate() {
+        if i + 1 < tiles.len() {
+            let sz = tile.len() - 1;
+            for k in 0..f.tile_size_bytes {
+                out.push((sz >> (8 * k)) as u8);
+            }
+        }
+        out.extend_from_slice(tile);
+    }
+}
+pub fn write_show_existing(slot: i32, out: &mut Vec<u8>) {
+    let mut b = Bw::<4>::new();
+    b.put(1, 1);
+    b.put(slot as u32, 3);
+    b.trailing();
+    obu(3, b.bytes(), out);
+}
+/// Convert SEI G/B/R primaries (0.00002), luminance (0.0001 cd/m2) to AV1 R/G/B, 0.16, 24.8, 18.14.
+pub fn write_hdr_metadata(mdcv: Option<&[u8; 24]>, cll: Option<&[u8; 4]>, out: &mut Vec<u8>) {
+    if let Some(v) = mdcv {
+        let be16 = |i| u16::from_be_bytes([v[i], v[i + 1]]) as u64;
+        let be32 = |i| u32::from_be_bytes([v[i], v[i + 1], v[i + 2], v[i + 3]]) as u64;
+        let mut b = Bw::<32>::new();
+        b.put(2, 8);
+        for i in [2, 0, 1] {
+            b.put(((be16(4 * i) * 131072 + 50000) / 100000) as u32, 16);
+            b.put(((be16(4 * i + 2) * 131072 + 50000) / 100000) as u32, 16);
+        }
+        b.put(((be16(12) * 131072 + 50000) / 100000) as u32, 16);
+        b.put(((be16(14) * 131072 + 50000) / 100000) as u32, 16);
+        b.put(((be32(16) * 256 + 5000) / 10000) as u32, 32);
+        b.put(((be32(20) * 16384 + 5000) / 10000) as u32, 32);
+        b.trailing();
+        obu(5, b.bytes(), out);
+    }
+    if let Some(v) = cll {
+        let mut b = Bw::<8>::new();
+        b.put(1, 8);
+        b.put(u16::from_be_bytes([v[0], v[1]]) as u32, 16);
+        b.put(u16::from_be_bytes([v[2], v[3]]) as u32, 16);
+        b.trailing();
+        obu(5, b.bytes(), out);
+    }
+}
