+            let o = 4 + 32 * k;
+            let input = k == 1;
+            put32(b, o, dims);
+            put32(b, o + 4, if input { ip | ip << 16 } else { rp | rp << 16 });
+            if input {
+                put32(b, o + 0x14, (self.luma_sz >> 8) as u32);
+            } else {
+                put32(b, o + 0x10, (rows / 2 * rpb as usize >> 8) as u32);
+                put32(b, o + 0x14, (self.r_luma >> 8) as u32);
+                put32(
+                    b,
+                    o + 0x18,
+                    ((self.r_luma + rows / 4 * rpb as usize) >> 8) as u32,
