---
 packaging/install.sh | 30 +++++++++++++++++++-----------
 1 file changed, 19 insertions(+), 11 deletions(-)

diff --git a/packaging/install.sh b/packaging/install.sh
index e71b7d7..b1bd88b 100755
--- a/packaging/install.sh
+++ b/packaging/install.sh
@@ -402,14 +402,20 @@ done < "$WORK/files"
 if [ -f "$LIST" ]; then   # upgrade: drop files the previous release had and this one does not
     comm -23 <(sort "$LIST") "$WORK/files" | while IFS= read -r f; do rm -f -- "$f"; done
 fi
-# Unchanged desktop-integration files stay untouched: rewriting one bumps its directory's mtime past
-# icon-theme.cache, and a running Qt (plasmashell) then drops the cached theme for good -- every
-# hicolor icon renders blank until the shell restarts, whatever the cache refresh below does.
-(cd "$ROOT" && find usr/share/icons usr/share/applications etc/xdg -type f 2>/dev/null) | while IFS= read -r f; do
-    if cmp -s "$ROOT/$f" "/$f"; then rm -f -- "$ROOT/$f"; fi
-done
-# existing directories keep their owner, mode and times (--no-overwrite-dir)
-tar -C "$ROOT" -cf - . | tar -C / -xpf - --no-overwrite-dir --no-same-owner
+# Unchanged desktop-integration files stay untouched, and directories that already exist are left out
+# of the archive (tar would otherwise reset their mtime to the staging tree's). A hicolor directory
+# newer than icon-theme.cache makes a running Qt (plasmashell) drop the cached theme for good: every
+# hicolor icon renders blank until the shell restarts, whatever a later cache refresh does.
+icons_changed=0
+while IFS= read -r f; do
+    if cmp -s "$ROOT/$f" "/$f"; then
+        rm -f -- "$ROOT/$f"
+    else
+        case "$f" in usr/share/icons/*) icons_changed=1 ;; esac
+    fi
+done < <(cd "$ROOT" && find usr/share/icons usr/share/applications etc/xdg -type f 2>/dev/null)
+(cd "$ROOT" && find . -mindepth 1 \( ! -type d -o ! -exec test -e "/{}" \; \) -print0) \
+    | tar -C "$ROOT" --null --no-recursion -T - -cf - | tar -C / -xpf - --no-same-owner
 mkdir -p "$STATE" && cp "$WORK/files" "$LIST"
 if selinux_on; then
     # semodule names a module after its file: install it as waydroid.pp
@@ -426,9 +432,11 @@ systemd-tmpfiles --create /usr/lib/tmpfiles.d/waydroid-venus.conf 2>/dev/null ||
 # waydroid-container.service fails to start ("Request to own name refused by policy").
 udevadm control --reload 2>/dev/null || true
 systemctl daemon-reload 2>/dev/null || true
-# The hicolor icon and .desktop files land outside a package manager, whose hooks refresh these caches. A
-# hicolor directory newer than its icon-theme.cache makes GTK/KDE distrust the cache: icons render blank.
-if command -v gtk-update-icon-cache >/dev/null 2>&1; then gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true; fi
+# The hicolor icon and .desktop files land outside a package manager, whose hooks refresh these caches.
+# Refresh the icon cache only after an icon really changed: the refresh itself rewrites the directory.
+if [ "$icons_changed" = 1 ] && command -v gtk-update-icon-cache >/dev/null 2>&1; then
+    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
+fi
 if command -v update-desktop-database >/dev/null 2>&1; then update-desktop-database -q /usr/share/applications || true; fi
 systemctl reload dbus.service 2>/dev/null || systemctl reload dbus-broker.service 2>/dev/null \
     || die "could not reload the system DBus configuration; run: sudo systemctl reload dbus (or reboot), then sudo waydroid-nvidia-setup"
