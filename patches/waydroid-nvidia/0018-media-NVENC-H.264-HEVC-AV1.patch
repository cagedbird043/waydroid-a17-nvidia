@@ -0,0 +1,13 @@
+# NVENC encoder core
+
+Drives the GPU's NVENC engine directly, like the NVDEC path: no closed NVIDIA codec library.
+
+| Part | Source |
+|---|---|
+| `mickys/` | Encoder core from [mickys/nvenc](https://github.com/mickys/nvenc) (MIT, `mickys/LICENSE`), commit `90d1d6a`: picture setups, rate control, H.264 / HEVC / AV1 headers, NVENC input layout. Unchanged except `blocklinear.c` (no libdispatch / Accelerate). |
+| `include/` | NVIDIA open-gpu-doc `classes/video/nvenc_drv.h`, `clc9b7.h` (MIT) |
+| `rm.h`, `channel.h`, `rm_shim.c` | The RM services the core calls, on top of `libnv_bionic_native` (`nv_venc.h`, Rust `src/video/venc.rs`) |
+
+The core also needs the RM SDK headers of open-gpu-kernel-modules (`src/common/sdk/nvidia/inc`, MIT).
+
+Host check (RTX 4060 Laptop, 615.78.08): `media/test/nvenc_test.c` encodes 1080p NV12; H.264 CQP / CBR / VBR, HEVC and AV1 streams decode with FFmpeg at the expected rate.
diff --git a/nvidia-prolapse/media/core/nvenc/channel.h b/nvidia-prolapse/media/core/nvenc/channel.h
new file mode 100644
index 0000000..472666e
--- /dev/null
+++ b/nvidia-prolapse/media/core/nvenc/channel.h
@@ -0,0 +1,27 @@
+// channel.h: a channel on NVENC0 (libnv_bionic_native owns ring, push buffer and doorbell); methods are collected here
+// and handed over on chan_submit. Same names and call shapes as mickys/nvenc src/channel.h, reduced to what enc.c calls.
+#pragma once
+#include "rm.h"
+
+#define CHAN_MAX_WORDS 4096
+
+typedef struct {
+    Rm *rm;
+    uint64_t id;
+    uint64_t last;                    // timeline value of the last submission
+    bool lost;                        // a submission or wait failed: the channel state is unknown
+    struct { void *cpu; } notifier;   // enc.c prints notifier[0] on errors: points at zeros
+    size_t n;
+    NvU32 words[CHAN_MAX_WORDS];
+} Chan;
+
+// engineType: NV2080_ENGINE_TYPE_NVENC0 only; objClass: the NVENC class; objParams unused (allocated by the library)
+NV_STATUS chan_create(Rm *rm, Chan *c, NvU32 engineType, NvU32 objClass, void *objParams);
+void chan_destroy(Chan *c);
+// incrementing method header + data: method byte offset, on subchannel subch
+void chan_mthd(Chan *c, int subch, NvU32 mthd, int count, ...);
+NV_STATUS chan_submit(Chan *c);                // everything since the last submit
+bool chan_rewind(Chan *c);                     // the library manages the push buffer: always true
+size_t chan_push_used(Chan *c);                // always 0
+NvU32 chan_error(Chan *c);                     // nonzero once the channel is lost
+NV_STATUS chan_fault(Chan *c, NvU64 *addr, NvU32 *type, char str[32]);   // not available: NV_ERR_NOT_SUPPORTED
