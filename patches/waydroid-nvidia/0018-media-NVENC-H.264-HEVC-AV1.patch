+//  31                            16                               0
+// .-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-.
+// |                             OFFSET                            | SetOutEncStatus
+// `-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-'
+//
+// #define NV_C9B7_NVENC_SETOUT_ENC_STATUS                 0x00000718  /* -W-4R */
