+// `-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-'
+//
+// #define NV_C9B7_NVENC_SETIN_CEA_HINTS_DATA              0x00000714  /* -W-4R */
+// #define NV_C9B7_NVENC_SETIN_CEA_HINTS_DATA_OFFSET             31:0  /* -W-UF */
+//
+//
+// SetOutEncStatus()
+// -----------------
+// This method sets the encoder status buffer offset. It sets the upper bits
