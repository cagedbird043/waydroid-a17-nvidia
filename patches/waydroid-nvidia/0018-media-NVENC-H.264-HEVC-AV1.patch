diff --git a/nvidia-prolapse/media/core/nvenc/mickys/hevchdr.c b/nvidia-prolapse/media/core/nvenc/mickys/hevchdr.c
new file mode 100644
index 0000000..274f96a
--- /dev/null
+++ b/nvidia-prolapse/media/core/nvenc/mickys/hevchdr.c
@@ -0,0 +1,133 @@
+// hevchdr.c: see hevchdr.h. Exp-Golomb bit writer + emulation prevention (as h264hdr.c).
+#include "hevchdr.h"
+#include <stdbool.h>
+#include <string.h>
+
+typedef struct { uint8_t buf[192]; int bits; } Bw;
+static void put(Bw *b, unsigned v, int n) { for (int i = n - 1; i >= 0; i--, b->bits++) if ((v >> i) & 1) b->buf[b->bits >> 3] |= (uint8_t)(0x80 >> (b->bits & 7)); }
+static void ue(Bw *b, unsigned v) { unsigned x = v + 1; int n = 0; while ((x >> n) > 1) n++; put(b, 0, n); put(b, x, n + 1); }
+static void se(Bw *b, int v) { ue(b, v > 0 ? 2u * (unsigned)v - 1 : 2u * (unsigned)(-v)); }
+static void trailing(Bw *b) { put(b, 1, 1); while (b->bits & 7) put(b, 0, 1); }
+
+static size_t emit(const Bw *b, unsigned nal_type, uint8_t *out)
+{
+    size_t n = 0, len = (size_t)(b->bits >> 3); int zeros = 0;
+    out[n++] = 0; out[n++] = 0; out[n++] = 0; out[n++] = 1;
+    out[n++] = (uint8_t)(nal_type << 1); out[n++] = 1;          // forbidden 0, type, nuh_layer_id 0, temporal_id_plus1 1
+    for (size_t i = 0; i < len; i++) {
+        if (zeros >= 2 && b->buf[i] <= 3) { out[n++] = 3; zeros = 0; }   // emulation prevention
+        out[n++] = b->buf[i]; zeros = b->buf[i] ? 0 : zeros + 1;
+    }
+    return n;
+}
+
+int hevc_level_for(int width, int height)
+{
+    long ps = (long)width * height, sr = ps * 60;               // A.4.1: MaxLumaPs, MaxLumaSr (Main tier)
+    if (ps <= 552960 && sr <= 33177600) return 93;              // 3.1
+    if (ps <= 2228224 && sr <= 133693440) return 123;           // 4.1
+    if (ps <= 8912896 && sr <= 534773760) return 153;           // 5.1
+    return 183;                                                 // 6.1
+}
+static int level(const HevcParams *p) { return p->level_idc ? p->level_idc : hevc_level_for(p->width, p->height); }
+// whole 32x32 CTBs: NVENC encodes a partial last CTB row/column as if it were whole (a 720-line picture coded as 720 lines
+// decoded wrong), so the picture is coded CTB-aligned and the conformance window crops it, as nullmoth's does (T6.06)
+size_t hevc_coded_width(const HevcParams *p) { return ((size_t)p->width + 31) & ~(size_t)31; }
+size_t hevc_coded_height(const HevcParams *p) { return ((size_t)p->height + 31) & ~(size_t)31; }
+
+static void profile_tier_level(Bw *b, int level_idc, bool ten, bool rext)  // 7.3.3, sps_max_sub_layers_minus1 = 0
+{
+    put(b, 0, 2); put(b, 0, 1); put(b, rext ? 4 : ten ? 2 : 1, 5);   // general_profile_space, tier Main, profile Main / Main 10 / RExt
+    put(b, rext ? 0x08000000u : ten ? 0x20000000u : 0x60000000u, 32);   // compatibility flags: RExt / Main 10 only / Main and Main 10
+    put(b, 1, 1); put(b, 0, 1); put(b, 0, 1); put(b, 1, 1);     // progressive, not interlaced, not non-packed, frame only
+    if (rext) {   // Main 4:4:4 (10): max_12bit, max_10bit, max_8bit (8-bit only), no 4:2:2 / 4:2:0 / monochrome / intra / one picture limits, lower_bit_rate
+        put(b, 1, 1); put(b, 1, 1); put(b, ten ? 0 : 1, 1); put(b, 0, 1); put(b, 0, 1); put(b, 0, 1); put(b, 0, 1); put(b, 0, 1); put(b, 1, 1);
+        put(b, 0, 32); put(b, 0, 2);                            // 34 reserved bits
+    } else { put(b, 0, 32); put(b, 0, 11); }                    // 43 reserved constraint bits
+    put(b, 0, 1);                                               // general_inbld_flag
+    put(b, (unsigned)level_idc, 8);
+}
+
+size_t hevc_write_vps(const HevcParams *p, uint8_t *out)
+{
+    Bw b; memset(&b, 0, sizeof b);
+    put(&b, 0, 4);                                              // vps_video_parameter_set_id
+    put(&b, 1, 1); put(&b, 1, 1);                               // base layer internal / available
+    put(&b, 0, 6); put(&b, 0, 3); put(&b, 1, 1);                // max_layers_minus1, max_sub_layers_minus1, temporal_id_nesting
+    put(&b, 0xffff, 16);                                        // vps_reserved_0xffff_16bits
+    profile_tier_level(&b, level(p), p->bit_depth > 8, p->chroma444);
+    put(&b, 1, 1);                                              // vps_sub_layer_ordering_info_present_flag
+    ue(&b, (unsigned)p->max_dec_pic_buffering - 1); ue(&b, (unsigned)p->num_reorder); ue(&b, 0);   // max_dec_pic_buffering_minus1, reorder, no latency limit
+    put(&b, 0, 6); ue(&b, 0);                                   // vps_max_layer_id, vps_num_layer_sets_minus1
+    put(&b, 0, 1);                                              // vps_timing_info_present_flag
+    put(&b, 0, 1);                                              // vps_extension_flag
+    trailing(&b);
+    return emit(&b, 32, out);
+}
+
+size_t hevc_write_sps(const HevcParams *p, uint8_t *out)
+{
+    Bw b; memset(&b, 0, sizeof b);
+    unsigned cw = (unsigned)hevc_coded_width(p), ch = (unsigned)hevc_coded_height(p);
+    put(&b, 0, 4); put(&b, 0, 3); put(&b, 1, 1);                // vps id, max_sub_layers_minus1, temporal_id_nesting
+    profile_tier_level(&b, level(p), p->bit_depth > 8, p->chroma444);
+    ue(&b, 0);                                                  // sps_seq_parameter_set_id
+    ue(&b, p->chroma444 ? 3 : 1);                               // chroma_format_idc 4:4:4 / 4:2:0
+    if (p->chroma444) put(&b, 0, 1);                            // separate_colour_plane_flag
+    ue(&b, cw); ue(&b, ch);
+    const unsigned u = p->chroma444 ? 1 : 2;                    // conformance window units: SubWidthC / SubHeightC
+    unsigned cr = (cw - (unsigned)p->width) / u, cb = (ch - (unsigned)p->height) / u;
+    put(&b, cr || cb ? 1 : 0, 1);
+    if (cr || cb) { ue(&b, 0); ue(&b, cr); ue(&b, 0); ue(&b, cb); }
+    unsigned bd = p->bit_depth > 8 ? (unsigned)p->bit_depth - 8 : 0;
+    ue(&b, bd); ue(&b, bd);                                     // bit depth luma / chroma - 8
+    ue(&b, (unsigned)p->log2_max_poc_lsb_minus4);
+    put(&b, 1, 1);                                              // sps_sub_layer_ordering_info_present_flag
+    ue(&b, (unsigned)p->max_dec_pic_buffering - 1); ue(&b, (unsigned)p->num_reorder); ue(&b, 0);
+    ue(&b, p->min_cb8 ? 0 : 1); ue(&b, p->min_cb8 ? 2 : 1);     // min CB 16 (log2 - 3 = 1) or 8, max CB 32
+    ue(&b, 0); ue(&b, 3);                                       // min TB 4 (log2 - 2 = 0), max TB 32 (diff 3)
+    ue(&b, 3); ue(&b, 3);                                       // max_transform_hierarchy_depth inter / intra
+    put(&b, 0, 1);                                              // scaling_list_enabled_flag
+    put(&b, p->no_amp ? 0 : 1, 1); put(&b, p->no_sao ? 0 : 1, 1); put(&b, 0, 1);   // amp, sample_adaptive_offset, pcm
+    ue(&b, 1);                                                  // num_short_term_ref_pic_sets
+    ue(&b, (unsigned)p->sps_rps_negative); ue(&b, 0);           // st_ref_pic_set(0): negative pictures, no positive
+    for (int i = 0; i < p->sps_rps_negative; i++) { ue(&b, 0); put(&b, 0, 1); }   // delta_poc_s0_minus1 0, not used by curr
+    put(&b, 0, 1);                                              // long_term_ref_pics_present_flag
+    put(&b, 0, 1); put(&b, p->sis ? 1 : 0, 1);                  // sps_temporal_mvp_enabled_flag, strong_intra_smoothing_enabled_flag
+    put(&b, p->vui ? 1 : 0, 1);
+    if (p->vui) {                                               // E.2.1
+        put(&b, 1, 1); put(&b, 1, 8);                           // aspect_ratio_info_present, aspect_ratio_idc 1 (square)
+        put(&b, 0, 1);                                          // overscan_info_present
+        put(&b, 1, 1); put(&b, 5, 3); put(&b, (unsigned)p->full_range, 1);   // video_signal_type: format unspecified, full range flag
+        put(&b, 1, 1); for (int i = 0; i < 3; i++) put(&b, (unsigned)(p->colour[i] ? p->colour[i] : 1), 8);   // colour description
+        put(&b, 0, 1);                                          // chroma_loc_info_present
+        put(&b, 0, 1); put(&b, 0, 1); put(&b, 0, 1);            // neutral_chroma, field_seq, frame_field_info
+        put(&b, 0, 1);                                          // default_display_window_flag
+        put(&b, 0, 1);                                          // vui_timing_info_present_flag
+        put(&b, 0, 1);                                          // bitstream_restriction_flag
+    }
+    put(&b, 0, 1);                                              // sps_extension_present_flag
+    trailing(&b);
+    return emit(&b, 33, out);
+}
+
+size_t hevc_write_pps(const HevcParams *p, uint8_t *out)
+{
+    Bw b; memset(&b, 0, sizeof b);
+    ue(&b, 0); ue(&b, 0);                                       // pps id, sps id
+    put(&b, 0, 1); put(&b, 0, 1); put(&b, 0, 3);                // dependent slices, output_flag_present, extra slice header bits
+    put(&b, p->no_sdh ? 0 : 1, 1); put(&b, 1, 1);               // sign_data_hiding, cabac_init_present
+    ue(&b, (unsigned)(p->num_ref_idx_l0_default ? p->num_ref_idx_l0_default : 1) - 1); ue(&b, 0);   // l0 / l1 default active - 1
+    se(&b, p->pic_init_qp - 26);
+    put(&b, 0, 1); put(&b, p->no_ts ? 0 : 1, 1);                // constrained_intra_pred, transform_skip_enabled
+    put(&b, p->no_cqd ? 0 : 1, 1); if (!p->no_cqd) ue(&b, 0);   // cu_qp_delta_enabled, diff_cu_qp_delta_depth 0
+    se(&b, 0); se(&b, 0); put(&b, 0, 1);                        // cb / cr qp offsets, slice chroma offsets present
+    put(&b, 0, 1); put(&b, 0, 1); put(&b, p->lossless ? 1 : 0, 1);   // weighted pred / bipred, transquant bypass
+    put(&b, 0, 1); put(&b, 0, 1);                               // tiles, entropy coding sync
+    put(&b, 1, 1);                                              // pps_loop_filter_across_slices_enabled_flag
+    put(&b, 1, 1); put(&b, 0, 1); put(&b, 0, 1); se(&b, 0); se(&b, 0);   // deblocking control present: no override, enabled, offsets 0
+    put(&b, 0, 1); put(&b, 0, 1);                               // pps scaling list, lists_modification_present
+    ue(&b, 0); put(&b, 0, 1); put(&b, 0, 1);                    // log2_parallel_merge_level - 2, slice header extension, pps extension
+    trailing(&b);
+    return emit(&b, 34, out);
+}
diff --git a/nvidia-prolapse/media/core/nvenc/mickys/hevchdr.h b/nvidia-prolapse/media/core/nvenc/mickys/hevchdr.h
new file mode 100644
index 0000000..b04605e
--- /dev/null
+++ b/nvidia-prolapse/media/core/nvenc/mickys/hevchdr.h
@@ -0,0 +1,35 @@
+// hevchdr.h: HEVC VPS/SPS/PPS NAL units (ITU-T H.265 7.3.2.1-7.3.2.3), matching what we tell NVENC in
+// nvenc_h265_sps_data_s / nvenc_h265_pps_data_s, so the slice segments the engine writes decode against them.
+// Values follow what nullmoth's libnvenc_hevc writes (docs/reports/T6.03.md): Main profile, CTB 32, CB 16..32,
+// TB 4..32, AMP + SAO, one short-term RPS in the SPS (slices send their own), no temporal MVP. Unlike nullmoth's, no
+// sign data hiding (no_sdh): NVENC does not apply it, and a PPS that signals it makes every residual decode wrong (T6.05).
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+
+typedef struct {
+    int width, height;              // display size; coded size is whole 32x32 CTBs (conformance window crops it)
+    int level_idc;                  // 30 x level (93 = 3.1, 123 = 4.1, 153 = 5.1); 0 = from the picture size at 60 fps
+    int log2_max_poc_lsb_minus4;    // 4 (as nullmoth's)
+    int max_dec_pic_buffering;      // DPB size in pictures (references + current)
+    int num_reorder;                // sps_max_num_reorder_pics (B pictures: 1)
+    int sps_rps_negative;           // pictures in the SPS's one short-term RPS (deltas 1, none used by the current picture)
+    int num_ref_idx_l0_default;     // PPS default active references in list 0
+    int pic_init_qp;                // 26 + init_qp_minus26
+    int vui;                        // write VUI: square pixels, colour description
+    int full_range;                 // VUI video_full_range_flag
+    int colour[3];                  // VUI colour_primaries, transfer_characteristics, matrix_coefficients (H.273); 0 = BT.709 (1)
+    int bit_depth;                  // 8 (Main) or 10 (Main 10); 0 = 8
+    int chroma444;                  // 4:4:4 (Main 4:4:4 / Main 4:4:4 10, Range Extensions profile)
+    int lossless;                   // transquant_bypass_enabled_flag (the engine bypasses every CU at QP 0)
+    int min_cb8;                    // 8x8 coding blocks (min CB 8 instead of 16; NVIDIA's p6 / p7)
+    int no_sdh, no_ts, no_cqd, no_sao, no_amp, sis;   // experiments (T6.05): coding tools off (sis: strong intra smoothing on)
+} HevcParams;
+
+int hevc_level_for(int width, int height);   // smallest Main-tier level for this size at 60 fps
+size_t hevc_coded_width(const HevcParams *p);
+size_t hevc_coded_height(const HevcParams *p);
+// Annex B (start code 00 00 00 01) NAL units; return bytes written into out (needs ~128 bytes)
+size_t hevc_write_vps(const HevcParams *p, uint8_t *out);
+size_t hevc_write_sps(const HevcParams *p, uint8_t *out);
+size_t hevc_write_pps(const HevcParams *p, uint8_t *out);
diff --git a/nvidia-prolapse/media/core/nvenc/nv_venc.h b/nvidia-prolapse/media/core/nvenc/nv_venc.h
new file mode 100644
index 0000000..2fea840
--- /dev/null
+++ b/nvidia-prolapse/media/core/nvenc/nv_venc.h
@@ -0,0 +1,40 @@
+/* C ABI of libnv_bionic_native's NVENC services (src/video/venc.rs): RM memory
+ * with GPU and CPU mappings, a channel on NVENC0 with its engine object,
+ * submission and completion. One device per encoder session; callers
+ * serialise each device. Errors: negative codes, message in
+ * nv_video_last_error(). */
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct NvVencDevice NvVencDevice;
+
+typedef struct {
+    uint64_t id;    /* for nv_venc_mem_free */
+    uint64_t size;  /* granted size (>= requested) */
+    void *cpu;      /* CPU mapping, NULL unless requested */
+    uint64_t gpu;   /* GPU virtual address */
+} NvVencMemory;
+
+int32_t nv_venc_open(NvVencDevice **out);
+void nv_venc_close(NvVencDevice *dev);
+/* newest class of kind 0 NVENC, 1 NVDEC, 2 host channel; 0 = none */
+uint32_t nv_venc_class(NvVencDevice *dev, uint32_t kind);
+int32_t nv_venc_mem_alloc(NvVencDevice *dev, uint64_t size, uint64_t align, uint32_t system,
+                          uint32_t cpu, NvVencMemory *out);
+void nv_venc_mem_free(NvVencDevice *dev, uint64_t id);
+int32_t nv_venc_channel_create(NvVencDevice *dev, uint32_t cls, uint64_t *channel);
+void nv_venc_channel_destroy(NvVencDevice *dev, uint64_t channel);
+int32_t nv_venc_channel_submit(NvVencDevice *dev, uint64_t channel, const uint32_t *words,
+                               size_t count, uint64_t *value);
+int32_t nv_venc_channel_completed(NvVencDevice *dev, uint64_t channel, uint64_t *value);
+int32_t nv_venc_channel_wait(NvVencDevice *dev, uint64_t channel, uint64_t value);
+const char *nv_video_last_error(void);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/nvidia-prolapse/media/core/nvenc/rm.h b/nvidia-prolapse/media/core/nvenc/rm.h
new file mode 100644
index 0000000..5cc3a9d
--- /dev/null
+++ b/nvidia-prolapse/media/core/nvenc/rm.h
@@ -0,0 +1,39 @@
+// rm.h: the RM services the encoder core (mickys/enc.c) uses, provided by libnv_bionic_native (nv_venc.h) instead of
+// mickys' macOS RM client. Same names and call shapes as mickys/nvenc src/rm.h, reduced to what enc.c calls.
+#pragma once
+#include <stdbool.h>
+#include <stdint.h>
+#include "nvtypes.h"
+#include "nvos.h"
+#include "nvstatus.h"
+#include "nv_venc.h"
+
+typedef struct {
+    NvVencDevice *dev;
+    uint64_t lastChannel;             // the channel rm_event_* wait on (the encoder opens one)
+    bool verbose;
+} Rm;
+
+int  rm_open(Rm *rm);                                                    // 0 = ok
+void rm_close(Rm *rm);
+// The newest class of each kind this GPU offers. 0 = none.
+enum { RM_CLS_NVENC, RM_CLS_NVDEC, RM_CLS_CHANNEL };
+NvU32 rm_class(Rm *rm, int kind);
+
+typedef struct {
+    NvU64 id;
+    NvU64 size;
+    void *cpu;                        // CPU mapping (NULL if none)
+    NvU64 gpu;                        // GPU virtual address
+    NvHandle hPhys;                   // nonzero while allocated (enc_close's test)
+} RmMem;
+NV_STATUS rm_va_init(Rm *rm);                                            // the device owns its address space: no-op
+NV_STATUS rm_mem_alloc(Rm *rm, RmMem *m, NvU64 size, NvU64 align, bool sysmem, bool cpuMap, bool gpuMap);
+void rm_mem_free(Rm *rm, RmMem *m);
+
+// Completion of the encoder's channel: the count is the channel's completed timeline value; waiting blocks on the
+// timeline's sync_file (no spinning).
+typedef struct { NvU32 h; Rm *rm; } RmEvent;
+NV_STATUS rm_event_open(Rm *rm, RmEvent *ev, NvU32 notifyIndex);
+int64_t rm_event_wait(RmEvent *ev, uint32_t seen, uint32_t timeout_us);   // the count after waiting; < 0 = error
+void rm_event_close(Rm *rm, RmEvent *ev);
diff --git a/nvidia-prolapse/media/core/nvenc/rm_shim.c b/nvidia-prolapse/media/core/nvenc/rm_shim.c
new file mode 100644
index 0000000..5ffbb8d
--- /dev/null
+++ b/nvidia-prolapse/media/core/nvenc/rm_shim.c
@@ -0,0 +1,119 @@
+// rm_shim.c: rm.h / channel.h on top of libnv_bionic_native's nv_venc.h.
+#include "channel.h"
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+
+static NvU32 zero_notifier[16];
+
+static void report(const Rm *rm, const char *what)
+{
+    (void)rm;
+    const char *msg = nv_video_last_error();
+    fprintf(stderr, "nvenc: %s: %s\n", what, msg ? msg : "?");
+}
+
+int rm_open(Rm *rm)
+{
+    bool verbose = rm->verbose;
+    memset(rm, 0, sizeof *rm);
+    rm->verbose = verbose;
+    if (nv_venc_open(&rm->dev)) { report(rm, "open"); rm->dev = NULL; return -1; }
+    return 0;
+}
+
+void rm_close(Rm *rm)
+{
+    nv_venc_close(rm->dev);
+    rm->dev = NULL;
+}
+
+NvU32 rm_class(Rm *rm, int kind) { return rm->dev ? nv_venc_class(rm->dev, (uint32_t)kind) : 0; }
+
+NV_STATUS rm_va_init(Rm *rm) { return rm->dev ? NV_OK : NV_ERR_INVALID_STATE; }
+
+NV_STATUS rm_mem_alloc(Rm *rm, RmMem *m, NvU64 size, NvU64 align, bool sysmem, bool cpuMap, bool gpuMap)
+{
+    (void)gpuMap;   // every allocation gets a GPU address
+    memset(m, 0, sizeof *m);
+    NvVencMemory out;
+    if (nv_venc_mem_alloc(rm->dev, size, align, sysmem, cpuMap, &out)) { report(rm, "memory"); return NV_ERR_NO_MEMORY; }
+    m->id = out.id; m->size = out.size; m->cpu = out.cpu; m->gpu = out.gpu; m->hPhys = 1;
+    return NV_OK;
+}
+
+void rm_mem_free(Rm *rm, RmMem *m)
+{
+    if (m->hPhys) nv_venc_mem_free(rm->dev, m->id);
+    memset(m, 0, sizeof *m);
+}
+
+NV_STATUS rm_event_open(Rm *rm, RmEvent *ev, NvU32 notifyIndex)
+{
+    (void)notifyIndex;
+    if (!rm->lastChannel) return NV_ERR_INVALID_STATE;
+    ev->h = 1; ev->rm = rm;
+    return NV_OK;
+}
+
+void rm_event_close(Rm *rm, RmEvent *ev) { (void)rm; memset(ev, 0, sizeof *ev); }
+
+int64_t rm_event_wait(RmEvent *ev, uint32_t seen, uint32_t timeout_us)
+{
+    Rm *rm = ev->rm;
+    uint64_t done = 0;
+    if (nv_venc_channel_completed(rm->dev, rm->lastChannel, &done)) return -1;
+    if (timeout_us == 0 || done > seen) return (int64_t)(uint32_t)done;
+    // the next completion after `seen` (the channel's timeline counts submissions)
+    if (nv_venc_channel_wait(rm->dev, rm->lastChannel, (uint64_t)seen + 1)) return -1;
+    if (nv_venc_channel_completed(rm->dev, rm->lastChannel, &done)) return -1;
+    return (int64_t)(uint32_t)done;
+}
+
+NV_STATUS chan_create(Rm *rm, Chan *c, NvU32 engineType, NvU32 objClass, void *objParams)
+{
+    (void)objParams;
+    memset(c, 0, sizeof *c);
+    c->rm = rm; c->notifier.cpu = zero_notifier;
+    if (engineType != 0x1b) { fprintf(stderr, "nvenc: only NVENC0 is supported (engine 0x%x)\n", engineType); return NV_ERR_NOT_SUPPORTED; }
+    if (nv_venc_channel_create(rm->dev, objClass, &c->id)) { report(rm, "channel"); return NV_ERR_GENERIC; }
+    rm->lastChannel = c->id;
+    return NV_OK;
+}
+
+void chan_destroy(Chan *c)
+{
+    if (c->id) nv_venc_channel_destroy(c->rm->dev, c->id);
+    if (c->rm && c->rm->lastChannel == c->id) c->rm->lastChannel = 0;
+    c->id = 0;
+}
+
+void chan_mthd(Chan *c, int subch, NvU32 mthd, int count, ...)
+{
+    if (c->n + 1 + (size_t)count > CHAN_MAX_WORDS) { c->lost = true; return; }
+    // incrementing method (SEND_INCR): opcode 2, count, subchannel, method dword address
+    c->words[c->n++] = (2u << 28) | ((NvU32)count << 16) | ((NvU32)subch << 13) | (mthd >> 2);
+    va_list ap;
+    va_start(ap, count);
+    for (int i = 0; i < count; i++) c->words[c->n++] = va_arg(ap, NvU32);
+    va_end(ap);
+}
+
+NV_STATUS chan_submit(Chan *c)
+{
+    if (c->lost) { c->n = 0; return NV_ERR_INVALID_STATE; }
+    if (!c->n) return NV_OK;
+    if (nv_venc_channel_submit(c->rm->dev, c->id, c->words, c->n, &c->last)) { report(c->rm, "submit"); c->lost = true; c->n = 0; return NV_ERR_GENERIC; }
+    c->n = 0;
+    return NV_OK;
+}
+
+bool chan_rewind(Chan *c) { (void)c; return true; }
+size_t chan_push_used(Chan *c) { (void)c; return 0; }
+NvU32 chan_error(Chan *c) { return c->lost ? 1u : 0u; }
+
+NV_STATUS chan_fault(Chan *c, NvU64 *addr, NvU32 *type, char str[32])
+{
+    (void)c; (void)addr; (void)type; (void)str;
+    return NV_ERR_NOT_SUPPORTED;
+}
diff --git a/nvidia-prolapse/media/test/nvenc_test.c b/nvidia-prolapse/media/test/nvenc_test.c
new file mode 100644
index 0000000..d1d2f39
--- /dev/null
+++ b/nvidia-prolapse/media/test/nvenc_test.c
@@ -0,0 +1,57 @@
+// nvenc_test.c: encode raw NV12 frames with the NVENC encoder core (media/core/nvenc) through libnv_bionic_native.
+//   nvenc_test [-hevc|-av1] [-cbr KBPS|-vbr KBPS] [-qp QP] [-gop N] [-fps F] W H in.nv12 out.(h264|h265|obu)
+// Frames are tightly packed NV12 (W x H luma, W x H/2 interleaved chroma). Prints per-frame size and engine time.
+#include "enc.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+int main(int argc, char **argv)
+{
+    EncConfig cfg = { .codec = ENC_H264, .qp_i = 26, .qp_p = 28, .num_refs = 1, .fps = 30, .h264_profile = 100, .cabac = true };
+    int ai = 1;
+    for (; ai < argc && argv[ai][0] == '-'; ai++) {
+        const char *a = argv[ai];
+        if (!strcmp(a, "-hevc")) cfg.codec = ENC_HEVC;
+        else if (!strcmp(a, "-av1")) { cfg.codec = ENC_AV1; cfg.qp_i = 90; cfg.qp_p = 110; }
+        else if (!strcmp(a, "-cbr") && ai + 1 < argc) { cfg.rc_mode = 2; cfg.bitrate = atoi(argv[++ai]) * 1000; }
+        else if (!strcmp(a, "-vbr") && ai + 1 < argc) { cfg.rc_mode = 1; cfg.bitrate = atoi(argv[++ai]) * 1000; }
+        else if (!strcmp(a, "-qp") && ai + 1 < argc) cfg.qp_i = cfg.qp_p = atoi(argv[++ai]);
+        else if (!strcmp(a, "-gop") && ai + 1 < argc) cfg.idr_period = atoi(argv[++ai]);
+        else if (!strcmp(a, "-fps") && ai + 1 < argc) cfg.fps = atoi(argv[++ai]);
+        else if (!strcmp(a, "-v")) cfg.verbose = true;
+        else { fprintf(stderr, "unknown option %s\n", a); return 2; }
+    }
+    if (argc - ai != 4) {
+        fprintf(stderr, "usage: nvenc_test [-hevc|-av1] [-cbr KBPS|-vbr KBPS] [-qp QP] [-gop N] [-fps F] W H in.nv12 out\n");
+        return 2;
+    }
+    cfg.width = atoi(argv[ai]); cfg.height = atoi(argv[ai + 1]);
+    const size_t W = (size_t)cfg.width, H = (size_t)cfg.height, frame = W * H + W * ((H + 1) / 2);
+    FILE *in = fopen(argv[ai + 2], "rb"), *out = fopen(argv[ai + 3], "wb");
+    if (!in || !out) { perror("open"); return 1; }
+    uint8_t *buf = malloc(frame);
+    Enc e;
+    if (enc_open(&e, &cfg)) { fprintf(stderr, "enc_open failed\n"); return 1; }
+    uint8_t hdr[512];
+    size_t hn = enc_headers(&e, hdr);
+    fwrite(hdr, 1, hn, out);
+    int n = 0, failed = 0;
+    size_t total = hn;
+    double ms = 0;
+    while (fread(buf, 1, frame, in) == frame) {
+        enc_load_nv12(&e, buf, W, buf + W * H, W);
+        EncFrame fr;
+        if (enc_encode(&e, false, &fr)) { fprintf(stderr, "frame %d failed (ucode error %u)\n", n, fr.ucode_error); failed++; n++; continue; }
+        // H.264 / HEVC IDRs repeat the parameter sets so any IDR starts a decodable stream
+        if (fr.idr && n > 0 && hn) { fwrite(hdr, 1, hn, out); total += hn; }
+        fwrite(fr.data, 1, fr.size, out);
+        total += fr.size; ms += fr.ms;
+        if (cfg.verbose || n < 3) printf("frame %d: %s %zu bytes, %.3f ms, avgQP %u\n", n, fr.idr ? "IDR" : "P", fr.size, fr.ms, fr.avg_qp);
+        n++;
+    }
+    printf("%d frames (%d failed), %zu bytes, mean engine time %.3f ms\n", n, failed, total, n > failed ? ms / (n - failed) : 0.0);
+    enc_close(&e);
+    fclose(in); fclose(out); free(buf);
+    return failed ? 1 : 0;
+}
