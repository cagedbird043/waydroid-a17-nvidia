+    b[0xc9] = (NvU8)e->cfg.qp_p; b[0xca] = (NvU8)av1_qp_b(e); b[0xcb] = (NvU8)e->cfg.qp_i;   // RC: QP[P, B, I]
+    put32(b, 0x154, (NvU32)e->hist.size); put32(b, 0x158, (NvU32)bs->size); put32(b, 0x15c, 0);   // pic_control buffer sizes
