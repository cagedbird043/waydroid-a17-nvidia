+//
+//  31                            16                               0
+// .-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-.
+// |                             OFFSET                            | SetInColocData
+// `-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-'
+//
+// #define NV_C9B7_NVENC_SETIN_COLOC_DATA                  0x00000728  /* -W-4R */
