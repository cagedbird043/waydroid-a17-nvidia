+//
+// #define NV_C9B7_NVENC_SETIN_DRV_PIC_SETUP               0x00000710  /* -W-4R */
+// #define NV_C9B7_NVENC_SETIN_DRV_PIC_SETUP_OFFSET              31:0  /* -W-UF */
+//
+//
+// SetInCEAHintsData()
+// -------------------
+// This method sets the CEA hints data buffer offset. It sets the upper bits (32
