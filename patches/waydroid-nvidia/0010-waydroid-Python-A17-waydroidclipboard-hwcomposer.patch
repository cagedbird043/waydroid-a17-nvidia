diff --git a/packaging/install.sh b/packaging/install.sh
index b1bd88b..3f4af14 100755
--- a/packaging/install.sh
+++ b/packaging/install.sh
@@ -333,6 +333,7 @@ patch -s -d "$WORK/waydroid" -p1 < "$SRC/waydroid/0001-lxc-nvidia-native-mounts.
 if [ -f "$SRC/waydroid/0002-seccomp-allow-kernelsu-supercall.patch" ]; then
     patch -s -d "$WORK/waydroid" -p1 < "$SRC/waydroid/0002-seccomp-allow-kernelsu-supercall.patch"
 fi
+patch -s -d "$WORK/waydroid" -p1 < "$SRC/waydroid/0003-drop-python-clipboard-service.patch"
 cmp -s "$SRC/waydroid/nvidia_native.py" "$WORK/waydroid/tools/helpers/nvidia_native.py" || die "patched generator differs from the release's"
 NFT=1; command -v nft >/dev/null 2>&1 || NFT=0
