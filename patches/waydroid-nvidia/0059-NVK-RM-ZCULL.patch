+++ b/nvidia-prolapse/driver-source/native/mesa/nv_rm.h
@@ -16,6 +16,15 @@
 #include <stddef.h>
 #include <stdint.h>
 struct NvRmDevice;
+/* NV2080_CTRL_GR_GET_ZCULL_INFO_PARAMS field order (ctrl2080gr.h), which is
+ * also the order of Mesa's nv_zcull_device_info. */
+struct NvRmZcullInfo {
+   uint32_t width_align_pixels, height_align_pixels;
+   uint32_t pixel_squares_by_aliquots, aliquot_total;
+   uint32_t region_byte_multiplier, region_header_size, subregion_header_size;
+   uint32_t subregion_count;
+   uint32_t subregion_width_align_pixels, subregion_height_align_pixels;
+};
 struct NvRmInfo {
    uint32_t vendor_id, device_id, chipset, sm;
    uint32_t pci_domain, pci_bus, pci_device, pci_function;
@@ -24,6 +33,13 @@ struct NvRmInfo {
    uint32_t generic_kind; /* NIL uncompressed color PTE kind: Fermi 0xfe, Turing+ 6 */
    uint64_t vram_size, bar_size;
    char name[64];
+   /* ZCULL region geometry (GR_GET_ZCULL_INFO) and the GRAPHICS_ZCULL
+    * context-switch buffer size/alignment. has_zcull_info is 0 when the RM
+    * query failed or returned values outside the supported range; the reason
+    * is logged at open. */
+   struct NvRmZcullInfo zcull;
+   uint32_t zcull_ctxsw_size, zcull_ctxsw_align;
+   uint32_t has_zcull_info, reserved;
 };
 struct NvRmAllocation {
    uint64_t id, size;
diff --git a/nvidia-prolapse/driver-source/native/mesa/nvkmd_rm.c b/nvidia-prolapse/driver-source/native/mesa/nvkmd_rm.c
index d34679c..4a6487d 100644
--- a/nvidia-prolapse/driver-source/native/mesa/nvkmd_rm.c
+++ b/nvidia-prolapse/driver-source/native/mesa/nvkmd_rm.c
@@ -502,6 +502,30 @@ nvkmd_rm_try_create_pdev(struct _drmDevice* drm,
     * version, the non-coherent atom from the CPU cache line. */
    nv_device_info_init_shared_mem_sizes(&pdev->base.dev_info);
    pdev->base.dev_info.nc_atom_size_B = util_cache_granularity();
+   /* ZCULL: the RM counterpart of DRM_NOUVEAU_GET_ZCULL_INFO, filled field
+    * for field like nouveau_ws_device_zcull_info (nouveau_device.c:271-284).
+    * GR_GET_ZCULL_INFO gives the region geometry, the GRAPHICS_ZCULL engine
+    * context properties the context-switch buffer the RM binds to every
+    * graphics channel (GR_CTXSW_ZCULL_BIND, SEPARATE_BUFFER). NVK then uses
+    * ZCULL wherever has_zcull_info is set (nvk_image.c:1142-1155,
+    * nvk_cmd_draw.c:1494-1590). */
+   if (info->has_zcull_info) {
+      pdev->base.dev_info.zcull_info = (struct nv_zcull_device_info){
+         .width_align_pixels = info->zcull.width_align_pixels,
+         .height_align_pixels = info->zcull.height_align_pixels,
+         .pixel_squares_by_aliquots = info->zcull.pixel_squares_by_aliquots,
+         .aliquot_total = info->zcull.aliquot_total,
+         .zcull_region_byte_multiplier = info->zcull.region_byte_multiplier,
+         .zcull_region_header_size = info->zcull.region_header_size,
+         .zcull_subregion_header_size = info->zcull.subregion_header_size,
+         .subregion_count = info->zcull.subregion_count,
+         .subregion_width_align_pixels = info->zcull.subregion_width_align_pixels,
+         .subregion_height_align_pixels = info->zcull.subregion_height_align_pixels,
+         .ctxsw_size = info->zcull_ctxsw_size,
+         .ctxsw_align = info->zcull_ctxsw_align,
+      };
+      pdev->base.dev_info.has_zcull_info = true;
+   }
    pdev->base.kmd_info = (struct nvkmd_info){
       .has_dma_buf = true,
       .has_alloc_tiled = info->generic_kind == 0x06 || info->generic_kind == 0xfe,
diff --git a/nvidia-prolapse/driver-source/native/mesa/tests/README.md b/nvidia-prolapse/driver-source/native/mesa/tests/README.md
