new file mode 100755
index 0000000..b4420c2
--- /dev/null
+++ b/nvidia-prolapse/media/tools/check-xmlgen-elf.py
@@ -0,0 +1,49 @@
+#!/usr/bin/env python3
+"""Reject a statically embedded RM or the wrong executable ABI before staging."""
+import os
+import re
+import subprocess
+import sys
+
+REQUIRED = {'nv_c2_caps_query', 'nv_c2_caps_view', 'nv_c2_media_codecs_xml',
+            'nv_c2_caps_destroy', 'nv_c2_no_decoder_xml', 'nv_c2_no_decoder_reason',
+            'nv_c2_text_view', 'nv_c2_text_destroy'}
+
+def check(path, android):
+    def read(*args):
+        return subprocess.check_output(['readelf', *args, str(path)], text=True,
+                                       env={**os.environ, 'LC_ALL': 'C'})
+    header, program, dynamic, symbols = read('-h'), read('-l'), read('-d'), read('--dyn-syms', '--wide')
+    if 'ELF64' not in header or 'Advanced Micro Devices X86-64' not in header:
+        raise ValueError('xmlgen must be ELF64 x86_64')
+    if android and 'Requesting program interpreter: /system/bin/linker64' not in program:
+        raise ValueError('xmlgen must use the Android linker64')
+    if not android and 'ld-linux-x86-64.so.2' not in program:
+        raise ValueError('host xmlgen must use the GNU loader')
+    needed = set(re.findall(r'\(NEEDED\).*\[([^]]+)\]', dynamic))
+    if 'libnv_bionic_native.so' not in needed:
+        raise ValueError('xmlgen must dynamically link the RM SONAME')
+    if android and ('libc.so.6' in needed or '(RUNPATH)' in dynamic or '(RPATH)' in dynamic):
+        raise ValueError('Android xmlgen has a GNU dependency or developer RUNPATH')
+    imports = set()
+    for line in symbols.splitlines():
+        cols = line.split()
+        if len(cols) >= 8:
+            symbol = cols[7].split('@')[0]
+            if cols[6] == 'UND':
+                imports.add(symbol)
+            elif symbol.startswith(('nv_c2_', 'nv_video_', 'nv_venc_')):
+                raise ValueError(f'xmlgen embeds an RM implementation: {symbol}')
+    missing = REQUIRED - imports
+    if missing:
+        raise ValueError(f'xmlgen lacks direct RM imports: {sorted(missing)}')
+    # Dynamic exports alone cannot detect hidden/static copies of the RM rlib.
+    full = read('--syms', '--wide')
+    if re.search(r'\b(?:_ZN\d+nv_bionic_native|_R\S*nv_bionic_native)', full):
+        raise ValueError('xmlgen contains linked RM Rust implementation symbols')
+
+if __name__ == '__main__':
+    try:
+        check(sys.argv[2], sys.argv[1] == 'android')
+    except (ValueError, subprocess.CalledProcessError) as error:
+        raise SystemExit(f'xmlgen ELF check: {error}')
