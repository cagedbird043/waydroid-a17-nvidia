diff --git a/nvidia-prolapse/driver-source/native/src/bin/nvc2-xmlgen.rs b/nvidia-prolapse/driver-source/native/src/bin/nvc2-xmlgen.rs
new file mode 100644
index 0000000..22e206a
--- /dev/null
+++ b/nvidia-prolapse/driver-source/native/src/bin/nvc2-xmlgen.rs
@@ -0,0 +1,302 @@
+//! Standalone CLI. Only the public shared-library ABI is linked, never the RM rlib.
+use std::{
+    ffi::{c_char, c_void, CStr, OsString},
+    io::{self, Write},
+    path::PathBuf,
+    ptr,
+};
+#[repr(C)]
+struct DeviceInfo {
+    abi_version: u32,
+    pci_vendor: u32,
+    pci_device: u32,
+    chipset: u32,
+    nvdec_class: u32,
+    nvdec_engines: u32,
+    name: [u8; 64],
+}
+#[repr(C)]
+#[derive(Default)]
+struct View {
+    abi_version: u32,
+    nvenc_class: u32,
+    decoders: *const c_void,
+    decoder_count: u32,
+    encoders: *const c_void,
+    encoder_count: u32,
+}
+#[repr(C)]
+#[derive(Default)]
+struct Bytes {
+    data: *const c_char,
+    len: usize,
+}
+#[link(name = "nv_bionic_native")]
+unsafe extern "C" {
+    fn nv_video_device_open(dev: *mut *mut c_void, info: *mut DeviceInfo) -> i32;
+    fn nv_video_device_close(dev: *mut c_void);
+    fn nv_video_last_error() -> *const c_char;
+    fn nv_c2_caps_query(dev: *mut c_void, out: *mut *mut c_void) -> i32;
+    fn nv_c2_caps_view(caps: *const c_void, out: *mut View) -> i32;
+    fn nv_c2_media_codecs_xml(caps: *const c_void, out: *mut Bytes) -> i32;
+    fn nv_c2_caps_destroy(caps: *mut c_void);
+    fn nv_c2_no_decoder_xml(gpu: *const c_char, out: *mut *mut c_void) -> i32;
+    fn nv_c2_no_decoder_reason(gpu: *const c_char, out: *mut *mut c_void) -> i32;
+    fn nv_c2_text_view(text: *const c_void, out: *mut Bytes) -> i32;
+    fn nv_c2_text_destroy(text: *mut c_void);
+}
+#[derive(Default)]
+struct Options {
+    output: Option<PathBuf>,
+    check: Option<PathBuf>,
+}
+fn parse(args: impl IntoIterator<Item = OsString>) -> Result<Options, ()> {
+    let mut args = args.into_iter();
+    let mut o = Options::default();
+    while let Some(arg) = args.next() {
+        if arg == "-o" {
+            o.output = Some(args.next().ok_or(())?.into());
+        } else if arg == "--check" {
+            o.check = Some(args.next().ok_or(())?.into());
+        } else {
+            return Err(());
+        }
+    }
+    Ok(o)
+}
+fn emit(
+    o: &Options,
+    xml: &[u8],
+    gpu: &str,
+    status: i32,
+    stdout: &mut impl Write,
+    stderr: &mut impl Write,
+) -> i32 {
+    if let Some(path) = &o.check {
+        match std::fs::read(path) {
+            Err(_) => {
+                let _ = writeln!(stderr, "nvc2-xmlgen: cannot read {}", path.display());
+                return 1;
+            }
+            Ok(got) if got != xml => {
+                let _=writeln!(stderr,"nvc2-xmlgen: {} does not match the live caps of {gpu}; regenerate it. Expected:",path.display());
+                let _ = stderr.write_all(xml);
+                return 1;
+            }
+            _ => {}
+        }
+    } else if let Some(path) = &o.output {
+        if std::fs::write(path, xml).is_err() {
+            let _ = writeln!(stderr, "nvc2-xmlgen: cannot write {}", path.display());
+            return 1;
+        }
+    } else if stdout.write_all(xml).and_then(|_| stdout.flush()).is_err() {
+        let _ = writeln!(stderr, "nvc2-xmlgen: cannot write stdout");
+        return 1;
+    }
+    status
+}
+#[derive(Default)]
+struct Handles {
+    dev: *mut c_void,
+    caps: *mut c_void,
+    text: *mut c_void,
+    reason: *mut c_void,
+}
+impl Drop for Handles {
+    fn drop(&mut self) {
+        unsafe {
+            nv_c2_text_destroy(self.reason);
+            nv_c2_text_destroy(self.text);
+            nv_c2_caps_destroy(self.caps);
+            nv_video_device_close(self.dev);
+        }
+    }
+}
+fn error() -> String {
+    unsafe { CStr::from_ptr(nv_video_last_error()) }
+        .to_string_lossy()
+        .into_owned()
+}
+fn generate(o: &Options) -> Result<i32, String> {
+    let mut h = Handles::default();
+    let mut info: DeviceInfo = unsafe { std::mem::zeroed() };
+    let rc = unsafe { nv_video_device_open(&mut h.dev, &mut info) };
+    if rc != 0 {
+        return Err(format!("nv_video_device_open failed ({rc}): {}", error()));
+    }
+    if info.abi_version != 2 {
+        return Err(format!("backend ABI {}, built for 2", info.abi_version));
+    }
+    let gpu = unsafe { CStr::from_ptr(info.name.as_ptr().cast()) }.to_string_lossy();
+    let mut xml = Bytes::default();
+    let status = if info.nvdec_class == 0 {
+        unsafe { nv_video_device_close(h.dev) };
+        h.dev = ptr::null_mut();
+        if unsafe { nv_c2_no_decoder_reason(info.name.as_ptr().cast(), &mut h.reason) } != 0 {
+            return Err(error());
+        }
+        let mut reason = Bytes::default();
+        if unsafe { nv_c2_text_view(h.reason, &mut reason) } != 0 {
+            return Err(error());
+        }
+        eprintln!(
+            "nvc2-xmlgen: {}",
+            unsafe { CStr::from_ptr(reason.data) }.to_string_lossy()
+        );
+        if unsafe { nv_c2_no_decoder_xml(info.name.as_ptr().cast(), &mut h.text) } != 0 {
+            return Err(error());
+        }
+        if unsafe { nv_c2_text_view(h.text, &mut xml) } != 0 {
+            return Err(error());
+        }
+        3
+    } else {
+        if unsafe { nv_c2_caps_query(h.dev, &mut h.caps) } != 0 {
+            return Err(error());
+        }
+        let mut view = View::default();
+        if unsafe { nv_c2_caps_view(h.caps, &mut view) } != 0 {
+            return Err(error());
+        }
+        if view.abi_version != 1 {
+            return Err(format!("caps ABI {}, built for 1", view.abi_version));
+        }
+        if unsafe { nv_c2_media_codecs_xml(h.caps, &mut xml) } != 0 {
+            return Err(error());
+        }
+        0
+    };
+    let bytes = unsafe { std::slice::from_raw_parts(xml.data.cast(), xml.len) };
+    Ok(emit(
+        o,
+        bytes,
+        &gpu,
+        status,
+        &mut io::stdout().lock(),
+        &mut io::stderr().lock(),
+    ))
+}
+fn main() {
+    let status = match parse(std::env::args_os().skip(1)) {
+        Err(()) => {
+            eprintln!("usage: nvc2-xmlgen [-o FILE] | --check FILE");
+            2
+        }
+        Ok(o) => match generate(&o) {
+            Ok(status) => status,
+            Err(e) => {
+                eprintln!("nvc2-xmlgen: {e}");
+                1
+            }
+        },
+    };
+    std::process::exit(status);
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn option_contract() {
+        for args in [vec!["-o"], vec!["--check"], vec!["--bad"], vec!["file"]] {
+            assert!(parse(args.into_iter().map(Into::into)).is_err());
+        }
+        let o = parse(
+            [
+                "-o", "one", "--check", "first", "-o", "two", "--check", "last",
+            ]
+            .map(Into::into),
+        )
+        .unwrap();
+        assert_eq!(o.output, Some("two".into()));
+        assert_eq!(o.check, Some("last".into()));
+    }
+    #[test]
+    fn byte_io_and_status_contract() {
+        let path = std::env::temp_dir().join(format!("nvc2-cli-test-{}", std::process::id()));
+        let mut out = Vec::new();
+        let mut err = Vec::new();
+        let xml = b"<xml/>\n";
+        for status in [0, 3] {
+            assert_eq!(
+                emit(&Options::default(), xml, "stub", status, &mut out, &mut err),
+                status
+            );
+            assert!(out.ends_with(xml));
+            assert_eq!(
+                emit(
+                    &Options {
+                        output: Some(path.clone()),
+                        check: None
+                    },
+                    xml,
+                    "stub",
+                    status,
+                    &mut out,
+                    &mut err
+                ),
+                status
+            );
+            let len = out.len();
+            assert_eq!(
+                emit(
+                    &Options {
+                        output: Some("/nonexistent/output".into()),
+                        check: Some(path.clone())
+                    },
+                    xml,
+                    "stub",
+                    status,
+                    &mut out,
+                    &mut err
+                ),
+                status
+            );
+            assert_eq!(len, out.len());
+        }
+        assert_eq!(std::fs::read(&path).unwrap(), xml);
+        assert_eq!(
+            emit(
+                &Options {
+                    output: None,
+                    check: Some(path.clone())
+                },
+                b"stale",
+                "stub",
+                0,
+                &mut out,
+                &mut err
+            ),
+            1
+        );
+        std::fs::remove_file(&path).unwrap();
+        assert_eq!(
+            emit(
+                &Options {
+                    output: None,
+                    check: Some(path)
+                },
+                xml,
+                "stub",
+                3,
+                &mut out,
+                &mut err
+            ),
+            1
+        );
+        assert_eq!(
+            emit(
+                &Options {
+                    output: Some("/nonexistent/output".into()),
+                    check: None
+                },
+                xml,
+                "stub",
+                0,
+                &mut out,
+                &mut err
+            ),
+            1
+        );
+    }
+}
diff --git a/nvidia-prolapse/driver-source/native/src/video/caps.rs b/nvidia-prolapse/driver-source/native/src/video/caps.rs
new file mode 100644
index 0000000..9d7d542
--- /dev/null
+++ b/nvidia-prolapse/driver-source/native/src/video/caps.rs
@@ -0,0 +1,313 @@
+//! Immutable Codec2 capability policy and contractual XML bytes.
+use super::{NvVideoCaps, CODEC_AV1, CODEC_H264, CODEC_HEVC, CODEC_VP9};
+use std::{
+    ffi::{c_char, CString},
+    fmt::Write,
+    ptr,
+};
+
+pub type Error = (i32, String);
+#[repr(C)]
+pub struct NvC2DecoderCaps {
+    pub codec: u32,
+    pub name: *const c_char,
+    pub mime: *const c_char,
+    pub caps: NvVideoCaps,
+}
+#[repr(C)]
+pub struct NvC2EncoderCaps {
+    pub codec: u32,
+    pub name: *const c_char,
+    pub mime: *const c_char,
+    pub min_width: u32,
+    pub min_height: u32,
+    pub max_width: u32,
+    pub max_height: u32,
+}
+#[repr(C)]
+#[derive(Default)]
+pub struct NvC2CapsView {
+    pub abi_version: u32,
+    pub nvenc_class: u32,
+    pub decoders: *const NvC2DecoderCaps,
+    pub decoder_count: u32,
+    pub encoders: *const NvC2EncoderCaps,
+    pub encoder_count: u32,
+}
+#[repr(C)]
+#[derive(Default)]
+pub struct NvC2Bytes {
+    pub data: *const c_char,
+    pub len: usize,
+}
+pub struct NvC2Caps {
+    decoders: Vec<NvC2DecoderCaps>,
+    encoders: Vec<NvC2EncoderCaps>,
+    _names: Vec<CString>,
+    xml: CString,
+    nvenc_class: u32,
+}
+pub struct NvC2Text(pub CString);
+const DECODERS: [(u32, &str, &str); 4] = [
+    (
+        CODEC_VP9,
+        "c2.nvprolapse.vp9.decoder",
+        "video/x-vnd.on2.vp9",
+    ),
+    (CODEC_AV1, "c2.nvprolapse.av1.decoder", "video/av01"),
+    (CODEC_HEVC, "c2.nvprolapse.hevc.decoder", "video/hevc"),
+    (CODEC_H264, "c2.nvprolapse.avc.decoder", "video/avc"),
+];
+const ENCODERS: [(u32, &str, &str, u32, u32, u32, u32); 3] = [
+    (
+        CODEC_H264,
+        "c2.nvprolapse.avc.encoder",
+        "video/avc",
+        50,
+        2,
+        4096,
+        4096,
+    ),
+    (
+        CODEC_HEVC,
+        "c2.nvprolapse.hevc.encoder",
+        "video/hevc",
+        66,
+        2,
+        8192,
+        8192,
+    ),
+    (
+        CODEC_AV1,
+        "c2.nvprolapse.av1.encoder",
+        "video/av01",
+        66,
+        66,
+        8192,
+        8192,
+    ),
+];
+fn name(names: &mut Vec<CString>, text: &str) -> *const c_char {
+    names.push(CString::new(text).expect("constant has no NUL"));
+    names.last().unwrap().as_ptr()
+}
+impl NvC2Caps {
+    pub fn query(
+        mut query: impl FnMut(u32) -> Result<NvVideoCaps, Error>,
+        nvenc: impl FnOnce() -> Result<u32, Error>,
+    ) -> Result<Self, Error> {
+        let mut names = Vec::with_capacity(14);
+        let mut decoders = Vec::with_capacity(4);
+        let mut x=String::from("<?xml version=\"1.0\" encoding=\"utf-8\" ?>\n<!-- Generated by nvc2-xmlgen from nv_video_query_caps() and the NVENC class on this GPU. Do not edit:\n     regenerate (the service refuses to start when this file and the live caps differ). -->\n<MediaCodecs>\n    <Decoders>\n");
+        for (codec, n, m) in DECODERS {
+            let c = query(codec)
+                .map_err(|(rc, msg)| (rc, format!("nv_video_query_caps({n}) = {rc}: {msg}")))?;
+            if c.supported == 0 {
+                continue;
+            }
+            if c.codec != codec
+                || c.max_width == 0
+                || c.max_height == 0
+                || c.min_width > c.max_width
+                || c.min_height > c.max_height
+                || c.bit_depth_mask & (1 << 8) == 0
+            {
+                return Err((-8,format!("nv_video_query_caps({n}) reports supported with an unusable size range or without 8-bit")));
+            }
+            writeln!(x,"        <MediaCodec name=\"{n}\" type=\"{m}\">\n            <Limit name=\"size\" min=\"{}x{}\" max=\"{}x{}\" />\n            <Limit name=\"alignment\" value=\"2x2\" />\n            <Limit name=\"block-size\" value=\"16x16\" />\n            <Feature name=\"adaptive-playback\" />\n        </MediaCodec>",c.min_width.wrapping_add(1)&!1,c.min_height.wrapping_add(1)&!1,c.max_width&!1,c.max_height&!1).unwrap();
+            decoders.push(NvC2DecoderCaps {
+                codec,
+                name: name(&mut names, n),
+                mime: name(&mut names, m),
+                caps: c,
+            });
+        }
+        if decoders.is_empty() {
+            return Err((-2, "GPU supports none of VP9/AV1/HEVC/H.264".into()));
+        }
+        let nvenc_class = nvenc()?;
+        let mut encoders = Vec::with_capacity(3);
+        x.push_str("    </Decoders>\n    <Encoders>\n");
+        if nvenc_class == 0xc9b7 {
+            for (codec, n, m, min_width, min_height, max_width, max_height) in ENCODERS {
+                writeln!(x,"        <MediaCodec name=\"{n}\" type=\"{m}\">\n            <Limit name=\"size\" min=\"{min_width}x{min_height}\" max=\"{max_width}x{max_height}\" />\n            <Limit name=\"alignment\" value=\"2x2\" />\n            <Limit name=\"block-size\" value=\"16x16\" />\n            <Limit name=\"bitrate\" range=\"1-200000000\" />\n            <Feature name=\"bitrate-modes\" value=\"VBR,CBR,CQ\" />\n        </MediaCodec>").unwrap();
+                encoders.push(NvC2EncoderCaps {
+                    codec,
+                    name: name(&mut names, n),
+                    mime: name(&mut names, m),
+                    min_width,
+                    min_height,
+                    max_width,
+                    max_height,
+                });
+            }
+        }
+        x.push_str("    </Encoders>\n</MediaCodecs>\n");
+        Ok(Self {
+            decoders,
+            encoders,
+            _names: names,
+            xml: CString::new(x).unwrap(),
+            nvenc_class,
+        })
+    }
+    pub fn view(&self) -> NvC2CapsView {
+        NvC2CapsView {
+            abi_version: 1,
+            nvenc_class: self.nvenc_class,
+            decoders: if self.decoders.is_empty() {
+                ptr::null()
+            } else {
+                self.decoders.as_ptr()
+            },
+            decoder_count: self.decoders.len() as u32,
+            encoders: if self.encoders.is_empty() {
+                ptr::null()
+            } else {
+                self.encoders.as_ptr()
+            },
+            encoder_count: self.encoders.len() as u32,
+        }
+    }
+    pub fn xml(&self) -> NvC2Bytes {
+        bytes(&self.xml)
+    }
+}
+pub fn bytes(s: &CString) -> NvC2Bytes {
+    NvC2Bytes {
+        data: s.as_ptr(),
+        len: s.as_bytes().len(),
+    }
+}
+pub fn no_decoder_reason(gpu: &str) -> String {
+    format!("hardware video decode: not available on {gpu} (no NVDEC class this decoder supports; supported from Turing): Android software decoders are used")
+}
+pub fn no_decoder_xml(gpu: &str) -> String {
+    let mut reason = no_decoder_reason(gpu);
+    while reason.contains("--") {
+        reason = reason.replace("--", "-");
+    }
+    format!("<?xml version=\"1.0\" encoding=\"utf-8\" ?>\n<!-- Generated by nvc2-xmlgen from nv_video_device_open() on this GPU: no hardware decoders.\n     {reason}.\n     Do not edit: regenerate (the service checks this file against the GPU at every start). -->\n<MediaCodecs>\n    <Decoders>\n    </Decoders>\n</MediaCodecs>\n")
+}
+const _: () = {
+    use std::mem::{align_of, offset_of, size_of};
+    assert!(size_of::<NvVideoCaps>() == 64);
+    if size_of::<usize>() == 8 {
+        assert!(
+            size_of::<NvC2DecoderCaps>() == 88
+                && align_of::<NvC2DecoderCaps>() == 8
+                && offset_of!(NvC2DecoderCaps, caps) == 24
+        );
+        assert!(size_of::<NvC2EncoderCaps>() == 40 && offset_of!(NvC2EncoderCaps, min_width) == 24);
+        assert!(size_of::<NvC2CapsView>() == 40 && offset_of!(NvC2CapsView, encoders) == 24);
+        assert!(size_of::<NvC2Bytes>() == 16);
+        assert!(
+            align_of::<NvC2EncoderCaps>() == 8
+                && align_of::<NvC2CapsView>() == 8
+                && align_of::<NvC2Bytes>() == 8
+        );
+        assert!(offset_of!(NvC2Bytes, len) == 8);
+    } else {
+        assert!(
+            size_of::<NvC2DecoderCaps>() == 76
+                && align_of::<NvC2DecoderCaps>() == 4
+                && offset_of!(NvC2DecoderCaps, caps) == 12
+        );
+        assert!(size_of::<NvC2EncoderCaps>() == 28 && offset_of!(NvC2EncoderCaps, min_width) == 12);
+        assert!(size_of::<NvC2CapsView>() == 24 && offset_of!(NvC2CapsView, encoders) == 16);
+        assert!(size_of::<NvC2Bytes>() == 8);
+        assert!(
+            align_of::<NvC2EncoderCaps>() == 4
+                && align_of::<NvC2CapsView>() == 4
+                && align_of::<NvC2Bytes>() == 4
+        );
+        assert!(offset_of!(NvC2Bytes, len) == 4);
+    }
+};
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn caps(codec: u32) -> Result<NvVideoCaps, Error> {
+        Ok(NvVideoCaps {
+            codec,
+            supported: if codec == CODEC_AV1 { 0 } else { 1 },
+            min_width: 33,
+            min_height: 17,
+            max_width: if codec == CODEC_H264 { 4096 } else { 8192 },
+            max_height: 8192,
+            bit_depth_mask: 1 << 8,
+            ..Default::default()
+        })
+    }
+    #[test]
+    fn xml_policy_and_immutable_views() {
+        let c = NvC2Caps::query(caps, || Ok(0xc9b7)).unwrap();
+        let v = c.view();
+        assert_eq!(
+            (v.decoder_count, v.encoder_count, v.nvenc_class),
+            (3, 3, 0xc9b7)
+        );
+        let x = c.xml.to_str().unwrap();
+        assert!(!x.contains("av1.decoder"));
+        assert!(x.contains("min=\"34x18\" max=\"8192x8192\""));
+        assert!(x.contains("max=\"4096x8192\""));
+        assert!(x.contains("min=\"50x2\" max=\"4096x4096\""));
+        assert!(x.contains("av1.encoder\" type=\"video/av01\""));
+        assert!(x.find("<Encoders>").unwrap() > x.find("</Decoders>").unwrap());
+        let other = NvC2Caps::query(caps, || Ok(0xc4b7)).unwrap();
+        assert_eq!(other.view().encoder_count, 0);
+        assert!(other.view().encoders.is_null());
+        assert!(!other.xml.to_str().unwrap().contains("encoder"));
+        assert_eq!(v.decoders, c.view().decoders);
+        assert_eq!(c.xml().data, c.xml().data);
+    }
+    #[test]
+    fn errors_are_atomic() {
+        assert_eq!(
+            NvC2Caps::query(
+                |_| Ok(NvVideoCaps::default()),
+                || panic!("must not open encoder")
+            )
+            .err()
+            .unwrap()
+            .0,
+            -2
+        );
+        assert!(NvC2Caps::query(
+            |codec| {
+                let mut c = caps(codec)?;
+                c.supported = 1;
+                c.bit_depth_mask = 0;
+                Ok(c)
+            },
+            || Ok(0xc9b7)
+        )
+        .err()
+        .unwrap()
+        .1
+        .contains("unusable"));
+        assert_eq!(
+            NvC2Caps::query(caps, || Err((-5, "nv_venc_open failed".into())))
+                .err()
+                .unwrap()
+                .0,
+            -5
+        );
+        assert_eq!(
+            NvC2Caps::query(|_| Err((-4, "allocation".into())), || Ok(0))
+                .err()
+                .unwrap()
+                .0,
+            -4
+        );
+    }
+    #[test]
+    fn no_decoder_contract() {
+        let reason = no_decoder_reason("stub");
+        assert_eq!(reason,"hardware video decode: not available on stub (no NVDEC class this decoder supports; supported from Turing): Android software decoders are used");
+        let xml = no_decoder_xml("a---b");
+        assert!(xml.contains("on a-b ("));
+        assert!(!xml.contains("<MediaCodec "));
+        assert!(xml.ends_with("</MediaCodecs>\n"));
+    }
+}
