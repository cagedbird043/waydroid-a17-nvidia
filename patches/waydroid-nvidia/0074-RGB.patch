+    let mut bank = ParameterSets::new(ENC_H264);
+    assert_eq!(bank.unescaped_parameter_len(&stream).unwrap(), raw_sps.len());
+    bank.update(&escaped_parameter(&stream[..raw_sps.len()])).unwrap();
