+                let pps = if let Some(raw) = raw_pps {
+                    h264::ps::parse_pps_for_encode(raw, |id| (id == sps.id).then(|| sps.clone()))?
+                } else { let mut p = dp.clone(); p.sps_id = sps.id; p };
