---
 nvidia-prolapse/driver-source/native/src/rm.rs     |  7 +++++++
 .../driver-source/native/src/video/session.rs      | 14 ++++++++++++++
 2 files changed, 21 insertions(+)

diff --git a/nvidia-prolapse/driver-source/native/src/rm.rs b/nvidia-prolapse/driver-source/native/src/rm.rs
index ca49feb..15d2fbf 100644
--- a/nvidia-prolapse/driver-source/native/src/rm.rs
+++ b/nvidia-prolapse/driver-source/native/src/rm.rs
@@ -1252,6 +1252,13 @@ impl Mapping {
         }
         Ok(())
     }
+    /// The whole mapping as bytes. Only for CPU-cached system memory whose writers (the GPU)
+    /// have completed; device memory must be read with [`Mapping::read_bytes`] instead.
+    pub(crate) fn system_bytes(&self) -> Result<&[u8]> {
+        self.live()?;
+        // SAFETY: the mapping is live and owns `size` bytes; callers synchronise with the writer.
+        Ok(unsafe { std::slice::from_raw_parts(self.pointer.as_ptr() as *const u8, self.size) })
+    }
     /// Bulk copy out of the mapping (bounds-checked, byte granular).
     pub(crate) fn read_bytes(&self, offset: usize, out: &mut [u8]) -> Result<()> {
         self.live()?;
diff --git a/nvidia-prolapse/driver-source/native/src/video/session.rs b/nvidia-prolapse/driver-source/native/src/video/session.rs
index 0184273..3ebfe1a 100644
--- a/nvidia-prolapse/driver-source/native/src/video/session.rs
+++ b/nvidia-prolapse/driver-source/native/src/video/session.rs
@@ -1087,6 +1087,15 @@ impl Session {
         Ok(OutputAllocation { fd, memory })
     }
 
+    /// PRIME-shareable CPU-cached system memory for copy-engine output that the CPU reads back
+    /// (device memory would be read through the uncached BAR). Map it with
+    /// [`OutputAllocation::map`] once and read [`OutputMapping::bytes`] after `copy_out_wait`.
+    pub fn allocate_readback(&self, size: usize) -> VResult<OutputAllocation> {
+        let memory = self.device.allocate_aligned(size, 4096, false, true)?;
+        let fd = crate::external::export(&memory, self.drm.as_fd())?;
+        Ok(OutputAllocation { fd, memory })
+    }
+
     /// Complete a copy-out before the CPU maps its destination.
     pub fn copy_out_wait(&mut self, id: u64, target: &Target) -> VResult<()> {
         if let Some(fence) = self.copy_out(id, target)? {
@@ -1163,6 +1172,11 @@ pub struct OutputMapping {
     mapping: Mapping,
 }
 impl OutputMapping {
+    /// The mapped bytes of an allocation from [`Session::allocate_readback`], valid once the
+    /// copy engine's work on it has completed.
+    pub fn bytes(&self) -> VResult<&[u8]> {
+        Ok(self.mapping.system_bytes()?)
+    }
     pub fn read_bytes(&self, offset: usize, out: &mut [u8]) -> VResult<()> {
         Ok(self.mapping.read_bytes(offset, out)?)
     }
