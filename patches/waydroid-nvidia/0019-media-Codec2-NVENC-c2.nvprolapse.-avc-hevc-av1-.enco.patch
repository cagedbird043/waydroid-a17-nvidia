+/*!
+ * Minimum bits required to represent a value between 1 and @p x inclusive.
+ *
+ * @param[in] x Highest unsigned value to represent: 1 <= x <= NV_U64_MAX
+ *
+ * Example
+ * @code
+ * enum Foo {
+ *     E_A,
+ *     E_B,
+ *     E_C,
+ *     E_D,
+ *     E_LAST = E_D
+ * };
