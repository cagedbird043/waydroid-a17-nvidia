+/* SPDX-License-Identifier: Apache-2.0
+ * Codec2 encoder components (c2.nvprolapse.{avc,hevc,av1}.encoder) over the NVENC encode session
+ * (core/nvc2_encoder). Parameter set as AOSP's software encoders (C2SoftAvcEnc IntfImpl): picture size,
+ * frame rate, bitrate mode (VBR / CBR / constant QP), bitrate, sync frame interval and requests, profile/level,
+ * color aspects, prepend-header mode. One picture in, one access unit out, synchronously.
+ */
+#ifndef NVC2_C2_ENCODER_H
+#define NVC2_C2_ENCODER_H
+
+#include <C2Component.h>
+#include <C2Config.h>
