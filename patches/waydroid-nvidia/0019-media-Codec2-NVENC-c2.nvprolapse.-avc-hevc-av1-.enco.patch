diff --git a/nvidia-prolapse/media/test/real_encode_test.cpp b/nvidia-prolapse/media/test/real_encode_test.cpp
new file mode 100644
index 0000000..ac9878b
--- /dev/null
+++ b/nvidia-prolapse/media/test/real_encode_test.cpp
@@ -0,0 +1,247 @@
+/* SPDX-License-Identifier: MIT
+ * The NVENC encode session (core/nvc2_encoder) on the real GPU: every input layout the Codec2 encoder loads,
+ * every codec / H.264 profile, a forced key frame, a rate change and the codec-specific data. Writes the streams
+ * and their references into OUT_DIR; test/run-real-encode.sh decodes them with FFmpeg and compares.
+ *
+ *   real_encode_test OUT_DIR
+ *
+ * Checked here: sessions open, every picture encodes, key frames where asked, codec-specific data shape, the
+ * second half of a 4 -> 1 Mbit/s stream at most 60 % of the first half's size.
+ */
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+#include "nv_video.h"
+#include "nvc2_encoder.h"
+
+using nvc2::EncodedFrame;
+using nvc2::Encoder;
+using nvc2::EncoderConfig;
+using nvc2::InputImage;
+
+static int g_fail = 0;
+#define CHECK(c)                                                                 \
+    do {                                                                         \
+        if (!(c)) {                                                              \
+            fprintf(stderr, "%s:%d: CHECK failed: %s\n", __FILE__, __LINE__, #c); \
+            g_fail++;                                                            \
+        }                                                                        \
+    } while (0)
+
+/* not a multiple of 16 in either direction: cropping and partial macroblocks / CTBs */
+constexpr uint32_t W = 350, H = 198, FRAMES = 12;
+
+static uint8_t clamp(int v) { return (uint8_t)(v < 0 ? 0 : v > 255 ? 255 : v); }
+
+/* moving gradients with edges: picture n of the YUV source, planar */
+static void yuv_picture(unsigned n, std::vector<uint8_t> *y, std::vector<uint8_t> *u, std::vector<uint8_t> *v)
+{
+    y->resize(W * H);
+    u->resize(W / 2 * (H / 2));
+    v->resize(W / 2 * (H / 2));
+    for (uint32_t r = 0; r < H; r++)
+        for (uint32_t c = 0; c < W; c++)
+            (*y)[r * W + c] = clamp(16 + (int)((c + 3 * n) % 200) + (((c / 24 + r / 24 + n) & 1) ? 20 : 0));
+    for (uint32_t r = 0; r < H / 2; r++)
+        for (uint32_t c = 0; c < W / 2; c++) {
+            (*u)[r * (W / 2) + c] = clamp(64 + (int)((r * 2 + n) % 128));
+            (*v)[r * (W / 2) + c] = clamp(192 - (int)((c + 2 * n) % 128));
+        }
+}
+
+/* RGB source: R G B per pixel */
+static void rgb_picture(unsigned n, std::vector<uint8_t> *rgb)
+{
+    rgb->resize(W * H * 3);
+    for (uint32_t r = 0; r < H; r++)
+        for (uint32_t c = 0; c < W; c++) {
+            uint8_t *p = &(*rgb)[(r * W + c) * 3];
+            p[0] = clamp((int)((c + 4 * n) % 256));
+            p[1] = clamp((int)((r * 2 + n) % 256));
+            p[2] = ((c / 32 + r / 32 + n) & 1) ? 230 : 40;
+        }
+}
+
+static bool write_file(const std::string &path, const std::vector<uint8_t> &d)
+{
+    FILE *f = fopen(path.c_str(), "wb");
+    if (!f)
+        return false;
+    const bool ok = fwrite(d.data(), 1, d.size(), f) == d.size();
+    return fclose(f) == 0 && ok;
+}
+
+struct Case {
+    const char *name;
+    uint32_t codec, profile;
+    InputImage::Layout layout;
+};
+
+/* one stream of FRAMES pictures in this layout; key frame forced at picture 7 */
+static void run_case(const std::string &dir, const Case &k)
+{
+    EncoderConfig cfg;
+    cfg.codec = k.codec;
+    cfg.width = W;
+    cfg.height = H;
+    cfg.rc = EncoderConfig::CONST_QP;
+    cfg.h264_profile = k.profile;
+    cfg.h264_level = k.codec == NV_VIDEO_CODEC_H264 ? 30 : 0;
+    std::string err;
+    std::unique_ptr<Encoder> e = Encoder::create(cfg, &err);
+    CHECK(e != nullptr);
+    if (!e) {
+        fprintf(stderr, "%s: %s\n", k.name, err.c_str());
+        return;
+    }
+    const std::vector<uint8_t> csd = e->codec_config();
+    std::vector<uint8_t> stream, ref;
+    if (k.codec == NV_VIDEO_CODEC_AV1) {
+        CHECK(csd.size() > 4 && csd[0] == 0x81 && (csd[4] >> 3 & 0xf) == 1); /* av1C + OBU_SEQUENCE_HEADER */
+    } else {
+        CHECK(csd.size() > 8 && csd[0] == 0 && csd[1] == 0 && csd[2] == 0 && csd[3] == 1);
+        CHECK(k.codec == NV_VIDEO_CODEC_HEVC ? (csd[4] >> 1) == 32 /* VPS */ : (csd[4] & 0x1f) == 7 /* SPS */);
+        if (k.codec == NV_VIDEO_CODEC_H264)
+            CHECK(csd[5] == k.profile && csd[7] == 30 && (k.profile != 66 || csd[6] == 0xc0));
+        stream = csd;
+    }
+    std::vector<uint8_t> y, u, v, rgb, a, b;
+    for (unsigned n = 0; n < FRAMES; n++) {
+        InputImage in;
+        in.layout = k.layout;
+        switch (k.layout) {
+        case InputImage::NV12:
+        case InputImage::NV21:
+            yuv_picture(n, &y, &u, &v);
+            a.resize(W * (H / 2));
+            for (uint32_t i = 0; i < W / 2 * (H / 2); i++) {
+                const bool nv21 = k.layout == InputImage::NV21;
+                a[2 * i] = nv21 ? v[i] : u[i];
+                a[2 * i + 1] = nv21 ? u[i] : v[i];
+            }
+            in.plane[0] = y.data();
+            in.stride[0] = W;
+            in.plane[1] = a.data();
+            in.stride[1] = W;
+            break;
+        case InputImage::I420:
+            yuv_picture(n, &y, &u, &v);
+            in.plane[0] = y.data();
+            in.stride[0] = W;
+            in.plane[1] = u.data();
+            in.stride[1] = W / 2;
+            in.plane[2] = v.data();
+            in.stride[2] = W / 2;
+            break;
+        case InputImage::RGBX:
+        case InputImage::BGRX:
+            rgb_picture(n, &rgb);
+            /* 4 bytes per pixel with a padded row */
+            a.assign((W * 4 + 64) * H, 0x55);
+            for (uint32_t r = 0; r < H; r++)
+                for (uint32_t c = 0; c < W; c++) {
+                    const uint8_t *p = &rgb[(r * W + c) * 3];
+                    uint8_t *d = &a[r * (W * 4 + 64) + c * 4];
+                    const bool bgr = k.layout == InputImage::BGRX;
+                    d[0] = bgr ? p[2] : p[0];
+                    d[1] = p[1];
+                    d[2] = bgr ? p[0] : p[2];
+                }
+            in.plane[0] = a.data();
+            in.stride[0] = W * 4 + 64;
+            break;
+        }
+        if (k.layout == InputImage::RGBX || k.layout == InputImage::BGRX) {
+            ref.insert(ref.end(), rgb.begin(), rgb.end());
+        } else {
+            ref.insert(ref.end(), y.begin(), y.end());
+            ref.insert(ref.end(), u.begin(), u.end());
+            ref.insert(ref.end(), v.begin(), v.end());
+        }
+        EncodedFrame fr;
+        const bool ok = e->encode(in, n == 7, &fr);
+        CHECK(ok);
+        if (!ok) {
+            fprintf(stderr, "%s frame %u: %s\n", k.name, n, e->error().c_str());
+            return;
+        }
+        CHECK(fr.key == (n == 0 || n == 7));
+        stream.insert(stream.end(), fr.data, fr.data + fr.size);
+    }
+    const char *ext = k.codec == NV_VIDEO_CODEC_AV1 ? "obu" : k.codec == NV_VIDEO_CODEC_HEVC ? "h265" : "h264";
+    const char *refext = k.layout == InputImage::RGBX || k.layout == InputImage::BGRX ? "rgb24" : "yuv420p";
+    CHECK(write_file(dir + "/" + k.name + "." + ext, stream));
+    CHECK(write_file(dir + "/" + k.name + "." + refext, ref));
+}
+
+/* 4 Mbit/s for 60 pictures, then 1 Mbit/s for 60 (CBR, H.264) */
+static void rate_change()
+{
+    EncoderConfig cfg;
+    cfg.codec = NV_VIDEO_CODEC_H264;
+    cfg.width = W;
+    cfg.height = H;
+    cfg.rc = EncoderConfig::CBR;
+    cfg.bitrate = 4000000;
+    cfg.fps = 30;
+    std::string err;
+    std::unique_ptr<Encoder> e = Encoder::create(cfg, &err);
+    CHECK(e != nullptr);
+    if (!e)
+        return;
+    std::vector<uint8_t> y, u, v, uv(W * (H / 2));
+    size_t half[2] = {0, 0};
+    for (unsigned n = 0; n < 120; n++) {
+        if (n == 60)
+            e->set_rate(1000000, 30);
+        yuv_picture(n * 7, &y, &u, &v);
+        for (uint32_t i = 0; i < W / 2 * (H / 2); i++) {
+            uv[2 * i] = u[i];
+            uv[2 * i + 1] = v[i] ^ (uint8_t)(n * 13); /* changing chroma noise keeps the rate up */
+        }
+        InputImage in;
+        in.plane[0] = y.data();
+        in.stride[0] = W;
+        in.plane[1] = uv.data();
+        in.stride[1] = W;
+        EncodedFrame fr;
+        CHECK(e->encode(in, false, &fr));
+        if (n >= 20 && n < 60)
+            half[0] += fr.size;
+        if (n >= 80)
+            half[1] += fr.size;
+    }
+    printf("rate change: %zu -> %zu bytes over 40 pictures\n", half[0], half[1]);
+    CHECK(half[1] * 10 <= half[0] * 6);
+}
+
+int main(int argc, char **argv)
+{
+    if (argc != 2) {
+        fprintf(stderr, "usage: real_encode_test OUT_DIR\n");
+        return 2;
+    }
+    const std::string dir = argv[1];
+    const Case cases[] = {
+        {"avc-cbp-nv12", NV_VIDEO_CODEC_H264, 66, InputImage::NV12},
+        {"avc-main-nv21", NV_VIDEO_CODEC_H264, 77, InputImage::NV21},
+        {"avc-high-i420", NV_VIDEO_CODEC_H264, 100, InputImage::I420},
+        {"avc-high-rgbx", NV_VIDEO_CODEC_H264, 100, InputImage::RGBX},
+        {"avc-high-bgrx", NV_VIDEO_CODEC_H264, 100, InputImage::BGRX},
+        {"hevc-nv12", NV_VIDEO_CODEC_HEVC, 0, InputImage::NV12},
+        {"hevc-i420", NV_VIDEO_CODEC_HEVC, 0, InputImage::I420},
+        {"av1-nv12", NV_VIDEO_CODEC_AV1, 0, InputImage::NV12},
+        {"av1-rgbx", NV_VIDEO_CODEC_AV1, 0, InputImage::RGBX},
+    };
+    for (const Case &k : cases)
+        run_case(dir, k);
+    rate_change();
+    if (g_fail) {
+        fprintf(stderr, "real_encode_test: %d check(s) FAILED\n", g_fail);
+        return 1;
+    }
+    printf("real_encode_test: all checks passed (%s)\n", dir.c_str());
+    return 0;
+}
diff --git a/nvidia-prolapse/media/test/run-real-encode.sh b/nvidia-prolapse/media/test/run-real-encode.sh
new file mode 100755
index 0000000..d468fc4
--- /dev/null
+++ b/nvidia-prolapse/media/test/run-real-encode.sh
@@ -0,0 +1,37 @@
+#!/usr/bin/env bash
+# SPDX-License-Identifier: MIT
+# make realenc: the NVENC encode session on the real GPU (test/real_encode_test.cpp), then every stream it wrote
+# decoded with FFmpeg and compared with its source picture by picture: YUV layouts with the planar source, RGB
+# layouts with FFmpeg's BT.709 video-range conversion of the RGB source (converted on its own: inside the
+# comparing filter graph the RGB input reached the conversion as BT.601).
+set -euo pipefail
+cd "$(dirname "$0")/.."
+out=out/host/realenc
+rm -rf "$out"
+mkdir -p "$out"
+./out/host/real_encode_test "$out"
+W=350
+H=198
+fail=0
+for s in "$out"/*.h264 "$out"/*.h265 "$out"/*.obu; do
+    name=$(basename "${s%.*}")
+    dec="$out/$name.dec.yuv"
+    if [[ $s == *.obu ]]; then fmt=(-f obu); else fmt=(); fi
+    ffmpeg -v error -y "${fmt[@]}" -i "$s" -f rawvideo -pix_fmt yuv420p "$dec"
+    if [ -f "$out/$name.rgb24" ]; then
+        ffmpeg -v error -y -f rawvideo -pix_fmt rgb24 -s ${W}x$H -i "$out/$name.rgb24" \
+            -vf scale=out_color_matrix=bt709:out_range=tv,format=yuv420p -f rawvideo "$out/$name.yuv420p"
+    fi
+    frames=$(( $(stat -c %s "$dec") / (W * H * 3 / 2) ))
+    psnr=$(ffmpeg -hide_banner -f rawvideo -pix_fmt yuv420p -s ${W}x$H -i "$dec" \
+        -f rawvideo -pix_fmt yuv420p -s ${W}x$H -i "$out/$name.yuv420p" \
+        -lavfi psnr -f null - 2>&1 | sed -n 's/.*PSNR.* min:\([0-9.inf]*\).*/\1/p')
+    min=38
+    if [ "$frames" != 12 ] || ! awk -v p="$psnr" -v m="$min" 'BEGIN { exit !(p == "inf" || p + 0 >= m) }'; then
+        echo "FAIL $name: $frames pictures, min PSNR ${psnr:-none} (need 12, >= $min dB)"
+        fail=1
+    else
+        echo "ok   $name: $frames pictures, min PSNR $psnr dB"
+    fi
+done
+exit $fail
