+realenc: out/host/real_encode_test
+	bash test/run-real-encode.sh
+out/host/enc/%.o: core/nvenc/%.c Makefile
+	@mkdir -p $(@D)
+	$(HOST_CC) $(ENC_CFLAGS) -c $< -o $@
