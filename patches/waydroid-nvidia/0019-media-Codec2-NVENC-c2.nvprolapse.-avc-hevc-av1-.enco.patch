+	$(HOST_CXX) $(CXXFLAGS_COMMON) $(ENC_INC) -o $@ core/nvc2_encoder.cpp test/real_encode_test.cpp $(ENC_HOST_OBJ) \
+	    $(NV_VIDEO_LIB) -lm
