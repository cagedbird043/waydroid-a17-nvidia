+// New engine addressing can be created like:                             //
+// \#define ENG_REG_PMC(o,d,r)                     NV##d##r               //
+// \#define ENG_IDX_REG_CE(o,d,i,r)                CE_MAP(o,r,i)          //
+//                                                                        //
+// See FB_FBPA* for more examples                                         //
