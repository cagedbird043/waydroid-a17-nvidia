@@ -0,0 +1,77 @@
+/* SPDX-License-Identifier: MIT
+ * NVENC encode session for the Codec2 encoder components: the encoder core (core/nvenc, mickys/nvenc) on
+ * libnv_bionic_native's NVENC services, fed from CPU-mapped input pictures. No Android dependencies, so the
+ * host tests run it against the real GPU (test/real_encode_test.cpp).
+ */
+#ifndef NVC2_ENCODER_H
+#define NVC2_ENCODER_H
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace nvc2 {
+
+struct EncoderConfig {
+    uint32_t codec = 0;              /* NV_VIDEO_CODEC_H264 / _HEVC / _AV1 */
+    uint32_t width = 0, height = 0;  /* even */
+    enum Rc { CONST_QP = 0, VBR = 1, CBR = 2 } rc = VBR;
+    uint32_t bitrate = 0;            /* bits/s (VBR, CBR) */
+    uint32_t fps = 30;
+    uint32_t idr_period = 0;         /* pictures from one IDR to the next; 0: the first picture only */
+    uint32_t h264_profile = 66;      /* profile_idc: 66 Constrained Baseline, 77 Main, 100 High */
+    uint32_t h264_level = 0;         /* level_idc; 0: the core's default */
+    bool full_range = false;
+    uint8_t primaries = 1, transfer = 1, matrix = 1; /* ITU-T H.273 code points of the VUI / color_config */
+};
+
+/* One CPU-mapped input picture, width x height of the session. */
+struct InputImage {
+    enum Layout {
+        NV12,   /* plane 0 Y, plane 1 interleaved Cb Cr */
+        NV21,   /* plane 0 Y, plane 1 interleaved Cr Cb */
+        I420,   /* planes Y, Cb, Cr */
+        BGRX,   /* plane 0: B G R X bytes per pixel */
+        RGBX,   /* plane 0: R G B X bytes per pixel */
+    } layout = NV12;
+    const uint8_t *plane[3] = {};
+    size_t stride[3] = {};           /* bytes per row */
+};
+
+struct EncodedFrame {
+    const uint8_t *data = nullptr;   /* valid until the next encode() */
+    size_t size = 0;
+    bool key = false;
+    unsigned avg_qp = 0;
+};
+
+class Encoder {
+public:
+    /* nullptr and *error on failure */
+    static std::unique_ptr<Encoder> create(const EncoderConfig &cfg, std::string *error);
+    ~Encoder();
+
+    /* Codec-specific data: H.264 SPS + PPS, HEVC VPS + SPS + PPS (Annex B); AV1 av1C (ISO/IEC 14496-12 AV1
+     * codec configuration record with the sequence header OBU). */
+    std::vector<uint8_t> codec_config();
+    /* Rate control of the next pictures (VBR / CBR) and the frame rate it assumes. */
+    void set_rate(uint32_t bitrate, uint32_t fps);
+    void set_idr_period(uint32_t pictures);
+    /* Encodes one picture; force_key: an IDR / key frame. false: error() says why (the session stays usable). */
+    bool encode(const InputImage &in, bool force_key, EncodedFrame *out);
+    const std::string &error() const { return mError; }
+
+private:
+    Encoder();
+    struct Impl;
+    std::unique_ptr<Impl> mImpl;
+    std::string mError;
+};
+
+/* The level the session signals for this size: HEVC general_level_idc (30 x level), AV1 seq_level_idx;
+ * H.264: 0 (EncoderConfig.h264_level chooses it). */
+uint32_t coded_level(uint32_t codec, uint32_t width, uint32_t height);
+
+} // namespace nvc2
+#endif
