+(
+    NVPOWERSTATE_FAILURE *pFailure
+)
+{
+#if !defined(NVRISCV_LIBFSP_BUILD) || !NVRISCV_LIBFSP_BUILD
+    (void)NVMISC_MEMSET(
+        pFailure,
