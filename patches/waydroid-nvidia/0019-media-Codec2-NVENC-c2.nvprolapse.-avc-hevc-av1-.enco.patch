+class EncIntfImpl : public SimpleInterface<void>::BaseParams {
+public:
+    EncIntfImpl(const std::shared_ptr<C2ReflectorHelper> &helper, const EncoderEntry &e)
+        : SimpleInterface<void>::BaseParams(helper, e.name, C2Component::KIND_ENCODER, C2Component::DOMAIN_VIDEO,
+                                            e.mime),
+          mCodec(e.codec)
+    {
+        noPrivateBuffers();
+        noInputReferences();
+        noOutputReferences();
+        noInputLatency();
+        noOutputLatency();
+        noTimeStretch();
+        setDerivedInstance(this);
+
+        addParameter(DefineParam(mUsage, C2_PARAMKEY_INPUT_STREAM_USAGE)
+                         .withConstValue(new C2StreamUsageTuning::input(0u, (uint64_t)C2MemoryUsage::CPU_READ))
+                         .build());
+
+        addParameter(DefineParam(mAttrib, C2_PARAMKEY_COMPONENT_ATTRIBUTES)
+                         .withConstValue(new C2ComponentAttributesSetting(C2Component::ATTRIB_IS_TEMPORAL))
+                         .build());
+
+        addParameter(DefineParam(mSize, C2_PARAMKEY_PICTURE_SIZE)
+                         .withDefault(new C2StreamPictureSizeInfo::input(0u, 320, 240))
+                         .withFields({C2F(mSize, width).inRange(e.min_width, e.max_width, 2),
+                                      C2F(mSize, height).inRange(e.min_height, e.max_height, 2)})
+                         .withSetter(SizeSetter)
+                         .build());
+
+        addParameter(DefineParam(mFrameRate, C2_PARAMKEY_FRAME_RATE)
+                         .withDefault(new C2StreamFrameRateInfo::output(0u, 30.))
+                         .withFields({C2F(mFrameRate, value).greaterThan(0.)})
+                         .withSetter(Setter<decltype(*mFrameRate)>::StrictValueWithNoDeps)
+                         .build());
+
+        addParameter(DefineParam(mBitrateMode, C2_PARAMKEY_BITRATE_MODE)
+                         .withDefault(new C2StreamBitrateModeTuning::output(0u, C2Config::BITRATE_VARIABLE))
+                         .withFields({C2F(mBitrateMode, value)
+                                          .oneOf({C2Config::BITRATE_CONST, C2Config::BITRATE_VARIABLE,
+                                                  C2Config::BITRATE_IGNORE})})
+                         .withSetter(Setter<decltype(*mBitrateMode)>::StrictValueWithNoDeps)
+                         .build());
+
+        addParameter(DefineParam(mBitrate, C2_PARAMKEY_BITRATE)
+                         .withDefault(new C2StreamBitrateInfo::output(0u, 2000000))
+                         .withFields({C2F(mBitrate, value).inRange(1, kMaxBitrate)})
+                         .withSetter(BitrateSetter)
+                         .build());
+
+        std::vector<uint32_t> profiles, levels;
+        uint32_t defProfile;
+        switch (e.codec) {
+        case NV_VIDEO_CODEC_H264:
+            profiles = {C2Config::PROFILE_AVC_CONSTRAINED_BASELINE, C2Config::PROFILE_AVC_BASELINE,
+                        C2Config::PROFILE_AVC_MAIN, C2Config::PROFILE_AVC_CONSTRAINED_HIGH,
+                        C2Config::PROFILE_AVC_PROGRESSIVE_HIGH, C2Config::PROFILE_AVC_HIGH};
+            for (const AvcLevel &l : kAvcLevels)
+                levels.push_back(l.level);
+            defProfile = C2Config::PROFILE_AVC_CONSTRAINED_BASELINE;
+            break;
+        case NV_VIDEO_CODEC_HEVC:
+            profiles = {C2Config::PROFILE_HEVC_MAIN};
+            levels = {C2Config::LEVEL_HEVC_MAIN_3_1, C2Config::LEVEL_HEVC_MAIN_4_1, C2Config::LEVEL_HEVC_MAIN_5_1,
+                      C2Config::LEVEL_HEVC_MAIN_6_1};
+            defProfile = C2Config::PROFILE_HEVC_MAIN;
+            break;
+        default:
+            profiles = {C2Config::PROFILE_AV1_0};
+            levels = {C2Config::LEVEL_AV1_3, C2Config::LEVEL_AV1_3_1, C2Config::LEVEL_AV1_4_1,
+                      C2Config::LEVEL_AV1_5_1, C2Config::LEVEL_AV1_6_1};
+            defProfile = C2Config::PROFILE_AV1_0;
+            break;
+        }
+        addParameter(DefineParam(mProfileLevel, C2_PARAMKEY_PROFILE_LEVEL)
+                         .withDefault(new C2StreamProfileLevelInfo::output(0u, (C2Config::profile_t)defProfile,
+                                                                           (C2Config::level_t)levels.front()))
+                         .withFields({C2F(mProfileLevel, profile).oneOf(profiles),
+                                      C2F(mProfileLevel, level).oneOf(levels)})
+                         .withSetter(ProfileLevelSetter, mSize, mFrameRate, mBitrate)
+                         .build());
+
+        addParameter(DefineParam(mRequestSync, C2_PARAMKEY_REQUEST_SYNC_FRAME)
+                         .withDefault(new C2StreamRequestSyncFrameTuning::output(0u, C2_FALSE))
+                         .withFields({C2F(mRequestSync, value).oneOf({C2_FALSE, C2_TRUE})})
+                         .withSetter(Setter<decltype(*mRequestSync)>::NonStrictValueWithNoDeps)
+                         .build());
+
+        addParameter(DefineParam(mSyncFramePeriod, C2_PARAMKEY_SYNC_FRAME_INTERVAL)
+                         .withDefault(new C2StreamSyncFrameIntervalTuning::output(0u, 1000000))
+                         .withFields({C2F(mSyncFramePeriod, value).any()})
+                         .withSetter(Setter<decltype(*mSyncFramePeriod)>::StrictValueWithNoDeps)
+                         .build());
+
+        addParameter(DefineParam(mPrependHeader, C2_PARAMKEY_PREPEND_HEADER_MODE)
+                         .withDefault(new C2PrependHeaderModeSetting(C2Config::PREPEND_HEADER_TO_NONE))
+                         .withFields({C2F(mPrependHeader, value)
+                                          .oneOf({C2Config::PREPEND_HEADER_TO_NONE,
+                                                  C2Config::PREPEND_HEADER_TO_ALL_SYNC})})
+                         .withSetter(Setter<decltype(*mPrependHeader)>::StrictValueWithNoDeps)
+                         .build());
+
+        addParameter(DefineParam(mColorAspects, C2_PARAMKEY_COLOR_ASPECTS)
+                         .withDefault(new C2StreamColorAspectsInfo::input(
+                             0u, C2Color::RANGE_UNSPECIFIED, C2Color::PRIMARIES_UNSPECIFIED,
+                             C2Color::TRANSFER_UNSPECIFIED, C2Color::MATRIX_UNSPECIFIED))
+                         .withFields({C2F(mColorAspects, range).inRange(C2Color::RANGE_UNSPECIFIED, C2Color::RANGE_OTHER),
+                                      C2F(mColorAspects, primaries)
+                                          .inRange(C2Color::PRIMARIES_UNSPECIFIED, C2Color::PRIMARIES_OTHER),
+                                      C2F(mColorAspects, transfer)
+                                          .inRange(C2Color::TRANSFER_UNSPECIFIED, C2Color::TRANSFER_OTHER),
+                                      C2F(mColorAspects, matrix)
+                                          .inRange(C2Color::MATRIX_UNSPECIFIED, C2Color::MATRIX_OTHER)})
+                         .withSetter(ColorAspectsSetter)
+                         .build());
+
+        addParameter(DefineParam(mCodedColorAspects, C2_PARAMKEY_VUI_COLOR_ASPECTS)
+                         .withDefault(new C2StreamColorAspectsInfo::output(0u, C2Color::RANGE_LIMITED,
+                                                                           C2Color::PRIMARIES_BT709,
+                                                                           C2Color::TRANSFER_170M,
+                                                                           C2Color::MATRIX_BT709))
+                         .withFields({C2F(mCodedColorAspects, range)
+                                          .inRange(C2Color::RANGE_UNSPECIFIED, C2Color::RANGE_OTHER),
+                                      C2F(mCodedColorAspects, primaries)
+                                          .inRange(C2Color::PRIMARIES_UNSPECIFIED, C2Color::PRIMARIES_OTHER),
+                                      C2F(mCodedColorAspects, transfer)
+                                          .inRange(C2Color::TRANSFER_UNSPECIFIED, C2Color::TRANSFER_OTHER),
+                                      C2F(mCodedColorAspects, matrix)
+                                          .inRange(C2Color::MATRIX_UNSPECIFIED, C2Color::MATRIX_OTHER)})
+                         .withSetter(CodedColorAspectsSetter, mColorAspects)
+                         .build());
+    }
+
+    static C2R SizeSetter(bool, const C2P<C2StreamPictureSizeInfo::input> &oldMe,
+                          C2P<C2StreamPictureSizeInfo::input> &me)
+    {
+        C2R res = C2R::Ok();
+        if (!me.F(me.v.width).supportsAtAll(me.v.width)) {
+            res = res.plus(C2SettingResultBuilder::BadValue(me.F(me.v.width)));
+            me.set().width = oldMe.v.width;
+        }
+        if (!me.F(me.v.height).supportsAtAll(me.v.height)) {
+            res = res.plus(C2SettingResultBuilder::BadValue(me.F(me.v.height)));
+            me.set().height = oldMe.v.height;
+        }
+        return res;
+    }
+    static C2R BitrateSetter(bool, C2P<C2StreamBitrateInfo::output> &me)
+    {
+        if (me.v.value < 1)
+            me.set().value = 1;
+        if (me.v.value > kMaxBitrate)
+            me.set().value = kMaxBitrate;
+        return C2R::Ok();
+    }
+    /* H.264: the requested level if it covers size, rate and bitrate, else the lowest that does (as
+     * C2SoftAvcEnc); HEVC / AV1: the level the session signals for the size. */
+    static C2R ProfileLevelSetter(bool, C2P<C2StreamProfileLevelInfo::output> &me,
+                                  const C2P<C2StreamPictureSizeInfo::input> &size,
+                                  const C2P<C2StreamFrameRateInfo::output> &frameRate,
+                                  const C2P<C2StreamBitrateInfo::output> &bitrate)
+    {
+        if (!me.F(me.v.profile).supportsAtAll(me.v.profile))
+            for (C2Config::profile_t p : {C2Config::PROFILE_AVC_CONSTRAINED_BASELINE, C2Config::PROFILE_HEVC_MAIN,
+                                          C2Config::PROFILE_AV1_0})
+                if (me.F(me.v.profile).supportsAtAll(p))
+                    me.set().profile = p; /* this component's default */
+        const C2Config::profile_t p = me.v.profile;
+        if (p != C2Config::PROFILE_AVC_CONSTRAINED_BASELINE && p != C2Config::PROFILE_AVC_BASELINE &&
+            p != C2Config::PROFILE_AVC_MAIN && p != C2Config::PROFILE_AVC_CONSTRAINED_HIGH &&
+            p != C2Config::PROFILE_AVC_PROGRESSIVE_HIGH && p != C2Config::PROFILE_AVC_HIGH) {
+            const uint32_t codec = p == C2Config::PROFILE_HEVC_MAIN ? NV_VIDEO_CODEC_HEVC : NV_VIDEO_CODEC_AV1;
+            me.set().level = c2_level(codec, coded_level(codec, size.v.width, size.v.height));
+            return C2R::Ok();
+        }
+        const uint64_t mbs = uint64_t((size.v.width + 15) / 16) * ((size.v.height + 15) / 16);
+        const double mbps = double(mbs) * frameRate.v.value;
+        const AvcLevel *lowest = nullptr;
+        bool requested_fits = false;
+        for (const AvcLevel &l : kAvcLevels) {
+            const bool fits = mbs <= l.mbs && mbps <= double(l.mbps) && bitrate.v.value <= l.bitrate;
+            if (fits && !lowest)
+                lowest = &l;
+            if (l.level == me.v.level)
+                requested_fits = fits;
+        }
+        if (!requested_fits)
+            me.set().level = lowest ? lowest->level : C2Config::LEVEL_AVC_6_2;
+        return C2R::Ok();
+    }
+    static C2R ColorAspectsSetter(bool, C2P<C2StreamColorAspectsInfo::input> &me)
+    {
+        if (me.v.range > C2Color::RANGE_OTHER)
+            me.set().range = C2Color::RANGE_OTHER;
+        if (me.v.primaries > C2Color::PRIMARIES_OTHER)
+            me.set().primaries = C2Color::PRIMARIES_OTHER;
+        if (me.v.transfer > C2Color::TRANSFER_OTHER)
+            me.set().transfer = C2Color::TRANSFER_OTHER;
+        if (me.v.matrix > C2Color::MATRIX_OTHER)
+            me.set().matrix = C2Color::MATRIX_OTHER;
+        return C2R::Ok();
+    }
+    /* what the VUI / color_config carries: the input's aspects, BT.709 limited range where unspecified */
+    static C2R CodedColorAspectsSetter(bool, C2P<C2StreamColorAspectsInfo::output> &me,
+                                       const C2P<C2StreamColorAspectsInfo::input> &in)
+    {
+        me.set().range = in.v.range == C2Color::RANGE_FULL ? C2Color::RANGE_FULL : C2Color::RANGE_LIMITED;
+        me.set().primaries = in.v.primaries == C2Color::PRIMARIES_UNSPECIFIED ? C2Color::PRIMARIES_BT709 : in.v.primaries;
+        me.set().transfer = in.v.transfer == C2Color::TRANSFER_UNSPECIFIED ? C2Color::TRANSFER_170M : in.v.transfer;
+        me.set().matrix = in.v.matrix == C2Color::MATRIX_UNSPECIFIED ? C2Color::MATRIX_BT709 : in.v.matrix;
+        return C2R::Ok();
+    }
+
+    /* the session configuration from the current parameters */
+    EncoderConfig sessionConfig() const
+    {
+        EncoderConfig c;
+        c.codec = mCodec;
+        c.width = mSize->width;
+        c.height = mSize->height;
+        c.rc = mBitrateMode->value == C2Config::BITRATE_CONST    ? EncoderConfig::CBR
+               : mBitrateMode->value == C2Config::BITRATE_IGNORE ? EncoderConfig::CONST_QP
+                                                                  : EncoderConfig::VBR;
+        c.bitrate = mBitrate->value;
+        c.fps = fps();
+        c.idr_period = idrPeriod();
+        if (mCodec == NV_VIDEO_CODEC_H264) {
+            switch (mProfileLevel->profile) {
+            case C2Config::PROFILE_AVC_MAIN: c.h264_profile = 77; break;
+            case C2Config::PROFILE_AVC_CONSTRAINED_HIGH:
+            case C2Config::PROFILE_AVC_PROGRESSIVE_HIGH:
+            case C2Config::PROFILE_AVC_HIGH: c.h264_profile = 100; break;
+            default: c.h264_profile = 66; break; /* Baseline: its constrained subset */
+            }
+            for (const AvcLevel &l : kAvcLevels)
+                if (l.level == mProfileLevel->level)
+                    c.h264_level = l.idc;
+        }
+        c.full_range = mCodedColorAspects->range == C2Color::RANGE_FULL;
+        c.primaries = h273_primaries(mCodedColorAspects->primaries);
+        c.transfer = h273_transfer(mCodedColorAspects->transfer);
+        c.matrix = h273_matrix(mCodedColorAspects->matrix);
+        return c;
+    }
+    uint32_t fps() const { return (uint32_t)c2_max(1., mFrameRate->value + 0.5); }
+    uint32_t bitrate() const { return mBitrate->value; }
+    /* pictures between sync frames: 0 = only the first (negative interval), 1 = every picture (interval 0) */
+    uint32_t idrPeriod() const
+    {
+        const int64_t us = mSyncFramePeriod->value;
+        if (us < 0 || us == INT64_MAX)
+            return 0;
+        const double n = double(us) / 1e6 * mFrameRate->value + 0.5;
+        return (uint32_t)c2_max(c2_min(n, double(UINT32_MAX)), 1.);
+    }
+    bool prependHeaders() const { return mPrependHeader->value == C2Config::PREPEND_HEADER_TO_ALL_SYNC; }
+    bool syncRequested() const { return mRequestSync->value; }
+    /* the getters above read the parameters: call them under lock() */
+
+    /* withdraws a handled sync frame request (as C2SoftAvcEnc); not under lock() */
+    void clearSyncRequest()
+    {
+        C2StreamRequestSyncFrameTuning::output clear(0u, C2_FALSE);
+        std::vector<std::unique_ptr<C2SettingResult>> failures;
+        config({&clear}, C2_MAY_BLOCK, &failures);
+    }
+
+private:
+    const uint32_t mCodec;
+    std::shared_ptr<C2StreamUsageTuning::input> mUsage;
+    std::shared_ptr<C2ComponentAttributesSetting> mAttrib;
+    std::shared_ptr<C2StreamPictureSizeInfo::input> mSize;
+    std::shared_ptr<C2StreamFrameRateInfo::output> mFrameRate;
+    std::shared_ptr<C2StreamBitrateModeTuning::output> mBitrateMode;
+    std::shared_ptr<C2StreamBitrateInfo::output> mBitrate;
+    std::shared_ptr<C2StreamProfileLevelInfo::output> mProfileLevel;
+    std::shared_ptr<C2StreamRequestSyncFrameTuning::output> mRequestSync;
+    std::shared_ptr<C2StreamSyncFrameIntervalTuning::output> mSyncFramePeriod;
+    std::shared_ptr<C2PrependHeaderModeSetting> mPrependHeader;
+    std::shared_ptr<C2StreamColorAspectsInfo::input> mColorAspects;
+    std::shared_ptr<C2StreamColorAspectsInfo::output> mCodedColorAspects;
+};
