+/* SPDX-License-Identifier: Apache-2.0
+ * Codec2 encoder components over the NVENC encode session (see NvC2Encoder.h).
+ *
+ * Input: graphic blocks the client fills (ByteBuffer mode: CCodec's copy into a YUV_420_888 block) or a Surface
+ * producer's buffers, mapped on the CPU (the interface asks for CPU_READ input usage, as AOSP's software encoders)
+ * and loaded into NVENC's input layout by the core: NV12 / NV21 / I420 YUV, or RGBX / BGRX converted to BT.709
+ * video-range 4:2:0. Output: one linear block per picture from the client's output pool, the codec-specific data
+ * as a C2StreamInitDataInfo config update with the first one.
+ */
+#define LOG_TAG "nvc2-enc"
+#include "NvC2Encoder.h"
+
+#include <C2PlatformSupport.h>
+#include <SimpleC2Interface.h>
+#include <log/log.h>
+#include <media/stagefright/foundation/MediaDefs.h>
+
+#include <cstring>
+#include <sys/system_properties.h>
+
+namespace nvc2 {
+
+using namespace ::android;
+
+namespace {
+
+constexpr uint32_t kMaxBitrate = 200000000; /* the listing's bitrate limit (nvc2_caps.cpp) */
+
+struct AvcLevel {
+    C2Config::level_t level;
+    uint32_t idc;
+    uint64_t mbps;   /* MaxMBPS */
+    uint64_t mbs;    /* MaxFS */
+    uint64_t bitrate; /* MaxBR x 1000 (Baseline / Main / Extended) */
+};
+/* ITU-T H.264 Table A-1 */
+constexpr AvcLevel kAvcLevels[] = {
+    {C2Config::LEVEL_AVC_1, 10, 1485, 99, 64000},
+    {C2Config::LEVEL_AVC_1_1, 11, 3000, 396, 192000},
+    {C2Config::LEVEL_AVC_1_2, 12, 6000, 396, 384000},
+    {C2Config::LEVEL_AVC_1_3, 13, 11880, 396, 768000},
+    {C2Config::LEVEL_AVC_2, 20, 11880, 396, 2000000},
+    {C2Config::LEVEL_AVC_2_1, 21, 19800, 792, 4000000},
+    {C2Config::LEVEL_AVC_2_2, 22, 20250, 1620, 4000000},
+    {C2Config::LEVEL_AVC_3, 30, 40500, 1620, 10000000},
+    {C2Config::LEVEL_AVC_3_1, 31, 108000, 3600, 14000000},
+    {C2Config::LEVEL_AVC_3_2, 32, 216000, 5120, 20000000},
+    {C2Config::LEVEL_AVC_4, 40, 245760, 8192, 20000000},
+    {C2Config::LEVEL_AVC_4_1, 41, 245760, 8192, 50000000},
+    {C2Config::LEVEL_AVC_4_2, 42, 522240, 8704, 50000000},
+    {C2Config::LEVEL_AVC_5, 50, 589824, 22080, 135000000},
+    {C2Config::LEVEL_AVC_5_1, 51, 983040, 36864, 240000000},
+    {C2Config::LEVEL_AVC_5_2, 52, 2073600, 36864, 240000000},
+    {C2Config::LEVEL_AVC_6, 60, 4177920, 139264, 240000000},
+    {C2Config::LEVEL_AVC_6_1, 61, 8355840, 139264, 480000000},
+    {C2Config::LEVEL_AVC_6_2, 62, 16711680, 139264, 800000000},
+};
+
+/* HEVC general_level_idc / AV1 seq_level_idx as coded_level() returns them */
+C2Config::level_t c2_level(uint32_t codec, uint32_t coded)
+{
+    if (codec == NV_VIDEO_CODEC_HEVC) {
+        switch (coded) {
+        case 93: return C2Config::LEVEL_HEVC_MAIN_3_1;
+        case 123: return C2Config::LEVEL_HEVC_MAIN_4_1;
+        case 153: return C2Config::LEVEL_HEVC_MAIN_5_1;
+        default: return C2Config::LEVEL_HEVC_MAIN_6_1;
+        }
+    }
+    switch (coded) {
+    case 4: return C2Config::LEVEL_AV1_3;
+    case 5: return C2Config::LEVEL_AV1_3_1;
+    case 9: return C2Config::LEVEL_AV1_4_1;
+    case 13: return C2Config::LEVEL_AV1_5_1;
+    default: return C2Config::LEVEL_AV1_6_1;
+    }
+}
+
+/* C2Color -> ITU-T H.273 code points; unspecified -> BT.709 */
+uint8_t h273_primaries(C2Color::primaries_t p)
+{
+    switch (p) {
+    case C2Color::PRIMARIES_BT470_M: return 4;
+    case C2Color::PRIMARIES_BT601_625: return 5;
+    case C2Color::PRIMARIES_BT601_525: return 6;
+    case C2Color::PRIMARIES_GENERIC_FILM: return 8;
+    case C2Color::PRIMARIES_BT2020: return 9;
+    default: return 1;
+    }
+}
+uint8_t h273_transfer(C2Color::transfer_t t)
+{
+    switch (t) {
+    case C2Color::TRANSFER_GAMMA22: return 4;
+    case C2Color::TRANSFER_GAMMA28: return 5;
+    case C2Color::TRANSFER_170M: return 6;
+    case C2Color::TRANSFER_LINEAR: return 8;
+    case C2Color::TRANSFER_SRGB: return 13;
+    case C2Color::TRANSFER_ST2084: return 16;
+    case C2Color::TRANSFER_HLG: return 18;
+    default: return 1;
+    }
+}
+uint8_t h273_matrix(C2Color::matrix_t m)
+{
+    switch (m) {
+    case C2Color::MATRIX_FCC47_73_682: return 4;
+    case C2Color::MATRIX_BT601: return 6;
+    case C2Color::MATRIX_240M: return 7;
+    case C2Color::MATRIX_BT2020: return 9;
+    case C2Color::MATRIX_BT2020_CONSTANT: return 10;
+    default: return 1;
+    }
+}
