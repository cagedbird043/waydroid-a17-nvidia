+    #elif defined(__GNUC__) || defined(__clang__) || defined(__INTEL_COMPILER)
+    #define NV_INLINE __inline__
+    #elif defined (macintosh) || defined(__SUNPRO_C) || defined(__SUNPRO_CC)
