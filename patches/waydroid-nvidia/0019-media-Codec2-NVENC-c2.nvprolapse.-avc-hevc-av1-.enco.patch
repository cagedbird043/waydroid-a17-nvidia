+EncComponent::~EncComponent() { release(); }
+
+std::shared_ptr<C2ComponentInterface> EncComponent::intf() { return mIntf; }
+
+c2_status_t EncComponent::setListener_vb(const std::shared_ptr<Listener> &listener, c2_blocking_t)
+{
+    std::lock_guard<std::mutex> lk(mLock);
+    if (mRunning && listener)
+        return C2_BAD_STATE;
+    mListener = listener;
+    return C2_OK;
+}
+
+c2_status_t EncComponent::start()
+{
+    std::lock_guard<std::mutex> lk(mLock);
+    if (mRunning)
+        return C2_BAD_STATE;
+    mQuit = false;
+    mError = false;
+    mRunning = true;
+    mThread = std::thread(&EncComponent::loop, this);
+    return C2_OK;
+}
+
+c2_status_t EncComponent::stop()
+{
+    {
+        std::lock_guard<std::mutex> lk(mLock);
+        if (!mRunning)
+            return C2_OK;
+        mQuit = true;
+    }
+    mCv.notify_all();
+    if (mThread.joinable())
+        mThread.join();
+    std::lock_guard<std::mutex> lk(mLock);
+    mRunning = false;
+    mQueue.clear();
+    mEncoder.reset();
+    mOutputPool.reset();
+    mCsd.clear();
+    mCsdSent = false;
+    return C2_OK;
+}
+
+c2_status_t EncComponent::reset()
+{
+    stop();
+    std::lock_guard<std::mutex> lk(mLock);
+    mListener.reset();
+    return C2_OK;
+}
+
+c2_status_t EncComponent::release() { return reset(); }
+
+c2_status_t EncComponent::queue_nb(std::list<std::unique_ptr<C2Work>> *const items)
+{
+    {
+        std::lock_guard<std::mutex> lk(mLock);
+        if (!mRunning)
+            return C2_BAD_STATE;
+        while (!items->empty()) {
+            mQueue.push_back(std::move(items->front()));
+            items->pop_front();
+        }
+    }
+    mCv.notify_all();
+    return C2_OK;
+}
+
+c2_status_t EncComponent::drain_nb(drain_mode_t)
+{
+    /* every picture is returned with its work: nothing is held back to drain (CCodec drains with an
+     * END_OF_STREAM work) */
+    return C2_OMITTED;
+}
+
+c2_status_t EncComponent::flush_sm(flush_mode_t, std::list<std::unique_ptr<C2Work>> *const flushedWork)
+{
+    std::lock_guard<std::mutex> lk(mLock);
+    while (!mQueue.empty()) {
+        flushedWork->push_back(std::move(mQueue.front()));
+        mQueue.pop_front();
+    }
+    return C2_OK;
+}
+
+void EncComponent::fatal(const std::string &why)
+{
+    ALOGE("%s: %s", mEntry.name, why.c_str());
+    std::lock_guard<std::mutex> lk(mLock);
+    mError = true;
+}
+
+bool EncComponent::ensure_encoder(std::string *error)
+{
+    if (mEncoder)
+        return true;
+    EncoderConfig cfg;
+    {
+        EncIntfImpl::Lock lock = mIntf->mImpl->lock();
+        cfg = mIntf->mImpl->sessionConfig();
+    }
+    mEncoder = Encoder::create(cfg, error);
+    if (!mEncoder)
+        return false;
+    mBitrate = cfg.bitrate;
+    mFps = cfg.fps;
+    mIdrPeriod = cfg.idr_period;
+    mCsd = mEncoder->codec_config();
+    ALOGI("%s: %ux%u, %s %u bit/s, %u fps, sync every %u picture(s), H.264 profile_idc %u level_idc %u", mEntry.name,
+          cfg.width, cfg.height, cfg.rc == EncoderConfig::CBR ? "CBR" : cfg.rc == EncoderConfig::VBR ? "VBR" : "const QP",
+          cfg.bitrate, cfg.fps, cfg.idr_period, cfg.h264_profile, cfg.h264_level);
+    return true;
+}
+
+namespace {
+
+/* the input view as one of the layouts the session loads; false: not one of them */
+bool input_image(const C2GraphicView &v, InputImage *in)
+{
+    const C2PlanarLayout &l = v.layout();
+    const uint8_t *const *d = v.data();
+    auto stride = [&](int p) { return (size_t)l.planes[p].rowInc; };
+    if (l.type == C2PlanarLayout::TYPE_YUV && l.numPlanes == 3) {
+        const auto &Y = l.planes[C2PlanarLayout::PLANE_Y], &U = l.planes[C2PlanarLayout::PLANE_U],
+                   &V = l.planes[C2PlanarLayout::PLANE_V];
+        if (Y.colInc != 1 || Y.allocatedDepth != 8 || U.allocatedDepth != 8 || V.allocatedDepth != 8 ||
+            U.colSampling != 2 || U.rowSampling != 2 || V.colSampling != 2 || V.rowSampling != 2)
+            return false;
+        const uint8_t *y = d[C2PlanarLayout::PLANE_Y], *u = d[C2PlanarLayout::PLANE_U], *vv = d[C2PlanarLayout::PLANE_V];
+        in->plane[0] = y;
+        in->stride[0] = stride(C2PlanarLayout::PLANE_Y);
+        if (U.colInc == 2 && V.colInc == 2 && U.rowInc == V.rowInc && vv == u + 1) {
+            in->layout = InputImage::NV12;
+            in->plane[1] = u;
+            in->stride[1] = stride(C2PlanarLayout::PLANE_U);
+            return true;
+        }
+        if (U.colInc == 2 && V.colInc == 2 && U.rowInc == V.rowInc && u == vv + 1) {
+            in->layout = InputImage::NV21;
+            in->plane[1] = vv;
+            in->stride[1] = stride(C2PlanarLayout::PLANE_V);
+            return true;
+        }
+        if (U.colInc == 1 && V.colInc == 1) {
+            in->layout = InputImage::I420;
+            in->plane[1] = u;
+            in->stride[1] = stride(C2PlanarLayout::PLANE_U);
+            in->plane[2] = vv;
+            in->stride[2] = stride(C2PlanarLayout::PLANE_V);
+            return true;
+        }
+        return false;
+    }
+    if (l.type == C2PlanarLayout::TYPE_RGB || l.type == C2PlanarLayout::TYPE_RGBA) {
+        const auto &R = l.planes[C2PlanarLayout::PLANE_R];
+        const uint8_t *r = d[C2PlanarLayout::PLANE_R], *g = d[C2PlanarLayout::PLANE_G], *b = d[C2PlanarLayout::PLANE_B];
+        if (R.colInc != 4 || R.allocatedDepth != 8 || g != r + 1)
+            return false;
+        if (b == r + 2) {
+            in->layout = InputImage::RGBX;
+            in->plane[0] = r;
+        } else if (r == b + 2) {
+            in->layout = InputImage::BGRX;
+            in->plane[0] = b;
+        } else {
+            return false;
+        }
+        in->stride[0] = stride(C2PlanarLayout::PLANE_R);
+        return true;
+    }
+    return false;
+}
+
+} // namespace
+
+void EncComponent::process(std::unique_ptr<C2Work> &work)
+{
+    auto &wl = work->worklets.front();
+    wl->output.flags = C2FrameData::flags_t(0);
+    wl->output.buffers.clear();
+    wl->output.ordinal = work->input.ordinal;
+    work->result = C2_OK;
+    work->workletsProcessed = 1u;
+    const bool eos = work->input.flags & C2FrameData::FLAG_END_OF_STREAM;
+    if (eos)
+        wl->output.flags = C2FrameData::FLAG_END_OF_STREAM;
+
+    std::shared_ptr<C2Buffer> input =
+        work->input.buffers.empty() ? nullptr : work->input.buffers.front();
+    if (!input || input->data().graphicBlocks().empty())
+        return; /* end of stream without a picture, or an empty work */
+
+    std::string err;
+    if (!ensure_encoder(&err)) {
+        fatal(err);
+        work->result = C2_CORRUPTED;
+        return;
+    }
+    if (!mOutputPool) {
+        C2BlockPool::local_id_t poolId = C2BlockPool::BASIC_LINEAR;
+        std::vector<std::unique_ptr<C2Param>> heap;
+        if (mIntf->query_vb({}, {C2PortBlockPoolsTuning::output::PARAM_TYPE}, C2_DONT_BLOCK, &heap) == C2_OK &&
+            heap.size() == 1 && heap[0]) {
+            auto *p = C2PortBlockPoolsTuning::output::From(heap[0].get());
+            if (p && p->flexCount() > 0)
+                poolId = p->m.values[0];
+        }
+        c2_status_t e = GetCodec2BlockPool(poolId, shared_from_this(), &mOutputPool);
+        if (e != C2_OK) {
+            fatal("GetCodec2BlockPool(" + std::to_string(poolId) + ") failed: " + std::to_string(e));
+            work->result = C2_CORRUPTED;
+            return;
+        }
+    }
+
+    /* parameters, read once per picture */
+    EncIntfImpl &p = *mIntf->mImpl;
+    EncoderConfig cfg;
+    bool key, prependHeaders;
+    {
+        EncIntfImpl::Lock lock = p.lock();
+        cfg = p.sessionConfig();
+        key = p.syncRequested();
+        prependHeaders = p.prependHeaders();
+    }
+    if (key)
+        p.clearSyncRequest();
+    if (cfg.bitrate != mBitrate || cfg.fps != mFps) {
+        mEncoder->set_rate(cfg.bitrate, cfg.fps);
+        mBitrate = cfg.bitrate;
+        mFps = cfg.fps;
+    }
+    if (cfg.idr_period != mIdrPeriod) {
+        mEncoder->set_idr_period(cfg.idr_period);
+        mIdrPeriod = cfg.idr_period;
+    }
+
+    const C2ConstGraphicBlock block = input->data().graphicBlocks().front();
+    const C2GraphicView view = block.map().get();
+    if (view.error() != C2_OK) {
+        fatal("cannot map the input picture: " + std::to_string(view.error()));
+        work->result = C2_CORRUPTED;
+        return;
+    }
+    if (view.width() < cfg.width || view.height() < cfg.height) {
+        fatal("input picture " + std::to_string(view.width()) + "x" + std::to_string(view.height()) +
+              " is smaller than the configured " + std::to_string(cfg.width) + "x" + std::to_string(cfg.height));
+        work->result = C2_BAD_VALUE;
+        return;
+    }
+    InputImage in;
+    if (!input_image(view, &in)) {
+        const C2PlanarLayout &l = view.layout();
+        fatal("input layout type " + std::to_string(l.type) + " with " + std::to_string(l.numPlanes) +
+              " planes is not NV12 / NV21 / I420 / RGBX / BGRX");
+        work->result = C2_BAD_VALUE;
+        return;
+    }
+    EncodedFrame fr;
+    if (!mEncoder->encode(in, key, &fr)) {
+        /* the session forces an IDR next; this picture is dropped */
+        ALOGW("%s: frame %llu: %s", mEntry.name, (unsigned long long)work->input.ordinal.frameIndex.peeku(),
+              mEncoder->error().c_str());
+        return;
+    }
+
+    if (!mCsdSent) {
+        std::unique_ptr<C2StreamInitDataInfo::output> csd = C2StreamInitDataInfo::output::AllocUnique(mCsd.size(), 0u);
+        if (!csd) {
+            fatal("codec-specific data allocation failed");
+            work->result = C2_NO_MEMORY;
+            return;
+        }
+        memcpy(csd->m.value, mCsd.data(), mCsd.size());
+        wl->output.configUpdate.push_back(std::move(csd));
+        mCsdSent = true;
+    }
+
+    /* Annex B parameter sets before each sync frame on request (AV1 key frames carry their sequence header) */
+    const bool prepend = fr.key && prependHeaders && mEntry.codec != NV_VIDEO_CODEC_AV1;
+    const size_t size = fr.size + (prepend ? mCsd.size() : 0);
+    std::shared_ptr<C2LinearBlock> out;
+    c2_status_t e = mOutputPool->fetchLinearBlock(size, {C2MemoryUsage::CPU_READ, C2MemoryUsage::CPU_WRITE}, &out);
+    if (e != C2_OK) {
+        fatal("fetchLinearBlock(" + std::to_string(size) + ") failed: " + std::to_string(e));
+        work->result = C2_NO_MEMORY;
+        return;
+    }
+    C2WriteView wv = out->map().get();
+    if (wv.error() != C2_OK) {
+        fatal("cannot map the output block: " + std::to_string(wv.error()));
+        work->result = C2_CORRUPTED;
+        return;
+    }
+    uint8_t *dst = wv.data();
+    if (prepend) {
+        memcpy(dst, mCsd.data(), mCsd.size());
+        dst += mCsd.size();
+    }
+    memcpy(dst, fr.data, fr.size);
+    std::shared_ptr<C2Buffer> buf = C2Buffer::CreateLinearBuffer(out->share(0, size, C2Fence()));
+    if (fr.key)
+        buf->setInfo(std::make_shared<C2StreamPictureTypeMaskInfo::output>(0u, C2Config::SYNC_FRAME));
+    wl->output.buffers.push_back(buf);
+}
+
+void EncComponent::loop()
+{
+    std::unique_lock<std::mutex> lk(mLock);
+    while (!mQuit) {
+        if (mError) {
+            if (std::shared_ptr<Listener> l = mListener) {
+                lk.unlock();
+                l->onError_nb(shared_from_this(), C2_CORRUPTED);
+                lk.lock();
+            }
+            mCv.wait(lk, [this] { return mQuit; });
+            break;
+        }
+        if (mQueue.empty()) {
+            mCv.wait(lk, [this] { return mQuit || !mQueue.empty(); });
+            continue;
+        }
+        std::unique_ptr<C2Work> work = std::move(mQueue.front());
+        mQueue.pop_front();
+        std::shared_ptr<Listener> l = mListener;
+        lk.unlock();
+        process(work);
+        std::list<std::unique_ptr<C2Work>> done;
+        done.push_back(std::move(work));
+        if (l)
+            l->onWorkDone_nb(shared_from_this(), std::move(done));
+        lk.lock();
+    }
+}
+
+} // namespace nvc2
