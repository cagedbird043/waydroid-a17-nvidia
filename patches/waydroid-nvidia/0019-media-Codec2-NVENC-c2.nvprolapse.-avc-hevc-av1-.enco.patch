@@ -0,0 +1,138 @@
+/* SPDX-License-Identifier: MIT
+ * Guest smoke test of the Codec2 NVENC encoders through the public MediaCodec NDK with ByteBuffer input
+ * (COLOR_FormatYUV420SemiPlanar, what Chrome's NdkVideoEncodeAccelerator queues): raw NV12 pictures in, the
+ * codec-specific data and every access unit out, in order, into one file the host decodes with FFmpeg.
+ *
+ *   c2_enc_smoke <codec name> <mime> <W> <H> <in.nv12> <out> [kbps]
+ *
+ * Mid-stream, as a WebRTC client would: a sync frame request at picture 45 and the bitrate halved at picture
+ * 60 (setParameters). Prints the picture count, the key frames and the bytes of each half.
+ */
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include <media/NdkMediaCodec.h>
+#include <media/NdkMediaFormat.h>
+
+int main(int argc, char **argv)
+{
+    if (argc < 7) {
+        fprintf(stderr, "usage: c2_enc_smoke <codec name> <mime> <W> <H> <in.nv12> <out> [kbps]\n");
+        return 2;
+    }
+    const char *name = argv[1], *mime = argv[2];
+    const int32_t W = atoi(argv[3]), H = atoi(argv[4]);
+    const int32_t kbps = argc > 7 ? atoi(argv[7]) : 4000;
+    FILE *in = fopen(argv[5], "rb"), *out = fopen(argv[6], "wb");
+    if (!in || !out) {
+        perror("open");
+        return 1;
+    }
+    const size_t frame = (size_t)W * H * 3 / 2;
+    std::vector<uint8_t> pic(frame);
+
+    AMediaCodec *codec = AMediaCodec_createCodecByName(name);
+    if (!codec) {
+        fprintf(stderr, "no codec %s\n", name);
+        return 1;
+    }
+    AMediaFormat *fmt = AMediaFormat_new();
+    AMediaFormat_setString(fmt, AMEDIAFORMAT_KEY_MIME, mime);
+    AMediaFormat_setInt32(fmt, AMEDIAFORMAT_KEY_WIDTH, W);
+    AMediaFormat_setInt32(fmt, AMEDIAFORMAT_KEY_HEIGHT, H);
+    AMediaFormat_setInt32(fmt, AMEDIAFORMAT_KEY_COLOR_FORMAT, 21 /* COLOR_FormatYUV420SemiPlanar */);
+    AMediaFormat_setInt32(fmt, AMEDIAFORMAT_KEY_BIT_RATE, kbps * 1000);
+    AMediaFormat_setInt32(fmt, AMEDIAFORMAT_KEY_BITRATE_MODE, 2 /* CBR */);
+    AMediaFormat_setInt32(fmt, AMEDIAFORMAT_KEY_FRAME_RATE, 30);
+    AMediaFormat_setFloat(fmt, AMEDIAFORMAT_KEY_I_FRAME_INTERVAL, 100.f);
+    media_status_t st = AMediaCodec_configure(codec, fmt, nullptr, nullptr, AMEDIACODEC_CONFIGURE_FLAG_ENCODE);
+    AMediaFormat_delete(fmt);
+    if (st != AMEDIA_OK || AMediaCodec_start(codec) != AMEDIA_OK) {
+        fprintf(stderr, "configure/start failed (%d)\n", st);
+        return 1;
+    }
+    AMediaFormat *ifmt = AMediaCodec_getInputFormat(codec);
+    int32_t stride = W, slice = H;
+    AMediaFormat_getInt32(ifmt, AMEDIAFORMAT_KEY_STRIDE, &stride);
+    AMediaFormat_getInt32(ifmt, AMEDIAFORMAT_KEY_SLICE_HEIGHT, &slice);
+    AMediaFormat_delete(ifmt);
+    printf("%s: input stride %d slice height %d\n", name, stride, slice);
+
+    int n_in = 0, n_out = 0, keys = 0, configs = 0;
+    size_t half[2] = {0, 0};
+    bool in_eos = false, out_eos = false;
+    while (!out_eos) {
+        if (!in_eos) {
+            ssize_t i = AMediaCodec_dequeueInputBuffer(codec, 10000);
+            if (i >= 0) {
+                size_t cap;
+                uint8_t *buf = AMediaCodec_getInputBuffer(codec, i, &cap);
+                if (fread(pic.data(), 1, frame, in) != frame) {
+                    AMediaCodec_queueInputBuffer(codec, i, 0, 0, 0, AMEDIACODEC_BUFFER_FLAG_END_OF_STREAM);
+                    in_eos = true;
+                } else {
+                    if (n_in == 45) {
+                        AMediaFormat *p = AMediaFormat_new();
+                        AMediaFormat_setInt32(p, AMEDIACODEC_KEY_REQUEST_SYNC_FRAME, 0);
+                        AMediaCodec_setParameters(codec, p);
+                        AMediaFormat_delete(p);
+                    }
+                    if (n_in == 60) {
+                        AMediaFormat *p = AMediaFormat_new();
+                        AMediaFormat_setInt32(p, AMEDIACODEC_KEY_VIDEO_BITRATE, kbps * 500);
+                        AMediaCodec_setParameters(codec, p);
+                        AMediaFormat_delete(p);
+                    }
+                    const size_t need = (size_t)stride * slice + (size_t)stride * (H / 2);
+                    if (need > cap) {
+                        fprintf(stderr, "input buffer %zu < %zu\n", cap, need);
+                        return 1;
+                    }
+                    for (int r = 0; r < H; r++)
+                        memcpy(buf + (size_t)r * stride, pic.data() + (size_t)r * W, W);
+                    for (int r = 0; r < H / 2; r++)
+                        memcpy(buf + (size_t)stride * slice + (size_t)r * stride, pic.data() + (size_t)W * H + (size_t)r * W, W);
+                    AMediaCodec_queueInputBuffer(codec, i, 0, need, (uint64_t)n_in * 33333, 0);
+                    n_in++;
+                }
+            }
+        }
+        AMediaCodecBufferInfo info;
+        ssize_t o = AMediaCodec_dequeueOutputBuffer(codec, &info, in_eos ? 100000 : 0);
+        if (o >= 0) {
+            size_t cap;
+            uint8_t *buf = AMediaCodec_getOutputBuffer(codec, o, &cap);
+            if (info.size > 0)
+                fwrite(buf + info.offset, 1, info.size, out);
+            if (info.flags & AMEDIACODEC_BUFFER_FLAG_CODEC_CONFIG) {
+                configs++;
+            } else if (info.size > 0) {
+                if (info.flags & 1 /* BUFFER_FLAG_KEY_FRAME */) {
+                    keys++;
+                    printf("key frame at output %d\n", n_out);
+                }
+                if (n_out >= 20 && n_out < 60)
+                    half[0] += info.size;
+                if (n_out >= 80)
+                    half[1] += info.size;
+                n_out++;
+            }
+            if (info.flags & AMEDIACODEC_BUFFER_FLAG_END_OF_STREAM)
+                out_eos = true;
+            AMediaCodec_releaseOutputBuffer(codec, o, false);
+        } else if (o == AMEDIACODEC_INFO_TRY_AGAIN_LATER && in_eos) {
+            fprintf(stderr, "no end of stream from the encoder\n");
+            return 1;
+        }
+    }
+    AMediaCodec_stop(codec);
+    AMediaCodec_delete(codec);
+    fclose(out);
+    printf("%s: %d pictures in, %d out, %d codec config, %d key frames, %zu -> %zu bytes per 40 pictures\n", name,
+           n_in, n_out, configs, keys, half[0], half[1]);
+    return n_out == n_in && configs == 1 ? 0 : 1;
+}
