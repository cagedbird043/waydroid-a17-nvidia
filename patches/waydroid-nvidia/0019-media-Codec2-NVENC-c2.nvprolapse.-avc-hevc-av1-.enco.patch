+
+class EncIntf;
+
+/* System property that routes encoding to this store or to the image's software encoders. */
+inline constexpr char kEncodeRouteProp[] = "persist.waydroid.nvidia_video_encode";
+bool encode_routed_here();
+
+std::shared_ptr<C2ComponentInterface> make_encoder_interface(const EncoderEntry &e, c2_node_id_t id,
+                                                             const std::shared_ptr<C2ReflectorHelper> &reflector);
+
+class EncComponent : public C2Component, public std::enable_shared_from_this<EncComponent> {
+public:
+    EncComponent(const EncoderEntry &entry, c2_node_id_t id, const std::shared_ptr<C2ReflectorHelper> &reflector);
+    ~EncComponent() override;
+
+    c2_status_t setListener_vb(const std::shared_ptr<Listener> &listener, c2_blocking_t mayBlock) override;
+    c2_status_t queue_nb(std::list<std::unique_ptr<C2Work>> *const items) override;
+    c2_status_t announce_nb(const std::vector<C2WorkOutline> &) override { return C2_OMITTED; }
+    c2_status_t flush_sm(flush_mode_t mode, std::list<std::unique_ptr<C2Work>> *const flushedWork) override;
+    c2_status_t drain_nb(drain_mode_t mode) override;
+    c2_status_t start() override;
+    c2_status_t stop() override;
+    c2_status_t reset() override;
+    c2_status_t release() override;
+    std::shared_ptr<C2ComponentInterface> intf() override;
+
+private:
+    void loop();
+    void process(std::unique_ptr<C2Work> &work);
+    bool ensure_encoder(std::string *error);
+    void fatal(const std::string &why);
+
+    EncoderEntry mEntry;
+    std::shared_ptr<EncIntf> mIntf;
+
+    std::mutex mLock;
+    std::condition_variable mCv;
+    std::thread mThread;
+    bool mRunning = false, mQuit = false, mError = false;
+    std::shared_ptr<Listener> mListener;
+    std::deque<std::unique_ptr<C2Work>> mQueue;
+
+    /* encoder thread only */
+    std::unique_ptr<Encoder> mEncoder;
+    std::shared_ptr<C2BlockPool> mOutputPool;
+    std::vector<uint8_t> mCsd;
+    bool mCsdSent = false;
+    uint32_t mBitrate = 0, mFps = 0, mIdrPeriod = 0;
+};
+
+} // namespace nvc2
+
+#endif
