--- /dev/null
+++ b/nvidia-prolapse/media/core/nvc2_encoder.cpp
@@ -0,0 +1,201 @@
+/* SPDX-License-Identifier: MIT */
+#include "nvc2_encoder.h"
+
+#include <cstring>
+
+#include "nv_video.h"
+
+extern "C" {
+#include "av1hdr.h"
+#include "enc.h"
+#include "hevchdr.h"
+}
+
+namespace nvc2 {
+
+namespace {
+/* constant-QP mode (BITRATE_IGNORE): I / P quantizers, AV1 as quantizer indices (the host test tool's defaults) */
+constexpr int kAv1QIndexI = 90, kAv1QIndexP = 110;
+constexpr int kQpI = 26, kQpP = 28;
+} // namespace
+
+struct Encoder::Impl {
+    Enc enc;
+    bool open = false;
+    std::vector<uint8_t> scratch;
+};
+
+uint32_t coded_level(uint32_t codec, uint32_t width, uint32_t height)
+{
+    switch (codec) {
+    case NV_VIDEO_CODEC_HEVC:
+        return (uint32_t)hevc_level_for((int)width, (int)height);
+    case NV_VIDEO_CODEC_AV1:
+        return (uint32_t)av1_level_for((int)width, (int)height);
+    default:
+        return 0;
+    }
+}
+
+Encoder::Encoder() : mImpl(new Impl()) {}
+
+Encoder::~Encoder()
+{
+    if (mImpl->open)
+        enc_close(&mImpl->enc);
+}
+
+std::unique_ptr<Encoder> Encoder::create(const EncoderConfig &c, std::string *error)
+{
+    EncConfig cfg{};
+    switch (c.codec) {
+    case NV_VIDEO_CODEC_H264:
+        cfg.codec = ENC_H264;
+        cfg.h264_profile = (int)c.h264_profile;
+        cfg.h264_level = (int)c.h264_level;
+        cfg.cabac = c.h264_profile != 66;
+        cfg.qp_i = kQpI;
+        cfg.qp_p = kQpP;
+        break;
+    case NV_VIDEO_CODEC_HEVC:
+        cfg.codec = ENC_HEVC;
+        cfg.qp_i = kQpI;
+        cfg.qp_p = kQpP;
+        break;
+    case NV_VIDEO_CODEC_AV1:
+        cfg.codec = ENC_AV1;
+        cfg.qp_i = kAv1QIndexI;
+        cfg.qp_p = kAv1QIndexP;
+        break;
+    default:
+        *error = "codec " + std::to_string(c.codec) + " has no NVENC encoder";
+        return nullptr;
+    }
+    if (!c.width || !c.height || (c.width | c.height) & 1) {
+        *error = "picture size " + std::to_string(c.width) + "x" + std::to_string(c.height) + " is not even";
+        return nullptr;
+    }
+    cfg.width = (int)c.width;
+    cfg.height = (int)c.height;
+    cfg.num_refs = 1;
+    cfg.fps = c.fps ? (int)c.fps : 30;
+    cfg.idr_period = (int)c.idr_period;
+    cfg.rc_mode = c.rc == EncoderConfig::CONST_QP ? 0 : c.rc == EncoderConfig::CBR ? 2 : 1;
+    if (cfg.rc_mode) {
+        if (!c.bitrate) {
+            *error = "rate control without a bitrate";
+            return nullptr;
+        }
+        cfg.bitrate = cfg.max_bitrate = cfg.vbv_bits = (int)c.bitrate;
+    }
+    cfg.depth = 1;
+    cfg.full_range = c.full_range;
+    cfg.colour[0] = c.primaries;
+    cfg.colour[1] = c.transfer;
+    cfg.colour[2] = c.matrix;
+
+    std::unique_ptr<Encoder> e(new Encoder());
+    if (enc_open(&e->mImpl->enc, &cfg)) {
+        const char *le = nv_video_last_error();
+        *error = std::string("NVENC session ") + std::to_string(c.width) + "x" + std::to_string(c.height) +
+                 " did not open" + (le && *le ? std::string(": ") + le : std::string());
+        return nullptr;
+    }
+    e->mImpl->open = true;
+    return e;
+}
+
+std::vector<uint8_t> Encoder::codec_config()
+{
+    Enc *e = &mImpl->enc;
+    uint8_t buf[512];
+    if (e->cfg.codec != ENC_AV1) {
+        const size_t n = enc_headers(e, buf);
+        return std::vector<uint8_t>(buf, buf + n);
+    }
+    /* av1C: marker 1, version 1; seq_profile 0, seq_level_idx_0; tier 0, 8-bit, not monochrome, 4:2:0
+     * (subsampling_x/y 1), chroma_sample_position 0; no initial_presentation_delay; then the sequence header OBU */
+    const size_t n = enc_av1_config(e, buf);
+    std::vector<uint8_t> v = {0x81, (uint8_t)(av1_level_for(e->cfg.width, e->cfg.height) & 0x1f), 0x0c, 0x00};
+    v.insert(v.end(), buf, buf + n);
+    return v;
+}
+
+void Encoder::set_rate(uint32_t bitrate, uint32_t fps)
+{
+    /* the core reads these while it builds each picture's rate control setup */
+    EncConfig &c = mImpl->enc.cfg;
+    if (c.rc_mode && bitrate)
+        c.bitrate = c.max_bitrate = c.vbv_bits = (int)bitrate;
+    if (fps)
+        c.fps = (int)fps;
+}
+
+void Encoder::set_idr_period(uint32_t pictures) { mImpl->enc.cfg.idr_period = (int)pictures; }
+
+bool Encoder::encode(const InputImage &in, bool force_key, EncodedFrame *out)
+{
+    Enc *e = &mImpl->enc;
+    const size_t w = (size_t)e->cfg.width, h = (size_t)e->cfg.height, cw = w / 2, ch = h / 2;
+    std::vector<uint8_t> &s = mImpl->scratch;
+    switch (in.layout) {
+    case InputImage::NV12:
+        enc_load_nv12(e, in.plane[0], in.stride[0], in.plane[1], in.stride[1]);
+        break;
+    case InputImage::NV21:
+    case InputImage::I420: {
+        /* to interleaved Cb Cr */
+        s.resize(w * ch);
+        for (size_t y = 0; y < ch; y++) {
+            uint8_t *d = s.data() + y * w;
+            if (in.layout == InputImage::NV21) {
+                const uint8_t *vu = in.plane[1] + y * in.stride[1];
+                for (size_t x = 0; x < cw; x++) {
+                    d[2 * x] = vu[2 * x + 1];
+                    d[2 * x + 1] = vu[2 * x];
+                }
+            } else {
+                const uint8_t *u = in.plane[1] + y * in.stride[1], *v = in.plane[2] + y * in.stride[2];
+                for (size_t x = 0; x < cw; x++) {
+                    d[2 * x] = u[x];
+                    d[2 * x + 1] = v[x];
+                }
+            }
+        }
+        enc_load_nv12(e, in.plane[0], in.stride[0], s.data(), w);
+        break;
+    }
+    case InputImage::BGRX:
+        enc_load_bgra(e, in.plane[0], in.stride[0]);
+        break;
+    case InputImage::RGBX: {
+        s.resize(w * 4 * h);
+        for (size_t y = 0; y < h; y++) {
+            const uint8_t *r = in.plane[0] + y * in.stride[0];
+            uint8_t *d = s.data() + y * w * 4;
+            for (size_t x = 0; x < w; x++) {
+                d[4 * x] = r[4 * x + 2];
+                d[4 * x + 1] = r[4 * x + 1];
+                d[4 * x + 2] = r[4 * x];
+                d[4 * x + 3] = 0xff;
+            }
+        }
+        enc_load_bgra(e, s.data(), w * 4);
+        break;
+    }
+    }
+    EncFrame fr{};
+    if (enc_encode(e, force_key, &fr)) {
+        const char *le = nv_video_last_error();
+        mError = "NVENC picture failed (ucode error " + std::to_string(fr.ucode_error) + ")" +
+                 (le && *le ? std::string(": ") + le : std::string());
+        return false;
+    }
+    out->data = fr.data;
+    out->size = fr.size;
+    out->key = fr.idr;
+    out->avg_qp = fr.avg_qp;
+    return true;
+}
+
+} // namespace nvc2
