+std::shared_ptr<C2ComponentInterface> make_encoder_interface(const EncoderEntry &e, c2_node_id_t id,
+                                                             const std::shared_ptr<C2ReflectorHelper> &reflector)
+{
+    return std::make_shared<EncIntf>(e.name, id, std::make_shared<EncIntfImpl>(reflector, e));
+}
+
+/* Runtime route, as persist.waydroid.nvidia_video_decode for the decoders (decode_routed_here):
+ * unset or "on" -> c2.nvprolapse.*.encoder are offered; "off" -> none, apps use the image's software encoders.
+ * Any other value offers none and logs why. Applies to app processes started afterwards. */
+bool encode_routed_here()
+{
+    char v[PROP_VALUE_MAX] = "";
+    __system_property_get(kEncodeRouteProp, v);
+    static std::mutex m;
+    static std::string last = "\x01";
+    std::lock_guard<std::mutex> l(m);
+    const bool on = !strcmp(v, "") || !strcmp(v, "on");
+    const bool off = !strcmp(v, "off");
+    if (last != v) {
+        last = v;
+        if (on)
+            ALOGI("%s=%s: hardware encode routed to c2.nvprolapse.*.encoder", kEncodeRouteProp, v[0] ? v : "(unset)");
+        else if (off)
+            ALOGI("%s=off: offering no encoders; apps use the image's software encoders", kEncodeRouteProp);
+        else
+            ALOGE("%s=\"%s\" is not on|off: offering no encoders until it is fixed", kEncodeRouteProp, v);
+    }
+    return on;
+}
