++/* Compute -> compute ordering with QMD dependencies (struct nvk_cs_join).
++ *
++ * NVIDIA's driver (libnvidia-eglcore.so 615.78.08) never drains the compute
++ * pipe for a compute -> compute barrier.  Every dispatch QMD gets
++ * DEPENDENT_QMD0 {DECREMENT_DEPENDENCE, PREFETCH} pointing at an empty
++ * "join" QMD J (CTA 1x1x1, grid 0) whose DEPENDENCE_COUNTER is the number of
++ * dispatches linked to it plus one.  At the first dispatch after a barrier,
++ * the host releases J (SEND_PCAS_A + SEND_SIGNALING_PCAS2_B
++ * DECREMENT_DEPENDENCE), J's DEPENDENT_QMD0 points at that dispatch, which
++ * has DEPENDENCE_COUNTER 1, and J carries the destination's cache
++ * invalidates.  Later dispatches hang off J through empty link QMDs on
++ * DEPENDENT_QMD1.  After each dispatch is launched, the QMD it waits on gets
++ * one more count and one host decrement, so it cannot complete before the
++ * dependent QMD has been loaded.  Join and link QMDs are loaded inline from
++ * the push buffer (SET_INLINE_QMD_ADDRESS + LOAD_INLINE_QMD_DATA) and their
++ * counters and links are patched in place until the command buffer ends,
++ * so every execution of the command buffer starts from the recorded state.
++ *
++ * Only the Blackwell B layout has been measured on hardware; every other
++ * class keeps WAIT_FOR_IDLE for compute barriers.
++ */
++#define NVK_CS_JOIN_MAX_CHAIN 0x24
++
++bool
++nvk_cmd_cs_join_supported(struct nvk_cmd_buffer *cmd)
++{
++   struct nvk_device *dev = nvk_cmd_buffer_device(cmd);
++   const struct nvk_physical_device *pdev = nvk_device_physical(dev);
++
++   return pdev->info.cls_compute == BLACKWELL_COMPUTE_B &&
++          !cmd->cs_join_cond_render;
++}
++
++static void
++nvk_cs_join_pcas_decrement(struct nvk_cmd_buffer *cmd,
++                           const struct nvk_cs_join_qmd *q)
++{
++   struct nv_push *p = nvk_cmd_buffer_push(cmd, 4);
++   P_MTHD(p, NVA0C0, SEND_PCAS_A);
++   P_NVA0C0_SEND_PCAS_A(p, q->addr >> 8);
++   P_IMMD(p, NVC6C0, SEND_SIGNALING_PCAS2_B,
++          PCAS_ACTION_DECREMENT_DEPENDENCE);
++}
++
++static void
++nvk_cs_join_set_counter(struct nvk_cmd_buffer *cmd,
++                        struct nvk_cs_join_qmd *q, uint32_t counter)
++{
++   const struct nvk_physical_device *pdev =
++      nvk_device_physical(nvk_cmd_buffer_device(cmd));
++   nak_qmd_set_dependence_counter(&pdev->info, q->map,
++                                  nak_qmd_size_B(&pdev->info), counter);
++   q->counter = counter;
++}
++
++/* An empty QMD built from the dispatch's own QMD, loaded inline. */
++static VkResult
++nvk_cs_join_emit_empty(struct nvk_cmd_buffer *cmd, const uint32_t *tmpl,
++                       struct nvk_cs_join_qmd *q)
++{
++   const struct nvk_physical_device *pdev =
++      nvk_device_physical(nvk_cmd_buffer_device(cmd));
++   const uint32_t qmd_size_B = nak_qmd_size_B(&pdev->info);
++   const uint32_t qmd_dw = qmd_size_B / 4;
++   assert(qmd_size_B == 384);
++
++   void *qmd_mem;
++   VkResult result = nvk_cmd_buffer_alloc_qmd(cmd, qmd_size_B, 0x100,
++                                              &q->addr, &qmd_mem);
++   if (unlikely(result != VK_SUCCESS))
++      return result;
++
++   uint32_t qmd[NAK_MAX_QMD_DWORDS];
++   memcpy(qmd, tmpl, qmd_size_B);
++   nak_qmd_set_empty_grid(&pdev->info, qmd, qmd_size_B);
++
++   /* NAK's V05 QMD is 384 bytes: load all of it, so nothing of the QMD
++    * comes from the memory behind q->addr.
++    */
++   uint32_t addr_a;
++   V_NVCEC0_SET_INLINE_QMD_ADDRESS_A(addr_a, {
++      .qmd_address_shifted8_upper = q->addr >> 40,
++      .inline_size = INLINE_SIZE_INLINE_384,
++   });
++
++   struct nv_push *p = nvk_cmd_buffer_push(cmd, 4 + qmd_dw);
++   P_MTHD(p, NVC6C0, SET_INLINE_QMD_ADDRESS_A);
++   P_INLINE_DATA(p, addr_a);
++   P_NVC6C0_SET_INLINE_QMD_ADDRESS_B(p, q->addr >> 8);
++   P_MTHD(p, NVC6C0, LOAD_INLINE_QMD_DATA(0));
++   q->map = p->end;
++   P_INLINE_ARRAY(p, qmd, qmd_dw);
++
++   q->counter = 0;
++   q->valid = true;
++   cmd->cs_join.chain++;
++
++   return VK_SUCCESS;
++}
++
++static void
++nvk_cs_join_put_invalidates(struct nvk_cmd_buffer *cmd, uint32_t *qmd)
++{
++   const struct nvk_physical_device *pdev =
++      nvk_device_physical(nvk_cmd_buffer_device(cmd));
++   struct nvk_cs_join *j = &cmd->cs_join;
++
++   nak_qmd_set_invalidates(&pdev->info, qmd, nak_qmd_size_B(&pdev->info),
++                           j->inval_tex, j->inval_data, j->inval_const);
++   j->inval_tex = j->inval_data = j->inval_const = false;
++}
++
++/* Before a dispatch QMD is written: make sure a join QMD is open (releasing
++ * the previous one if a barrier happened), link the dispatch to the work
++ * before the barrier and to the open join QMD.  `qmd` is the dispatch's QMD
++ * (not yet in memory), `qmd_addr` where it will be launched from.
++ */
++static VkResult
++nvk_cs_join_dispatch(struct nvk_cmd_buffer *cmd, uint32_t *qmd,
++                     uint64_t qmd_addr)
++{
++   const struct nvk_physical_device *pdev =
++      nvk_device_physical(nvk_cmd_buffer_device(cmd));
++   const uint32_t qmd_size_B = nak_qmd_size_B(&pdev->info);
++   struct nvk_cs_join *j = &cmd->cs_join;
++   VkResult result;
++
++   /* The chain length counts dispatches and the QMDs created for them */
++   j->chain++;
++
++   /* Join QMD (E 0xd345d0) */
++   if (j->join.valid && j->barrier) {
++      nvk_cs_join_pcas_decrement(cmd, &j->join);
++      j->prev = j->join;
++      j->link.valid = false;
++      j->join.valid = false;
++      j->linked = 0;
++      j->barrier = false;
++   }
++   if (j->join.valid) {
++      nvk_cs_join_set_counter(cmd, &j->join, j->linked + 2);
++   } else {
++      result = nvk_cs_join_emit_empty(cmd, qmd, &j->join);
++      if (unlikely(result != VK_SUCCESS))
++         return result;
++      nvk_cs_join_set_counter(cmd, &j->join, j->linked + 2);
++   }
++
++   /* Link to the work before the last barrier (E 0xd33fb0) */
++   struct nvk_cs_join_qmd *holder = j->link.valid ? &j->link :
++                                    j->prev.valid ? &j->prev : NULL;
++   if (holder == &j->prev &&
++       !nak_qmd_dependent_qmd_enabled(&pdev->info, j->prev.map,
++                                      qmd_size_B, 0)) {
++      nak_qmd_set_dependent_qmd(&pdev->info, j->prev.map, qmd_size_B,
++                                0, qmd_addr);
++      nvk_cs_join_put_invalidates(cmd, j->prev.map);
++   } else if (holder != NULL) {
++      struct nvk_cs_join_qmd link;
++      result = nvk_cs_join_emit_empty(cmd, qmd, &link);
++      if (unlikely(result != VK_SUCCESS))
++         return result;
++      nak_qmd_set_dependent_qmd(&pdev->info, link.map, qmd_size_B,
++                                0, qmd_addr);
++      nvk_cs_join_set_counter(cmd, &link, 1);
++      nak_qmd_set_dependent_qmd(&pdev->info, holder->map, qmd_size_B,
++                                1, link.addr);
++      nvk_cs_join_set_counter(cmd, holder, holder->counter + 1);
++      nvk_cs_join_pcas_decrement(cmd, holder);
++      nvk_cs_join_put_invalidates(cmd, holder->map);
++      j->link = link;
++   }
++
++   /* The dispatch itself (E 0xd35a90): wait for one decrement if anything
++    * precedes it, decrement the open join QMD when done.
++    */
++   const bool waits = j->link.valid || j->prev.valid;
++   nak_qmd_set_dependence_counter(&pdev->info, qmd, qmd_size_B, waits);
++   if (!waits)
++      nvk_cs_join_put_invalidates(cmd, qmd);
++   nak_qmd_set_dependent_qmd(&pdev->info, qmd, qmd_size_B, 0,
++                             j->join.addr);
++
++   return VK_SUCCESS;
++}
++
++/* After the dispatch QMD was launched (E 0xd36060) */
++static void
++nvk_cs_join_launched(struct nvk_cmd_buffer *cmd)
++{
++   struct nvk_cs_join *j = &cmd->cs_join;
++   struct nvk_cs_join_qmd *holder = j->link.valid ? &j->link :
++                                    j->prev.valid ? &j->prev : NULL;
++   if (holder != NULL) {
++      nvk_cs_join_set_counter(cmd, holder, holder->counter + 1);
++      nvk_cs_join_pcas_decrement(cmd, holder);
++   }
++   j->linked++;
++}
++
++/* Release the open join QMD and forget the chain.  A barrier still waiting
++ * for its dispatch is drained with methods.  Called before anything that
++ * waits for idle, before secondaries and at the end of the command buffer.
++ */
++void
++nvk_cmd_cs_join_close(struct nvk_cmd_buffer *cmd)
++{
++   struct nvk_cs_join *j = &cmd->cs_join;
++
++   /* Dispatches of this chain no later chain links to */
++   if (j->join.valid || j->prev.valid)
++      cmd->cs_join_covered = false;
++
++   if (j->join.valid)
++      nvk_cs_join_pcas_decrement(cmd, &j->join);
++
++   if (j->barrier) {
++      struct nv_push *p = nvk_cmd_buffer_push(cmd, 6);
++      P_IMMD(p, NVA0C0, WAIT_FOR_IDLE, 0);
++      if (j->inval_tex) {
++         P_IMMD(p, NVA0C0, INVALIDATE_TEXTURE_DATA_CACHE_NO_WFI, {
++            .lines = LINES_ALL,
++         });
++      }
++      if (j->inval_data || j->inval_const) {
++         P_IMMD(p, NVA0C0, INVALIDATE_SHADER_CACHES_NO_WFI, {
++            .global_data = j->inval_data,
++            .constant = j->inval_const,
++         });
++      }
++      cmd->cs_join_covered = true;
++   }
++
++   memset(j, 0, sizeof(*j));
++}
