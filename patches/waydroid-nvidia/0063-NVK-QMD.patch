++       (dep->dependencyFlags & VK_DEPENDENCY_ASYMMETRIC_EVENT_BIT_KHR))
++      return false;
++
++   struct nvk_cs_join t = *j;
++   bool any = false;
++
++   for (uint32_t i = 0; i < dep->memoryBarrierCount; i++) {
++      const VkMemoryBarrier2 *bar = &dep->pMemoryBarriers[i];
++      if (!nvk_cs_join_add(&t, bar->srcStageMask, bar->srcAccessMask,
++                           bar->dstStageMask, bar->dstAccessMask))
++         return false;
++      any = true;
++   }
++
++   for (uint32_t i = 0; i < dep->bufferMemoryBarrierCount; i++) {
++      const VkBufferMemoryBarrier2 *bar = &dep->pBufferMemoryBarriers[i];
++      if (bar->srcQueueFamilyIndex != bar->dstQueueFamilyIndex ||
++          !nvk_cs_join_add(&t, bar->srcStageMask, bar->srcAccessMask,
++                           bar->dstStageMask, bar->dstAccessMask))
++         return false;
++      any = true;
++   }
++
++   for (uint32_t i = 0; i < dep->imageMemoryBarrierCount; i++) {
