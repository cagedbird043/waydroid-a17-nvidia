diff --git a/nvidia-prolapse/driver-source/native/mesa/nak-qmd-dependency.patch b/nvidia-prolapse/driver-source/native/mesa/nak-qmd-dependency.patch
new file mode 100644
index 0000000..198a839
--- /dev/null
+++ b/nvidia-prolapse/driver-source/native/mesa/nak-qmd-dependency.patch
@@ -0,0 +1,222 @@
+nak: QMD dependency field setters for Blackwell B
+
+NVIDIA's driver (libnvidia-eglcore.so 615.78.08) orders compute work with QMD dependencies:
+DEPENDENCE_COUNTER, DEPENDENT_QMD{0,1} {ENABLE, ACTION = DECREMENT_DEPENDENCE, PREFETCH,
+POINTER} and the per-QMD INVALIDATE_{TEXTURE_DATA,SHADER_DATA,SHADER_CONSTANT}_CACHE bits
+(writers E 0xd32f60, E 0xd33340, E 0xd334a0, E 0xd33fb0), plus empty QMDs with CTA 1x1x1 and
+grid 0 (E 0xd34709).  Expose setters for those fields (clcec0qmd.h layout) to NVK.  Only the
+Blackwell B layout is supported; any other class aborts with a named reason.
+
+diff --git a/src/nouveau/compiler/nak.h b/src/nouveau/compiler/nak.h
+index 54a31230f642..fc5c1ad65f86 100644
+--- a/src/nouveau/compiler/nak.h
++++ b/src/nouveau/compiler/nak.h
+@@ -334,6 +334,23 @@ struct nak_qmd_cbuf_desc_layout {
+ struct nak_qmd_cbuf_desc_layout
+ nak_get_qmd_cbuf_desc_layout(const struct nv_device_info *dev, uint8_t idx);
+ 
++/* QMD dependency fields (Blackwell B compute only; other classes abort). */
++void nak_qmd_set_empty_grid(const struct nv_device_info *dev,
++                            void *qmd, size_t qmd_size);
++void nak_qmd_set_dependence_counter(const struct nv_device_info *dev,
++                                    void *qmd, size_t qmd_size,
++                                    uint32_t counter);
++void nak_qmd_set_dependent_qmd(const struct nv_device_info *dev,
++                               void *qmd, size_t qmd_size,
++                               uint32_t slot, uint64_t dep_addr);
++bool nak_qmd_dependent_qmd_enabled(const struct nv_device_info *dev,
++                                   void *qmd, size_t qmd_size,
++                                   uint32_t slot);
++void nak_qmd_set_invalidates(const struct nv_device_info *dev,
++                             void *qmd, size_t qmd_size,
++                             bool texture_data, bool shader_data,
++                             bool shader_constant);
++
+ #ifdef __cplusplus
+ }
+ #endif
+diff --git a/src/nouveau/compiler/nak/qmd.rs b/src/nouveau/compiler/nak/qmd.rs
+index 6b54e7153b94..35f9c2e29103 100644
+--- a/src/nouveau/compiler/nak/qmd.rs
++++ b/src/nouveau/compiler/nak/qmd.rs
+@@ -625,6 +625,16 @@ mod qmd_5_0 {
+     }
+ 
+     impl Qmd5_0 {
++        pub fn from_words(words: &[u32]) -> Self {
++            let mut qmd = [0; 96];
++            qmd.copy_from_slice(words);
++            Self { qmd }
++        }
++
++        pub fn qmd_words(&self) -> [u32; 96] {
++            self.qmd
++        }
++
+         /// L1 membar when each CTA completes, so the grid's stores are
+         /// visible in L2 once the CWD retires it.  NVIDIA's own driver
+         /// (libnvidia-eglcore.so 615.78.08) has CWD_MEMBAR_TYPE = L1_MEMBAR
+@@ -634,6 +644,65 @@ mod qmd_5_0 {
+             set_enum!(bv, clcdc0, QMDV05_00, CWD_MEMBAR_TYPE, L1_MEMBAR);
+         }
+     }
++
++    /// Dependency fields of a Blackwell B (cec0) QMD, as laid out in
++    /// clcec0qmd.h.  NVIDIA's driver (libnvidia-eglcore.so 615.78.08,
++    /// E 0xd32f60 / E 0xd33340 / E 0xd334a0 / E 0xd33fb0) writes exactly
++    /// these bits: DEPENDENCE_COUNTER, DEPENDENT_QMD{0,1} enable / action /
++    /// prefetch / pointer and the per-QMD cache invalidates.
++    pub mod cec0 {
++        use crate::qmd::*;
++        use nvidia_headers::classes::clcec0::qmd::*;
++
++        pub fn set_dependence_counter(qmd: &mut [u32], counter: u16) {
++            let mut bv = QMDBitView::new(qmd);
++            bv.set_field(QMDV05_00_DEPENDENCE_COUNTER, counter);
++        }
++
++        pub fn set_dependent_qmd(qmd: &mut [u32], slot: usize, addr: u64) {
++            assert!(addr % 256 == 0);
++            let mut bv = QMDBitView::new(qmd);
++            bv.set_field(
++                QMDV05_00_DEPENDENT_QMD_ENABLE(slot),
++                QMDV05_00_DEPENDENT_QMD_ENABLE_TRUE,
++            );
++            bv.set_field(
++                QMDV05_00_DEPENDENT_QMD_ACTION(slot),
++                QMDV05_00_DEPENDENT_QMD_ACTION_QMD_DECREMENT_DEPENDENCE,
++            );
++            bv.set_field(
++                QMDV05_00_DEPENDENT_QMD_PREFETCH(slot),
++                QMDV05_00_DEPENDENT_QMD_PREFETCH_TRUE,
++            );
++            bv.set_field(
++                QMDV05_00_DEPENDENT_QMD_POINTER(slot),
++                u32::try_from(addr >> 8).unwrap(),
++            );
++        }
++
++        pub fn dependent_qmd_enabled(qmd: &mut [u32], slot: usize) -> bool {
++            let bv = QMDBitView::new(qmd);
++            bv.get_bit_range_u64(QMDV05_00_DEPENDENT_QMD_ENABLE(slot)) != 0
++        }
++
++        pub fn set_invalidates(
++            qmd: &mut [u32],
++            texture_data: bool,
++            shader_data: bool,
++            shader_constant: bool,
++        ) {
++            let mut bv = QMDBitView::new(qmd);
++            if texture_data {
++                bv.set_field(QMDV05_00_INVALIDATE_TEXTURE_DATA_CACHE, 1_u32);
++            }
++            if shader_data {
++                bv.set_field(QMDV05_00_INVALIDATE_SHADER_DATA_CACHE, 1_u32);
++            }
++            if shader_constant {
++                bv.set_field(QMDV05_00_INVALIDATE_SHADER_CONSTANT_CACHE, 1_u32);
++            }
++        }
++    }
+ }
+ use qmd_5_0::Qmd5_0;
+ 
+@@ -794,3 +863,97 @@ pub extern "C" fn nak_get_qmd_cbuf_desc_layout(
+         panic!("Unsupported shader model");
+     }
+ }
++
++/// The QMD words of `qmd` for a class with QMD dependency support (only
++/// Blackwell B for now: the only class whose dependency layout has been
++/// measured on hardware).
++fn dep_qmd<'a>(
++    dev: &nv_device_info,
++    qmd: *mut ::std::os::raw::c_void,
++    qmd_size: usize,
++) -> &'a mut [u32] {
++    assert!(
++        dev.cls_compute == clcec0::BLACKWELL_COMPUTE_B,
++        "QMD dependencies are only supported on Blackwell B compute"
++    );
++    assert!(!qmd.is_null());
++    assert!(qmd_size == size_of::<Qmd5_0>());
++    unsafe { std::slice::from_raw_parts_mut(qmd as *mut u32, qmd_size / 4) }
++}
++
++#[no_mangle]
++pub extern "C" fn nak_qmd_set_empty_grid(
++    dev: &nv_device_info,
++    qmd: *mut ::std::os::raw::c_void,
++    qmd_size: usize,
++) {
++    // Keep everything of the template and only set CTA 1x1x1 / grid 0,
++    // as the proprietary driver builds its empty QMDs (E 0xd34709).
++    let words = dep_qmd(dev, qmd, qmd_size);
++    let mut q = Qmd5_0::from_words(words);
++    q.set_global_size(0, 0, 0);
++    q.set_local_size(1, 1, 1);
++    words.copy_from_slice(&q.qmd_words());
++}
++
++#[no_mangle]
++pub extern "C" fn nak_qmd_set_dependence_counter(
++    dev: &nv_device_info,
++    qmd: *mut ::std::os::raw::c_void,
++    qmd_size: usize,
++    counter: u32,
++) {
++    let counter = u16::try_from(counter)
++        .expect("QMD dependence counter exceeds the 16-bit field");
++    qmd_5_0::cec0::set_dependence_counter(
++        dep_qmd(dev, qmd, qmd_size),
++        counter,
++    );
++}
++
++#[no_mangle]
++pub extern "C" fn nak_qmd_set_dependent_qmd(
++    dev: &nv_device_info,
++    qmd: *mut ::std::os::raw::c_void,
++    qmd_size: usize,
++    slot: u32,
++    dep_addr: u64,
++) {
++    assert!(slot < 2);
++    qmd_5_0::cec0::set_dependent_qmd(
++        dep_qmd(dev, qmd, qmd_size),
++        slot as usize,
++        dep_addr,
++    );
++}
++
++#[no_mangle]
++pub extern "C" fn nak_qmd_dependent_qmd_enabled(
++    dev: &nv_device_info,
++    qmd: *mut ::std::os::raw::c_void,
++    qmd_size: usize,
++    slot: u32,
++) -> bool {
++    assert!(slot < 2);
++    qmd_5_0::cec0::dependent_qmd_enabled(
++        dep_qmd(dev, qmd, qmd_size),
++        slot as usize,
++    )
++}
++
++#[no_mangle]
++pub extern "C" fn nak_qmd_set_invalidates(
++    dev: &nv_device_info,
++    qmd: *mut ::std::os::raw::c_void,
++    qmd_size: usize,
++    texture_data: bool,
++    shader_data: bool,
++    shader_constant: bool,
++) {
++    qmd_5_0::cec0::set_invalidates(
++        dep_qmd(dev, qmd, qmd_size),
++        texture_data,
++        shader_data,
++        shader_constant,
++    );
++}
diff --git a/nvidia-prolapse/driver-source/native/mesa/nvk-cs-join-qmd.patch b/nvidia-prolapse/driver-source/native/mesa/nvk-cs-join-qmd.patch
new file mode 100644
index 0000000..3d5c608
--- /dev/null
+++ b/nvidia-prolapse/driver-source/native/mesa/nvk-cs-join-qmd.patch
@@ -0,0 +1,758 @@
+nvk: compute -> compute barriers through QMD dependencies on Blackwell B
+
+NVIDIA's driver (libnvidia-eglcore.so 615.78.08: dispatch hook E 0xd35a90, join QMD
+E 0xd345d0, consumer link E 0xd33fb0, launch kick E 0xd36060) never waits for idle for a
+compute -> compute barrier.  Every dispatch decrements an empty "join" QMD through
+DEPENDENT_QMD0; at the first dispatch after a barrier the host releases the join QMD
+(SEND_SIGNALING_PCAS2_B DECREMENT_DEPENDENCE), which then starts that dispatch (DEPENDENCE_COUNTER
+1) with the destination's cache invalidates; further dispatches hang off it through empty link
+QMDs on DEPENDENT_QMD1, and each launch is followed by one more count and one host decrement on
+the QMD it waits on.  Join and link QMDs are loaded inline from the push buffer and patched in
+place until the command buffer ends, so every execution starts from the recorded counters.
+
+Do the same for barriers whose source and destination are only compute shaders (shader reads and
+writes) on Blackwell B compute.  The chain never crosses a command buffer, a secondary, an
+internal dispatch, an indirect dispatch or conditional rendering; it is released before anything
+that waits for idle, and is limited to 0x24 QMDs before the method path is used again, as the
+proprietary driver limits it.  Every other barrier and every other class keep WAIT_FOR_IDLE.
+
+diff --git a/src/nouveau/vulkan/nvk_cmd_buffer.c b/src/nouveau/vulkan/nvk_cmd_buffer.c
+index 07738ae55e00..0903caeffb4f 100644
+--- a/src/nouveau/vulkan/nvk_cmd_buffer.c
++++ b/src/nouveau/vulkan/nvk_cmd_buffer.c
+@@ -130,6 +130,9 @@ nvk_reset_cmd_buffer(struct vk_command_buffer *vk_cmd_buffer,
+    cmd->push_mem_limit = NULL;
+    cmd->push = (struct nv_push) {0};
+    cmd->cond_render_mem = NULL;
++   memset(&cmd->cs_join, 0, sizeof(cmd->cs_join));
++   cmd->cs_join_cond_render = false;
++   cmd->cs_join_covered = false;
+ 
+    util_dynarray_clear(&cmd->pushes);
+    util_dynarray_clear(&cmd->copy_memory_indirect_temps);
+@@ -363,10 +366,17 @@ nvk_BeginCommandBuffer(VkCommandBuffer commandBuffer,
+ 
+    nvk_reset_cmd_buffer(&cmd->vk, 0);
+ 
+-   if (cmd->vk.level == VK_COMMAND_BUFFER_LEVEL_SECONDARY)
++   if (cmd->vk.level == VK_COMMAND_BUFFER_LEVEL_SECONDARY) {
+       cmd->state.inherited_pipeline_statistics =
+          pBeginInfo->pInheritanceInfo->pipelineStatistics;
+ 
++      const VkCommandBufferInheritanceConditionalRenderingInfoEXT *cond =
++         vk_find_struct_const(pBeginInfo->pInheritanceInfo->pNext,
++                              COMMAND_BUFFER_INHERITANCE_CONDITIONAL_RENDERING_INFO_EXT);
++      cmd->cs_join_cond_render = cond != NULL &&
++                                 cond->conditionalRenderingEnable;
++   }
++
+    /* Start with a nop so we have at least something to submit */
+    struct nv_push *p = nvk_cmd_buffer_push(cmd, 2);
+    P_MTHD(p, NV90B5, NOP);
+@@ -393,6 +403,7 @@ nvk_EndCommandBuffer(VkCommandBuffer commandBuffer)
+ {
+    VK_FROM_HANDLE(nvk_cmd_buffer, cmd, commandBuffer);
+ 
++   nvk_cmd_cs_join_close(cmd);
+    nvk_cmd_buffer_flush_push(cmd, false);
+ 
+    /* We only need to flush the memory objects we own because, if there are
+@@ -415,6 +426,8 @@ nvk_CmdExecuteCommands(VkCommandBuffer commandBuffer,
+    if (commandBufferCount == 0)
+       return;
+ 
++   nvk_cmd_cs_join_close(cmd);
++   cmd->cs_join_covered = false;
+    nvk_cmd_buffer_flush_push(cmd, false);
+ 
+    for (uint32_t i = 0; i < commandBufferCount; i++) {
+@@ -716,6 +729,11 @@ nvk_cmd_flush_wait_dep(struct nvk_cmd_buffer *cmd,
+    enum nvk_barrier barriers = 0;
+    struct nvk_pixel_dep pixel_dep = { .dst_pixel_reads = true };
+ 
++   /* The method path below may wait for idle: no join QMD may be left
++    * waiting for a host release.
++    */
++   nvk_cmd_cs_join_close(cmd);
++
+    /* For asymmetric, we don't know what the access flags will be yet.
+     * Handle this by setting access to everything.
+     */
+@@ -784,6 +802,10 @@ nvk_cmd_flush_wait_dep(struct nvk_cmd_buffer *cmd,
+             .flush_data = FLUSH_DATA_TRUE,
+          });
+       }
++      /* Compute work before a 3D-subchannel drain was already idled by the
++       * switch to 3D (see below).
++       */
++      cmd->cs_join_covered = true;
+    } else if ((barriers & NVK_BARRIER_WFI) && wait) {
+       /* If this comes from a vkCmdSetEvent, we don't need to wait
+        *
+@@ -814,11 +836,13 @@ nvk_cmd_flush_wait_dep(struct nvk_cmd_buffer *cmd,
+          }
+          struct nv_push *p = nvk_cmd_buffer_push(cmd, 2);
+          P_IMMD(p, NV9097, WAIT_FOR_IDLE, 0);
++         cmd->cs_join_covered = true;
+          break;
+       }
+       case SUBC_NV90C0: {
+          struct nv_push *p = nvk_cmd_buffer_push(cmd, 2);
+          P_IMMD(p, NVA0C0, WAIT_FOR_IDLE, 0);
++         cmd->cs_join_covered = true;
+          break;
+       }
+       default:
+@@ -1037,6 +1061,9 @@ nvk_CmdPipelineBarrier2(VkCommandBuffer commandBuffer,
+ {
+    VK_FROM_HANDLE(nvk_cmd_buffer, cmd, commandBuffer);
+ 
++   if (nvk_cmd_cs_join_barrier(cmd, pDependencyInfo))
++      return;
++
+    nvk_cmd_flush_wait_dep(cmd, pDependencyInfo, true);
+    nvk_cmd_image_layout_transition(cmd, pDependencyInfo);
+    nvk_cmd_invalidate_deps(cmd, 1, pDependencyInfo);
+diff --git a/src/nouveau/vulkan/nvk_cmd_buffer.h b/src/nouveau/vulkan/nvk_cmd_buffer.h
+index e844b0ff4df6..ea751804a427 100644
+--- a/src/nouveau/vulkan/nvk_cmd_buffer.h
++++ b/src/nouveau/vulkan/nvk_cmd_buffer.h
+@@ -224,6 +224,41 @@ struct nvk_compute_state {
+    bool active_compute_invocations_query;
+ };
+ 
++/* One QMD of the compute dependency chain: an empty QMD loaded inline from
++ * the push buffer, patched in place until the command buffer ends.
++ */
++struct nvk_cs_join_qmd {
++   uint64_t addr;
++   uint32_t *map;
++   uint32_t counter;
++   bool valid;
++};
++
++/* Compute -> compute ordering through QMD dependencies instead of
++ * WAIT_FOR_IDLE, as NVIDIA's driver does it (libnvidia-eglcore.so
++ * 615.78.08: per-dispatch hook E 0xd35a90, join QMD E 0xd345d0, consumer
++ * link E 0xd33fb0, launch kick E 0xd36060).  Every dispatch decrements the
++ * open join QMD when it completes; a barrier makes the next dispatch wait
++ * for that join QMD.  The state never crosses a command buffer boundary.
++ */
++struct nvk_cs_join {
++   /* The open join QMD every dispatch since the last barrier decrements */
++   struct nvk_cs_join_qmd join;
++   /* The join QMD of the last barrier and the newest empty link QMD hung
++    * below it: the next dispatch waits on the newest of the two.
++    */
++   struct nvk_cs_join_qmd prev;
++   struct nvk_cs_join_qmd link;
++   /* Dispatches linked to the open join QMD */
++   uint32_t linked;
++   /* Dispatches and QMDs since the chain was last drained with methods */
++   uint32_t chain;
++   /* A barrier is pending: the next dispatch releases the join QMD */
++   bool barrier;
++   /* Invalidates the pending barrier's destination needs */
++   bool inval_tex, inval_data, inval_const;
++};
++
+ struct nvk_cmd_push {
+    void *map;
+    uint64_t addr;
+@@ -235,6 +270,19 @@ struct nvk_cmd_push {
+ struct nvk_cmd_buffer {
+    struct vk_command_buffer vk;
+ 
++   struct nvk_cs_join cs_join;
++   /* Conditional rendering may skip dispatches: their dependency decrements
++    * would never arrive, so no dispatch joins the chain while it can be on.
++    */
++   bool cs_join_cond_render;
++   /* All compute work recorded so far is either complete when the open join
++    * QMD chain starts or part of the chain: only then can a barrier wait on
++    * the chain alone.  Set by a compute-subchannel drain, cleared by compute
++    * work that is not linked and at the start of the command buffer (an
++    * earlier command buffer's dispatches may still be running).
++    */
++   bool cs_join_covered;
++
+    struct nvk_cmd_state {
+       uint64_t descriptor_buffers[NVK_MAX_SETS];
+       struct nvk_graphics_state gfx;
+@@ -444,6 +492,11 @@ void nvk_cmd_flush_gfx_dynamic_state(struct nvk_cmd_buffer *cmd);
+ void nvk_cmd_flush_gfx_shaders(struct nvk_cmd_buffer *cmd);
+ void nvk_cmd_flush_gfx_cbufs(struct nvk_cmd_buffer *cmd);
+ 
++bool nvk_cmd_cs_join_supported(struct nvk_cmd_buffer *cmd);
++bool nvk_cmd_cs_join_barrier(struct nvk_cmd_buffer *cmd,
++                             const VkDependencyInfo *dep);
++void nvk_cmd_cs_join_close(struct nvk_cmd_buffer *cmd);
++
+ void nvk_cmd_dispatch_shader(struct nvk_cmd_buffer *cmd,
+                              struct nvk_shader *shader,
+                              const void *push_data, size_t push_size,
+diff --git a/src/nouveau/vulkan/nvk_cmd_dispatch.c b/src/nouveau/vulkan/nvk_cmd_dispatch.c
+index 4c596b785414..75d6e7a54f8a 100644
+--- a/src/nouveau/vulkan/nvk_cmd_dispatch.c
++++ b/src/nouveau/vulkan/nvk_cmd_dispatch.c
+@@ -10,6 +10,8 @@
+ #include "nvk_physical_device.h"
+ #include "nvk_shader.h"
+ 
++#include "vk_synchronization.h"
++
+ #include "cl906f.h"
+ #include "cla0b5.h"
