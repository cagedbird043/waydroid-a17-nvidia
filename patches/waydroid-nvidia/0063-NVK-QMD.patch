++static bool
++nvk_cs_join_add(struct nvk_cs_join *j,
++                VkPipelineStageFlags2 src_stages, VkAccessFlags2 src_access,
++                VkPipelineStageFlags2 dst_stages, VkAccessFlags2 dst_access)
++{
++   if (!nvk_cs_join_stages_ok(src_stages, dst_stages))
++      return false;
++
++   src_access = vk_filter_src_access_flags2(
++      vk_expand_src_stage_flags2(src_stages), src_access);
++   if (src_access & ~(VK_ACCESS_2_SHADER_WRITE_BIT |
++                      VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT |
++                      VK_ACCESS_2_MEMORY_WRITE_BIT |
++                      VK_ACCESS_2_SHADER_READ_BIT |
++                      VK_ACCESS_2_SHADER_STORAGE_READ_BIT |
++                      VK_ACCESS_2_SHADER_SAMPLED_READ_BIT |
++                      VK_ACCESS_2_UNIFORM_READ_BIT |
++                      VK_ACCESS_2_MEMORY_READ_BIT))
++      return false;
++
++   dst_access = vk_filter_dst_access_flags2(
++      vk_expand_dst_stage_flags2(dst_stages), dst_access);
++   if (dst_access & ~(VK_ACCESS_2_SHADER_READ_BIT |
++                      VK_ACCESS_2_SHADER_STORAGE_READ_BIT |
++                      VK_ACCESS_2_SHADER_SAMPLED_READ_BIT |
++                      VK_ACCESS_2_UNIFORM_READ_BIT |
++                      VK_ACCESS_2_SHADER_WRITE_BIT |
++                      VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT))
++      return false;
++
++   /* The proprietary driver's mapping: shader / storage / sampled reads
++    * invalidate texture and shader data, uniform reads the constant cache.
++    * NAK may also read uniform buffers through global loads, so they also
++    * invalidate shader data, as NVK's own barrier does.
++    */
++   if (dst_access & (VK_ACCESS_2_SHADER_READ_BIT |
++                     VK_ACCESS_2_SHADER_STORAGE_READ_BIT |
++                     VK_ACCESS_2_SHADER_SAMPLED_READ_BIT)) {
++      j->inval_tex = true;
++      j->inval_data = true;
++   }
++   if (dst_access & VK_ACCESS_2_UNIFORM_READ_BIT) {
++      j->inval_data = true;
++      j->inval_const = true;
++   }
++
++   return true;
++}
