 }
+
+/* The graphics producer owns the exclusive buffer initially. Compute copies
+ * its first half to the second, then graphics copies that half to readback.
+ * Distinct initial halves make a missing compute copy observable. */
+static void ownership_roundtrip(struct Worker *graphics, struct Worker *compute,
+                                struct Worker *readback, uint32_t gf, uint32_t cf,
+                                uint32_t pattern) {
+ struct Api *a = graphics->api;
+ VkDevice device = graphics->device;
+ VkSemaphore sem[2];
+ VkSemaphoreCreateInfo sci = {.sType = VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO};
+ for (unsigned i = 0; i < 2; i++) CHECK(a->CreateSemaphore(device, &sci, NULL, &sem[i]));
+ struct Worker *recorders[3] = {graphics, compute, readback};
+ VkBufferMemoryBarrier release = {.sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER,
+  .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT, .srcQueueFamilyIndex = gf,
+  .dstQueueFamilyIndex = cf, .buffer = graphics->buffer, .offset = 0, .size = 8192};
+ VkBufferCopy copy = {.srcOffset = 0, .dstOffset = 4096, .size = 4096};
+ VkPipelineStageFlags wait_stage = VK_PIPELINE_STAGE_ALL_COMMANDS_BIT;
+ for (unsigned phase = 0; phase < 3; phase++) {
+  struct Worker *w = recorders[phase];
+  CHECK(a->ResetCommandPool(device, w->pool, 0));
+  VkCommandBufferBeginInfo begin = {.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+  CHECK(a->BeginCommandBuffer(w->command, &begin));
+  if (phase == 0) {
+   a->CmdFillBuffer(w->command, graphics->buffer, 0, 4096, pattern);
+   a->CmdFillBuffer(w->command, graphics->buffer, 4096, 4096, ~pattern);
+   a->CmdPipelineBarrier(w->command, VK_PIPELINE_STAGE_TRANSFER_BIT,
+    VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, 0, 0, NULL, 1, &release, 0, NULL);
+  } else {
+   VkBufferMemoryBarrier acquire = release;
+   acquire.srcAccessMask = 0;
+   acquire.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT;
+   a->CmdPipelineBarrier(w->command, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+    VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, NULL, 1, &acquire, 0, NULL);
+   if (phase == 1) {
+    a->CmdCopyBuffer(w->command, graphics->buffer, graphics->buffer, 1, &copy);
+    release.srcQueueFamilyIndex = cf;
+    release.dstQueueFamilyIndex = gf;
+    release.srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT;
+    a->CmdPipelineBarrier(w->command, VK_PIPELINE_STAGE_TRANSFER_BIT,
+     VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, 0, 0, NULL, 1, &release, 0, NULL);
+   } else {
+    copy.srcOffset = 4096;
+    copy.dstOffset = 0;
+    a->CmdCopyBuffer(w->command, graphics->buffer, readback->buffer, 1, &copy);
+    VkMemoryBarrier host = {.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+     .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT, .dstAccessMask = VK_ACCESS_HOST_READ_BIT};
+    a->CmdPipelineBarrier(w->command, VK_PIPELINE_STAGE_TRANSFER_BIT,
+     VK_PIPELINE_STAGE_HOST_BIT, 0, 1, &host, 0, NULL, 0, NULL);
+   }
+  }
+  CHECK(a->EndCommandBuffer(w->command));
+  VkSubmitInfo submit = {.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+   .waitSemaphoreCount = phase != 0, .pWaitSemaphores = phase ? &sem[phase - 1] : NULL,
+   .pWaitDstStageMask = &wait_stage, .commandBufferCount = 1, .pCommandBuffers = &w->command,
+   .signalSemaphoreCount = phase != 2, .pSignalSemaphores = phase < 2 ? &sem[phase] : NULL};
+  CHECK(a->QueueSubmit(phase == 1 ? compute->queue : graphics->queue, 1, &submit,
+   phase == 2 ? readback->fence : VK_NULL_HANDLE));
+ }
+ CHECK(a->WaitForFences(device, 1, &readback->fence, VK_TRUE, 10000000000ull));
+ for (unsigned i = 0; i < 1024; i++) REQUIRE(readback->mapped[i] == pattern);
+ CHECK(a->ResetFences(device, 1, &readback->fence));
+ for (unsigned i = 0; i < 2; i++) a->DestroySemaphore(device, sem[i], NULL);
+ printf("ownership_roundtrip=%u->%u->%u PASS\n", gf, cf, gf);
+}
 int main(int argc, char **argv) {
  REQUIRE(argc == 2 && argv[1][0] == '/');
  void *lib = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);
@@ -155,7 +220,8 @@ int main(int argc, char **argv) {
   REQUIRE(w->queue);
   for (unsigned j = 0; j < i; j++) REQUIRE(w->queue != workers[j].queue);
   VkBufferCreateInfo bci = {.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
-   .size = 4096, .usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT};
+   .size = 8192, .usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+   .sharingMode = VK_SHARING_MODE_EXCLUSIVE};
   CHECK(api.CreateBuffer(device, &bci, NULL, &w->buffer));
   VkMemoryRequirements req;
   api.GetBufferMemoryRequirements(device, w->buffer, &req);
@@ -179,6 +245,8 @@ int main(int argc, char **argv) {
  }
  for (unsigned i = 0; i < total; i++) REQUIRE(!pthread_create(&threads[i], NULL, run, &workers[i]));
  for (unsigned i = 0; i < total; i++) REQUIRE(!pthread_join(threads[i], NULL));
+ if (ng == 2 && nc) ownership_roundtrip(&workers[0], &workers[ng], &workers[1],
+  family, compute, 0x17a00000u | (repeat << 8) | c);
  for (unsigned i = 0; i < total; i++) {
   struct Worker *w = &workers[i];
   api.DestroyFence(device, w->fence, NULL);
