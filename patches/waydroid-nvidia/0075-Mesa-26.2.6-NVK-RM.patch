 nvidia-prolapse/driver-source/native/mesa/README.md       | 8 ++++----
 nvidia-prolapse/driver-source/native/mesa/build.py        | 2 +-
 .../driver-source/native/mesa/gallium-nvrm/nvrm_screen.c  | 2 +-
 3 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/nvidia-prolapse/driver-source/native/mesa/README.md b/nvidia-prolapse/driver-source/native/mesa/README.md
index 0b733b6..48218bd 100644
--- a/nvidia-prolapse/driver-source/native/mesa/README.md
+++ b/nvidia-prolapse/driver-source/native/mesa/README.md
@@ -6,8 +6,8 @@ frontend, graphics command generation, image layouts, SPIR-V/NIR/NAK compiler,
 and Android HAL entrypoints. The `nvkmd` adapter supplies allocation, GPU virtual
 address binding, channels, execution and synchronization through `nv_rm.h`.
 
-The source pin is **ddaf85e353442d9d7f192fdcf1823e652e3f2ee3** (tag mesa-26.2.5,
-2026-10-14; moved from 0b97dcdd = mesa-25.2.0 on 2026-10-16). The isolated
+The source pin is **8e87a503ebd91408c88596d1b9eeb5f4c0b2088d** (tag mesa-26.2.6,
+2026-10-28). The isolated
 `build/mesa-rm-source` worktree leaves the compiler-only worktree and original
 Mesa checkout unchanged. This is separate from the earlier narrow experimental
 Vulkan frontend: Rust builds use `--no-default-features` so it does not export
@@ -56,8 +56,8 @@ NVK's internal OpenCL helpers; application SPIR-V uses source-built NAK at
 runtime. The Android driver does not depend on LLVM, libclc, NVRTC, CUDA, or
 proprietary NVIDIA userspace.
 
-`build-compat.patch` adapts the host glibc C11 thread definitions (26.2.5 already
-handles LLVM 22/23 in clc_helpers.cpp). All code generation remains in the pinned source.
+`build-compat.patch` adapts the host glibc C11 thread definitions; Mesa 26.2.6
+handles LLVM 22/23 in clc_helpers.cpp. All code generation remains in the pinned source.
 `rm-integration.patch` and the canonical `nvkmd_rm.*` implement backend
 selection and report only capabilities actually provided by the adapter.
 On 26.2 it also moves nouveau's shared-memory derivation into
diff --git a/nvidia-prolapse/driver-source/native/mesa/build.py b/nvidia-prolapse/driver-source/native/mesa/build.py
index d7a60ff..1829ec8 100644
--- a/nvidia-prolapse/driver-source/native/mesa/build.py
+++ b/nvidia-prolapse/driver-source/native/mesa/build.py
@@ -19,7 +19,7 @@ import cc_launcher  # NATIVE_CC_LAUNCHER (ccache) in front of the C/C++ compiler
 from fetch import fetch, retry_run  # pinned downloads: mirrors, retries, verified before kept
 import android_libelf
 
-PIN = "ddaf85e353442d9d7f192fdcf1823e652e3f2ee3"  # tag mesa-26.2.5 (2026-10-14)
+PIN = "8e87a503ebd91408c88596d1b9eeb5f4c0b2088d"  # tag mesa-26.2.6 (2026-10-28)
 SOURCE = ROOT / "build/mesa-rm-source"
 TOOLS = ROOT / "build/nak-tools/bin"
 DEPS = ROOT / "build/nvk-host-deps"
diff --git a/nvidia-prolapse/driver-source/native/mesa/gallium-nvrm/nvrm_screen.c b/nvidia-prolapse/driver-source/native/mesa/gallium-nvrm/nvrm_screen.c
index 096cc38..cf5dd35 100644
--- a/nvidia-prolapse/driver-source/native/mesa/gallium-nvrm/nvrm_screen.c
+++ b/nvidia-prolapse/driver-source/native/mesa/gallium-nvrm/nvrm_screen.c
@@ -1035,7 +1035,7 @@ nvrm_get_disk_shader_cache(struct pipe_screen *pscreen)
 static void
 nvrm_set_max_shader_compiler_threads(struct pipe_screen *pscreen, unsigned max_threads)
 {
-   util_queue_adjust_num_threads(&nvrm_screen(pscreen)->compile_queue, max_threads, false);
+   util_queue_adjust_num_threads(&nvrm_screen(pscreen)->compile_queue, max_threads);
 }
 
 /* GL_COMPLETION_STATUS (main/shaderapi.c): non-blocking. */
